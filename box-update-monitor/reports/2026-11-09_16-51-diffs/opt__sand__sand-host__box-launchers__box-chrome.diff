+exit_locale_script() {
+	local bundled="${0%/box-launchers/box-chrome}/box-scripts/sand-egress-timezone.mjs"
+	case "$0" in
+	/*/box-launchers/box-chrome)
+		[ ! -r "${bundled}" ] || {
+			printf '%s' "${bundled}"
+			return 0
+		}
+		;;
+	esac
+	printf '%s' /usr/local/bin/sand-egress-timezone.mjs
+}
+# With TZ set, Chrome takes its zone from TZ instead of watching /etc/localtime
+# (https://chromium.googlesource.com/chromium/src/+/refs/tags/151.0.7922.169/services/device/time_zone_monitor/time_zone_monitor_linux.cc),
+# so every page and worker of this browser keeps the exit's zone, and the
+# governor reads the zone back from --sand-exit-geo. A lookup that fails or
+# runs out of time leaves the launch as it was.
+apply_exit_locale() {
+	local script line zone list provider source i as_box=()
+	[ -e "${SAND_BROWSER_EXIT_LOCALE_FILE}" ] && [ -n "${SAND_EGRESS_PROXY_ADDR}" ] || return 0
+	[ "${#SAND_TAILNET_SUFFIXES[@]}" -eq 0 ] || return 0
+	script="$(exit_locale_script)"
+	[ -x "${SAND_COOKIE_NODE}" ] && [ -r "${script}" ] || return 0
+	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
+	line="$(timeout "${SAND_EXIT_LOCALE_WAIT_S}" "${as_box[@]}" "${SAND_COOKIE_NODE}" "${script}" \
+		--exit-locale "http://${SAND_EGRESS_PROXY_ADDR}" "${SAND_ACCEPT_LANGUAGE_LIST}" </dev/null 2>/dev/null 9>&-)" || return 0
+	IFS=$'\t' read -r zone list provider source <<<"${line}" || true
+	case "${zone}" in
+	'' | - | */ | /* | *..* | *[!A-Za-z0-9_+/-]*) return 0 ;;
+	esac
+	[ -f "/usr/share/zoneinfo/${zone}" ] || return 0
+	case "${provider},${source}" in
+	*[!a-z_,]*) return 0 ;;
+	esac
+	CHROME_ENV+=(TZ="${zone}")
+	CHROME_FLAGS+=(--sand-exit-geo="${zone},${provider},${source}")
+	if [ "${SAND_ACCEPT_LANGUAGE_FLAGGED}" = 1 ] && sand_accept_language_valid "${list}"; then
+		for i in "${!CHROME_FLAGS[@]}"; do
+			case "${CHROME_FLAGS[i]}" in --accept-lang=*) CHROME_FLAGS[i]="--accept-lang=${list}" ;; esac
+		done
+	fi
+}
