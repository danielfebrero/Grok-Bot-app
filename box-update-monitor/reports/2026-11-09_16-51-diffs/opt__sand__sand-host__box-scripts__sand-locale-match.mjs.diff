+export function likelyLanguage(country) {
+  try {
+    const locale = new Intl.Locale(`und-${country}`).maximize();
+    return locale.region === country ? locale.language : undefined;
+  } catch (error) {
+    if (error instanceof RangeError) return undefined;
+    throw error;
+  }
+}
