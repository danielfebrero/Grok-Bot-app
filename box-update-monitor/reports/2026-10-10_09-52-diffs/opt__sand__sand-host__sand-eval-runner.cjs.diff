+var schema_default22 = '{
+\n  "properties": {
+\n    "namespace": {
+\n      "description": "Dynamic namespace to inspect, e.g. an MCP server.",\n      "type": "string"\n    }
+,\n    "pattern": {
+\n      "description": "RE2 regex pattern to search namespace and tool names (max 256 chars). Optionally combine with namespace to scope the search.",\n      "type": "string"\n    }
+,\n    "toolName": {
+\n      "description": "Tool name within the namespace. Requires namespace to be set.",\n      "type": "string"\n    }
+\n  }
+,\n  "type": "object"\n}
+\n';
+
+
+// raw-text:/workdir/packages/grok-bot-harness/frozen-prompts/grok-bot-2026-10-09/tools/GetMcpServerStatus/description.md
+var description_default23 = "The runtime status of the user's installed MCP servers (connected / needsAuth / needsGrant / error, per account). needsGrant means the user already connected it but has not granted it this turn: call AuthenticateMcpServer for it and nothing else;
