 	[ "${SAND_HOST_UID_SPLIT_ACTIVE}" = "1" ]
 }
 
+# write_hibernate_hook_script must emit the same bytes as
+# buildHibernateHookScript in
+# sand/src/host/extensions/box-store-sync/hibernate-hook-service.ts;
+# hibernate-hook-service.test.ts asserts the parity.
+sand_box_hibernate_hook_requested() {
+	[ "${SAND_BOX_STORE_HIBERNATE_HOOK:-}" = "1" ]
+}
+write_hibernate_hook_script() {
+	local fifo_dir="$1"
+	printf '%s\n' \
+		'#!/bin/sh' \
+		"resp=\$(mktemp -u \"${fifo_dir}/response.\$\$.XXXXXXXX\") || exit 2" \
+		"trap 'rm -f \"\$resp\"' EXIT" \
+		'mkfifo -m 0622 "$resp" || exit 2' \
+		"printf 'flush %s\\n' \"\$resp\" > ${fifo_dir}/request || exit 2" \
+		'IFS= read -r status < "$resp" || exit 2' \
+		'[ "$status" = "ok" ]'
+}
+provision_hibernate_hook_channel() {
+	local hook_path="$1" fifo_dir="$2" owner="$3" group="$4"
+	rm -rf "${fifo_dir}" "${hook_path}.staged" 2>/dev/null || true
+	if ! sand_box_hibernate_hook_requested; then
+		rm -f "${hook_path}" 2>/dev/null || true
+		return 0
+	fi
+	install -d -m 1733 -o "${owner}" -g "${group}" "${fifo_dir}" || return 1
+	mkfifo -m 0622 "${fifo_dir}/request" || return 1
+	chown "${owner}:${group}" "${fifo_dir}/request" || return 1
+	write_hibernate_hook_script "${fifo_dir}" >"${hook_path}.staged" || return 1
+	chmod 0755 "${hook_path}.staged" || return 1
+	mv -f "${hook_path}.staged" "${hook_path}" || return 1
+}
+
