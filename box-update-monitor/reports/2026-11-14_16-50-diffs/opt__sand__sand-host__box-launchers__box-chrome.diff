 # curl sends a plain http request through the proxy that http_proxy, all_proxy
 # or ALL_PROXY names unless no_proxy covers the host
-# (https://curl.se/docs/manpage.html#ENVIRONMENT), so with one of them set the
-# readiness probe may never have reached this box's own CDP port.
+# (https://curl.se/docs/manpage.html#ENVIRONMENT). The readiness check goes past
+# that proxy as the read after the wait does, so with one of them set a launch
+# reads proxied only when the browser answers that read and not the readiness
+# check that follows it. A launcher whose readiness check went to the proxy
+# wrote proxied for a browser the check never reached.
 cdp_proxy_named() {
 	[ -n "${http_proxy:-}${all_proxy:-}${ALL_PROXY:-}" ]
 }
