+/**
+ * Vertical gradient across an arc band.  pptxgenjs has no gradient fill, so
+ * the band is painted as overlapping slices: every slice reaches the far end
+ * of the sweep, which hides the seams between them.
+ */
+function arcBandGradient(s, cx, cy, rIn, rOut, a0, a1, top, bottom) {
+  const N = 26;
+  const mid = (rIn + rOut) / 2;
+  const yOf = function (a) { return cy + mid * Math.sin(a * RAD); };
+  let yMin = 1e9, yMax = -1e9;
+  for (let i = 0; i <= N; i++) {
+    const y = yOf(a0 + (a1 - a0) * i / N);
+    yMin = Math.min(yMin, y); yMax = Math.max(yMax, y);
+  }
+  for (let i = 0; i < N; i++) {
+    const b0 = a0 + (a1 - a0) * i / N;
+    const t = (yOf(b0 + (a1 - a0) / N / 2) - yMin) / (yMax - yMin || 1);
+    arcBand(s, cx, cy, rIn, rOut, b0, a1, { color: mixHex(top, bottom, t) });
+  }
