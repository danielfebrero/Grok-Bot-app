+/** Linear gradient rectangle, painted as overlapping slices. */
+function gradRect(s, x, y, w, h, from, to, dir) {
+  const N = 26;
+  for (let i = 0; i < N; i++) {
+    const t = (i + 0.5) / N;
+    const c = mixHex(from, to, t);
+    if (dir === 'down') rect(s, x, y + h * i / N, w, h - h * i / N, c);
+    else rect(s, x + w * i / N, y, w - w * i / N, h, c);
+  }
