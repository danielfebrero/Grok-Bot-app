+    x: x, y: y, w: w, h: h, fill: fill,
+    points: [
+      { x: p0[0] - x, y: p0[1] - y },
+      { curve: { type: 'arc', wR: rOut, hR: rOut, stAng: a0, swAng: a1 - a0 } },
+      { x: p1[0] - x, y: p1[1] - y },
+      { curve: { type: 'arc', wR: rIn, hR: rIn, stAng: a1, swAng: a0 - a1 } },
+      { close: true }
