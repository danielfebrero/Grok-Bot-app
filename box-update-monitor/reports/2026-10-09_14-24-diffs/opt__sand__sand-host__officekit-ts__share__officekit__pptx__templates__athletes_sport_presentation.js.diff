+    sp.forEach(function (p) {
+      x0 = Math.min(x0, p[0]); y0 = Math.min(y0, p[1]);
+      x1 = Math.max(x1, p[0]); y1 = Math.max(y1, p[1]);
+    });
+  });
+  const list = [];
+  subpaths.forEach(function (sp) {
+    sp.forEach(function (p, i) {
+      const pt = { x: p[0] - x0, y: p[1] - y0 };
+      if (i === 0) pt.moveTo = true;
+      list.push(pt);
+    });
+    list.push({ close: true });
+  });
+  shape(s, 'custGeom', Object.assign({
+    x: ox + x0, y: oy + y0, w: x1 - x0, h: y1 - y0,
+    fill: { color: color }, points: list
+  }, o || {}));
