+function mixHex(a, b, t) {
+  t = Math.max(0, Math.min(1, t));
+  let out = '';
+  for (let i = 0; i < 3; i++) {
+    const va = parseInt(a.substr(i * 2, 2), 16), vb = parseInt(b.substr(i * 2, 2), 16);
+    out += Math.round(va + (vb - va) * t).toString(16).padStart(2, '0');
