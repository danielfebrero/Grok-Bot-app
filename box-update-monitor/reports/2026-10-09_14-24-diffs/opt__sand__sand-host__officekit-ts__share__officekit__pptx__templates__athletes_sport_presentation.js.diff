+function arcBand(s, cx, cy, rIn, rOut, a0, a1, fill) {
+  const at = function (r, a) { return [cx + r * Math.cos(a * RAD), cy + r * Math.sin(a * RAD)]; };
+  const xs = [], ys = [];
+  for (let i = 0; i <= 12; i++) {
+    const a = a0 + (a1 - a0) * i / 12;
+    [rIn, rOut].forEach(function (r) { const p = at(r, a); xs.push(p[0]); ys.push(p[1]); });
+  }
+  const x = Math.min.apply(null, xs), y = Math.min.apply(null, ys);
+  const w = Math.max.apply(null, xs) - x, h = Math.max.apply(null, ys) - y;
+  const p0 = at(rOut, a0), p1 = at(rIn, a1);
