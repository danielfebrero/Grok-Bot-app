+function arcRegion(s, cx, cy, r, a0, a1, tail, fill) {
+  const at = function (a) { return [cx + r * Math.cos(a * RAD), cy + r * Math.sin(a * RAD)]; };
+  const pts = tail.slice();
+  for (let i = 0; i <= 8; i++) pts.push(at(a0 + (a1 - a0) * i / 8));
+  const xs = pts.map(function (p) { return p[0]; }), ys = pts.map(function (p) { return p[1]; });
+  const x = Math.min.apply(null, xs), y = Math.min.apply(null, ys);
+  const w = Math.max.apply(null, xs) - x, h = Math.max.apply(null, ys) - y;
+  const start = at(a0);
+  const list = [{ x: start[0] - x, y: start[1] - y },
+    { curve: { type: 'arc', wR: r, hR: r, stAng: a0, swAng: a1 - a0 } }];
+  tail.forEach(function (p) { list.push({ x: p[0] - x, y: p[1] - y }); });
+  list.push({ close: true });
+  shape(s, 'custGeom', { x: x, y: y, w: w, h: h, fill: fill, points: list });
