+/** Closed polygon in absolute inches. */
+function poly(s, pts, color, o) {
+  const xs = pts.map(function (p) { return p[0]; });
+  const ys = pts.map(function (p) { return p[1]; });
+  const x = Math.min.apply(null, xs), y = Math.min.apply(null, ys);
+  const w = Math.max.apply(null, xs) - x, h = Math.max.apply(null, ys) - y;
+  const list = pts.map(function (p) { return { x: p[0] - x, y: p[1] - y }; });
+  list.push({ close: true });
+  shape(s, 'custGeom', Object.assign({ x: x, y: y, w: w, h: h, fill: { color: color }, points: list }, o || {}));
+}
