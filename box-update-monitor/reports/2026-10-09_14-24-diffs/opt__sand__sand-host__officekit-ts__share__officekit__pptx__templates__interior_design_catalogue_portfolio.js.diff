+/** Free-form polygon; `pts` are [x,y] fractions of the shape box. */
+function poly(s, x, y, w, h, pts, fill) {
+  s.addShape('custGeom', {
+    x, y, w, h, fill, line: { type: 'none' },
+    points: pts.map(([px, py]) => ({ x: px * w, y: py * h })).concat([{ close: true }]),
