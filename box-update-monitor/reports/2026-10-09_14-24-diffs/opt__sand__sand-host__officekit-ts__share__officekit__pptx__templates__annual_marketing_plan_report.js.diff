+
+// Sutherland-Hodgman clip of one flat ring against the half-plane n.p <= d.
+function clip(ring, nx, ny, d) {
+
+  const out = [];
+
+  for (let i = 0;
+ i < ring.length;
+ i += 2) {
+
+    const ax = ring[i], ay = ring[i + 1];
+
+    const j = (i + 2) % ring.length;
+
+    const bx = ring[j], by = ring[j + 1];
+
+    const da = nx * ax + ny * ay - d, db = nx * bx + ny * by - d;
+
+    if (da <= 0) out.push(ax, ay);
+
+    if ((da < 0 && db > 0) || (da > 0 && db < 0)) {
+
+      const t = da / (da - db);
+
+      out.push(ax + (bx - ax) * t, ay + (by - ay) * t);
+
+    }
+
+  }
+
+  return out;
+
+}
