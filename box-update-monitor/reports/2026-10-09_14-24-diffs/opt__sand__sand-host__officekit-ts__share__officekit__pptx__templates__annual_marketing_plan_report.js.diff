+function blend(a, b, t) {
+
+  let out = '';
+
+  for (let i = 0;
+ i < 3;
+ i++) {
+
+    const x = parseInt(a.substr(i * 2, 2), 16), y = parseInt(b.substr(i * 2, 2), 16);
+
+    out += ('0' + Math.round(x + (y - x) * t).toString(16)).slice(-2);
+
+  }
+
+  return out.toUpperCase();
+
+}
