+// pptxgenjs cannot emit gradient fills, so a linear gradient is painted as a
+// stack of nested shapes: the whole outline in the far colour first, then
+// progressively smaller half-plane clips on top. Overlaying rather than
+// abutting the slices means no hairline seams. `angle` follows OOXML:
+// 0 = left to right, 90 = top to bottom.
+function grad(s, r, poly, from, to, angle, opts) {
+
+  const rad = angle * Math.PI / 180, nx = Math.cos(rad), ny = Math.sin(rad);
+
+  let lo = Infinity, hi = -Infinity, size = 0;
+
+  for (let n = 1;
+ n < poly.length;
+ n++) {
+
+    const ring = poly[n];
+
+    size += ring.length / 2;
+
+    for (let i = 0;
+ i < ring.length;
+ i += 2) {
+
+      const v = nx * ring[i] + ny * ring[i + 1];
+
+      if (v < lo) lo = v;
+
+      if (v > hi) hi = v;
+
+    }
+
+  }
+
+  // one slice per ~0.1in along the gradient, fewer for very detailed outlines
+  const inches = Math.abs(nx) * r[2] + Math.abs(ny) * r[3];
+
+  const bands = Math.max(2, Math.min(size > 400 ? 10 : 24, Math.round(inches / 0.1)));
+
+  const step = (hi - lo) / bands;
+
+  for (let i = bands - 1;
+ i >= 0;
+ i--) {
+
+    const cut = [poly[0]];
+
+    for (let n = 1;
+ n < poly.length;
+ n++) {
+
+      const c = i === bands - 1 ? poly[n] : clip(poly[n], nx, ny, lo + step * (i + 1));
+
+      if (c.length > 4) cut.push(c);
+
+    }
+
+    if (cut.length > 1) {
+
+      icon(s, r, cut, blend(from, to, (i + 0.5) / bands),
+        i === bands - 1 ? opts : Object.assign({
+}
+, opts, {
+ shadow: undefined, line: undefined }
+));
+
+    }
+
+  }
+
+}
