+// ------------------------------------------------------- custom geometry
+// Outlines live in a 0..1000 square and are scaled into the target rectangle.
+
+// `poly` is [grid, ring, ring...];
+ each ring is a flat x,y,x,y list on a
+// 0..grid square, mapped onto the target rectangle. Rings after the first cut
+// holes, so an outline is drawn as a single multi-subpath shape.
+function icon(s, r, poly, fill, opts) {
+
+  const g = poly[0], pts = [];
+
+  for (let n = 1;
+ n < poly.length;
+ n++) {
+
+    const ring = poly[n];
+
+    for (let i = 0;
+ i < ring.length;
+ i += 2) {
+
+      pts.push({
+ x: ring[i] * r[2] / g, y: ring[i + 1] * r[3] / g, moveTo: i === 0 }
+);
+
+    }
+
+    pts.push({
+ close: true }
+);
+
+  }
+
+  if (pts.length) {
+
+    shape(s, 'custGeom', r,
+      Object.assign({
+ points: pts, fill: solid(fill), line: {
+ type: 'none' }
+ }
+, opts));
+
+  }
+
+}
