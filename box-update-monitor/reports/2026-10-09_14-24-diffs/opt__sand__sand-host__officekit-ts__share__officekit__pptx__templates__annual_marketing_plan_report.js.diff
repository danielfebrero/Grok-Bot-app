+// ------------------------------------------------------------------- helpers
+// Every draw helper takes the rectangle as [x, y, w, h] in inches.
+
+function shape(s, kind, r, opts) {
+
+  s.addShape(kind, Object.assign({
+ x: r[0], y: r[1], w: r[2], h: r[3] }
+, opts));
+
+}
+
+
+function box(s, r, fill, opts) {
+
+  shape(s, 'rect', r, Object.assign({
+ fill: solid(fill) }
+, opts));
+
+}
+
+
+function oval(s, r, fill, opts) {
+
+  shape(s, 'ellipse', r, Object.assign({
+ fill: solid(fill) }
+, opts));
+
+}
+
+
+function pill(s, r, fill, radius, opts) {
+
+  shape(s, 'roundRect', r, Object.assign({
+ fill: solid(fill), rectRadius: radius }
+, opts));
+
+}
+
+
+// Thin accent rule (the source deck uses zero-height/width connectors).
+function rule(s, r, color, width, opts) {
+
+  shape(s, 'line', r, Object.assign({
+ line: {
+ color: color, width: width }
+ }
+, opts));
+
+}
+
+
+function solid(fill) {
+
+  if (!fill) return {
+ type: 'none' }
+;
+
+  return typeof fill === 'string' ? {
+ color: fill }
+ : fill;
+
+}
+
+
+// `body` is one string or an array of strings, one per paragraph. `style` is one
+// style object (shared) or an array of them, one per paragraph.
