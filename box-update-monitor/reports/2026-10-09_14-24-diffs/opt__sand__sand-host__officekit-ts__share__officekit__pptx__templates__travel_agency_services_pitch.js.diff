+    ['C', 0, (r - k) / ht, (r - k) / wd, 0, r / wd, 0],
+    ['L', (wd - r) / wd, 0],
+    ['C', (wd - r + k) / wd, 0, 1, (r - k) / ht, 1, r / ht],
+    ['L', 1, 1], ['Z']
