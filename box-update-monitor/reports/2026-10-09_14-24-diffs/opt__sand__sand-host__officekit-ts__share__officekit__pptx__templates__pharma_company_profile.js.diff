+// string -> one paragraph, [str, str] -> one paragraph each, [{text,options}] -> runs
+function paragraphs(t) {
+  if (!Array.isArray(t)) return t;
+  if (typeof t[0] === 'object') return t;
+  return t.map((p, i) => ({ text: p, options: { breakLine: i < t.length - 1 } }));
