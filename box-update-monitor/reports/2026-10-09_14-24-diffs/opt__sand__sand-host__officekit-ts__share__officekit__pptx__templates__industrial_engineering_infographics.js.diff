+      x: x + inset, y: y + inset, w: size - 2 * inset, h: size - 2 * inset,
+      chartColors: [color, 'FFFFFF'], chartColorsOpacity: 100,
+      showLegend: false, showTitle: false, showValue: false,
+      layout: { x: 0.005, y: 0.005, w: 0.99, h: 0.9875 },
+      chartArea: { fill: { color: 'FFFFFF', transparency: 100 } },
+      plotArea: { fill: { color: 'FFFFFF', transparency: 100 } },
+      dataBorder: { pt: 0.1, color: 'FFFFFF' },
+    });
+  const hub = size * 0.547;
+  shape(slide, 'ellipse', { x: x + (size - hub) / 2, y: y + (size - hub) / 2, w: hub, h: hub,
+    fill: { color: C.white } });
