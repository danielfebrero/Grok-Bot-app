+// runs: array of [text, {opts}] pairs -> pptxgenjs rich-text array
+function runs(pairs, common) {
+  return pairs.map(([text, o]) => ({ text, options: Object.assign({}, common, o) }));
+}
+
+function addText(slide, content, o) {
+  slide.addText(content, Object.assign({ margin: INSET, valign: 'top', wrap: true }, o));
