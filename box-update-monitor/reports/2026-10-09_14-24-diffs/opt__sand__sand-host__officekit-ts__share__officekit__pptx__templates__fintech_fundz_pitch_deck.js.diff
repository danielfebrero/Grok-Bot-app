+/**
+ * Fundz Financial Technology — fintech presentation template (30 slides, 13.333" x 7.5").
+ * Standalone pptxgenjs recreation of the reference deck.
+ * Raster images in the original are replaced with flat "[image]" placeholder rectangles.
+ */
+'use strict';
+
+
+const path = require('path');
+
+const PptxGenJS = require('pptxgenjs');
+
+
+// ---------------------------------------------------------------------------
+// Theme
+// ---------------------------------------------------------------------------
+
+const TEAL = '017871';
+ // accent1 / accent3 / accent5
+const TEAL_DK = '005A54';
+ // accent1 shaded 25%
+const PEACH = 'FFC4BA';
+ // accent2 / accent4 / accent6
+const PEACH_DK = 'BF938B';
+ // accent4 shaded 25%
+const WHITE = 'FFFFFF';
+
+const NAVY = '333F4F';
+ // tx2 lumMod 75%
+const INK = '231A28';
+ // literal ink used by a few headings
+const GREY05 = '0C0C0C';
+ // tx1 +5%
+const GREY15 = '262626';
+ // tx1 +15%
+const GREY25 = '3F3F3F';
+ // tx1 +25%
+const GREY35 = '595959';
+ // tx1 +35%
+const GREY50 = '7F7F7F';
+ // tx1 +50%
+const GREY_LN = 'BFBFBF';
+ // bg1 -25%
+const GREY_BAR = 'F2F2F2';
+ // bg1 -5%
+const PHOTO_TINT = 'FBFBFB';
+ // stand-in tint for removed photographs
+const PHOTO_LABEL = "C9C9C9";
+
+
+const MAJOR = 'Space Grotesk';
+ // +mj-lt
+const MINOR = 'Rubik';
+ // +mn-lt
+
+// Diffuse drop shadows used by the template's "floating card" shapes
+// (the source deck uses ~50-75pt blur at 14-15% black, offset down-right).
+const CARD_SHADOW = {
+ type: 'outer', color: '000000', opacity: 0.14, blur: 70, offset: 26, angle: 45 }
+;
+
+const SOFT_SHADOW = {
+ type: 'outer', color: '000000', opacity: 0.13, blur: 46, offset: 20, angle: 45 }
+;
+
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/** Text box matching the template default: 0.1" side / 0.05" top-bottom insets. */
+function tbox(slide, text, o) {
+
+  slide.addText(text, Object.assign({
+ fontFace: MINOR, margin: [7.2, 7.2, 3.6, 3.6], valign: 'top' }
+, o));
+
+}
+
+
+/** Heading in the major (display) typeface. */
+function heading(slide, text, o) {
+
+  tbox(slide, text, Object.assign({
+ fontFace: MAJOR, color: GREY25 }
+, o));
+
+}
+
+
+/** Body copy in the minor typeface, 12pt grey, 130% leading. */
+function body(slide, text, o) {
+
+  tbox(slide, text, Object.assign({
+ fontSize: 12, color: GREY50, lineSpacingMultiple: 1.3 }
+, o));
+
+}
+
+
+function rect(slide, o) {
+
+  slide.addShape('rect', o);
+
+}
+
+
+function roundRect(slide, o) {
+
+  slide.addShape('roundRect', o);
+
+}
+
+
+function ellipse(slide, o) {
+
+  slide.addShape('ellipse', o);
+
+}
+
+
+/** Straight connector (pptxgenjs draws a `line` shape between x,y and x+w,y+h). */
+function connector(slide, o) {
+
+  slide.addShape('line', o);
+
+}
+
+
+/**
+ * Stand-in for a raster image. The template ships with its picture placeholders empty
+ * (they render as nothing), so this is used only where the reference actually shows
+ * artwork: the tilted phone on slide 27 and the grey photo bed on slide 30.
+ */
+function photoFrame(slide, x, y, w, h, opts) {
+
+  const o = opts || {
+}
+;
+
+  slide.addShape(o.shape || 'rect', {
+
+    x: x, y: y, w: w, h: h,
+    fill: {
+ color: o.tint || PHOTO_TINT }
+,
+    line: o.line || {
+ type: 'none' }
+,
+    rectRadius: o.rectRadius, rotate: o.rotate,
+  }
+);
+
+  if (o.label) {
+
+    tbox(slide, '[image]', {
+
+      x: x, y: y + h / 2 - 0.18, w: w, h: 0.36, align: 'center', valign: 'middle',
+      fontSize: 11, color: o.labelColor || PHOTO_LABEL, rotate: o.rotate,
+    }
+);
+
+  }
+
+}
+
+
+/** Circular "icon chip": filled disc plus a glyph drawn as text. */
+function iconChip(slide, x, y, d, fill, glyph, glyphColor, glyphSize) {
+
+  ellipse(slide, {
+ x: x, y: y, w: d, h: d, fill: {
+ color: fill }
+, line: {
+ type: 'none' }
+ }
+);
+
+  if (glyph) {
+
+    tbox(slide, glyph, {
+
+      x: x, y: y, w: d, h: d, align: 'center', valign: 'middle', fontFace: MAJOR,
+      fontSize: glyphSize || Math.round(d * 26), color: glyphColor || WHITE,
+    }
+);
+
+  }
+
+}
+
+
+/** Small square glyph-stand-in for the deck's line icons (frame + inner bar). */
+function iconGlyph(slide, x, y, d, color) {
+
+  slide.addShape('roundRect', {
+
+    x: x + d * 0.22, y: y + d * 0.22, w: d * 0.56, h: d * 0.56, rectRadius: d * 0.06,
+    fill: {
+ type: 'none' }
+, line: {
+ color: color, width: 1.25 }
+,
+  }
+);
+
+  connector(slide, {
+ x: x + d * 0.32, y: y + d * 0.5, w: d * 0.36, h: 0, line: {
+ color: color, width: 1.25 }
+ }
+);
+
+}
+
+
+/** Arrow-in-circle button used on the "Hello & Welcome" / two-paragraph slides. */
+function arrowButton(slide, x, y, d, glyph) {
+
+  ellipse(slide, {
+ x: x, y: y, w: d, h: d, fill: {
+ color: WHITE }
+, line: {
+ type: 'none' }
+, shadow: SOFT_SHADOW }
+);
+
+  tbox(slide, glyph || '\u2192', {
+
+    x: x, y: y, w: d, h: d, align: 'center', valign: 'middle', fontSize: 14, fontFace: MAJOR, color: TEAL,
+  }
+);
+
+}
