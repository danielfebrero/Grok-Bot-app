+];
+
+function asterisk(s, x, y, w, h, color, rotate) {
+  const points = STAR.map(([px, py], i) => ({ x: px * w, y: py * h, moveTo: i === 0 }));
+  points.push({ close: true });
+  s.addShape('custGeom', { x, y, w, h, points, rotate,
+                           fill: { color }, line: { type: 'none' } });
+}
