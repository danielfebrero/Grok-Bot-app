+  const faceH = h * 0.722;
+  const fy = y + h - faceH;
+  const half = w / 2;
+  box(s, x, fy, half, faceH, {
+    shape: 'custGeom', fill: left,
+    points: [{ x: half, y: faceH, moveTo: true }, { x: 0, y: faceH * 0.625 },
+      { x: 0, y: 0 }, { x: half, y: faceH * 0.375 }, { close: true }],
+  });
+  box(s, x + half, fy, half, faceH, {
+    shape: 'custGeom', fill: right,
+    points: [{ x: half, y: faceH * 0.625, moveTo: true }, { x: 0, y: faceH },
+      { x: 0, y: faceH * 0.375 }, { x: half, y: 0 }, { close: true }],
+  });
+  box(s, x, y, w, topH, {
+    shape: 'custGeom', fill: top,
+    points: [{ x: w, y: topH * 0.505, moveTo: true }, { x: half, y: topH },
+      { x: 0, y: topH * 0.505 }, { x: half, y: 0 }, { close: true }],
+  });
