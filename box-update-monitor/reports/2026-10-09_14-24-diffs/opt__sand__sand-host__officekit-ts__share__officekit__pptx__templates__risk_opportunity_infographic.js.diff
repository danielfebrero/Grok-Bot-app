+
+/** Rounded rectangle; `adj` is the corner radius as a fraction of the short side. */
+function rrect(slide, o) {
+  const adj = o.adj === undefined ? 0.1667 : o.adj;
+  slide.addShape('roundRect', Object.assign({}, o, {
+    adj: undefined, rectRadius: adj * Math.min(o.w, o.h),
+  }));
+}
+
+/** Filled ellipse. */
+function circle(slide, o) { slide.addShape('ellipse', o); }
+
+/** Convert a compact path list ['M',x,y,'L',x,y,'C',x1,y1,x2,y2,x,y,'Z'] into
+ *  PptxGenJS custGeom points. Coordinates are fractions of the shape box. */
+function pathPoints(cmds, w, h) {
+  const pts = [];
+  for (let i = 0; i < cmds.length;) {
+    const op = cmds[i++];
+    if (op === 'Z') { pts.push({ close: true }); } else if (op === 'M') {
+      pts.push({ x: cmds[i++] * w, y: cmds[i++] * h, moveTo: true });
+    } else if (op === 'L') {
+      pts.push({ x: cmds[i++] * w, y: cmds[i++] * h });
+    } else if (op === 'C') {
+      const x1 = cmds[i++] * w, y1 = cmds[i++] * h;
+      const x2 = cmds[i++] * w, y2 = cmds[i++] * h;
+      pts.push({ x: cmds[i++] * w, y: cmds[i++] * h, curve: { type: 'cubic', x1, y1, x2, y2 } });
+    }
+  }
+  return pts;
+}
+
+/** Free-form shape from a normalised path. */
+function poly(slide, o, cmds) {
+  slide.addShape('custGeom', Object.assign({}, o, { points: pathPoints(cmds, o.w, o.h) }));
+}
+
+/** Mirror a normalised path horizontally and/or vertically. */
+function mirror(cmds, flipX, flipY) {
+  const out = [];
+  for (let i = 0; i < cmds.length;) {
+    const op = cmds[i++];
+    out.push(op);
+    const n = op === 'Z' ? 0 : op === 'C' ? 6 : 2;
+    for (let k = 0; k < n; k += 2) {
+      out.push(flipX ? +(1 - cmds[i]).toFixed(4) : cmds[i]);
+      out.push(flipY ? +(1 - cmds[i + 1]).toFixed(4) : cmds[i + 1]);
+      i += 2;
+    }
+  }
+  return out;
+}
+function mirrorX(cmds) { return mirror(cmds, true, false); }
+function mirrorY(cmds) { return mirror(cmds, false, true); }
+
+/** Open poly-line / connector given absolute inch points. */
+function polyline(slide, pts, line) {
+  const xs = pts.map((p) => p[0]);
+  const ys = pts.map((p) => p[1]);
+  const x = Math.min.apply(null, xs);
+  const y = Math.min.apply(null, ys);
+  const w = Math.max(0.01, Math.max.apply(null, xs) - x);
+  const h = Math.max(0.01, Math.max.apply(null, ys) - y);
+  slide.addShape('custGeom', {
+    x, y, w, h, line,
+    points: pts.map((p, i) => (i === 0
+      ? { x: p[0] - x, y: p[1] - y, moveTo: true }
+      : { x: p[0] - x, y: p[1] - y })),
+  });
+}
