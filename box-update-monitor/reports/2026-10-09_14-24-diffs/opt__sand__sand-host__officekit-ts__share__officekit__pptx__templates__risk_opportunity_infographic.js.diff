+const PLANK_W = 3.232;   // width of a jigsaw plank, inches
+const KNOB = 0.2;        // how far a knob sticks out of the plank body
+
+/**
+ * Wide jigsaw plank measured in inches and normalised to its shape box:
+ * a socket on the left edge, an optional socket in the top edge at `topKnob`
+ * and an optional knob under the bottom edge at `botKnob` (x offsets, inches).
+ */
+function plank(bodyH, topKnob, botKnob) {
+  const h = bodyH + (botKnob === null ? 0 : KNOB);
+  const X = (v) => +(v / PLANK_W).toFixed(4);
+  const Y = (v) => +(v / h).toFixed(4);
+  let p = [];
+  if (topKnob === null) {
+    p = p.concat(['M', X(PLANK_W), 0, 'L', 0, 0]);
+  } else {
+    p = p.concat([
+      'M', X(topKnob + 0.162), Y(0.039),
+      'C', X(topKnob + 0.162), Y(0.128), X(topKnob + 0.09), Y(0.199), X(topKnob), Y(0.199),
+      'C', X(topKnob - 0.09), Y(0.199), X(topKnob - 0.162), Y(0.128), X(topKnob - 0.162), Y(0.039),
+      'C', X(topKnob - 0.162), Y(0.027), X(topKnob - 0.159), Y(0.013), X(topKnob - 0.156), 0,
+      'L', 0, 0]);
+  }
+  // left edge with its socket
+  p = p.concat([
+    'L', 0, Y(0.215),
+    'C', X(0.013), Y(0.212), X(0.026), Y(0.21), X(0.039), Y(0.21),
+    'C', X(0.13), Y(0.21), X(0.198), Y(0.285), X(0.198), Y(0.375),
+    'C', X(0.198), Y(0.465), X(0.13), Y(0.54), X(0.039), Y(0.54),
+    'C', X(0.026), Y(0.54), X(0.013), Y(0.538), 0, Y(0.535),
+    'L', 0, Y(bodyH)]);
+  // bottom edge, optionally with a protruding knob
+  if (botKnob !== null) {
+    p = p.concat([
+      'L', X(botKnob - 0.058), Y(bodyH),
+      'C', X(botKnob - 0.1), Y(bodyH + 0.06), X(botKnob - 0.1), Y(bodyH + 0.14), X(botKnob), Y(h),
+      'C', X(botKnob + 0.1), Y(bodyH + 0.14), X(botKnob + 0.1), Y(bodyH + 0.06), X(botKnob + 0.058), Y(bodyH)]);
+  }
+  p = p.concat(['L', X(PLANK_W), Y(bodyH), 'L', X(PLANK_W), 0]);
+  if (topKnob !== null) {
+    p = p.concat(['L', X(topKnob + 0.156), 0,
+      'C', X(topKnob + 0.159), Y(0.013), X(topKnob + 0.162), Y(0.027), X(topKnob + 0.162), Y(0.039)]);
+  }
+  return p.concat(['Z']);
