+    line: o.line ? { color: o.line, width: o.lw || 0.75 } : { type: 'none' },
+    rectRadius: o.round ? radius(o) : undefined,
+    angleRange: o.diag ? [o.diag / 60000, 0] : undefined,
+    rotate: o.rot || undefined,
+    flipH: o.flip || undefined,
+  });
+}
+
+function textBox(s, str, o, font, size, color) {
+  s.addText(str, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: font, fontSize: size, color: color,
+    bold: o.bold || undefined,
