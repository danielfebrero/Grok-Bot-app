+/* ------------------------------------------------------------------ helpers */
+const deck = new PptxGenJS();
+deck.defineLayout({ name: 'W16', width: 13.333, height: 7.5 });
+deck.layout = 'W16';
+deck.theme = { headFontFace: F.major, bodyFontFace: F.minor };
