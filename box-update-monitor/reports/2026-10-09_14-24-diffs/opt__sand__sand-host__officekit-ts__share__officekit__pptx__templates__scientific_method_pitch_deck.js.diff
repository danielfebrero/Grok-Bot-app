+];
+const CHEVRON = [ // ">" arrow used in the round buttons
+  [0.878, 0.349], [0.238, 0.021], [0.041, 0.021], [0.04, 0.122], [0.041, 0.122],
+  [0.683, 0.449], [0.683, 0.55], [0.683, 0.551], [0.041, 0.878], [0.041, 0.979],
+  [0.238, 0.979], [0.878, 0.651],
