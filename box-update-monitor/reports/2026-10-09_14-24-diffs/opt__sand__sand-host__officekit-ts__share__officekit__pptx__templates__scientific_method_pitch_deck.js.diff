+  teal: '35CFDF',
+  tealLt: '88E2EC',
+  tealDk: '1CA5B3',
+  blue: '00A4F0',
+  imgBg: 'EFEFEF',
+  imgFg: '9A9A9A',
+  g1: 'F2F2F2',
+  g2: 'D9D9D9',
