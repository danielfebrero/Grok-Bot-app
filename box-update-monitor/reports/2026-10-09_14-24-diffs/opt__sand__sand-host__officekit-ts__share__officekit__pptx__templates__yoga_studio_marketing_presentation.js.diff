+// ---------------------------------------------------------------- helpers ---
+/** Freeform shape: scales a normalised GEO outline into the box x/y/w/h. */
+function freeform(slide, geoName, x, y, w, h, fill, opts = {}) {
+  const pts = GEO[geoName].map(c => {
+    if (c[0] === 'Z') return { close: true };
+    if (c[0] === 'M') return { x: c[1] * w, y: c[2] * h, moveTo: true };
+    if (c[0] === 'L') return { x: c[1] * w, y: c[2] * h };
+    return { x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h } };
+  });
+  slide.addShape('custGeom', Object.assign({ x, y, w, h, points: pts, fill: { color: fill }, line: NO_LINE }, opts));
+}
+
+/** Plain filled rectangle (used for cards, colour blocks and progress bars). */
+function rect(slide, x, y, w, h, fill, opts = {}) {
+  slide.addShape('rect', Object.assign({ x, y, w, h, fill: { color: fill }, line: NO_LINE }, opts));
+}
+
+/** The three dots that sit in a top corner of every slide (2 filled, 1 outlined). */
+function dots(slide, x, color) {
+  [0, 0.1727, 0.3453].forEach((dx, i) => {
+    slide.addShape('ellipse', {
+      x: x + dx, y: 0.2855, w: 0.1077, h: 0.1077,
+      fill: i < 2 ? { color } : { type: 'none' },
+      line: i < 2 ? NO_LINE : { color, width: 0.75 },
+    });
+  });
+}
+
+/** Four-point star glint: a big star plus a small companion diagonally below it.
+ *  The companion sits below-right normally, below-left when the pair hugs the right edge. */
+function sparkles(slide, x, y, color, toLeft = false) {
+  freeform(slide, 'sparkle', x, y, 0.4402, 0.4402, color);
+  freeform(slide, 'sparkle', x + (toLeft ? -0.1595 : 0.3519), y + 0.3512, 0.2497, 0.2497, color);
+}
+
+/** Short teal rule (dash + two dots) that sits above every section heading. */
+function rule(slide, x, y, color = TEAL, w = 0.5037, h = 0.0676) {
+  freeform(slide, 'accentBar', x, y, w, h, color);
+}
+
+/** Heading in Oswald: runs is [text, colour, text, colour, ...]; lines split on '\n'.
+ *  The two 54pt cover titles sit in non-wrapping, auto-sized boxes. */
+function heading(slide, x, y, w, h, runs, size = 28, wrap = true) {
+  const parts = [];
+  for (let i = 0; i < runs.length; i += 2) {
+    String(runs[i]).split('\n').forEach((piece, n, all) => {
+      parts.push({ text: piece, options: { color: runs[i + 1], breakLine: n < all.length - 1 } });
+    });
+  }
+  slide.addText(parts, {
+    x, y, w, h, fontFace: HEAD, fontSize: size, bold: true, charSpacing: 3,
+    align: 'left', valign: 'top', wrap, fit: wrap ? undefined : 'resize',
+  });
+}
+
+/** Small all-caps Oswald label (14pt by default, 12pt on slides 2-4). */
+function label(slide, x, y, w, h, text, color, size = 14, align = 'left') {
+  slide.addText(text, {
+    x, y, w, h, fontFace: HEAD, fontSize: size, bold: true, charSpacing: 3,
+    color, align, valign: 'top', wrap: false, fit: 'resize',
+  });
+}
+
+/** Roboto body copy — always 10.5pt with 1.5 line spacing. */
+function body(slide, x, y, w, h, text, color = GREY, align = 'left') {
+  slide.addText(text, {
+    x, y, w, h, fontFace: BODY, fontSize: 10.5, color, align,
+    lineSpacingMultiple: 1.5, valign: 'top', wrap: true, fit: 'resize',
+  });
+}
+
+/** Teal/white/orange pill button reading "Read More". */
+function button(slide, x, y, fill, textColor) {
+  slide.addShape('roundRect', {
+    x, y, w: 1.5217, h: 0.4674, rectRadius: 0.2337,
+    fill: { color: fill }, line: NO_LINE,
+  });
+  slide.addText('Read More', {
+    x: x + 0.0981, y: y + 0.0906, w: 1.3257, h: 0.2861,
+    fontFace: BODY, fontSize: 10.5, charSpacing: 3, color: textColor,
+    align: 'center', valign: 'top', wrap: false, fit: 'resize',
+  });
+}
+
+/** Bottom-left studio credit + bottom-right page number. */
+function footer(slide, studioColor, pageText, pageColor) {
+  slide.addText('Your Studio Name', {
+    x: 0.3406, y: 6.9368, w: 2.062, h: 0.2777,
+    fontFace: BODY, fontSize: 10.5, charSpacing: 3, color: studioColor,
+    valign: 'top', wrap: false, fit: 'resize',
+  });
+  slide.addText(pageText, {
+    x: 11.9598, y: 6.9368, w: 1.0329, h: 0.2777,
+    fontFace: BODY, fontSize: 10.5, charSpacing: 3, color: pageColor,
+    align: 'right', valign: 'top', wrap: false, fit: 'resize',
+  });
+}
+
+/** Skill meter: grey track with an orange fill on top, captioned above. */
+function meter(slide, x, y, track, filled, caption, captionW) {
+  rect(slide, x, y, track, 0.14, BAR);
+  rect(slide, x, y, filled, 0.14, ORANGE);
+  slide.addText(caption, {
+    x: x - 0.0864, y: y - 0.338, w: captionW, h: 0.2861,
+    fontFace: HEAD, fontSize: 11, color: INK75, valign: 'top', wrap: false, fit: 'resize',
+  });
+}
