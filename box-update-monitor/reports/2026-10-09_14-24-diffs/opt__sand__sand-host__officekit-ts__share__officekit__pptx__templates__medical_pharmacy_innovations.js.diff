+    for (let c = 0; c < line.length; c++) {
+      const ch = line[c];
+      if (ch === ' ') continue;
+      slide.addShape('ellipse', {
+        x: x0 + c * dx - 0.019, y: y0 + r * dy - 0.014, w: 0.038, h: 0.028,
+        fill: { color: ch === '#' ? PINK : 'BFBFBF' },
+      });
+    }
+  });
+}
