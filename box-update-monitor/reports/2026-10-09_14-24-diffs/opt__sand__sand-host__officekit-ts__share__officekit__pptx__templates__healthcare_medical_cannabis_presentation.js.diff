+/* ----------------------------------------------------------- path plumbing */
+function cubic(p0, c1, c2, p3, t) {
+  const u = 1 - t, a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
+  return [a * p0[0] + b * c1[0] + c * c2[0] + d * p3[0],
+          a * p0[1] + b * c1[1] + c * c2[1] + d * p3[1]];
+}
+
+/** Convert a fractional path into pptxgenjs custGeom points (inches). */
+function toPoints(cmds, w, h) {
+  return cmds.map((c, i) => {
+    if (c[0] === 'Z') return { close: true };
+    if (c[0] === 'C') return { x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h } };
+    return i === 0 ? { x: c[1] * w, y: c[2] * h, moveTo: true } : { x: c[1] * w, y: c[2] * h };
+  });
+}
+
+/** Flatten a fractional path into a polygon of [x,y] samples. */
+function flatten(cmds, steps) {
+  const poly = []; let cur = [0, 0];
+  cmds.forEach(c => {
+    if (c[0] === 'Z') return;
+    if (c[0] === 'C') {
+      const p3 = [c[5], c[6]];
+      for (let i = 1; i <= steps; i++) poly.push(cubic(cur, [c[1], c[2]], [c[3], c[4]], p3, i / steps));
+      cur = p3;
+    } else { cur = [c[1], c[2]]; poly.push(cur); }
+  });
+  return poly;
+}
+
+/** Extent of a polygon across position u along `axis` ('x' or 'y'). */
+function spanAt(poly, u, axis) {
+  const ax = axis === 'x' ? 0 : 1, other = 1 - ax;
+  let lo = Infinity, hi = -Infinity;
+  for (let i = 0; i < poly.length; i++) {
+    const p = poly[i], q = poly[(i + 1) % poly.length];
+    if ((p[ax] <= u && q[ax] >= u) || (q[ax] <= u && p[ax] >= u)) {
+      const t = q[ax] === p[ax] ? 0 : (u - p[ax]) / (q[ax] - p[ax]);
+      const v = p[other] + (q[other] - p[other]) * t;
+      if (v < lo) lo = v;
+      if (v > hi) hi = v;
+    }
+  }
+  return lo <= hi ? [lo, hi] : null;
+}
+
+const clamp01 = v => v < 0 ? 0 : v > 1 ? 1 : v;
+
+/** Blend two hex colours; t=0 gives `a`, t=1 gives `b`. */
+function blend(a, b, t) {
+  const ch = (h, i) => parseInt(h.substr(i * 2, 2), 16);
+  return [0, 1, 2].map(i => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * clamp01(t))
+    .toString(16).padStart(2, '0').toUpperCase()).join('');
+}
+
+function addPath(slide, o) {
+  slide.addShape('custGeom', { x: o.x, y: o.y, w: o.w, h: o.h,
+    points: toPoints(o.path, o.w, o.h), fill: { color: o.fill }, line: { type: 'none' } });
+}
+
+/**
+ * Freeform painted with a linear colour ramp (pptxgenjs cannot emit gradient
+ * fills), drawn as a fan of slices cut across the outline and shaded from the
+ * backdrop colour to the fill colour. `from`/`to` mark where the ramp leaves
+ * the backdrop and reaches full colour, measured from the faded end.
+ */
+function addFadePath(slide, o) {
+  const axis = o.axis || 'x', steps = o.steps || 110, pad = 0.6 / steps;
+  const from = o.from || 0, to = o.to === undefined ? 1 : o.to;
+  const back = o.back || WHITE;
+  const poly = flatten(o.path, 30);
+  for (let i = 0; i < steps; i++) {
+    const ua = clamp01(i / steps - pad) + 1e-5, ub = clamp01((i + 1) / steps + pad) - 1e-5;
+    const sa = spanAt(poly, ua, axis), sb = spanAt(poly, ub, axis);
+    if (!sa || !sb) continue;
+    const mid = (i + 0.5) / steps;                   // 0..1 along the axis
+    const g = o.reverse ? 1 - mid : mid;             // 0 at the faded edge
+    const quad = axis === 'x'
+      ? [[ua, sa[0]], [ub, sb[0]], [ub, sb[1]], [ua, sa[1]]]
+      : [[sa[0], ua], [sb[0], ub], [sb[1], ub], [sa[1], ua]];
+    slide.addShape('custGeom', { x: o.x, y: o.y, w: o.w, h: o.h,
+      points: quad.map((p, k) => ({ x: p[0] * o.w, y: p[1] * o.h, moveTo: k === 0 }))
+                  .concat([{ close: true }]),
+      fill: { color: blend(back, o.fill, (g - from) / (to - from)) }, line: { type: 'none' } });
+  }
+}
+
+/** Box shaded from the white page at its top edge down to solid colour. */
+function addFadeBox(slide, o) {
+  const steps = 90, to = o.to || 0.95, band = o.h / steps;
+  for (let i = 0; i < steps; i++) {
+    slide.addShape(o.shape || 'rect', Object.assign(
+      { x: o.x, y: o.y + i * band, w: o.w, h: band * 1.6,
+        fill: { color: blend(WHITE, o.fill || GREEN, ((i + 0.5) / steps) / to) }, line: { type: 'none' } },
+      o.radius ? { rectRadius: o.radius } : {}));
+  }
+  if (o.radius) {  // restore the rounded silhouette lost by the slicing
+    slide.addShape(o.shape, { x: o.x, y: o.y, w: o.w, h: o.h, rectRadius: o.radius,
+      fill: { type: 'none' }, line: { color: WHITE, width: 2.5 } });
+  }
+}
