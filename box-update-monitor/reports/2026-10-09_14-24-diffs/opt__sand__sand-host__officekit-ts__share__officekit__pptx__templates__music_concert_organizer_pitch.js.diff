+    const t0 = k / bands, t1 = (k + 1) / bands;
+    let q = clipHalf(poly, nx, ny, lo + (hi - lo) * t1 + 0.004);
+    q = clipHalf(q, -nx, -ny, -(lo + (hi - lo) * t0) + 0.004);
