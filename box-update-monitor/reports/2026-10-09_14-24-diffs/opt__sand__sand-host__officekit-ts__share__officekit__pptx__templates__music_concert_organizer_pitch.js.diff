+    if (q.length < 3) continue;
+    const xs = q.map((z) => z[0]), ys = q.map((z) => z[1]);
+    const x0 = Math.min(...xs), y0 = Math.min(...ys);
+    const w = Math.max(Math.max(...xs) - x0, 0.004), h = Math.max(Math.max(...ys) - y0, 0.004);
+    s.addShape('custGeom', {
+      x: x0, y: y0, w: w, h: h,
+      points: q.map((z) => ({ x: +(z[0] - x0).toFixed(3), y: +(z[1] - y0).toFixed(3) })).concat([{ close: true }]),
+      fill: { color: hex(stopAt(stops, t - 0.5 / bands)) }, line: { type: 'none' }
+    });
+  }
