+// Outlines are stored as fractions; `fit` maps one onto a w x h inch box.
+function fit(pts, w, h) {
+  const fx = v => Math.round(v * w * 1e4) / 1e4, fy = v => Math.round(v * h * 1e4) / 1e4;
+  return pts.map(p => {
+    if (p.close) return p;
+    const o = { x:fx(p.x), y:fy(p.y) };
+    if (p.moveTo) o.moveTo = true;
+    if (p.curve) {
+      o.curve = { type:p.curve.type, x1:fx(p.curve.x1), y1:fy(p.curve.y1) };
