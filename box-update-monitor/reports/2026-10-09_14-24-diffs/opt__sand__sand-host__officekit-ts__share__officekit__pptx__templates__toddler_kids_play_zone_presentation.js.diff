+}
+
+// Phone mockup body: the dark handset, drawn before its screen photo.
+function phone(s, x, y, w, h, rot) {
+  s.addShape('roundRect', { x:x + 0.009 * w, y:y + 0.003 * h, w:0.983 * w, h:0.986 * h,
+    rectRadius:0.42, fill:{ color:C.PHONE }, rotate:rot });
+}
+
+// ...and the speaker notch, drawn after it so it sits above the screen.
+function notch(s, x, y, w, h, rot) {
+  s.addShape('roundRect', { x:x + 0.26 * w, y:y + 0.024 * h, w:0.48 * w, h:0.042 * h,
+    rectRadius:0.06, fill:{ color:C.PHONE }, rotate:rot });
+}
+
+// Laptop mockup: silver lid behind the screen photo, plus the wider base bar.
+function laptop(s, x, y, w, h) {
+  s.addShape('roundRect', { ...at(x + 0.093 * w, y, 0.815 * w, 0.93 * h),
+    rectRadius:0.04, fill:{ color:C.PHONE } });
+  s.addShape('roundRect', { ...at(x, y + 0.935 * h, w, 0.045 * h),
+    rectRadius:0.02, fill:{ color:C.LAPTOP } });
+}
+
+// 10 x 6 grid of small dots used as a texture (box is 1.533 x 0.867 in).
+function dotGrid(s, x, y, color) {
+  for (let row = 0; row < 6; row++) {
+    for (let col = 0; col < 10; col++) {
+      s.addShape('ellipse', { ...at(x + 0.017 + col * 0.1667, y + 0.001 + row * 0.1667,
+        0.052, 0.052), fill:{ color } });
+    }
+  }
+}
+
+// The four corner dots; `spec` gives [x, y, diameter] for each colour slot.
+function dots(s, spec) {
+  spec.forEach(([x, y, d], i) => s.addShape('ellipse', { ...at(x, y, d, d),
+    fill:{ color:DOT_FILL[i] }, shadow:GLOW(DOT_SHADOW[i]) }));
+}
+
+// Blue pill button with its centred caption - used on 17 slides.
+function button(s, x, y, label) {
+  s.addShape('roundRect', { ...at(x, y, 2.39, 0.66), rectRadius:0.33,
+    fill:{ color:C.BLUE }, shadow:sh(C.BLUE, 25, 15, 0.2) });
+  tx(s, label, at(x + 0.662, y + 0.171, 1.173, 0.32), T.onDark);
+}
