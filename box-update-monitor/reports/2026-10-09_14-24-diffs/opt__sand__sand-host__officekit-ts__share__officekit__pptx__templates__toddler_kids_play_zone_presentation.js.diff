+  num:    { fontSize:72, fontFace:F.BODY, color:C.INK, bold:true, align:'left' },   // the big 27
+  plan:   { fontSize:16, fontFace:F.BODY, color:C.INK, bold:true, align:'center' }, // Basic / Pro
