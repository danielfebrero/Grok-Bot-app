+#!/usr/bin/env node
+/**
+ * "Make It Write" motivational quote deck — recreated with pptxgenjs.
+ *
+ * 17 slides on a tall 15 x 26.667 in canvas (9:16 story format):
+ *   1–12  quote posters
+ *  13–17  pictogram reference sheets
+ *
+ * The reference deck's background photographs / paper textures are replaced
+ * here by flat colour rectangles (`photoBackdrop`) matching each image's
+ * average tone; its hand-drawn vector pictograms are rebuilt from native
+ * pptxgenjs shapes and custom geometry.
+ */
+
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ================================================================== *
+ * Design tokens
+ * ================================================================== */
+
+const SLIDE_W = 15.0;
+const SLIDE_H = 80 / 3;
+
+const C = {
+  ink: '050000', // near-black: headlines, brand dot, dark backgrounds
+  cocoa: '411004', // deep brown headline / logo (slides 2, 6)
+  plum: '643E46', // muted plum on the light-paper slides
+  rust: 'B05F43', // accent bar (slides 1, 4, 5)
+  peach: 'E29A72', // accent bar (slide 12)
+  white: 'FFFFFF',
+  black: '000000',
+  smoke: 'D5D5D5', // light grey panels + body copy on dark slides
+  wash: '171616', // 95%-transparent watermark
+};
+
+// Average tone of each replaced photograph / paper texture.
+const PHOTO = {
+  paperWhite: 'F2F2F2', // "nordwood-themes" paper (slide 1)
+  paperCream: 'F3F3F3', // "sincerely-media" paper (slides 2, 3)
+  textureRose: 'BDB4B2', // "Texture 1" (slides 4, 5)
+  textureClay: 'BEB5B3', // "Texture 2" (slide 6)
+};
+
+const F = {
+  bold: 'Montserrat Bold',
+  light: 'Montserrat Light',
+  regular: 'Montserrat Regular',
+  display: 'Playfair Display Bold',
+};
+
+// The deck only ever uses two display sizes for its quotes.
+const HEAD_XL = { fontFace: F.display, fontSize: 136, charSpacing: -6.8 };
+const HEAD_LG = { fontFace: F.display, fontSize: 84, charSpacing: -2.52 };
+
+const BOX = { isTextBox: true, valign: 'middle', margin: 2.5 };
+
+/* ================================================================== *
+ * Text helpers
+ * ================================================================== */
+
+/** Full-bleed stand-in for a background photograph / paper texture. */
+function photoBackdrop(slide, color) {
+  slide.addShape('rect', { x: 0, y: 0, w: SLIDE_W, h: SLIDE_H, fill: { color } });
+}
+
+/**
+ * Multi-paragraph text box. `paras` is an array of paragraphs; each
+ * paragraph is an array of runs `{ t: 'text', ...runOptions }`.
+ */
+function richText(slide, paras, opts) {
+  const runs = [];
+  paras.forEach((para, pi) => {
+    const last = pi === paras.length - 1;
+    para.forEach((run, ri) => {
+      const { t, ...rest } = run;
+      runs.push({
+        text: t,
+        options: Object.assign({}, rest, { breakLine: !last && ri === para.length - 1 }),
+      });
+    });
+  });
+  slide.addText(runs, Object.assign({}, BOX, opts));
+}
+
+/** Single-paragraph text box. */
+function text(slide, str, opts) {
+  slide.addText(str, Object.assign({}, BOX, opts));
+}
+
+/** A quote headline (80% line spacing is used deck-wide). */
+function headline(slide, str, opts) {
+  text(slide, str, Object.assign({ lineSpacingMultiple: 0.8, color: C.ink }, opts));
+}
+
+/* ================================================================== *
+ * Branding furniture
+ * ================================================================== */
+
+/** The circular "MW™" brand dot. */
+function brandDot(slide, x, y, dotColor, markColor) {
+  slide.addShape('ellipse', { x, y, w: 0.787, h: 0.787, fill: { color: dotColor } });
+  richText(
+    slide,
+    [[{ t: 'MW' }, { t: '™', fontFace: F.light, superscript: true }]],
+    {
+      x: x + 0.139, y: y + 0.262, w: 0.51, h: 0.264,
+      fontFace: F.bold, fontSize: 11, color: markColor,
+      lineSpacingMultiple: 0.8, wrap: false,
+    }
+  );
+}
+
+/** "Make It Write™ / since 2015" lock-up. */
+function wordmarkStacked(slide, x, y, color, align) {
+  richText(
+    slide,
+    [
+      [{ t: 'Make It Write', fontFace: F.bold }, { t: '™', fontFace: F.light, superscript: true }],
+      [{ t: 'since 2015', fontFace: F.light }],
+    ],
+    { x, y, w: 2.021, h: 0.681, fontSize: 18, color, align, lineSpacingMultiple: 1.0, wrap: false }
+  );
+}
+
+/** Two-line "Make It / Write™" lock-up. */
+function makeItWrite(slide, opts) {
+  richText(
+    slide,
+    [
+      [{ t: 'Make It' }],
+      [{ t: 'Write' }, { t: '™', fontFace: F.light, superscript: true }],
+    ],
+    Object.assign({ fontFace: F.bold, lineSpacingMultiple: 0.8, wrap: false }, opts)
+  );
+}
+
+/** The same lock-up preceded by its coloured accent bar. */
+function wordmarkBar(slide, bar, mark) {
+  slide.addShape('rect', { x: bar.x, y: mark.y, w: 0.116, h: mark.h, fill: { color: bar.color } });
+  makeItWrite(slide, mark);
+}
+
+/** Four-line address block used on slides 7 and 8. */
+function footerBlock(slide, x, y, color) {
+  richText(
+    slide,
+    [
+      [{ t: 'Make it Write', fontFace: F.bold }],
+      [{ t: 'Influence More People', fontFace: F.regular, italic: true }],
+      [{ t: '© Since 2015', fontFace: F.light }],
+      [{ t: ' ' }],
+      [{ t: 'www.makeitwrite.com', fontFace: F.light }],
+    ],
+    { x, y, w: 2.874, h: 1.658, fontSize: 18, color, lineSpacingMultiple: 1.0, wrap: false }
+  );
+}
+
+/** Strap-line rotated 270° down the right edge (slides 11, 12). */
+function verticalStrapline(slide, x, y, color) {
+  richText(
+    slide,
+    [
+      [{ t: 'We brings motivation. ', fontFace: F.bold, align: 'right' }],
+      [{ t: 'Because you deserve better.', fontFace: F.light }],
+    ],
+    {
+      x, y, w: 3.555, h: 0.681, fontSize: 18, color,
+      lineSpacingMultiple: 1.0, wrap: false, rotate: 270,
+    }
+  );
+}
