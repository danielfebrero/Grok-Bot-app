+// Outline pencil: body, sharpened tip and eraser cap.
+const PENCIL_PATH = [
+  [0.017, 0.983], [0.049, 0.789], [0.789, 0.049],
+  [0.951, 0.049, 0.834, 0.005, 0.916, 0.014],
+  [0.951, 0.211, 0.986, 0.084, 0.995, 0.166],
+  [0.211, 0.951], [0.017, 0.983], 'Z',
+];
+
+function pencilIcon(slide, x, y, size, color, transparency) {
+  const line = { color, width: size * 2.2, transparency };
+  slide.addShape('custGeom', {
+    x, y, w: size, h: size, points: geom(PENCIL_PATH, size, size),
+    fill: { type: 'none' }, line,
+  });
+  // The two creases that separate tip / body / eraser.
+  slide.addShape('line', { x: x + 0.049 * size, y: y + 0.789 * size, w: 0.162 * size, h: 0.162 * size, line });
+  slide.addShape('line', { x: x + 0.677 * size, y: y + 0.161 * size, w: 0.162 * size, h: 0.162 * size, line });
+}
