+/* ================================================================== *
+ * Vector artwork
+ * ================================================================== */
+
+/**
+ * Converts a compact path description into pptxgenjs `custGeom` points.
+ * Coordinates are fractions of the shape box; entries are
+ * `[x, y]` (line/move), `[x, y, cx1, cy1, cx2, cy2]` (cubic) or `'Z'`.
+ */
+function geom(cmds, w, h) {
+  return cmds.map((c, i) => {
+    if (c === 'Z') return { close: true };
+    const pt = { x: c[0] * w, y: c[1] * h };
+    if (i === 0) pt.moveTo = true;
+    if (c.length === 6) {
+      pt.curve = { type: 'cubic', x1: c[2] * w, y1: c[3] * h, x2: c[4] * w, y2: c[5] * h };
+    }
+    return pt;
+  });
+}
