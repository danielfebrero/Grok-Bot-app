+/** Four-hump wavy line for the harbour water. */
+function waterPath(y0) {
+  const humps = 4;
+  const step = 1 / humps;
+  const cmds = [[0, y0]];
+  for (let i = 0; i < humps; i += 1) {
+    const a = i * step;
+    cmds.push([a + step, y0, a + step * 0.25, y0 - 0.055, a + step * 0.75, y0 + 0.055]);
+  }
+  return cmds;
+}
