+function operaHouseIcon(slide, x, y, w, h, color) {
+  const line = { color, width: 2.5 };
+  const stroke = (cmds) => slide.addShape('custGeom', {
+    x, y, w, h, points: geom(cmds, w, h), fill: { type: 'none' }, line,
+  });
+  SAILS.forEach(stroke);
+  stroke([[0, 0.72], [1, 0.72]]); // podium
+  stroke(waterPath(0.90));
