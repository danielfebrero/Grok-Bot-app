+const A1 = '4145B1'; // accent1 - deep indigo
+const A2 = '7A7AEE'; // accent2 - light periwinkle
+const MID = '5D5FCF'; // accent1/accent2 midpoint, used for small accents
+const WHITE = 'FFFFFF';
+const INK = '000000';
+const BODY = '7F7F7F'; // bg1 @ 50% luminance - paragraph copy
+const NEAR_BLACK = '0D0D0D';
+const PHOTO = 'CCCCCC'; // raster placeholder fill
+const PHOTO_TINT = '6E71BA'; // photo seen through the 67% accent1 veil
+const PHOTO_LABEL = '8D8D8D';
+const MAP_LAND = 'F1F2F3';
+const DEVICE = '2B2B2E'; // device mock-up body
+const DEVICE_LT = 'BCBDC0'; // brushed-metal device body
