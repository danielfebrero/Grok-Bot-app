+const SEMI_F = 'Poppins SemiBold';
+const MED_F = 'Poppins Medium';
+const SANS_F = 'Poppins';
+const TEXT_F = 'Roboto';
+
+const NO_LINE = { type: 'none' };
+const CARD_SHADOW = { type: 'outer', blur: 30, offset: 0, angle: 90, color: A1, opacity: 0.18 };
+/** White panel with a thin accent hairline + soft indigo glow. */
+const CARD = { fill: { color: WHITE }, line: { color: A1, width: 0.75 }, shadow: CARD_SHADOW };
+
+/* ========================================================================== *
+ * Geometry helpers
+ * ========================================================================== */
+
+const lerp = (a, b, t) => a + (b - a) * t;
+
+/** Blend two hex colours; t=0 -> c1, t=1 -> c2. */
+function mix(c1, c2, t) {
+  const ch = (c, i) => parseInt(c.substr(i * 2, 2), 16);
+  return [0, 1, 2]
+    .map((i) => Math.round(lerp(ch(c1, i), ch(c2, i), t)).toString(16).padStart(2, '0'))
+    .join('')
+    .toUpperCase();
+}
+
+/** Free-form polygon from absolute inch coordinates. */
+function poly(slide, pts, opts) {
+  const xs = pts.map((p) => p[0]);
+  const ys = pts.map((p) => p[1]);
+  const x = Math.min(...xs);
+  const y = Math.min(...ys);
+  slide.addShape('custGeom', Object.assign(
+    {
+      x,
+      y,
+      w: Math.max(...xs) - x,
+      h: Math.max(...ys) - y,
+      points: pts.map((p) => ({ x: p[0] - x, y: p[1] - y })).concat([{ close: true }]),
+    },
+    opts
+  ));
+}
+
+/**
+ * Absolute points for a shape given as fractions of its own bounding box -
+ * the same normalised form the original deck stores its custom geometry in.
+ */
+function frac(x, y, w, h, pts) {
+  return pts.map((p) => [x + p[0] * w, y + p[1] * h]);
+}
+
+/**
+ * Corners of a quad whose left/right edges are straight.
+ * `top`/`bot` are [left, right] x-positions as a fraction of `w`.
+ */
+function quad(x, y, w, h, top, bot) {
+  return frac(x, y, w, h, [[top[0], 0], [top[1], 0], [bot[1], 1], [bot[0], 1]]);
+}
+
+/** Sutherland-Hodgman clip of a polygon to the horizontal band y0..y1. */
+function clipBand(pts, y0, y1) {
+  const cut = (poly2, keep, edge) => {
+    const out = [];
+    poly2.forEach((cur, i) => {
+      const prev = poly2[(i + poly2.length - 1) % poly2.length];
+      const curIn = keep(cur);
+      const prevIn = keep(prev);
+      if (curIn !== prevIn) {
+        const t = (edge - prev[1]) / (cur[1] - prev[1]);
+        out.push([lerp(prev[0], cur[0], t), edge]);
+      }
+      if (curIn) out.push(cur);
+    });
+    return out;
+  };
+  const top = cut(pts, (p) => p[1] >= y0, y0);
+  return top.length ? cut(top, (p) => p[1] <= y1, y1) : [];
+}
+
+/**
+ * Paints a polygon with the accent1 -> accent2 vertical gradient. pptxgenjs has
+ * no gradient fill, so the shape is sliced into horizontal bands of flat colour.
+ * `y0`/`y1` bound the gradient ramp (defaults to the polygon's own extent).
+ */
+function gradPoly(slide, pts, o) {
+  const opts = o || {};
+  const ys = pts.map((p) => p[1]);
+  const y0 = opts.y0 !== undefined ? opts.y0 : Math.min(...ys);
+  const y1 = opts.y1 !== undefined ? opts.y1 : Math.max(...ys);
+  const c1 = opts.c1 || A1;
+  const c2 = opts.c2 || A2;
+  const steps = opts.steps || Math.max(4, Math.round((Math.max(...ys) - Math.min(...ys)) * 6));
+  const band = (Math.max(...ys) - Math.min(...ys)) / steps;
+  for (let i = 0; i < steps; i++) {
+    const a = Math.min(...ys) + i * band;
+    const b = a + band + (i < steps - 1 ? band / 8 : 0); // overlap hides seams
+    const piece = clipBand(pts, a, b);
+    if (piece.length < 3) continue;
+    const t = (a + band / 2 - y0) / (y1 - y0);
+    poly(slide, piece, { fill: { color: mix(c1, c2, Math.min(1, Math.max(0, t))) }, line: NO_LINE });
+  }
+}
+
+/** The deck's signature diagonal band, drawn as a gradient-filled quad. */
+function gradQuad(slide, o) {
+  gradPoly(slide, quad(o.x, o.y, o.w, o.h, o.top || [0, 1], o.bot || [0, 1]), o);
+}
+
+/**
+ * The "///" motif: `count` sheared bars. One bar is 0.6303 of the pitch wide
+ * and leans 0.2755 of the pitch to the right.
+ */
+function slashMark(slide, o) {
+  const n = o.count || 3;
+  const pitch = o.w / (n - 0.0942);
+  const bar = 0.6303 * pitch;
+  const skew = 0.2755 * pitch;
+  for (let i = 0; i < n; i++) {
+    const l = o.x + i * pitch;
+    poly(
+      slide,
+      [[l + skew, o.y], [l + skew + bar, o.y], [l + bar, o.y + o.h], [l, o.y + o.h]],
+      { fill: { color: o.color }, line: NO_LINE }
+    );
+  }
+}
+
+/** Grey stand-in for a photograph, captioned so the swap is obvious. */
+function photo(slide, pts, opts) {
+  const o = opts || {};
+  poly(slide, pts, { fill: { color: o.color || PHOTO }, line: NO_LINE });
