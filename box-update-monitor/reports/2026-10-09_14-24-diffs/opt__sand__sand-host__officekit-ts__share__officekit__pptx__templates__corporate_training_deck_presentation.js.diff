+  const ys = pts.map((p) => p[1]);
+  const cx = (Math.min(...xs) + Math.max(...xs)) / 2;
+  const cy = (Math.min(...ys) + Math.max(...ys)) / 2;
+  txt(slide, '[image]', {
+    x: cx - 1, y: cy - 0.18, w: 2, h: 0.36, align: 'center', valign: 'middle',
+    fontFace: TEXT_F, fontSize: 12, color: o.label || PHOTO_LABEL,
+  });
+}
