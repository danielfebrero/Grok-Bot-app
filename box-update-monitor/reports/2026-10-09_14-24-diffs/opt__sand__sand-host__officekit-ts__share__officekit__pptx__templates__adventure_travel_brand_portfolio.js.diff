+// Turn a normalised outline into custGeom points inside the shape's own box.
+function outline(w, h, pts) {
+  const out = pts.map((p, i) => ({ x: +(p[0] * w).toFixed(3), y: +(p[1] * h).toFixed(3), moveTo: i === 0 }));
+  out.push({ close: true });
+  return out;
+}
+
+// A torn / ragged shape: `pts` is one of the outline tables further down.
+function blob(slide, pts, x, y, w, h, opts) {
+  const o = opts || {};
+  slide.addShape('custGeom', {
+    x, y, w, h,
+    points: outline(w, h, pts),
+    fill: { color: o.color || GREEN, transparency: o.transparency || 0 },
+    line: { type: 'none' },
+    flipH: !!o.flipH, flipV: !!o.flipV, rotate: o.rotate || 0,
+  });
+}
+
+function rect(slide, x, y, w, h, color, opts) {
+  const o = opts || {};
+  slide.addShape(o.shape || 'rect', {
+    x, y, w, h,
+    fill: { color, transparency: o.transparency || 0 },
+    line: { type: 'none' },
+    rotate: o.rotate || 0,
+    rectRadius: o.rectRadius,
+  });
+}
+
+function line(slide, x, y, w, color, pt) {
+  slide.addShape('line', { x, y, w, h: 0, line: { color, width: pt } });
+}
+
+function vline(slide, x, y, h, color, pt) {
+  slide.addShape('line', { x, y, w: 0, h, line: { color, width: pt } });
+}
+
+// Every text run in the deck goes through here so defaults stay in one place.
+function text(slide, body, x, y, w, h, opts) {
+  const o = opts || {};
+  slide.addText(body, {
+    x, y, w, h,
+    fontFace: o.face || BODY,
+    fontSize: o.size || 18,
+    color: o.color || WHITE,
+    bold: !!o.bold,
+    italic: !!o.italic,
+    align: o.align || 'left',
+    valign: o.valign || 'top',
+    lineSpacingMultiple: o.spacing,
+    wrap: o.wrap !== false,
+    margin: o.margin,
+  });
+}
+
+// 12 pt paragraph, the deck's standard body copy (1.5 line spacing).
+function para(slide, body, x, y, w, h, opts) {
+  const o = opts || {};
+  text(slide, body, x, y, w, h, Object.assign({ size: 12, spacing: 1.5 }, o));
+}
+
+// Bold Oswald caption, used for "Description" style labels.
+function label(slide, body, x, y, w, h, opts) {
+  text(slide, body, x, y, w, h, Object.assign({ face: HEAD, bold: true, wrap: false }, opts));
