+const SLATE = '313C41'; // theme tx2
+const WHITE = 'FFFFFF'; // theme tx1 / bg2
+const GREY = 'BFBFBF'; // white shaded 25% - inactive pictograms, world map
+const GREY_LINE = '838A8D'; // slate lightened 40% - skill-bar troughs
+const PHOTO = '383838'; // average colour of the placeholder photographs
