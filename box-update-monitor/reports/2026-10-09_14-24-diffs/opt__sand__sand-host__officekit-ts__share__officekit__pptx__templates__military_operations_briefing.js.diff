+/* ------------------------------------------------------------------- text */
+
+/** An array of strings becomes one paragraph per entry. */
+function lines(text) {
+
+  return Array.isArray(text)
+    ? text.map((t, i) => ({
+ text: t, options: {
+ breakLine: i < text.length - 1 }
+ }
+))
+    : text;
+
+}
