+// ------------------------------------------------------------------- pixel art
+// Maps are drawn from ASCII rows: each run of '#' becomes one rectangle.
+function pixelArt(s, rows, x0, y0, cell, color) {
+  rows.forEach(function (row, r) {
+    let c = 0;
+    while (c < row.length) {
+      if (row[c] === '#') {
+        let end = c;
+        while (end < row.length && row[end] === '#') end++;
+        box(s, x0 + c * cell, y0 + r * cell, (end - c) * cell, cell, color);
+        c = end;
+      } else c++;
+    }
+  });
