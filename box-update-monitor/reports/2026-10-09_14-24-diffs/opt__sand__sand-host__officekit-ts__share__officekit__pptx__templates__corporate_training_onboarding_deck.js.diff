+// Smartphone mock-up, expressed as fractions of its bounding frame:
+// [dx, dy, dw, dh, fill, cornerFraction]
+const PHONE_PARTS = [
+  [0, 0, 1, 1, 'C7C7C7', 0.14],
+  [0.0165, 0.0082, 0.9671, 0.9838, '404040', 0.13],
+  [0.0368, 0.0181, 0.9269, 0.9638, '000000', 0.12],
