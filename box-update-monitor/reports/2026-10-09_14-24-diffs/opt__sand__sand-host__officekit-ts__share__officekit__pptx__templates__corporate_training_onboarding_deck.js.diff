+/** Draw the phone, rotating every part about the frame's own centre. */
+function phone(s, x, y, w, h, rotate) {
+  const rot = rotate || 0;
+  const rad = rot * Math.PI / 180;
+  const cx = x + w / 2, cy = y + h / 2;
+  function place(dx, dy, dw, dh) {
+    const ox = x + dx + dw / 2 - cx, oy = y + dy + dh / 2 - cy;
+    return {
+      x: cx + ox * Math.cos(rad) - oy * Math.sin(rad) - dw / 2,
+      y: cy + ox * Math.sin(rad) + oy * Math.cos(rad) - dh / 2,
+      w: dw, h: dh, rotate: rot
+    };
+  }
+  PHONE_PARTS.forEach(function (pt, i) {
+    const box = place(pt[0] * w, pt[1] * h, pt[2] * w, pt[3] * h);
+    s.addShape(pt[5] ? 'roundRect' : 'rect', Object.assign(box,
+      { fill: { color: pt[4] } },
+      pt[5] ? { rectRadius: box.w * pt[5] } : {},
+      i === 0 && rot ? { shadow: SHADOW_DROP } : {}));
+  });
+  const cap = place(w * 0.15, h * 0.44, w * 0.7, 0.3);
+  s.addText('[image]', txt(cap.x, cap.y, cap.w, cap.h, {
+    align: 'center', fontSize: 10, color: GREY_TXT, rotate: rot
+  }));
+}
