+function vectorArt(slide, x, y, w, h, outlines, color, rotate) {
+  outlines.forEach((tokens) => {
+    const points = [];
+    for (let i = 0; i < tokens.length; ) {
+      const op = tokens[i++];
+      if (op === 'z') {
