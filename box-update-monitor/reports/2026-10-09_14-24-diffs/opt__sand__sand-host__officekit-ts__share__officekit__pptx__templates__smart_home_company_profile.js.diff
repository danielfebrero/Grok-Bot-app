+/**
+ * Soft gradient "bokeh" circle — the deck is built almost entirely from these.
+ * Stacked translucent ellipses give a core of `c` fading out over a `feather` wide rim.
+ * `tilt` (0..1) plus `dir` (degrees) reproduce the discs whose fill is denser on one
+ * side: the inner rings drift toward `dir`, so `c` lands on that edge and the opposite
+ * edge keeps only `1 - tilt` of it.
+ */
+function blob(slide, o) {
+  const feather = o.feather == null ? 0.3 : o.feather;
+  const rim = 1 - (o.tilt || 0);
+  const rOut = o.r + feather / 2;
+  const rIn = Math.max(0.03, o.r - feather / 2);
+  let covered = 0;
+  const lay = (cx, cy, w, h, rot, target) => {
+    const alpha = (target - covered) / (1 - covered);
+    covered = target;
+    if (alpha <= 0.004 || w <= 0.02 || h <= 0.02) return;
+    slide.addShape('ellipse', {
+      x: cx - w / 2, y: cy - h / 2, w, h, rotate: rot,
+      fill: { color: o.c, transparency: Math.max(0, Math.round(100 - alpha * 100)) },
+      line: { type: 'none' },
+    });
+  };
+  const edge = Math.max(8, Math.min(26, Math.round(feather / 0.07)));
+  for (let i = 1; i <= edge; i++) {
+    const f = i / edge;                                  // 1 = innermost rim ring
+    const rad = rOut + (rIn - rOut) * f;
+    lay(o.x, o.y, 2 * rad, 2 * rad, 0, rim * f * f * (3 - 2 * f));
+  }
+  if (o.tilt) {
+    // inscribed ellipses sliding toward `dir` build a linear ramp across the disc
+    const deg = o.dir || 0, a = deg * Math.PI / 180, n = 14;
+    for (let j = 1; j <= n; j++) {
+      const f = j / n, off = rIn * 0.98 * f;
+      lay(o.x + off * Math.cos(a), o.y + off * Math.sin(a),
+        2 * (rIn - off), 2 * Math.sqrt(Math.max(0, rIn * rIn - off * off)),
+        deg, rim + (1 - rim) * f);
+    }
+  }
+}
