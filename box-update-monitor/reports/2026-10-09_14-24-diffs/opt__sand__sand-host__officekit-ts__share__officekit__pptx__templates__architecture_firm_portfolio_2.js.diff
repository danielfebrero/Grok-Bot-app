+// These two outlines are ring-shaped (outer contour + inner cut-out per stroke), so each
+// consecutive pair of contours has to become its own shape to keep the holes punched out.
+const RINGED = ['worker', 'pick'];
+
+
+/** Freeform icon drawn from the normalised outlines above. */
+function icon(slide, name, x, y, w, h, color, rotate) {
+
+	const contours = ICONS[name];
+
+	const step = RINGED.includes(name) ? 2 : contours.length;
+
+	for (let start = 0;
+ start < contours.length;
+ start += step) {
+
+		const pts = [];
+
+		contours.slice(start, start + step).forEach(sub => {
+
+			sub.forEach((p, i) => {
+
+				const pt = {
+ x: (p[0] / 1000) * w, y: (p[1] / 1000) * h }
+;
+
+				if (i === 0) pt.moveTo = true;
+
+				if (p.length === 6) {
+
+					pt.curve = {
+ type: 'cubic', x1: (p[2] / 1000) * w, y1: (p[3] / 1000) * h, x2: (p[4] / 1000) * w, y2: (p[5] / 1000) * h }
+;
+
+				}
+
+				pts.push(pt);
+
+			}
+);
+
+			pts.push({
+ close: true }
+);
+
+		}
+);
+
+		slide.addShape(pptx.ShapeType.custGeom, {
+ x, y, w, h, points: pts, fill: {
+ color }
+, line: {
+ type: 'none' }
+, rotate: rotate || 0 }
+);
