+/** Solid panel / card. */
+function panel(slide, x, y, w, h, color) {
+
+	slide.addShape(pptx.ShapeType.rect, {
+ x, y, w, h, fill: {
+ color: color || BLACK }
+, line: {
+ type: 'none' }
+ }
+);
