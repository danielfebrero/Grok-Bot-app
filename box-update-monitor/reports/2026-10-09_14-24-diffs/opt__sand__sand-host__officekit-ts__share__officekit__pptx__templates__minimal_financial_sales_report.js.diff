+  if (o.geom) { opts.points = geomPoints(o.geom, o.w, o.h); }
+  else if (o.radius) { opts.rectRadius = o.radius * Math.min(o.w, o.h); }
+  s.addShape(o.geom ? 'custGeom' : (o.shape || 'roundRect'), opts);
