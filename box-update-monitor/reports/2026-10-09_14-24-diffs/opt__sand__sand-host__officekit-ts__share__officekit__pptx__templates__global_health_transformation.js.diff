+/** full-bleed slide gradient, painted as 40 diagonal bands (no clipping needed) */
+function gradBackground(slide, bands) {
+  const n = bands || 40, S = W + H, L = 2 * S, T = S / n / Math.SQRT2 + 0.02;
+  for (let k = 0; k < n; k++) {
