+/* ------------------------------------------------------- gradient machinery */
+const hex2rgb = h => [0, 2, 4].map(i => parseInt(h.substr(i, 2), 16));
+const rgb2hex = c => c.map(v => Math.round(v).toString(16).padStart(2, '0')).join('').toUpperCase();
+
+/** colour of the brand gradient at position t (0 = top-left .. 1 = bottom-right) */
+function gradColor(t) {
+  const a = hex2rgb(GRAD_A), b = hex2rgb(GRAD_B), k = Math.max(0, Math.min(1, t));
+  return rgb2hex([0, 1, 2].map(i => a[i] + (b[i] - a[i]) * k));
