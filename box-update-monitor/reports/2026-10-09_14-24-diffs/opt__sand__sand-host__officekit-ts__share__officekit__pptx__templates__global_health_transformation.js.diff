+/**
+ * Paint the window (x,y,w,h) with flat tiles taken from the gradient of `box`
+ * (defaults to the window itself).
+ */
+function gradTiles(slide, x, y, w, h, cell, box) {
+  const b = box || { x, y, w, h };
+  const nx = Math.max(1, Math.round(w / cell)), ny = Math.max(1, Math.round(h / cell));
+  const ov = 0.02;  // tiles bleed into each other so no hairline seams show
+  for (let i = 0; i < nx; i++) {
+    for (let j = 0; j < ny; j++) {
+      const x0 = Math.max(x, x + w * i / nx - ov), x1 = Math.min(x + w, x + w * (i + 1) / nx + ov);
+      const y0 = Math.max(y, y + h * j / ny - ov), y1 = Math.min(y + h, y + h * (j + 1) / ny + ov);
+      const cx = x + w * (i + 0.5) / nx, cy = y + h * (j + 0.5) / ny;
+      slide.addShape('rect', {
+        x: x0, y: y0, w: x1 - x0, h: y1 - y0,
+        fill: { color: gradColor(((cx - b.x) + (cy - b.y)) / (b.w + b.h)) }, line: { type: 'none' },
+      });
+    }
+  }
