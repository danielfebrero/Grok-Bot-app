+    slide.addShape('rect', {
+      x: W / 2 + d - L / 2, y: H / 2 + d - T / 2, w: L, h: T, rotate: -45,
+      fill: { color: gradColor((k + 0.5) / n) }, line: { type: 'none' },
+    });
+  }
