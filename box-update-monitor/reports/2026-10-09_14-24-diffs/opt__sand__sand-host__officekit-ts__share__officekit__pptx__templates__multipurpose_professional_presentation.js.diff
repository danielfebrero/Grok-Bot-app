+/** Diagonal two-stop gradient, painted as a fan of rotated bands
+ *  (pptxgenjs cannot emit a gradient slide background). */
+function wash(s, from, to, deg = 60, bands = 44) {
+
+  const a = deg * Math.PI / 180, ux = Math.cos(a), uy = Math.sin(a);
+
+  const cx = SLIDE_W / 2, cy = SLIDE_H / 2;
+
+  const proj = [[0, 0], [SLIDE_W, 0], [0, SLIDE_H], [SLIDE_W, SLIDE_H]]
+                 .map(([x, y]) => (x - cx) * ux + (y - cy) * uy);
+
+  const t0 = Math.min(...proj), step = (Math.max(...proj) - t0) / bands;
+
+  const len = Math.hypot(SLIDE_W, SLIDE_H);
+
+  const rgb = h => [0, 2, 4].map(i => parseInt(h.substr(i, 2), 16));
+
+  const A = rgb(from), B = rgb(to);
+
+  for (let i = 0;
+ i < bands;
+ i++) {
+
+    const f = (i + 0.5) / bands, t = t0 + (i + 0.5) * step;
+
+    const c = A.map((v, k) => Math.round(v + (B[k] - v) * f))
+               .map(v => v.toString(16).padStart(2, '0')).join('').toUpperCase();
+
+    s.addShape('rect', {
+ x: cx + t * ux - step / 2, y: cy + t * uy - len / 2,
+                         w: step * 1.03, h: len, fill: {
+ color: c }
+, rotate: deg }
+);
+
+  }
+
+}
