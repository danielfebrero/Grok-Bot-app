+/* --- custom-geometry icons ----------------------------------------- *
+ * Every glyph is stored as a mini SVG-ish path string on a square grid:
+ *   M dx dy      move    (relative)
+ *   L dx dy      line    (relative)
+ *   C dx dy ...  cubic   (three relative control/end points)
+ *   Z            close
+ * `ICONS[name] = [gridSize, pathData]`.                               */
+function decode(spec, x, y, w, h) {
+
+  const [g, d] = spec, sx = w / g, sy = h / g;
+
+  const tok = d.match(/[MLCZ]|-?\d+/g);
+
+  const pts = [];
+
+  let cx = 0, cy = 0, i = 0;
+
+  const at = () => {
+ cx += +tok[i++];
+ cy += +tok[i++];
+ return {
+ x: x + cx * sx, y: y + cy * sy }
+;
+ }
+;
+
+  while (i < tok.length) {
+
+    const c = tok[i++];
+
+    if (c === 'Z') {
+ pts.push({
+ close: true }
+);
+ }
+
+    else if (c === 'M') {
+ pts.push(Object.assign(at(), {
+ moveTo: true }
+));
+ }
+
+    else if (c === 'L') {
+ pts.push(at());
+ }
+
+    else {
+ const a = at(), b = at(), e = at();
+
+           pts.push({
+ x: e.x, y: e.y, curve: {
+ type: 'cubic', x1: a.x, y1: a.y, x2: b.x, y2: b.y }
+ }
+);
+ }
+
+  }
+
+  return pts;
+
+}
