+            const px = cx + r * Math.cos(s * rad), py = cy + r * Math.sin(s * rad);
+            const qx = cx + r * Math.cos(e * rad), qy = cy + r * Math.sin(e * rad);
+            out.push([qx, qy,
+                px - k * r * Math.sin(s * rad), py + k * r * Math.cos(s * rad),
+                qx + k * r * Math.sin(e * rad), qy - k * r * Math.cos(e * rad)]);
