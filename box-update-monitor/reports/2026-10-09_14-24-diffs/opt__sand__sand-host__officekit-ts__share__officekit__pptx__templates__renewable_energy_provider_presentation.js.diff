+function gradientBand(slide, x, y, w, h, from, to, rad, steps) {
+    const n = steps || 40;
+    roundRect(slide, x, y, w, h, from, rad); // keeps the rounded left corners
+    const step = (w - rad) / n;
+    for (let i = 0; i < n; i++) {
+        rect(slide, x + rad + i * step, y, step + 0.01, h, mix(from, to, (i + 0.5) / n));
+    }
