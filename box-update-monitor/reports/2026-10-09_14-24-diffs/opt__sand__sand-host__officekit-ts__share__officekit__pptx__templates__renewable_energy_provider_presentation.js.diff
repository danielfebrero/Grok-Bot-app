+    let out = '';
+    for (let i = 0; i < 6; i += 2) {
+        const a = parseInt(c1.substr(i, 2), 16), b = parseInt(c2.substr(i, 2), 16);
+        out += ('0' + Math.round(a + (b - a) * t).toString(16)).slice(-2);
+    }
+    return out.toUpperCase();
+}
