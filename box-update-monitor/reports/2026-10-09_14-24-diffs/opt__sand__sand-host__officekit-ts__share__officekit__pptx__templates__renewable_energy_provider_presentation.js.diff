+/**
+ * Free-form shape.  `pts` is a compact list where
+ *   [x, y]                       -> move/line to
+ *   [x, y, cx1, cy1, cx2, cy2]   -> cubic bezier to (x,y)
+ * All values are inches relative to (x, y); the path is auto-closed.
+ */
+function poly(slide, x, y, w, h, color, pts) {
+    const points = pts.map(function (p, i) {
+        const pt = { x: p[0], y: p[1] };
+        if (i > 0 && p.length === 6) pt.curve = { type: 'cubic', x1: p[2], y1: p[3], x2: p[4], y2: p[5] };
