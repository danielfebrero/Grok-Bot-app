+/* ------------------------------------------------------------------ theme */
+const BG = 'FAEDC8'; // cream page background
+const DARK = '1D1F16'; // dark olive cards
+const GOLD = 'C88F42'; // accent / headings
+const CREAM = 'FAEDC8'; // body copy on dark cards
