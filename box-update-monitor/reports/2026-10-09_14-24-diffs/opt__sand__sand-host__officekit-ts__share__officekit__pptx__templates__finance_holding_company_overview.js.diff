+/** Interpolate between two hex colours; t runs 0 -> 1. */
+function mix(from, to, t) {
+  const channel = (i) => {
+    const a = parseInt(from.substr(i * 2, 2), 16);
+    const b = parseInt(to.substr(i * 2, 2), 16);
+    return Math.round(a + (b - a) * t).toString(16).padStart(2, '0');
+  };
+  return (channel(0) + channel(1) + channel(2)).toUpperCase();
+}
