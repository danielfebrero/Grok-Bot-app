+/* Every card in the deck carries the same 290-degree gradient: light at the
+ * bottom-left corner, dark towards the top-right. */
+const GRAD_DX = Math.cos((-70 * Math.PI) / 180);
+const GRAD_DY = Math.sin((-70 * Math.PI) / 180);
+
+/**
+ * Tile the interior of a panel with cells shaded along the 290-degree ramp.
+ * `topR` / `botR` are the corner radii; rows near a rounded corner are pulled
+ * in horizontally so no cell pokes outside the silhouette drawn beneath.
+ */
+function diagonalCells(slide, o) {
+  const lo = o.h * GRAD_DY; // ramp value at the bottom-left corner
+  const hi = o.w * GRAD_DX; // ramp value at the top-right corner
+  // Size the cells so no neighbour differs by more than ~5 levels per
+  // channel, then cap row height so the rounded corners stay smooth.
+  const spread = Math.max(
+    ...[0, 1, 2].map((i) =>
+      Math.abs(parseInt(o.light.substr(i * 2, 2), 16) - parseInt(o.dark.substr(i * 2, 2), 16)))
+  );
+  const perLevel = (5 * (hi - lo)) / Math.max(spread, 1);
+  const maxR = Math.max(o.topR, o.botR);
+  const COLS = Math.min(Math.max(Math.ceil(o.w / (perLevel / GRAD_DX)), 2), 24);
+  const ROWS = Math.min(
+    Math.max(Math.ceil(o.h / Math.min(perLevel / -GRAD_DY, maxR ? maxR / 4 : Infinity)), 4), 48);
+  const rowH = o.h / ROWS;
+  const bite = (radius, depth) =>
+    radius - Math.sqrt(Math.max(radius * radius - Math.max(radius - depth, 0) ** 2, 0));
+  const inset = (y) => Math.max(bite(o.topR, y), bite(o.botR, o.h - y));
+  for (let r = 0; r < ROWS; r++) {
+    const y0 = rowH * r;
+    const pad = Math.max(inset(y0), inset(y0 + rowH));
+    const cellW = (o.w - pad * 2) / COLS;
+    for (let c = 0; c < COLS; c++) {
+      const cx = pad + cellW * c;
+      const ramp = (cx + cellW / 2) * GRAD_DX + (y0 + rowH / 2) * GRAD_DY;
+      slide.addShape('rect', {
+        x: o.x + cx, y: o.y + y0, w: cellW + 0.008, h: rowH + 0.008,
+        fill: { color: mix(o.light, o.dark, (ramp - lo) / (hi - lo)) }, line: { type: 'none' },
+      });
+    }
+  }
