+function verticalWash(slide, o) {
+  const topR = o.topR || 0;
+  const botR = o.botR || 0;
+  const rows = Math.max(Math.ceil(o.h / 0.12), 12);
+  const rowH = o.h / rows;
+  const inset = (y) => Math.max(cornerInset(topR, y), cornerInset(botR, o.h - y));
+  for (let i = 0; i < rows; i++) {
+    const y0 = rowH * i;
+    const pad = Math.max(inset(y0), inset(y0 + rowH));
+    slide.addShape('rect', {
+      x: o.x + pad, y: o.y + y0, w: o.w - pad * 2, h: rowH + 0.01,
+      fill: { color: mix(o.top, o.bottom, i / (rows - 1)) }, line: { type: 'none' },
+    });
+  }
