+/**
+ * A disc carrying a linear fade from `from` to `to`, sliced perpendicular to
+ * the fade. Each slice's outer edges are quadratic curves through the true
+ * circle, so the silhouette stays round. `axis` is 'v' for a top-to-bottom
+ * fade or 'h' for left-to-right. The source deck fades each disc out into
+ * the slide background, so the far colour is normally that background.
+ */
+function gradientDisc(slide, x, y, d, from, to, axis) {
+  const BANDS = 18;
+  const r = d / 2;
+  const chord = (t) => Math.sqrt(Math.max(r * r - (t - r) * (t - r), 0));
+  const step = d / BANDS;
+  for (let i = 0; i < BANDS; i++) {
+    const t0 = step * i;
+    const t1 = Math.min(t0 + step * 1.3, d); // slices overlap to hide seams
+    const span = t1 - t0;
+    const c0 = chord(t0);
+    const c1 = chord(t1);
+    const half = Math.max(c0, c1, chord((t0 + t1) / 2));
+    // Control offset that makes the quadratic pass through the mid chord.
+    const ctrl = 2 * chord((t0 + t1) / 2) - (c0 + c1) / 2;
+    const across = (a, b) => (axis === 'h' ? { x: b, y: a } : { x: a, y: b });
+    const curveTo = (a, b, ca, cb) => ({
+      ...across(a, b),
+      curve: axis === 'h'
+        ? { type: 'quadratic', x1: cb, y1: ca }
+        : { type: 'quadratic', x1: ca, y1: cb },
+    });
+    freeform(slide, {
+      x: x + (axis === 'h' ? t0 : r - half),
+      y: y + (axis === 'h' ? r - half : t0),
+      w: axis === 'h' ? span : half * 2,
+      h: axis === 'h' ? half * 2 : span,
+      fill: mix(from, to, i / (BANDS - 1)),
+      points: [
+        { ...across(half - c0, 0), moveTo: true },
+        across(half + c0, 0),
+        curveTo(half + c1, span, half + ctrl, span / 2),
+        across(half - c1, span),
+        curveTo(half - c0, 0, half - ctrl, span / 2),
+        { close: true },
+      ],
+    });
+  }
