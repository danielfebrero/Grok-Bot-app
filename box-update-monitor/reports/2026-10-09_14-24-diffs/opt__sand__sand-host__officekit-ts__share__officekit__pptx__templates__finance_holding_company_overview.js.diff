+  slide.addShape('roundRect', {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fill: o.fill ? { color: o.fill } : undefined,
+    line: o.line ? { color: o.line, width: o.lineWidth || 1 } : { type: 'none' },
+    rectRadius: (o.adj / 100000) * Math.min(o.w, o.h),
+  });
+}
