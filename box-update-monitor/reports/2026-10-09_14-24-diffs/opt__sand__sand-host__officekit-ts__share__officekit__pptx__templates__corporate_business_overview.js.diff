+/* ------------------------------------------------------------- primitives */
+// Every text frame in the deck has zero insets and is top anchored.
+const TEXT_BASE = { margin: 0, valign: 'top', isTextBox: true };
+
+function text(slide, content, box, opts) {
+  slide.addText(content, Object.assign({ x: box[0], y: box[1], w: box[2], h: box[3] }, TEXT_BASE, opts));
+}
+
+// Body copy: 10pt Lato Light italic, grey, 150% leading.
+function body(slide, str, box, opts) {
+  text(slide, str, box, Object.assign({ fontFace: LIGHT, fontSize: 10, italic: true, color: GRAY, lineSpacingMultiple: 1.5 }, opts));
+}
+
+// Sub-heading: 14pt Lato bold.
+function heading(slide, str, box, opts) {
+  text(slide, str, box, Object.assign({ fontFace: MINOR, fontSize: 14, bold: true, color: BLACK, lineSpacingMultiple: 1.5 }, opts));
+}
+
+// Big Montserrat headline (default 44pt, 90% leading).
+function headline(slide, str, box, opts) {
+  text(slide, str, box, Object.assign({ fontFace: MAJOR, fontSize: 44, bold: true, color: BLACK, lineSpacingMultiple: 0.9 }, opts));
+}
+
+// Rounded rectangle. `adj` is the OOXML corner ratio (default 16667).
+function roundRect(slide, box, fill, opts) {
+  const o = opts || {};
+  const adj = o.adj === undefined ? 0.16667 : o.adj;
+  slide.addShape('roundRect', Object.assign({
+    x: box[0], y: box[1], w: box[2], h: box[3],
+    rectRadius: adj * Math.min(box[2], box[3]),
+    fill: fill ? { color: fill } : { type: 'none' },
+    line: o.line || { type: 'none' }
+  }, o.rotate ? { rotate: o.rotate } : {}, o.flipH ? { flipH: true } : {}));
+}
+
+function rect(slide, box, fill) {
+  slide.addShape('rect', { x: box[0], y: box[1], w: box[2], h: box[3], fill: { color: fill }, line: { type: 'none' } });
+}
+
+function hLine(slide, x, y, w, color, width) {
+  slide.addShape('line', { x: x, y: y, w: w, h: 0, line: { color: color, width: width } });
+}
+
+function vLine(slide, x, y, h, color, width) {
+  slide.addShape('line', { x: x, y: y, w: 0, h: h, line: { color: color, width: width } });
+}
+
+// Stand-in for a photo / logo bitmap in the source deck.
+function imagePlaceholder(slide, box) {
+  slide.addShape('rect', { x: box[0], y: box[1], w: box[2], h: box[3], fill: { color: 'FBFBFB' }, line: { color: 'E4E4E4', width: 0.75 } });
+  text(slide, '[image]', box, { fontFace: MINOR, fontSize: 9, color: 'B8B8B8', align: 'center', valign: 'middle' });
+}
+
+// The two mockup slides show a device photo. Both are rebuilt from native
+// shapes: a dark rounded body with a white "screen" holding the placeholder.
+function deviceMockup(slide, body, screen, extras) {
+  (extras || []).forEach(function (e) {
+    roundRect(slide, e.box, e.fill, { adj: e.adj === undefined ? 0.5 : e.adj });
+  });
+  roundRect(slide, body, '111214', { adj: 0.03 });
+  roundRect(slide, screen, WHITE, { adj: 0.005 });
+  imagePlaceholder(slide, [
+    screen[0] + screen[2] / 2 - 0.45, screen[1] + screen[3] / 2 - 0.32, 0.9, 0.64
+  ]);
+}
