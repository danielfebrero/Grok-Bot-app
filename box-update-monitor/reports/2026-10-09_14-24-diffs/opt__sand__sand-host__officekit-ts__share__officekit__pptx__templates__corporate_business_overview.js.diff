+
+function chevrons(slide) {
+  const colors = ['CCCCFF', '9999FF', '6667FE', BLUE];
+  colors.forEach(function (color, i) {
+    const x = 0.3581 + i * 0.2031, y = 7.0097, w = 0.1312, h = 0.1873;
+    slide.addShape('custGeom', {
+      x: x, y: y, w: w, h: h,
+      fill: { color: color }, line: { type: 'none' },
+      points: CHEVRON_PATH.map(function (p) { return { x: p[0] * w, y: p[1] * h }; }).concat([{ close: true }])
+    });
+  });
+}
