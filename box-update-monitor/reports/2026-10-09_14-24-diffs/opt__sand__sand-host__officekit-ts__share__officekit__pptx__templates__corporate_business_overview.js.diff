+function chrome(slide, o) {
+  const opt = o || {};
+  logo(slide);
+  if (opt.businessPill !== false) pill(slide, 9.5885, 1.2431, 'Business');
+  pill(slide, 10.9306, 2.0447, 'Template Presentation');
+  if (opt.railL !== false) vLine(slide, 0.3581, 1.7891, 4.0717, BLUE, 2);
+  if (opt.railR !== false) vLine(slide, 12.9752, 1.7891, 4.0717, BLUE, 2);
