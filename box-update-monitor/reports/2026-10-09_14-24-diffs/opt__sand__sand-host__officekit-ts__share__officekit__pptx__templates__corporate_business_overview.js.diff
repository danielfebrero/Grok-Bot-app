+/* ------------------------------------------------------- shared furniture */
+// The ">" glyph used in the footer, drawn as an outline chevron.
+const CHEVRON_PATH = [
+  [0, 0.025], [0.881, 0.5], [0, 0.975], [0, 1], [0.05, 1],
