+/** Rotate normalised points a quarter turn at a time inside the unit square. */
+function orient(pts, dir) {
+  const turn = { up: p => p, down: ([x, y]) => [1 - x, 1 - y],
+                 right: ([x, y]) => [1 - y, x], left: ([x, y]) => [y, 1 - x] };
