+    });
+    slide.addShape('line', { x: cx - 0.093, y: cy - 0.04, w: 0.093, h: 0.13, line: { color: C.black, width: 1.25 } });
+    slide.addShape('line', { x: cx, y: cy + 0.09, w: 0.093, h: -0.13, line: { color: C.black, width: 1.25 } });
+  }
+}
