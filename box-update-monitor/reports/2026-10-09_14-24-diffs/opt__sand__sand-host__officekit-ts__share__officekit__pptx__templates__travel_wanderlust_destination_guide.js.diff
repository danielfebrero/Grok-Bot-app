+      fill: { color: C.white }, line: { type: 'none' }, rotate: 315,
+    });
+    [[-0.075, -0.055], [0.03, 0.05]].forEach(function (d) {   // ear- and mouth-piece
+      slide.addShape('roundRect', {
+        x: cx + d[0], y: cy + d[1], w: 0.085, h: 0.035, rectRadius: 0.017,
+        fill: { color: C.white }, line: { type: 'none' }, rotate: 315,
+      });
+    });
+  } else if (kind === 'globe') {
+    slide.addShape('ellipse', {
+      x: cx - 0.09, y: cy - 0.09, w: 0.18, h: 0.18, fill: { type: 'none' }, line: { color: C.white, width: 1.25 },
+    });
+    slide.addShape('ellipse', {
+      x: cx - 0.038, y: cy - 0.09, w: 0.076, h: 0.18, fill: { type: 'none' }, line: { color: C.white, width: 1 },
+    });
+    slide.addShape('line', { x: cx - 0.09, y: cy, w: 0.18, h: 0, line: { color: C.white, width: 1 } });
+    slide.addShape('line', { x: cx - 0.075, y: cy - 0.052, w: 0.15, h: 0, line: { color: C.white, width: 0.75 } });
+    slide.addShape('line', { x: cx - 0.075, y: cy + 0.052, w: 0.15, h: 0, line: { color: C.white, width: 0.75 } });
+  } else {   // open envelope with an "@" on the flap
+    slide.addShape('rect', {
+      x: cx - 0.093, y: cy - 0.04, w: 0.186, h: 0.13, fill: { color: C.yellow }, line: { color: C.black, width: 1.25 },
+    });
+    slide.addShape('roundRect', {
+      x: cx - 0.062, y: cy - 0.105, w: 0.124, h: 0.115, rectRadius: 0.02,
+      fill: { color: C.yellow }, line: { color: C.black, width: 1.25 },
