+/** Small glyph centred on a contact chip. */
+function contactIcon(slide, kind, cx, cy) {
+  if (kind === 'marker') {
+    freeform(slide, PATHS.pinSolid, { x: cx - 0.115, y: cy - 0.115, w: 0.23, h: 0.23, color: C.white });
+  } else if (kind === 'phone') {
+    slide.addShape('roundRect', {   // handset body
