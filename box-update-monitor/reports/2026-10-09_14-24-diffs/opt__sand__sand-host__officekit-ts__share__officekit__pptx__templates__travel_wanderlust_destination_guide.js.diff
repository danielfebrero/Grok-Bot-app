+/* ------------------------------------------------------------------ helpers */
+
+/** Convert one of the PATHS strings into pptxgenjs `points`, scaled to w x h. */
+function pathPoints(d, w, h) {
+  const t = d.match(/[MLCZ]|-?[\d.]+/g);
+  const pts = [];
+  let i = 0;
+  while (i < t.length) {
+    const op = t[i++];
+    const num = () => parseFloat(t[i++]);
+    if (op === 'M') pts.push({ x: num() * w, y: num() * h, moveTo: true });
+    else if (op === 'L') pts.push({ x: num() * w, y: num() * h });
+    else if (op === 'C') {
+      const x1 = num() * w, y1 = num() * h, x2 = num() * w, y2 = num() * h;
+      pts.push({ x: num() * w, y: num() * h, curve: { type: 'cubic', x1, y1, x2, y2 } });
+    } else if (op === 'Z') pts.push({ close: true });
+  }
+  return pts;
+}
+
+/** Freeform shape from a PATHS entry. */
+function freeform(slide, d, o) {
+  slide.addShape('custGeom', Object.assign({
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    points: pathPoints(d, o.w, o.h),
+    fill: { color: o.color, transparency: o.transparency || 0 },
+    line: { type: 'none' },
+    rotate: o.rotate || 0,
+  }, o.extra));
+}
+
+/* Text-box insets used throughout the deck: [left, right, bottom, top] in points. */
+const MARGIN = [7.2, 7.2, 3.6, 3.6];
+
+/** Text box matching the deck defaults: 0.1" side inset, top-anchored. */
+function text(slide, str, o) {
+  slide.addText(str, Object.assign({
+    fontFace: FONT.body, fontSize: 10, color: C.black,
+    align: 'left', valign: 'top', margin: MARGIN,
+  }, o));
+}
+
+/** Heading text (Red Hat Display). */
+function heading(slide, str, o) {
+  text(slide, str, Object.assign({ fontFace: FONT.head, bold: true, fontSize: 40 }, o));
+}
+
+/** Body paragraph: 10pt Open Sans at 1.5 line spacing. */
+function body(slide, str, o) {
+  text(slide, str, Object.assign({ fontSize: 10, lineSpacing: 18 }, o));
+}
+
+/** Rounded rectangle card. `r` is the corner radius in inches. */
+function card(slide, o) {
+  slide.addShape('roundRect', Object.assign({
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    rectRadius: o.r === undefined ? Math.min(o.w, o.h) * 0.1667 : o.r,
+    fill: o.fill ? { color: o.fill, transparency: o.transparency || 0 } : { type: 'none' },
+    line: o.line || { type: 'none' },
+    shadow: o.shadow,
+  }, o.extra));
+}
+
+/**
+ * Stand-in for a photograph: flat grey block in the original frame shape,
+ * captioned "[image]".  `shape` picks a PATHS frame, 'circle' or 'rect'.
+ */
+function imagePlaceholder(slide, o) {
+  const shape = o.shape || 'circle';
+  if (shape === 'circle') {
+    slide.addShape('ellipse', { x: o.x, y: o.y, w: o.w, h: o.h, fill: { color: C.photo }, line: { type: 'none' } });
+  } else if (shape === 'rect') {
+    slide.addShape('roundRect', {
+      x: o.x, y: o.y, w: o.w, h: o.h, rectRadius: o.r || 0,
+      fill: { color: C.photo }, line: { type: 'none' },
+    });
+  } else {
+    freeform(slide, PATHS[shape], { x: o.x, y: o.y, w: o.w, h: o.h, color: C.photo, rotate: o.rotate });
+  }
+  if (o.label !== false) {
+    text(slide, '[image]', {
+      x: o.x, y: o.y + o.h / 2 - 0.2, w: o.w, h: 0.4,
+      align: 'center', valign: 'middle', fontSize: o.cap || 11, color: C.photoTx,
+    });
+  }
