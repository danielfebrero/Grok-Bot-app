+// ------------------------------------------------------------- gradients
+// PowerPoint linear gradients have no pptxgenjs API, so the BLUE -> CYAN ramp
+// is painted as a run of solid bands and then clipped back to the intended
+// silhouette with a white cover that has the silhouette punched out of it.
+//
+//   dir  'v'  = top -> bottom
+//        'd'  = 45 deg, top-left -> bottom-right
+//        'dh' / 'dv' / 'dhv' = the 45 deg ramp mirrored horizontally, vertically
+//        or both, matching the flipH / flipV / rot180 freeforms in the deck
+//   clip 'rect' | 'ellipse' | <corner radius in inches> | <custGeom points>
+
+function mix(t) {
+  const a = [0x14, 0x60, 0xf8], b = [0x12, 0xcd, 0xf2];
+  return a.map((v, i) => Math.round(v + (b[i] - v) * t))
+    .map(v => v.toString(16).padStart(2, '0')).join('').toUpperCase();
+}
+
+// Clip a convex polygon against the half-plane  ax + by <= c  (Sutherland-Hodgman).
+function clipHalf(poly, a, b, c) {
+  const out = [];
+  for (let i = 0; i < poly.length; i++) {
+    const p = poly[i], q = poly[(i + 1) % poly.length];
+    const dp = a * p[0] + b * p[1] - c, dq = a * q[0] + b * q[1] - c;
+    if (dp <= 0) out.push(p);
+    if ((dp < 0 && dq > 0) || (dp > 0 && dq < 0)) {
+      const t = dp / (dp - dq);
+      out.push([p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t]);
+    }
+  }
+  return out;
+}
+
+function gradBands(s, x, y, w, h, dir) {
+  const n = Math.max(10, Math.min(44, Math.round((w + h) * 7)));
+  const fx = dir.indexOf('h') > 0, fy = dir.indexOf('v') > 0;
+  // Bands are stacked (each one reaches the far edge and is overpainted by the
+  // next), which keeps the ramp free of hairline seams.
+  for (let i = 0; i < n; i++) {
+    const color = mix((i + 0.5) / n);
+    if (dir === 'v') {
+      const y0 = (h * i) / n;
+      rect(s, [x, y + y0, w, h - y0], color);
+    } else {
+      // 45 deg: the ramp runs along u + v, so each band is the part of the box
+      // beyond the diagonal  u + v = s0.
+      const s0 = ((w + h) * i) / n;
+      const poly = clipHalf([[0, 0], [w, 0], [w, h], [0, h]], -1, -1, -s0);
+      if (poly.length < 3) continue;
+      s.addShape('custGeom', {
+        x, y, w, h, fill: { color }, line: { type: 'none' },
+        points: poly
+          .map((p, k) => ({ x: r4(fx ? w - p[0] : p[0]), y: r4(fy ? h - p[1] : p[1]),
+            moveTo: k === 0 }))
+          .concat([{ close: true }]),
+      });
+    }
+  }
+}
+
+const r4 = v => Math.round(v * 10000) / 10000;
+
+// Cover = a slightly oversized white frame with `clip` punched out of it, so
+// only the wanted silhouette of the band stack survives.
+const PAD = 0.06;
+
+function gradCover(s, x, y, w, h, clip) {
+  if (clip === 'rect') return;
+  const W = w + 2 * PAD, H = h + 2 * PAD;
+  const frame = [{ x: 0, y: 0, moveTo: true }, { x: W, y: 0 }, { x: W, y: H }, { x: 0, y: H },
+    { close: true }];
+  const off = p => {
+    if (p.close) return p;
+    const q = { x: r4(p.x + PAD), y: r4(p.y + PAD) };
+    if (p.moveTo) q.moveTo = true;
+    if (p.curve) q.curve = p.curve;
+    return q;
+  };
+  let hole;
+  if (clip === 'ellipse') {
+    hole = [{ x: w / 2, y: 0, moveTo: true },
+      { curve: { type: 'arc', wR: w / 2, hR: h / 2, stAng: 270, swAng: 360 }, x: w / 2, y: 0 },
+      { close: true }];
+  } else if (typeof clip === 'number') {
+    const r = clip;
+    hole = [{ x: r, y: 0, moveTo: true },
+      { curve: { type: 'arc', wR: r, hR: r, stAng: 270, swAng: -90 }, x: 0, y: r },
+      { x: 0, y: h - r },
+      { curve: { type: 'arc', wR: r, hR: r, stAng: 180, swAng: -90 }, x: r, y: h },
+      { x: w - r, y: h },
+      { curve: { type: 'arc', wR: r, hR: r, stAng: 90, swAng: -90 }, x: w, y: h - r },
+      { x: w, y: r },
+      { curve: { type: 'arc', wR: r, hR: r, stAng: 0, swAng: -90 }, x: w - r, y: 0 },
+      { close: true }];
+  } else {
+    hole = clip;
+  }
+  s.addShape('custGeom', {
+    x: x - PAD, y: y - PAD, w: W, h: H,
+    fill: { color: WHITE }, line: { type: 'none' },
+    points: frame.concat(hole.map(off)),
+  });
+}
+
+function grad(s, [x, y, w, h], dir, clip, shadow) {
+  if (shadow) rrect(s, [x, y, w, h], mix(0.5), clip, true);
+  gradBands(s, x, y, w, h, dir);
+  gradCover(s, x, y, w, h, clip);
