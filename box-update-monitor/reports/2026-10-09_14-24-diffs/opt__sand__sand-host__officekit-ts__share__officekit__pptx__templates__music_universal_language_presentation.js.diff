+ * sliced into bands perpendicular to that diagonal and each band is painted
+ * as one flat polygon. Position along the axis is (x + y) / (w + h) measured
+ * in inches, so the banding stays at 45 degrees whatever the box's shape.
+ */
+function gradient(s, x, y, w, h, stops, bands) {
+  const N = bands || 36;
+  const from = stops[0], to = stops[1];
+  const a = [0, 2, 4].map(i => parseInt(from.substr(i, 2), 16));
+  const b = [0, 2, 4].map(i => parseInt(to.substr(i, 2), 16));
+  const box = [[0, 0], [1, 0], [1, 1], [0, 1]];
+  const axis = p => (p[0] * w + p[1] * h) / (w + h);
+  const bleed = 0.6 / N;   // overlap neighbours slightly so no seam shows
+  const blend = t => a.map((c, k) => Math.round(c + (b[k] - c) * t))
+                      .map(v => v.toString(16).padStart(2, '0').toUpperCase()).join('');
+  panel(s, x, y, w, h, blend(0.5));   // base coat: hides antialiasing between bands
+  for (let i = 0; i < N; i++) {
+    const lo = i / N, hi = (i + 1) / N;
+    let poly = clipHalfPlane(box, p => (lo - bleed) - axis(p));
+    poly = clipHalfPlane(poly, p => axis(p) - (hi + bleed));
+    if (poly.length < 3) continue;
+    polygon(s, poly.map(p => [x + p[0] * w, y + p[1] * h]), blend((lo + hi) / 2));
+  }
