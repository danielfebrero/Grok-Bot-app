+/** Free polygon in inches, given as [[x, y], ...] absolute points. */
+function polygon(s, pts, color) {
+  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]);
+  const x = Math.min(...xs), y = Math.min(...ys);
+  const w = Math.max(...xs) - x, h = Math.max(...ys) - y;
+  if (w < 1e-4 || h < 1e-4) return;
+  s.addShape('custGeom', {
+    x, y, w, h,
+    points: pts.map((p, i) => ({ x: p[0] - x, y: p[1] - y, moveTo: i === 0 }))
+                .concat([{ close: true }]),
+    fill: { color }, line: { type: 'none' },
+  });
+}
+
+/** Clip a convex polygon against the half-plane  f(p) <= 0. */
+function clipHalfPlane(poly, f) {
+  const out = [];
+  for (let i = 0; i < poly.length; i++) {
+    const a = poly[i], b = poly[(i + 1) % poly.length];
+    const fa = f(a), fb = f(b);
+    if (fa <= 0) out.push(a);
+    if ((fa < 0 && fb > 0) || (fa > 0 && fb < 0)) {
+      const t = fa / (fa - fb);
+      out.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]);
+    }
+  }
+  return out;
