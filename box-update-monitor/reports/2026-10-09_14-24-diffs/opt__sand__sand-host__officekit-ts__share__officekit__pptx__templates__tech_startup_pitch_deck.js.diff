+/** Place one of the normalised icon paths. */
+function icon(s, pts, x, y, w, h, color, rotate) {
+  s.addShape('custGeom', {
+    x, y, w, h, rotate: rotate || 0,
+    points: pts.map(p => (p.close ? p : {
+      ...p,
+      x: +(p.x * w).toFixed(4), y: +(p.y * h).toFixed(4),
+      ...(p.curve ? { curve: { type: 'cubic', x1: +(p.curve.x1 * w).toFixed(4), y1: +(p.curve.y1 * h).toFixed(4), x2: +(p.curve.x2 * w).toFixed(4), y2: +(p.curve.y2 * h).toFixed(4) } } : {}),
+    })),
+    fill: { color }, line: NOLINE,
+  });
+}
+const arrowIcon = (s, x, y, sz, color, rot) => icon(s, ARROW_PTS, x, y, sz, sz, color, rot);
