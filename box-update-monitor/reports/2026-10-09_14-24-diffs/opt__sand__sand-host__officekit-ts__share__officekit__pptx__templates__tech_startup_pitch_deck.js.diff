+const dollarIcon = (s, x, y, h, color) => icon(s, DOLLAR_PTS, x, y, h * 0.5222, h, color);
+const trendIcon = (s, x, y, w, color, rot) => icon(s, TREND_PTS, x, y, w, w * 0.6, color, rot);
