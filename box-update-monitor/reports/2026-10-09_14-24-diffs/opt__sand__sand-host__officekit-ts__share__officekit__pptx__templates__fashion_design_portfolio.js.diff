+/** Body / caption text — Open Sans, white, top-anchored like the original. */
+function text(s, str, o) {
+  s.addText(str, Object.assign({
+    fontFace: F.body, fontSize: 10, color: C.white,
+    align: 'left', valign: 'top', margin: INSET, isTextBox: true,
