+  .map(v => v.toString(16).padStart(2, '0').toUpperCase()).join('');
+const ORANGE_A = [0.89, 0.7765, 0.6706].map(a => BLEND(C.orange, a));
+const WHITE_A = [0.89, 0.7765, 0.6706].map(a => BLEND(C.white, a));
