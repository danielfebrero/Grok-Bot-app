+// Bar widths of the decorative EAN strip, alternating bar / gap, in source px.
+const BAR_RUNS = 'PLACEHOLDER';
+
+/** Barcode strip (1.473" x 0.846" in the original artwork). */
+function barcode(s, x, y) {
+  const u = 1.473 / 324;      // source bitmap was 324 px wide
+  let px = 23;
+  BAR_RUNS.split('').forEach((d, i) => {
+    const w = Number(d);
+    if (i % 2 === 0) rect(s, x + px * u, y + 23 * u, w * u, 112 * u, C.barcode);
+    px += w;
+  });
+  text(s, 'A1234567890A', {
+    x: x + 0.02, y: y + 0.615, w: 1.43, h: 0.22, fontSize: 10, color: C.barcode,
+    align: 'center', charSpacing: 1.4, margin: 0,
+  });
+}
