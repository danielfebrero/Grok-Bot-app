+/** Wire-globe glyph used in the badge and inside the orange tiles. */
+function globe(s, x, y, d, color) {
+  const lw = Math.max(0.75, d * 4);
+  const o = { line: { color, width: lw }, fill: { type: 'none' } };
+  s.addShape('ellipse', Object.assign({ x, y, w: d, h: d }, o));
+  s.addShape('ellipse', Object.assign({ x: x + d * 0.31, y, w: d * 0.38, h: d }, o));
+  hline(s, x + d * 0.03, y + d * 0.29, d * 0.94, color, lw);
+  hline(s, x, y + d * 0.5, d, color, lw);
+  hline(s, x + d * 0.03, y + d * 0.71, d * 0.94, color, lw);
+  vline(s, x + d * 0.5, y, d, color, lw);
+}
+
+/** Orange square (or circle) with the white globe centred on it. */
+function globeTile(s, x, y, w, h, gx, gy, gd, shape = 'rect') {
+  s.addShape(shape, { x, y, w, h, fill: { color: C.orange } });
