+    s.addShape('ellipse', {
+      x: o.x + o.w * 0.5 - o.hd / 2, y: o.y + o.h - o.hd - o.h * 0.035, w: o.hd, h: o.hd,
+      fill: { type: 'none' }, line: { color: o.rim, width: 1.25 },
