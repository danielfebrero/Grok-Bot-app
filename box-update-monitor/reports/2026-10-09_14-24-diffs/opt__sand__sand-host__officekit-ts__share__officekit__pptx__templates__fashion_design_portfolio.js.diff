+/** Giant rotated "PORTFOLIO" / "EXCLUSIVE" watermark word. */
+function sideWord(s, str, x, color = C.orange, size = 60) {
+  head(s, str, { x, y: 3.195, w: 5.192, h: 1.111, rotate: 270, align: 'center', color, fontSize: size });
+}
