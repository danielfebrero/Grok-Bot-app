+/* -------------------------------------------------------------- world maps */
+// Each string is one raster row of the map; '#' = land, 'o' = highlighted
+// country, '.' = shadowed country, ' ' = sea. Runs are merged into rectangles.
+
+const MAP_PALETTE = { '#': C.gray, o: C.orange, '.': C.dark };
+
+function drawMap(s, grid, x0, y0, x1, y1) {
+  const cw = (x1 - x0) / grid[0].length, ch = (y1 - y0) / grid.length;
+  grid.forEach((row, r) => {
+    for (let c = 0; c < row.length;) {
+      const ch0 = row[c];
+      let n = 1;
+      while (c + n < row.length && row[c + n] === ch0) n++;
+      if (MAP_PALETTE[ch0]) rect(s, x0 + c * cw, y0 + r * ch, n * cw + cw * 0.12, ch * 1.12, MAP_PALETTE[ch0]);
+      c += n;
+    }
+  });
+}
