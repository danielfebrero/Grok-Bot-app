+/** Empty picture frames in the source render as nothing — mirrored here. */
+function photoFrame() { /* intentionally blank */ }
+
+/** A single line of text stretched across a square block — reads as stripes. */
+function stretchedWordmark(s, x, y, w, h, phrase) {
+  const cell = w / phrase.length;
+  phrase.split('').forEach((ch, i) => {
+    if (ch !== ' ') rect(s, x + i * cell, y, cell * 0.58, h, C.white);
+  });
+}
