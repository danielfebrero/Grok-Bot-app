+/** Display type — DM Sans. */
+function head(s, str, o) {
+  s.addText(str, Object.assign({
+    fontFace: F.head, fontSize: 60, bold: true, color: C.orange,
+    align: 'left', valign: 'top', margin: INSET, isTextBox: true,
+  }, o));
+}
+
+const rect = (s, x, y, w, h, color) => s.addShape('rect', { x, y, w, h, fill: { color } });
+const oval = (s, x, y, w, h, color) => s.addShape('ellipse', { x, y, w, h, fill: { color } });
+const hline = (s, x, y, w, color = C.white, width = 0.75) =>
+  s.addShape('line', { x, y, w, h: 0, line: { color, width } });
+const vline = (s, x, y, h, color = C.white, width = 0.75) =>
+  s.addShape('line', { x, y, w: 0, h, line: { color, width } });
