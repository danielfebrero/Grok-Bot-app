+/** "WRITE MESSAGE HERE" caption + rule + barcode block. */
+function messageBlock(s, x, y, ruleW, barX, barY) {
+  text(s, 'WRITE MESSAGE HERE', { x, y, w: 1.667, h: 0.268 });
+  hline(s, x + 0.097, y + 0.282, ruleW);
