+/**
+ * The template's big decorative blob is one SVG cropped by `srcRect`; the
+ * visible part is reproduced by drawing the whole blob oversized and letting
+ * the slide edges do the cropping.
+ * `cropR` / `cropT` are the fractions trimmed from right / top.
+ */
+function croppedBlob(slide, o) {
+  const full = o.w / (1 - o.cropR);
+  freeform(slide, PATHS.blob, {
+    x: o.flipH ? o.x + o.w - full : o.x, y: o.y - o.cropT * full,
+    w: full, h: full, fill: o.fill, flipH: o.flipH,
+  });
+}
