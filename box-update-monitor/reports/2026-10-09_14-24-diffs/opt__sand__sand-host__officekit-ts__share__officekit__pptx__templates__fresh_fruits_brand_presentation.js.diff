+/** Convert a normalised outline into pptxgenjs `points` for a w x h box. */
+function pathPoints(spec, w, h) {
+  const pts = spec.map((seg, i) => {
+    if (seg[0] === 'L') return { x: seg[1] * w, y: seg[2] * h };
+    if (i === 0 || seg.length === 2) return { x: seg[0] * w, y: seg[1] * h };
+    return {
+      x: seg[4] * w, y: seg[5] * h,
+      curve: { type: 'cubic', x1: seg[0] * w, y1: seg[1] * h, x2: seg[2] * w, y2: seg[3] * h },
+    };
+  });
+  pts.push({ close: true });
+  return pts;
+}
+
+/** Freeform shape from a normalised outline. */
+function freeform(slide, spec, o) {
+  slide.addShape('custGeom', {
+    x: o.x, y: o.y, w: o.w, h: o.h, points: pathPoints(spec, o.w, o.h),
+    fill: o.fill ? { color: o.fill } : { type: 'none' },
+    line: o.line ? { color: o.line, width: o.lineW || 1 } : { type: 'none' },
+    rotate: o.rotate || 0, flipH: !!o.flipH, flipV: !!o.flipV, shadow: o.shadow,
+  });
+}
+
+/** Filled polygon from absolute-inch points. */
+function polygon(slide, pts, color) {
+  const x = Math.min(...pts.map((p) => p[0]));
+  const y = Math.min(...pts.map((p) => p[1]));
+  const w = Math.max(...pts.map((p) => p[0])) - x;
+  const h = Math.max(...pts.map((p) => p[1])) - y;
+  slide.addShape('custGeom', {
+    x, y, w, h, fill: { color }, line: { type: 'none' },
+    points: pts.map((p) => ({ x: p[0] - x, y: p[1] - y })).concat([{ close: true }]),
+  });
+}
