+/** Rounded-rectangle corner radius: OOXML stores `adj` as 1/100000 of min(w,h). */
+const radius = (adj, w, h) => (adj / 100000) * Math.min(w, h);
+
+/** Plain text box, top anchored, auto-fit height — the deck's default text frame. */
+function txt(slide, text, o) {
+    slide.addText(text, {
+        x: o.x, y: o.y, w: o.w, h: o.h,
+        fontFace: o.font || BODY, fontSize: o.size || 14,
+        color: o.color || BLACK, bold: !!o.bold, italic: !!o.italic,
+        align: o.align || 'left', valign: 'top', wrap: o.wrap !== false, fit: 'resize',
+    });
+}
+
+/** Bold heading (Poppins 40pt navy by default) — one array entry per line. */
+function heading(slide, lines, o) {
+    txt(slide, lines.join('\n'), {
+        x: o.x, y: o.y, w: o.w, h: o.h, font: HEAD, size: o.size || 40,
+        bold: true, italic: !!o.italic, color: o.color || NAVY, align: o.align, wrap: false,
+    });
+}
+
+/** Filled / outlined rectangle or rounded rectangle card. */
+function card(slide, o) {
+    slide.addShape(o.round ? 'roundRect' : 'rect', {
+        x: o.x, y: o.y, w: o.w, h: o.h,
+        fill: o.fill ? { color: o.fill } : { type: 'none' },
+        line: o.lineColor ? { color: o.lineColor, width: o.lineWidth || 1 } : { type: 'none' },
+        rectRadius: o.round ? radius(o.round, o.w, o.h) : undefined,
+        shadow: o.shadow ? SHADOW : undefined,
+    });
+}
+
+/** Pill / chip with centred bold text ("$4,000", "01", "Explore More"). */
+function chip(slide, label, o) {
+    card(slide, o.fill ? o : Object.assign({ fill: ORANGE }, o));
+    slide.addText(label, {
+        x: o.x, y: o.y, w: o.w, h: o.h, align: 'center', valign: 'middle',
+        fontFace: HEAD, fontSize: o.size || 20, bold: true, color: o.color || NAVY,
+    });
+}
+
+/** Horizontal rule. */
+function rule(slide, x, y, w, color, dash) {
+    slide.addShape('line', { x, y, w, h: 0, line: { color, width: 1, dashType: dash || 'solid' } });
+}
+
+/** Bold label above a body paragraph — the deck's most repeated text pattern. */
+function labelPara(slide, o) {
