+/* Each pictogram in the source deck is redrawn as the closest native
+ * pptxgenjs shape, filled in navy at roughly the glyph's visual weight. */
+const GLYPH = {
+    cross: 'plus', heartbeat: 'wave', skeleton: 'plus', heart: 'heart',
+    arm: 'teardrop', robot: 'roundRect', warning: 'triangle', hands: 'teardrop',
