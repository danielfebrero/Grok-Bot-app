+};
+
+/** Stand-in for a pictogram: navy glyph centred in a `box`-inch square. */
+function icon(slide, x, y, box, name) {
+    const s = box * 0.7;
+    const h = name === 'heartbeat' ? s * 0.5 : s;   // the ECG glyph is a flat line
+    slide.addShape(GLYPH[name] || 'ellipse', {
+        x: x + (box - s) / 2, y: y + (box - h) / 2, w: s, h,
+        fill: { color: NAVY }, line: { type: 'none' }, rectRadius: s * 0.22,
+    });
