+/** Mix two hex colours, `t` = 0 gives `a`, 1 gives `b`. */
+function mix(a, b, t) {
+	let out = '';
+	for (let i = 0; i < 6; i += 2) {
+		const va = parseInt(a.substr(i, 2), 16);
+		const vb = parseInt(b.substr(i, 2), 16);
+		out += ('0' + Math.round(va + (vb - va) * t).toString(16)).slice(-2);
+	}
+	return out.toUpperCase();
+}
