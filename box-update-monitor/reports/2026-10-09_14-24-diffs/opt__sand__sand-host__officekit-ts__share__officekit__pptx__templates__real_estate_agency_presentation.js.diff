+
+/** Rounded rectangle; `r` is the corner radius in inches. */
+function round(s, x, y, w, h, r, opts) {
+	s.addShape('roundRect', Object.assign({ x, y, w, h, rectRadius: r, line: { type: 'none' } }, opts));
