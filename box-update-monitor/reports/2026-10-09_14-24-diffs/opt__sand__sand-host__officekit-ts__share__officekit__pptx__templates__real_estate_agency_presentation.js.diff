+	s.addShape('ellipse', Object.assign({ x, y, w: d, h: d, fill: { color }, line: { type: 'none' } }, opts));
+}
+
+/** Placeholder standing in for a photograph in the source deck. */
+function photo(s, x, y, w, h, color) {
