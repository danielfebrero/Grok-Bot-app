+function rings(s, cx, cy, d, color) {
+  RING_BANDS.forEach(function (b) {
+    const dd = d * b[0];
+    s.addShape('ellipse', {
+      x: cx - dd / 2, y: cy - dd / 2, w: dd, h: dd,
