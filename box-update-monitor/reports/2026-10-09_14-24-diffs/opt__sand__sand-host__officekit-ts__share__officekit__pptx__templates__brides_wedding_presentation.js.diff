+];
+
+// Concentric "tree ring" motif: [mid diameter / D, stroke weight / D].
+const RING_BANDS = [
+  [0.961, 0.0387], [0.797, 0.0297], [0.624, 0.0238], [0.443, 0.0149], [0.288, 0.0089]
