+    x: x, y: y, w: w, h: h,
+    fill: { color: fill }, line: { type: 'none' },
+    points: pts.map((p) => ({ x: +(p[0] * w).toFixed(4), y: +(p[1] * h).toFixed(4) })).concat([{ close: true }])
+  });
+}
