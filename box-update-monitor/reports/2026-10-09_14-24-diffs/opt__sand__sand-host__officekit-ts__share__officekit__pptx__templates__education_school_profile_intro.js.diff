+// Generic shape: `geom` is a preset name, a B.* blob key or an I.* icon key.
+function sh(s, geom, x, y, w, h, o) {
+  o = o || {};
+  const opt = { x, y, w, h };
+  if (o.f) opt.fill = typeof o.f === 'string' ? { color: o.f } : o.f;
+  if (o.l) opt.line = o.l;
+  if (o.rot) opt.rotate = o.rot;
+  if (o.fh) opt.flipH = true;
+  if (o.fv) opt.flipV = true;
+  if (o.r != null) opt.rectRadius = o.r;
+  if (B[geom]) { opt.points = blobPts(B[geom], w, h); geom = 'custGeom'; }
+  else if (I[geom]) { opt.points = iconPts(I[geom], w, h); geom = 'custGeom'; }
+  s.addShape(geom, opt);
