+  sh(s, geom, x, y, w, h, Object.assign({}, o, { f: PHOTO }));
+  if (w > 1.6 && w < 11 && h > 1.2 && h < 7.4) {
+    s.addText('[image]', { x, y: y + h / 2 - 0.2, w, h: 0.4, align: 'center',
+      valign: 'middle', fontFace: BD, fontSize: 12, color: '8A8A8A' });
+  }
