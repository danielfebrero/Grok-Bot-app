+// ---------------------------------------------------------------- helpers
+// Turn a blob/icon definition into pptxgenjs `points` (shape-local inches).
+function blobPts(def, w, h) {
+  const pts = [];
+  let open = false;
+  def.forEach(cmd => {
+    if (cmd.length === 0) { pts.push({ close: true }); open = false; return; }
+    if (cmd.length === 6) {
+      pts.push({ x: cmd[4] * w, y: cmd[5] * h,
+                 curve: { type: 'cubic', x1: cmd[0] * w, y1: cmd[1] * h,
+                          x2: cmd[2] * w, y2: cmd[3] * h } });
+    } else {
+      pts.push({ x: cmd[0] * w, y: cmd[1] * h, moveTo: !open });
+    }
+    open = true;
+  });
+  return pts;
