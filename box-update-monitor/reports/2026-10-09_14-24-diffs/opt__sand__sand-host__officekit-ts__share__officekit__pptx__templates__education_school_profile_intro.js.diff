+function iconPts(subs, w, h) {
+  const pts = [];
+  subs.forEach(sub => {
+    for (let i = 0; i < sub.length; i += 2) {
+      pts.push({ x: sub[i] * w, y: sub[i + 1] * h, moveTo: i === 0 });
+    }
+    pts.push({ close: true });
+  });
+  return pts;
