+  if (w > h) {                                   // laptop
+    const lid = h * 0.88, pad = 0.11;
+    sh(s, 'roundRect', x, y, w, lid, { f: body, r: 0.1 });
+    if (screen) photo(s, 'rect', x + pad, y + pad, w - 2 * pad, lid - 2 * pad);
+    sh(s, 'roundRect', x - 0.1, y + lid + 0.02, w + 0.2, h - lid - 0.02,
+       { f: '3A3F45', r: 0.05 });
+  } else {                                       // phone
+    const pad = 0.11;
