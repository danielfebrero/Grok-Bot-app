+function archUp(s, x, y, w, h, hole, color, bgColor) {
+  s.addShape('chord', { x, y: y - h, w, h: 2 * h, angleRange: [0, 180], fill: { color } });
+  s.addShape('chord', {
+    x: x + (w * (1 - hole)) / 2,
+    y: y - h * hole,
+    w: w * hole,
+    h: 2 * h * hole,
+    angleRange: [0, 180],
+    fill: { color: bgColor },
+  });
