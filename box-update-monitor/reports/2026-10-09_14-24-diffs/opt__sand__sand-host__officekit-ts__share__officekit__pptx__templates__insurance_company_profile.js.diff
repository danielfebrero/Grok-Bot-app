+	/* Thumb angled up to the right. */
+	slide.addShape('roundRect', {
+		x: x + 0.653 * s, y: y + 0.573 * s, w: 0.304 * s, h: 0.095 * s,
+		fill: { color }, rectRadius: 0.047 * s, rotate: -46,
+	});
