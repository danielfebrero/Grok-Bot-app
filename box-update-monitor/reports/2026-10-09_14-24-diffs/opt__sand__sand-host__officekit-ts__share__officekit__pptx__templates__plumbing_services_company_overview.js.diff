+  const horiz = o.dir === 'h';
+  const cap = o.cap || 0;
+  const len = (horiz ? box[2] : box[3]) - 2 * cap;
+  const at = function (i) {
+    return blend(o.color, o.over || PHOTO, 1 - (o.from + (o.to - o.from) * i / (steps - 1)) / 100);
