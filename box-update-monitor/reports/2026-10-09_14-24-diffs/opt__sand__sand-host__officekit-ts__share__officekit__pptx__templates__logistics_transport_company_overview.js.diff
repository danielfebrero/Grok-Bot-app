+/** Rounded rectangle; `shadow` turns on the soft card drop shadow. */
+function roundRect(s, x, y, w, h, r, color, withShadow) {
+  const o = { x, y, w, h, rectRadius: r, fill: { color }, line: { type: 'none' } };
+  if (withShadow) o.shadow = shadow();
+  s.addShape('roundRect', o);
+}
+
+/** Filled circle. */
+function dot(s, x, y, d, color) {
+  s.addShape('ellipse', { x, y, w: d, h: d, fill: { color }, line: { type: 'none' } });
+}
+
+/** Thin straight line. */
+function line(s, x, y, w, h, color) {
+  s.addShape('line', { x, y, w, h, line: { color, width: 1 } });
