+/** Orange disc with a white chevron; `dir` is 'right' (default), 'left' or 'down'. */
+function arrow(s, x, y, d, dir) {
+  dot(s, x, y, d, ORANGE);
+  const long = d * 0.39, short = d * 0.26;
+  const w = dir === 'down' ? long : short;
