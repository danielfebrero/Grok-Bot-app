+function panel(s, x, y, w, h, r, color, withShadow) {
+  const c = typeof r === 'number' ? { tl: r, tr: r, br: r, bl: r } : { tl: 0, tr: 0, br: 0, bl: 0, ...r };
+  const pts = [
+    { x: c.tl, y: 0, moveTo: true },
+    { x: w - c.tr, y: 0 },
+    { x: w, y: c.tr, curve: { type: 'cubic', x1: w - c.tr / 2, y1: 0, x2: w, y2: c.tr / 2 } },
+    { x: w, y: h - c.br },
+    { x: w - c.br, y: h, curve: { type: 'cubic', x1: w, y1: h - c.br / 2, x2: w - c.br / 2, y2: h } },
+    { x: c.bl, y: h },
+    { x: 0, y: h - c.bl, curve: { type: 'cubic', x1: c.bl / 2, y1: h, x2: 0, y2: h - c.bl / 2 } },
+    { x: 0, y: c.tl },
+    { x: c.tl, y: 0, curve: { type: 'cubic', x1: 0, y1: c.tl / 2, x2: c.tl / 2, y2: 0 } },
+    { close: true },
+  ];
+  const o = { x, y, w, h, fill: { color }, line: { type: 'none' }, points: pts };
+  if (withShadow) o.shadow = shadow();
+  s.addShape('custGeom', o);
