+/** One freeform made of `n` x `n` little squares, as in the original artwork. */
+function squareGrid(s, x, y, cell, gap, n, color) {
+  const pts = [];
+  for (let r = 0; r < n; r++) {
+    for (let c = 0; c < n; c++) {
+      const px = c * gap, py = r * gap;
+      pts.push({ x: px, y: py, moveTo: true }, { x: px + cell, y: py },
+        { x: px + cell, y: py + cell }, { x: px, y: py + cell }, { close: true });
+    }
+  }
+  const span = gap * (n - 1) + cell;
+  s.addShape('custGeom', { x, y, w: span, h: span, fill: { color }, line: { type: 'none' }, points: pts });
