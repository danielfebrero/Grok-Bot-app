+	box(slide, 'roundRect', x + w * 0.14, y + h * 0.06, w * 0.72, h * 0.66, color, { rectRadius: w * 0.36 });
+	box(slide, 'rect', x + w * 0.14, y + h * 0.36, w * 0.72, h * 0.38, color);
+	box(slide, 'roundRect', x, y + h * 0.68, w, h * 0.14, color, { rectRadius: h * 0.07 });
+	box(slide, 'ellipse', x + w * 0.34, y + h * 0.84, w * 0.32, h * 0.16, color);
+}
+
+function iconCheck(slide, x, y, w, h, color, bg) {
