+ *
+ * Slide size 13.333 x 7.5 in (16:9).  The source deck has several empty
+ * "Picture Placeholder" frames; they carry no image and render blank, so they
+ * are intentionally not drawn here.  The few small raster/SVG icons in the
+ * source are redrawn below from native shapes (see the icon helpers).
+ */
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ------------------------------------------------------------------ theme */
+const ORANGE = 'FF794C';   // accent1
+const DARK = '183641';     // accent2
+const CYAN = '01CDED';     // accent5
+const WHITE = 'FFFFFF';
+const INK = '404040';      // tx1 @ 75% lum  — headings
+const INK_MID = '595959';  // tx1 @ 65% lum
+const INK_SOFT = '808080'; // tx1 @ 50% lum  — body copy
+const GREY = 'F2F2F2';     // bg1 @ 95% lum  — card / track fill
+const GREY_DOT = 'D9D9D9';
+const FOOT = 'A6A6A6';
+const PEACH = 'FFE4DB';
+
+const HEAD = 'Lexend Medium'; // theme major font
+const BODY = 'Open Sans';     // theme minor font
+const ALT = 'Work Sans';
+
+const NOLINE = { type: 'none' };
+
+/**
+ * The deck's soft 45-degree drop shadow, in the same units PowerPoint stores:
+ * `opacity` 0-1, `blur`/`offset` in points.  Returns a fresh object every call
+ * because pptxgenjs rewrites the shadow options in place while serialising.
+ */
+const sh = (opacity, blur, offset) => ({ type: 'outer', color: '000000', angle: 45, opacity, blur, offset });
+
+/* ---------------------------------------------------------------- helpers */
+
+/** Filled shape without an outline. */
+function box(slide, kind, x, y, w, h, fill, extra) {
+	slide.addShape(kind, Object.assign({ x, y, w, h, fill: { color: fill }, line: NOLINE }, extra));
+}
+
+/** Rounded rectangle. `adj` is PowerPoint's corner-radius fraction of the short side. */
+function rrect(slide, x, y, w, h, fill, adj, extra) {
+	box(slide, 'roundRect', x, y, w, h, fill, Object.assign({ rectRadius: adj * Math.min(w, h) }, extra));
+}
+
+/** Fully rounded ends. */
+function pill(slide, x, y, w, h, fill, extra) {
+	rrect(slide, x, y, w, h, fill, 0.5, extra);
+}
+
+/**
+ * Rectangle rounded on the top two corners only (DrawingML `round2SameRect`).
+ * pptxgenjs exposes a single corner-radius adjustment, so square off the bottom
+ * with a patch rectangle.
+ */
+function topRound(slide, x, y, w, h, fill, radius, extra) {
+	box(slide, 'roundRect', x, y, w, h, fill, Object.assign({ rectRadius: radius }, extra));
+	box(slide, 'rect', x, y + h - radius, w, radius, fill);
+}
+
+/** Horizontal bar rounded on its right end only. */
+function capBarRight(slide, x, y, w, h, fill) {
+	box(slide, 'roundRect', x, y, w, h, fill, { rectRadius: h / 2 });
+	box(slide, 'rect', x, y, h / 2, h, fill);
+}
+
+/** Text box: top anchored, theme body font, 12 pt, like the source deck. */
+function txt(slide, text, o) {
+	slide.addText(text, Object.assign({ fontFace: BODY, fontSize: 12, color: INK, valign: 'top', isTextBox: true }, o));
+}
+
+/** Straight connector. */
+function rule(slide, x, y, w, color, width, dashType) {
+	slide.addShape('line', { x, y, w, h: 0, line: { color, width, dashType, endArrowType: 'none' } });
+}
+
+/** Master footer: deck name bottom-left, slide number bottom-right. */
+function footer(slide, num) {
+	txt(slide, 'Project Agenda', { x: 0.764, y: 6.786, w: 2.324, h: 0.278, fontSize: 10.5, color: FOOT });
+	txt(slide, String(num), { x: 11.971, y: 6.788, w: 0.816, h: 0.399, fontSize: 10.5, color: FOOT, align: 'center' });
+}
+
+/**
+ * "Logoipsum" wordmark: a dark disc crossed by three wavy slices, plus the
+ * name. `bg` is the slide colour showing through the slices.
+ */
+function logo(slide, x, y, color, bg) {
+	const d = 0.321;
+	box(slide, 'ellipse', x, y, d, d, DARK);
+	[0.20, 0.40, 0.60].forEach(t => box(slide, 'wave', x - d * 0.05, y + d * t, d * 1.1, d * 0.13, bg, { rotate: -12 }));
+	txt(slide, 'Logoipsum', { x: x + 0.36, y: y + 0.04, w: 1.6, h: 0.28, fontSize: 13, bold: true, color, margin: 0 });
+}
+
+/* -------------------------------------------------------------- icon glyphs
+ * Small monochrome pictograms, each drawn to fill the bounding box (x,y,w,h)
+ * that the corresponding freeform/graphic occupies in the source deck.        */
+
+function iconFolder(slide, x, y, w, h, color, bg) {
+	box(slide, 'roundRect', x + w * 0.06, y, w * 0.5, h * 0.42, color, { rectRadius: h * 0.14 });
+	box(slide, 'roundRect', x, y + h * 0.2, w, h * 0.8, color, { rectRadius: h * 0.16 });
+	box(slide, 'rect', x + w * 0.12, y + h * 0.4, w * 0.76, h * 0.13, bg);
+}
+
+function iconPencil(slide, x, y, w, h, color, bg) {
+	box(slide, 'roundRect', x + w * 0.42, y - h * 0.02, w * 0.36, h * 0.82, color, { rectRadius: w * 0.16, rotate: 45 });
+	box(slide, 'triangle', x + w * 0.02, y + h * 0.62, w * 0.36, h * 0.36, color, { rotate: 225 });
+}
+
+function iconPie(slide, x, y, w, h, color, bg) {
+	box(slide, 'pie', x, y + h * 0.14, w * 0.86, h * 0.86, color, { angleRange: [8, 340] });
