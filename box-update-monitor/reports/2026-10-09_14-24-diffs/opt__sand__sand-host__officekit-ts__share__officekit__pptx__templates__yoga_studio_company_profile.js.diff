+// ---------------------------------------------------------------- primitives
+// Freeform path commands.  Coordinates are fractions of the shape's own box, so a
+// path can be re-used at any size.
+const M = (x, y) => ['M', x, y];
+const L = (x, y) => ['L', x, y];
+const C = (x1, y1, x2, y2, x, y) => ['C', x1, y1, x2, y2, x, y];
+const Z = ['Z'];
+
+function shape(slide, kind, x, y, w, h, opts) {
+  slide.addShape(kind, Object.assign({ x, y, w, h }, opts));
+}
+
+function freeform(slide, pathDef, x, y, w, h, opts) {
+  const pts = [];
+  for (const c of pathDef) {
+    if (c[0] === 'M') pts.push({ x: c[1] * w, y: c[2] * h, moveTo: true });
+    else if (c[0] === 'L') pts.push({ x: c[1] * w, y: c[2] * h });
+    else if (c[0] === 'C') pts.push({
+      x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h },
+    });
+    else pts.push({ close: true });
+  }
+  slide.addShape('custGeom', Object.assign({ x, y, w, h, points: pts }, opts));
+}
+
+// Rectangle with two opposite corners rounded by r1 and the other two by r2
+// (PowerPoint's "round2DiagRect": top-left/bottom-right use r1).
+function diagRounded(w, h, r1, r2) {
+  const a = r1 / w, b = r1 / h, c = r2 / w, e = r2 / h, k = 0.4477;
+  return [
+    M(a, 0), L(1 - c, 0), C(1 - c * k, 0, 1, e * k, 1, e), L(1, 1 - b),
+    C(1, 1 - b * k, 1 - a * k, 1, 1 - a, 1), L(c, 1),
+    C(c * k, 1, 0, 1 - e * k, 0, 1 - e), L(0, b), C(0, b * k, a * k, 0, a, 0), Z,
+  ];
+}
+
+// Text box.  Every box in the deck is top-anchored and "resize shape to fit text"
+// (pptxgenjs centres text vertically by default, hence the explicit valign).
+function tx(slide, x, y, w, h, text, opts) {
+  slide.addText(text, Object.assign({ x, y, w, h, valign: 'top', fit: 'resize' }, opts));
+}
