+  shape(slide, 'roundRect', x, y, 1.547, 0.485, { rectRadius: 0.111, fill });
+  tx(slide, x + 0.187, y + 0.099, 1.173, 0.286, label,
+    { ...LABEL, color: fill === MINT ? GRAY : WHITE, charSpacing: 1, align: 'center' });
+}
