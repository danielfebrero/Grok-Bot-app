+// thick ring segment: arc of `sweep` degrees starting at `start` (0 deg = 3 o'clock, clockwise)
+function ringSegment(s, x, y, d, start, sweep, thickness, color) {
+  const R = d / 2;
+  const r = R * (1 - thickness);
+  const at = (rad, a) => ({ x: R + rad * Math.cos(a * Math.PI / 180), y: R + rad * Math.sin(a * Math.PI / 180) });
+  const p0 = at(R, start);
+  const p1 = at(r, start + sweep);
+  s.addShape('custGeom', {
+    x, y, w: d, h: d, fill: solid(color), line: NOLINE,
+    points: [
+      { x: p0.x, y: p0.y, moveTo: true },
+      { x: 0, y: 0, curve: { type: 'arc', hR: R, wR: R, stAng: start, swAng: sweep } },
+      { x: p1.x, y: p1.y },
+      { x: 0, y: 0, curve: { type: 'arc', hR: r, wR: r, stAng: start + sweep, swAng: -sweep } },
+      { close: true },
+    ],
+  });
+}
