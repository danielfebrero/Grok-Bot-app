+  const rm = (d / 2) * (1 - THICK / 2);
+  const pad = d * 0.42;
+  [START, START + SWEEP].forEach((a) => {
+    const cx = x + d / 2 + rm * Math.cos(a * Math.PI / 180);
+    const cy = y + d / 2 + rm * Math.sin(a * Math.PI / 180);
+    s.addShape('roundRect', {
+      x: cx - pad / 2, y: cy - pad / 2, w: pad, h: pad * 0.86,
+      rectRadius: pad * 0.3, fill: solid(ink), line: NOLINE, rotate: a + 90,
