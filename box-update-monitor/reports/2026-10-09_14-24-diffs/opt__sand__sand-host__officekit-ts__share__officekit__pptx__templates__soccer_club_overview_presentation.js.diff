+function mix(a, b, t) {
+  let out = '';
+  for (let i = 0; i < 6; i += 2) {
+    const av = parseInt(a.substr(i, 2), 16);
+    const bv = parseInt(b.substr(i, 2), 16);
+    out += Math.round(av + (bv - av) * t).toString(16).padStart(2, '0');
+  }
+  return out.toUpperCase();
