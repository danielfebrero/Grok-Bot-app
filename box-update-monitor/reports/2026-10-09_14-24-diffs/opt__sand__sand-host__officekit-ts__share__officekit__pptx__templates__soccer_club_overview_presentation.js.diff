+  const N = 64;
+  for (let i = 0; i < N; i++) {
+    const t = Math.max(0, (i / (N - 1) - 0.15) / 0.85);
+    const k = flip ? N - 1 - i : i;
+    rect(s, x + (w * k) / N, y, w / N + 0.02, h, mix(from, RED, t));
+  }
