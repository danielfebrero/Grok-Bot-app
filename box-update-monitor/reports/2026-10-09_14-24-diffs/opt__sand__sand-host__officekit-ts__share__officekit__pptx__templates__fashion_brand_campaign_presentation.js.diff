+/* ------------------------------------------------------------------ *
+ * Shape / text helpers
+ * ------------------------------------------------------------------ */
+
+/** Colour panel. */
+function panel(s, x, y, w, h, color) {
+  s.addShape('rect', { x, y, w, h, fill: { color }, line: NOLINE });
+}
+
+/** Full-bleed background panel. */
+function bg(s, color) {
+  panel(s, 0, 0, SW, SH, color);
+}
+
+/** Grey block standing in for a photograph. */
+function photo(s, x, y, w, h) {
+  s.addShape('rect', { x, y, w, h, fill: { color: C.photo }, line: NOLINE });
+}
+
+/** Libre Baskerville headline. */
+function heading(s, x, y, w, h, text, opts) {
+  s.addText(text, Object.assign(
+    { x, y, w, h, fontFace: F.serif, fontSize: 36, color: C.ink, valign: 'top' }, opts));
+}
+
+/** 12pt bold "Amartha" brand mark. */
+function brand(s, x, y, color, align) {
+  s.addText('Amartha', {
+    x, y, w: 1.479, h: 0.303, fontFace: F.serif, fontSize: 12, bold: true,
+    color, align: align || 'left', valign: 'top'
+  });
+}
+
+/** 9pt Open Sans paragraph, 200% leading. */
+function body(s, x, y, w, h, text, opts) {
+  s.addText(text, Object.assign(
+    { x, y, w, h, fontFace: F.sans, fontSize: 9, color: C.body,
+      lineSpacingMultiple: 2, valign: 'top' }, opts));
+}
+
+/** 14pt italic serif accent / kicker line. */
+function accent(s, x, y, w, h, text, color) {
+  s.addText(text, {
+    x, y, w, h, fontFace: F.serif, fontSize: 14, italic: true, color, valign: 'top'
+  });
+}
+
+/** Thin horizontal rule. */
+function rule(s, x, y, w, color) {
+  s.addShape('line', { x, y, w, h: 0, line: { color, width: 0.5 } });
+}
+
+const DOT_COLORS = [C.brown, C.tan, C.cream];
+const DOT_COLORS_WHITE = [C.brown, C.tan, C.white];
+
+/**
+ * Row (or column) of three brand dots.
+ * `opts.vertical` stacks them; `opts.ring` draws tan outlines instead of discs.
+ */
+function dots(s, x, y, d, gap, colors, opts) {
+  const o = opts || {};
+  colors.forEach((c, i) => {
+    const disc = { x: x + (o.vertical ? 0 : i * gap), y: y + (o.vertical ? i * gap : 0), w: d, h: d };
+    if (o.ring) s.addShape('ellipse', Object.assign(disc, { line: { color: c, width: 3 } }));
+    else s.addShape('ellipse', Object.assign(disc, { fill: { color: c }, line: NOLINE }));
+  });
+}
+
+/* Decorative comma glyph, expressed as cubic bezier segments on a 0..1 grid.
+ * The ornament is this glyph plus a 180-degree rotated copy beside it. */
+const COMMA_PATH = [
+  ['M', 0.943, 0.1704],
+  ['C', 0.8984, 0.1151, 0.8297, 0.0705, 0.7464, 0.0427],
+  ['C', 0.6458, 0.0097, 0.5342, -0.0046, 0.4228, 0.0013],
+  ['L', 0.4207, 0.0013],
+  ['C', 0.0903, 0.0296, 0.0407, 0.1796, 0.0422, 0.2280],
+  ['C', 0.0479, 0.3484, 0.1558, 0.4209, 0.2820, 0.4209],
+  ['C', 0.3832, 0.4209, 0.5066, 0.3317, 0.4228, 0.2398],
+  ['C', 0.3226, 0.1362, 0.1771, 0.2324, 0.1596, 0.1890],
+  ['C', 0.1558, 0.1788, 0.2179, 0.0440, 0.4892, 0.0517],
+  ['L', 0.4924, 0.0517],
+  ['C', 0.6554, 0.0677, 0.7064, 0.1568, 0.7284, 0.2614],
+  ['C', 0.7709, 0.4788, 0.5594, 0.6740, 0.4092, 0.7765],
+  ['C', 0.2896, 0.8645, 0.0920, 0.9446, 0.0094, 0.9832],
+  ['C', 0.0007, 0.9871, -0.0024, 0.9948, 0.0020, 1.0013],
+  ['L', 0.0020, 1.0013],
+  ['C', 0.0066, 1.0087, 0.0191, 1.0121, 0.0299, 1.0089],
+  ['C', 0.0302, 1.0088, 0.0304, 1.0088, 0.0307, 1.0087],
+  ['C', 0.4475, 0.8767, 0.9596, 0.6393, 1.0067, 0.3855],
+  ['C', 1.0194, 0.3110, 0.9971, 0.2357, 0.9430, 0.1704],
+  ['Z']
+];
+
+function commaPoints(w, h) {
+  return COMMA_PATH.map(seg => {
+    if (seg[0] === 'Z') return { close: true };
+    if (seg[0] === 'M') return { x: seg[1] * w, y: seg[2] * h, moveTo: true };
+    if (seg[0] === 'L') return { x: seg[1] * w, y: seg[2] * h };
+    return {
+      x: seg[5] * w, y: seg[6] * h,
+      curve: { type: 'cubic', x1: seg[1] * w, y1: seg[2] * h, x2: seg[3] * w, y2: seg[4] * h }
+    };
+  });
+}
+
+/** Mirrored pair of comma glyphs used as the Amartha monogram. */
+function ornament(s, x, y, w, h, color) {
+  const gw = w / 2;
+  const gh = h * 0.985;
+  const pts = commaPoints(gw, gh);
+  s.addShape('custGeom', { x: x + gw, y: y + h - gh, w: gw, h: gh, points: pts,
+    fill: { color }, line: NOLINE });
+  s.addShape('custGeom', { x, y, w: gw, h: gh, points: pts, rotate: 180,
+    fill: { color }, line: NOLINE });
+}
