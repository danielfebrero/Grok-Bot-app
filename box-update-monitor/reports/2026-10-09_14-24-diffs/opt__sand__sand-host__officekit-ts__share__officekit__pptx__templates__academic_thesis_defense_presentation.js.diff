+function ellipse(slide, cx, cy, d, fill, opts) {
+  slide.addShape(pptx.ShapeType.ellipse, Object.assign({
+    x: cx - d / 2, y: cy - d / 2, w: d, h: d, fill: { color: fill },
+  }, opts || {}));
