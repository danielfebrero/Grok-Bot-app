+/** Teardrop pin body: circular head plus the triangle tangent to it. */
+function pinBody(slide, x, y, w, h, color, headR, tipY) {
+  const cy = 0.41; // head centre as a fraction of the height
+  const d = (tipY - cy) * h, r = headR * w, t = Math.sqrt(d * d - r * r);
+  const dx = (t * r / d) / w, dy = (t * t / d) / h;
+  poly(slide, [[0.5, tipY], [0.5 - dx, tipY - dy], [0.5 + dx, tipY - dy]], x, y, w, h, color);
+  ellipse(slide, x + w / 2, y + cy * h, 2 * r, color, { line: { type: 'none' } });
