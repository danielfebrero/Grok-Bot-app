+/** Draw a normalised polygon scaled into the box (x, y, w, h). */
+function poly(slide, pts, x, y, w, h, fill, opts) {
+  slide.addShape(pptx.ShapeType.custGeom, Object.assign({
+    x: x, y: y, w: w, h: h,
+    fill: fill.transparency ? fill : { color: fill.color || fill },
+    line: { type: 'none' },
+    points: pts.map(function (p) { return { x: p[0] * w, y: p[1] * h }; }).concat([{ close: true }]),
+  }, opts || {}));
