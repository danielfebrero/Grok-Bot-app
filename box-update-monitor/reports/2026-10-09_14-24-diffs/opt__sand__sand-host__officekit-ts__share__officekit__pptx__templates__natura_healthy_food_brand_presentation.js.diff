+// Slides 41-44 are the template's icon libraries: five rows of eleven small
+// black pictograms. The glyphs themselves are decorative, so each is drawn as
+// a neutral rounded tile on the original 11 x 5 grid.
+function iconSheet(s, cols, rows, size, count) {
+  let drawn = 0;
+  for (const cy of rows) {
+    for (const cx of cols) {
+      if (drawn++ >= count) return;
+      shape(s, 'roundRect', cx - size / 2, cy - size / 2, size, size, DARK,
+        { rectRadius: size * 0.18 });
+    }
+  }
+}
