+// ------------------------------------------------------------------ helpers
+// Custom outlines are stored as compact tuples in fractions of the shape box:
+//   [x, y]                 lineTo
+//   [x, y, 1]              moveTo (starts a new sub-path)
+//   [x, y, x1,y1, x2,y2]   cubic bezier with two control points, ending at (x, y)
+//   []                     closePath
+function scalePts(pts, w, h) {
+  return pts.map(p => {
+    if (p.length === 0) return { close: true };
+    if (p.length === 3) return { x: p[0] * w, y: p[1] * h, moveTo: true };
+    if (p.length === 6) return { x: p[0] * w, y: p[1] * h,
+      curve: { type: 'cubic', x1: p[2] * w, y1: p[3] * h, x2: p[4] * w, y2: p[5] * h } };
+    return { x: p[0] * w, y: p[1] * h };
+  }).concat([{ close: true }]);
+}
