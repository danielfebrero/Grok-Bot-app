+// Placeholder for a photograph: same box and mask, flat tone instead of pixels.
+function photo(s, x, y, w, h, o) {
+  o = o || {};
+  const base = { x, y, w, h, fill: { color: o.tone || PHOTO } };
+  if (o.pts) geom(s, o.pts, x, y, w, h, o.tone || PHOTO, o.extra);
+  else if (o.round !== undefined) s.addShape('roundRect', Object.assign(base, { rectRadius: o.round }, o.extra));
+  else if (o.circle) s.addShape('ellipse', Object.assign(base, o.extra));
+  else s.addShape('rect', Object.assign(base, o.extra));
+}
