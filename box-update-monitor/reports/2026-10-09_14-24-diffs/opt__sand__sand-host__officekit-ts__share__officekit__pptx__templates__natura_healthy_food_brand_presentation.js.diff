+// Solid preset shape.
+function shape(s, type, x, y, w, h, fill, extra) {
+  extra = extra || {};
+  const f = { color: fill };
+  if (extra.transparency !== undefined) { f.transparency = extra.transparency; extra = Object.assign({}, extra); delete extra.transparency; }
+  s.addShape(type, Object.assign({ x, y, w, h, fill: f }, extra));
+}
+
+// Free-form shape from a tuple outline.
+function geom(s, pts, x, y, w, h, fill, extra) {
+  extra = extra || {};
+  const f = { color: fill };
+  if (extra.transparency !== undefined) { f.transparency = extra.transparency; extra = Object.assign({}, extra); delete extra.transparency; }
+  s.addShape('custGeom', Object.assign({ x, y, w, h, fill: f,
+    points: scalePts(pts, w, h) }, extra));
+}
