+// Stand-in for one of the deck's line-art eco icons: two concentric rings in the
+// icon's own tint, sized and placed exactly like the artwork it replaces.
+function icon(s, x, y, w, h, tint) {
+  const stroke = Math.max(0.75, w * 2.6);
+  s.addShape('ellipse', {
+    x: x + w * 0.1, y: y + h * 0.1, w: w * 0.8, h: h * 0.8,
+    fill: { type: 'none' }, line: { color: tint, width: stroke },
+  });
+  s.addShape('ellipse', {
+    x: x + w * 0.33, y: y + h * 0.33, w: w * 0.34, h: h * 0.34,
+    fill: { type: 'none' }, line: { color: tint, width: stroke },
+  });
+}
+
+// Stand-in for a product mock-up photograph. The originals are cut-outs whose
+// screen is transparent, so only the chassis is drawn as an open frame.
+function device(s, x, y, w, h, kind) {
+  const frame = (shape, fx, fy, fw, fh, t, radius) => s.addShape(shape, {
+    x: fx + t / 2, y: fy + t / 2, w: fw - t, h: fh - t,
+    fill: { type: 'none' }, line: { color: DEVICE_DARK, width: t * 72 },
+    rectRadius: radius,
+  });
+  const base = (bx, by, bw, bh) => s.addShape('rect', {
+    x: bx, y: by, w: bw, h: bh, fill: { color: DEVICE_BODY }, line: { type: 'none' },
+  });
+  if (kind === 'monitor') {
+    frame('rect', x + 0.02 * w, y + 0.15 * h, 0.96 * w, 0.54 * h, 0.035 * w);
+    base(x + 0.43 * w, y + 0.69 * h, 0.14 * w, 0.19 * h);
+    base(x + 0.25 * w, y + 0.88 * h, 0.5 * w, 0.07 * h);
+  } else if (kind === 'phone') {
+    frame('roundRect', x, y, w, h, 0.065 * w, w * 0.12);
+  } else {
+    frame('rect', x + 0.09 * w, y, 0.82 * w, 0.9 * h, 0.028 * w);
+    base(x, y + 0.89 * h, w, 0.1 * h);
+  }
+}
