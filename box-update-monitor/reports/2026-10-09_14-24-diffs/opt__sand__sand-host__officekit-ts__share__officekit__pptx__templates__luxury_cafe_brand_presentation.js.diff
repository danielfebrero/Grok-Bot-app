+// 19 — Hexagonal ring split into six coloured wedges
+function slide19(s) {
+  eyebrow(s, 'INFOGRAPHIC SLIDE', 1.236, 0.896, 10.861, { align: 'center' });
+  title(s, 'Hexagonal Infographic', 1.236, 1.275, 10.861, 0.766, { align: 'center' });
+
+  // Pointy-top hexagonal ring: six trapezoid wedges between an outer and an
+  // inner hexagon, capped by a white hexagon carrying the "87%" figure.
+  const cx = 6.667;
+  const cy = 4.469;
+  const RX = 1.6915;
+  const RY = 1.901;
+  const IX = 0.962;
+  const IY = 1.081;
+  const vertex = (rx, ry, i) => {
+    const a = (Math.PI / 180) * (90 - 60 * i);
+    return { x: cx + rx * Math.cos(a), y: cy - ry * Math.sin(a) };
+  };
+  const hexagon = (rx, ry, dy = 0) => [...Array(6)].map((_, i) => {
+    const p = vertex(rx, ry, i);
+    return { x: p.x - (cx - rx), y: p.y - (cy - ry) + dy };
+  }).concat([{ close: true }]);
+
+  s.addShape(S.CUSTOM_GEOMETRY, { // soft drop shadow behind the ring
+    x: cx - RX, y: cy - RY, w: 2 * RX, h: 2 * RY,
+    points: hexagon(RX, RY, 0.09), fill: { color: C.body, transparency: 96 },
+  });
+
+  const wedgeColors = [C.brown, C.orange, C.plum, C.purple, C.rust, C.gold];
+  wedgeColors.forEach((color, k) => {
+    const quad = [vertex(RX, RY, k), vertex(RX, RY, k + 1), vertex(IX, IY, k + 1), vertex(IX, IY, k)];
+    const minX = Math.min(...quad.map((p) => p.x));
+    const minY = Math.min(...quad.map((p) => p.y));
+    const maxX = Math.max(...quad.map((p) => p.x));
+    const maxY = Math.max(...quad.map((p) => p.y));
+    s.addShape(S.CUSTOM_GEOMETRY, {
+      x: minX, y: minY, w: maxX - minX, h: maxY - minY,
+      points: quad.map((p) => ({ x: p.x - minX, y: p.y - minY })).concat([{ close: true }]),
+      fill: { color }, line: { color: C.white, width: 1.5 },
+    });
+    const mid = quad.reduce((acc, p) => ({ x: acc.x + p.x / 4, y: acc.y + p.y / 4 }), { x: 0, y: 0 });
+    drinkIcon(s, mid.x, mid.y, 0.42, C.white);
+  });
+  s.addShape(S.CUSTOM_GEOMETRY, {
+    x: cx - IX, y: cy - IY, w: 2 * IX, h: 2 * IY,
+    points: hexagon(IX, IY), fill: { color: C.white },
+  });
+  s.addShape(S.CUSTOM_GEOMETRY, {
+    x: 5.823, y: 3.521, w: 1.688, h: 1.897,
+    points: hexagon(0.844, 0.9485).map((p) => (p.close ? p : { x: p.x, y: p.y })),
+    fill: { color: C.white }, line: { color: C.hairline, width: 0.75 },
+  });
+  s.addText('87%', {
