+    fontFace: HEAD, fontSize: 40, color: C.gold, align: 'center', valign: 'top',
+  });
+
+  const labels = [
+    { x: 1.083, y: 2.464, color: C.gold, align: 'right' },
+    { x: 0.851, y: 3.999, color: C.purple, align: 'right' },
