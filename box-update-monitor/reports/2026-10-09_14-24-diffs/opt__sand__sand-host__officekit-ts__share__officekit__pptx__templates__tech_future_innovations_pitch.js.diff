+const mix = (from, to, t) => {
+  const ch = (i) => {
+    const a = parseInt(from.substr(i * 2, 2), 16);
+    const b = parseInt(to.substr(i * 2, 2), 16);
+    return Math.round(a + (b - a) * Math.max(0, Math.min(1, t)))
+      .toString(16)
+      .padStart(2, '0');
+  };
+  return (ch(0) + ch(1) + ch(2)).toUpperCase();
+};
