+  const { x, y, w, h, r = 0 } = box;
+  const outline = roundRectPath(x, y, w, h, r);
+  const span = w + h;
+  const n = bands || Math.max(10, Math.min(26, Math.round(span * 7)));
+  const bleed = span / n / 20;
+  for (let i = 0; i < n; i++) {
+    const s0 = (span * i) / n - bleed;
+    const s1 = (span * (i + 1)) / n + bleed;
+    const diag = (pt) => pt[0] - x + (pt[1] - y);
+    let poly = clipPoly(outline, (pt) => diag(pt) - s0);
+    if (poly.length) poly = clipPoly(poly, (pt) => s1 - diag(pt));
+    if (poly.length < 3) continue;
+    const xs = poly.map((p) => p[0]);
+    const ys = poly.map((p) => p[1]);
+    const bx = Math.min(...xs);
+    const by = Math.min(...ys);
+    slide.addShape('custGeom', {
+      x: bx,
+      y: by,
+      w: Math.max(...xs) - bx,
+      h: Math.max(...ys) - by,
+      fill: { color: colorAt(x + y + (span * (i + 0.5)) / n) },
+      line: noLine,
+      points: poly
