+/** Outline of a rounded rectangle as a polygon (5 segments per corner). */
+function roundRectPath(x, y, w, h, r) {
+  if (!r) return [[x, y], [x + w, y], [x + w, y + h], [x, y + h]];
+  const seg = 5;
+  const corners = [
+    [x + w - r, y + r, -90],
+    [x + w - r, y + h - r, 0],
+    [x + r, y + h - r, 90],
+    [x + r, y + r, 180],
+  ];
+  const pts = [];
+  corners.forEach(([cx, cy, a0]) => {
+    for (let i = 0; i <= seg; i++) {
+      const a = ((a0 + (90 * i) / seg) * Math.PI) / 180;
+      pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]);
+    }
+  });
+  return pts;
+}
+
+/** Sutherland-Hodgman clip of a polygon by a half-plane `inside(pt) >= 0`. */
+function clipPoly(poly, inside) {
+  const out = [];
+  for (let i = 0; i < poly.length; i++) {
+    const a = poly[i];
+    const b = poly[(i + 1) % poly.length];
+    const da = inside(a);
+    const db = inside(b);
+    if (da >= 0) out.push(a);
+    if (da >= 0 !== db >= 0) {
+      const t = da / (da - db);
+      out.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]);
+    }
+  }
+  return out;
+}
