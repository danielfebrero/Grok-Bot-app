+function worldMap(slide, box) {
+  CONTINENTS.forEach(function (flat) {
+    const pts = [];
+    for (let i = 0; i < flat.length; i += 2) {
+      pts.push({ x: flat[i] * box.w, y: flat[i + 1] * box.h, moveTo: i === 0 });
+    }
+    pts.push({ close: true });
+    slide.addShape('custGeom', { x: box.x, y: box.y, w: box.w, h: box.h,
+      points: pts, fill: { color: C.map }, line: NOLINE });
+  });
+
+  MAP_ARCS.forEach(function (a) {
+    slide.addShape('arc', { x: a.x, y: a.y, w: a.w, h: a.h, angleRange: a.a,
+      line: { color: C.lilac, width: 0.75 }, fill: NOFILL });
+  });
