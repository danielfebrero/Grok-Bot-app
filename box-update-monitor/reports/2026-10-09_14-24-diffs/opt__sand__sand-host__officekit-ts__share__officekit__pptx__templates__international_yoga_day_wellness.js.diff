+/** Add a freeform built from one of the normalised paths above. */
+function freeform(slide, spec, o) {
+  slide.addShape('custGeom', Object.assign({ fill: NOFILL, line: NOLINE }, o,
+    { points: pathPoints(spec, o.w, o.h) }));
+}
