+/** Piecewise-linear lookup into COVER_STOPS at radius fraction `f`. */
+function coverColor(f) {
+  let i = 1;
+  while (i < COVER_STOPS.length - 1 && COVER_STOPS[i][0] < f) i++;
+  const [p0, c0] = COVER_STOPS[i - 1], [p1, c1] = COVER_STOPS[i];
+  const t = p1 === p0 ? 0 : (f - p0) / (p1 - p0);
