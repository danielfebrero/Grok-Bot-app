+    const a = parseInt(c0.substr(ch * 2, 2), 16), b = parseInt(c1.substr(ch * 2, 2), 16);
+    out += Math.round(a + (b - a) * t).toString(16).padStart(2, '0');
+  }
+  return out.toUpperCase();
