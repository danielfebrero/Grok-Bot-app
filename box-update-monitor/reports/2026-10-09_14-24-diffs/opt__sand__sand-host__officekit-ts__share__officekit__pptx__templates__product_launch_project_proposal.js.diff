+/**
+ * Wi-fi / signal mark: a dot plus two concentric arcs.  All three pieces share
+ * the same centre, so rotating each one about itself rotates the whole mark.
+ */
+function signalIcon(slide, x, y, w, h, color, rotate) {
+  const rad = (rotate * Math.PI) / 180;
+  // Dot sits 35.3% of the height below the frame centre before rotation.
+  const off = 0.353 * h;
+  const cx = x + w / 2 - off * Math.sin(rad);
+  const cy = y + h / 2 + off * Math.cos(rad);
+  const at = (radius, extra) => Object.assign({
+    x: cx - radius, y: cy - radius, w: radius * 2, h: radius * 2,
+    rotate, fill: { color }, line: { type: 'none' },
+  }, extra);
+  slide.addShape('blockArc', at(0.853 * h, { angleRange: [218, 322], arcThicknessRatio: 0.207 }));
+  slide.addShape('blockArc', at(0.500 * h, { angleRange: [214, 326], arcThicknessRatio: 0.353 }));
+  slide.addShape('ellipse', at(0.147 * h, {}));
+}
