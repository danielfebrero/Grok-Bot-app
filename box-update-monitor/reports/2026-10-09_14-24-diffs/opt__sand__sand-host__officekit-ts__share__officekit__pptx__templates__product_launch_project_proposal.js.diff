+
+/** Diagonal "open in new tab" arrow used in the nav bar (rotate 315 = up-right). */
+function arrowGlyph(slide, x, y, size, color, rotate) {
+  // custGeom points are relative to the shape's own box.
+  const p = (fx, fy) => ({ x: fx * size, y: fy * size });
+  slide.addShape('custGeom', {
+    x, y, w: size, h: size, rotate,
+    fill: { color }, line: { type: 'none' },
+    points: [
+      p(0.7625, 0.5625), p(0, 0.5625), p(0, 0.4375), p(0.7625, 0.4375),
+      p(0.4125, 0.0875), p(0.5, 0), p(1, 0.5), p(0.5, 1), p(0.4125, 0.9125),
+      { close: true },
+    ],
+  });
