+ */
+function topRoundedCard(slide, x, y, w, h, color, r) {
+  card(slide, x, y, w, h, color, r);
+  slide.addShape('rect', { x, y: y + r, w, h: h - r, fill: { color }, line: { type: 'none' } });
+}
+
+/** Fully rounded "pill". */
