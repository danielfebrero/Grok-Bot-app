+/** Filled rectangle (the deck is built almost entirely out of these). */
+function rect(slide, x, y, w, h, color, opts) {
+    slide.addShape('rect', Object.assign({ x, y, w, h, fill: { color }, line: { type: 'none' } }, opts));
+}
+
+/** Dark bezel + light screen: stand-in for the device mock-up photographs. */
+function deviceFrame(slide, x, y, w, h, bezel, radius) {
+    slide.addShape('roundRect', {
+        x, y, w, h, fill: { color: C.deviceInk }, line: { type: 'none' }, rectRadius: radius
+    });
+    slide.addShape('rect', {
+        x: x + bezel, y: y + bezel, w: w - 2 * bezel, h: h - 2 * bezel,
+        fill: { color: C.white }, line: { type: 'none' }
+    });
+}
+
+/** Grey stand-in for a raster image / picture placeholder. */
+function imageBox(slide, x, y, w, h, color) {
+    slide.addText('[image]', {
+        x, y, w, h,
+        fill: { color: color || C.image },
+        align: 'center', valign: 'middle',
+        fontFace: FONT.body, fontSize: 11, color: C.imageInk
+    });
+}
+
+/** Any text run; `str` may be a string, "a\nb", or an array of rich runs. */
+function text(slide, str, o) {
+    slide.addText(str, Object.assign({ fontFace: FONT.body, fontSize: 12, color: C.body, margin: 0, valign: 'top' }, o));
+}
+
+/** Big Montserrat headline (wrap disabled, exactly like the source deck). */
+function title(slide, x, y, w, h, str, o) {
+    text(slide, str, Object.assign({ x, y, w, h, fontFace: FONT.head, fontSize: 28, color: C.blue, wrap: false }, o));
+}
