+/** Small bold sub-heading such as "Description" / "Image 01". */
+function label(slide, x, y, w, h, str, o) {
+    text(slide, str, Object.assign({ x, y, w, h, fontSize: 14, bold: true, color: C.sub, lineSpacingMultiple: 1.5, wrap: false }, o));
+}
+
+/** Justified paragraph at 150 % leading — the deck's standard body block. */
