+/** Male / female pictogram used by the social-stats slide. */
+function personIcon(slide, x, y, w, h, color, female) {
+    const blob = function (bx, by, bw, bh, radius) {
+        slide.addShape('roundRect', {
+            x: bx, y: by, w: bw, h: bh, fill: { color }, line: { type: 'none' }, rectRadius: radius
+        });
+    };
+    const head = w * 0.42;
+    const bodyTop = y + head * 1.18;
+    const bodyH = h * 0.40;
+    const legTop = bodyTop + bodyH;
+    slide.addShape('ellipse', { x: x + (w - head) / 2, y, w: head, h: head, fill: { color }, line: { type: 'none' } });
+    blob(x + w * 0.26, bodyTop, w * 0.48, bodyH, 0.09); // torso
+    blob(x + w * 0.08, bodyTop, w * 0.15, bodyH * 0.9, 0.08); // left arm
+    blob(x + w * 0.77, bodyTop, w * 0.15, bodyH * 0.9, 0.08); // right arm
+    if (female) {
+        slide.addShape('triangle', { x, y: bodyTop, w, h: bodyH * 1.12, fill: { color }, line: { type: 'none' } });
+        blob(x + w * 0.33, legTop + bodyH * 0.14, w * 0.13, h - (legTop - y) - bodyH * 0.14, 0.06);
+        blob(x + w * 0.54, legTop + bodyH * 0.14, w * 0.13, h - (legTop - y) - bodyH * 0.14, 0.06);
+    } else {
+        blob(x + w * 0.28, legTop, w * 0.19, h - (legTop - y), 0.06);
+        blob(x + w * 0.53, legTop, w * 0.19, h - (legTop - y), 0.06);
+    }
+}
