+/**
+ * Draws a coarse pixel silhouette of a '#'/'.' grid.  Horizontal runs of '#'
+ * are merged into one rectangle and identical runs on consecutive rows are
+ * stacked into a single taller rectangle, which keeps the shape count (and
+ * the hairline seams between abutting fills) down.  Used for the two vector
+ * maps of the infographic slides.
+ */
+function silhouette(slide, grid, x0, y0, cell, color) {
+    const used = grid.map(function (row) { return new Array(row.length).fill(false); });
+    grid.forEach(function (row, r) {
+        let c = 0;
+        while (c < row.length) {
+            if (row[c] !== '#' || used[r][c]) { c++; continue; }
+            let end = c;
+            while (row[end + 1] === '#' && !used[r][end + 1]) end++;
+            const span = row.slice(c, end + 1);
+            let last = r;
+            while (grid[last + 1] && grid[last + 1].slice(c, end + 1) === span &&
+                   grid[last + 1][c - 1] !== '#' && grid[last + 1][end + 1] !== '#') last++;
+            for (let k = r; k <= last; k++) for (let i = c; i <= end; i++) used[k][i] = true;
+            slide.addShape('rect', {
+                x: x0 + c * cell, y: y0 + r * cell,
+                w: span.length * cell, h: (last - r + 1) * cell + cell * 0.08,
+                fill: { color }, line: { type: 'none' }
+            });
+            c = end + 1;
+        }
+    });
+}
+
+/** Map pin: round head + downward triangle + white centre dot. */
+function pin(slide, x, y, w, h, color) {
+    slide.addShape('ellipse', { x, y, w, h: w, fill: { color }, line: { type: 'none' } });
+    slide.addShape('triangle', {
+        x: x + w * 0.17, y: y + w * 0.6, w: w * 0.66, h: h - w * 0.6,
+        fill: { color }, line: { type: 'none' }, flipV: true
+    });
+    const d = w * 0.36;
+    slide.addShape('ellipse', {
+        x: x + (w - d) / 2, y: y + (w - d) / 2, w: d, h: d,
+        fill: { color: C.white }, line: { type: 'none' }
+    });
+}
