+/* -------------------------------------------------- primitive shape helpers */
+// Every helper takes (slide, x, y, w, h, ...) in inches.
+// Option keys: rot (deg), fh/fv (flip), lc/lw (line colour / width in pt).
+function xf(o) {
+  const r = {};
+  if (o.rot) r.rotate = o.rot;
+  if (o.fh) r.flipH = true;
+  if (o.fv) r.flipV = true;
+  return r;
