+const R   = (s, x, y, w, h, c, o) => shape(s, 'rect', x, y, w, h, c, o);
+const O   = (s, x, y, w, h, c, o) => shape(s, 'ellipse', x, y, w, h, c, o);
+const TRI = (s, x, y, w, h, c, o) => shape(s, 'triangle', x, y, w, h, c, o);
+const RT  = (s, x, y, w, h, c, o) => shape(s, 'rtTriangle', x, y, w, h, c, o);
+const BRK = (s, x, y, w, h, c, o) => shape(s, 'leftBracket', x, y, w, h, c, o);
