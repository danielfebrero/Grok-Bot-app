+/* ------------------------------------------------------------ text placement
+ * T(slide, text, x, y, w, h, opts) where text is a string or an array of runs.
+ * Run/opt keys: f font, sz size(pt), b bold, i italic, c colour, sp charSpacing,
+ * al align (l|c|r|j), ls line-spacing multiple, br break after, v valign, nw nowrap. */
+const ALIGN = { l: 'left', c: 'center', r: 'right', j: 'justify' };
+const VALIGN = { m: 'middle', b: 'bottom' };
+function runOpts(o) {
+  const r = {};
+  if (o.f) r.fontFace = o.f;
+  if (o.sz) r.fontSize = o.sz;
+  if (o.b) r.bold = true;
+  if (o.i) r.italic = true;
+  if (o.c) r.color = o.c;
+  if (o.sp) r.charSpacing = o.sp;
+  if (o.al) r.align = ALIGN[o.al];
+  if (o.ls) r.lineSpacingMultiple = o.ls;
+  if (o.br) r.breakLine = true;
+  return r;
+}
+function T(s, txt, x, y, w, h, o) {
+  o = o || {};
+  const base = Object.assign(runOpts(o), box(x, y, w, h, o), {
+    valign: VALIGN[o.v] || 'top', wrap: !o.nw,
+    fontFace: o.f || LATO, fontSize: o.sz || 18, color: o.c || GREY,
+  });
+  if (!o.al) base.align = 'left';
+  const body = Array.isArray(txt)
+    ? txt.map(r => ({ text: r.t, options: runOpts(r) }))
+    : txt;
+  s.addText(body, base);
+}
