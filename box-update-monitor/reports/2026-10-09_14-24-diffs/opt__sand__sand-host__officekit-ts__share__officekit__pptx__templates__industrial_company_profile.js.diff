+function box(x, y, w, h, o) { return Object.assign({ x, y, w, h }, xf(o || {})); }
+function paint(c, o) {
+  const r = {};
+  r.fill = c ? { color: c } : { type: 'none' };
+  if (c && o && o.a) r.fill.transparency = o.a;
+  r.line = (o && o.lc) ? { color: o.lc, width: o.lw || 1 } : { type: 'none' };
+  return r;
+}
+function shape(s, kind, x, y, w, h, c, o) {
+  o = o || {};
+  s.addShape(kind, Object.assign(box(x, y, w, h, o), paint(c, o)));
