+/*
+ * Cinezone - Filmaker & Movie Studio Presentation (35 slides, 13.333 x 7.5 in)
+ * Rebuilt with pptxgenjs. Raster photos in the source deck are re-created here
+ * as light "[image]" placeholder shapes that keep the original geometry.
+ */
+'use strict';
+
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ------------------------------------------------------------------ theme */
+
+const C = {
+  bg: '282828',        // deck background
+  teal: '37BD9F',      // primary accent
+  tealDk: '018274',    // secondary accent
+  white: 'FFFFFF',
+  soft: 'F2F2F2',      // bg1 lumMod 95%
+  dim: 'D9D9D9',       // bg1 lumMod 85%
+  body: 'BFBFBF',      // bg1 lumMod 75%  (paragraph copy)
+  photo: 'EDEDED',     // image placeholder fill
+  photoTx: '8C8C8C'    // image placeholder caption
+};
+
+const F = {
+  head: 'Plus Jakarta Sans ExtraBold',
+  sub: 'Plus Jakarta Sans SemiBold',
+  med: 'Poppins Medium',
+  semi: 'Poppins SemiBold',
+  body: 'Lato'
+};
+
+const SZ = { eyebrow: 16, title: 32, sub: 18, body: 12, small: 14 };
+
+/* --------------------------------------------------------------- helpers */
+
+// pptxgenjs shape fills use "transparency" (0 = opaque); the deck uses alpha.
+const alpha = (color, pct) => ({ color: color, transparency: 100 - pct });
+const noLine = { type: 'none' };
+
+// Text box that behaves like PowerPoint's default: top anchored, no autofit.
+function text(slide, content, o) {
+  slide.addText(content, Object.assign({ valign: 'top', fontFace: F.body, color: C.body }, o));
+}
+
+// Small teal label that sits above every section title.
+function eyebrow(slide, x, y, str, opts) {
+  text(slide, str, Object.assign({
+    x: x, y: y, w: 2.6, h: 0.37, fontSize: SZ.eyebrow, fontFace: F.med, color: C.teal
+  }, opts));
+}
+
+// Two-tone section title: white part + teal part.
+function title(slide, x, y, w, h, whitePart, tealPart, opts) {
+  const runs = [];
+  if (whitePart) runs.push({ text: whitePart, options: { color: C.white } });
+  if (tealPart) runs.push({ text: tealPart, options: { color: C.teal } });
+  text(slide, runs, Object.assign({
+    x: x, y: y, w: w, h: h, fontSize: SZ.title, fontFace: F.head, lineSpacingMultiple: 1.0
+  }, opts));
+}
+
+// Justified body copy with the deck's 1.5 line spacing.
+function para(slide, x, y, w, h, str, opts) {
+  text(slide, str, Object.assign({
+    x: x, y: y, w: w, h: h, fontSize: SZ.body, fontFace: F.body,
+    color: C.body, align: 'justify', lineSpacingMultiple: 1.5
+  }, opts));
+}
+
+// "———  More Info" call to action.
+function moreInfo(slide, x, y) {
+  slide.addShape('line', { x: x, y: y + 0.168, w: 1.161, h: 0, line: { color: C.teal, width: 1 } });
+  text(slide, 'More Info', {
+    x: x + 1.381, y: y, w: 1.137, h: 0.337, fontSize: SZ.small, fontFace: F.semi, color: C.teal
+  });
+}
+
+/* Rounded-corner outline as custGeom points. r = radius in inches, either a
+ * single number or [topLeft, topRight, bottomRight, bottomLeft]. */
+const KAPPA = 0.5523;
+function roundedPts(w, h, r) {
+  const [tl, tr, br, bl] = Array.isArray(r) ? r : [r, r, r, r];
+  const p = [{ x: tl, y: 0, moveTo: true }, { x: w - tr, y: 0 }];
+  if (tr) p.push({ x: w, y: tr, curve: { type: 'cubic', x1: w - tr * (1 - KAPPA), y1: 0, x2: w, y2: tr * (1 - KAPPA) } });
+  p.push({ x: w, y: h - br });
+  if (br) p.push({ x: w - br, y: h, curve: { type: 'cubic', x1: w, y1: h - br * (1 - KAPPA), x2: w - br * (1 - KAPPA), y2: h } });
+  p.push({ x: bl, y: h });
+  if (bl) p.push({ x: 0, y: h - bl, curve: { type: 'cubic', x1: bl * (1 - KAPPA), y1: h, x2: 0, y2: h - bl * (1 - KAPPA) } });
+  p.push({ x: 0, y: tl });
+  if (tl) p.push({ x: tl, y: 0, curve: { type: 'cubic', x1: 0, y1: tl * (1 - KAPPA), x2: tl * (1 - KAPPA), y2: 0 } });
+  p.push({ close: true });
+  return p;
+}
+
+/* Vertical alpha ramp, used where the deck has a gradient fill. */
+function vGradient(slide, x, y, w, h, r, color, topPct, botPct, bands) {
+  const bh = h / bands;
+  for (let i = 0; i < bands; i++) {
+    const pct = topPct + (botPct - topPct) * i / (bands - 1);
+    const first = i === 0, last = i === bands - 1;
+    slide.addShape('custGeom', {
+      x: x, y: y + i * bh, w: w, h: bh,
+      points: roundedPts(w, bh, [first ? r : 0, first ? r : 0, last ? r : 0, last ? r : 0]),
+      fill: alpha(color, pct), line: noLine
+    });
+  }
+}
+
+/* Photo stand-in: light panel with the original rounded geometry + caption. */
+function photo(slide, x, y, w, h, r, opts) {
+  const o = opts || {};
+  slide.addShape('custGeom', {
+    x: x, y: y, w: w, h: h, points: roundedPts(w, h, r || 0),
+    fill: { color: o.fill || C.photo }, line: noLine, rotate: o.rotate || 0
+  });
+  if (o.label !== false) {
+    text(slide, '[image]', {
+      x: x, y: y + h / 2 - 0.22, w: w, h: 0.44, align: 'center', valign: 'middle',
+      rotate: o.rotate || 0,
+      fontSize: Math.max(10, Math.min(16, Math.min(w, h) * 4.5)),
+      fontFace: F.med, color: o.labelColor || C.photoTx
+    });
+  }
+}
+
+// Box for a shape that is drawn rotated: PowerPoint spins it about the centre,
+// so give the un-rotated box that shares that centre.
+function spun(cx, cy, w, h, deg) {
+  return { x: cx - w / 2, y: cy - h / 2, w: w, h: h, rotate: deg };
+}
+
+/* The source photos are a repeating "insert image here" tile sheet; recreate
+ * that rhythm with a grid of captions across the placeholder panel. */
+function tileLabels(slide, x, y, w, h, cols, rows, size) {
+  const cw = w / cols;
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      text(slide, '[image]', {
+        x: x + c * cw, y: y + h * (r + 0.5) / rows - 0.18, w: cw, h: 0.36,
+        align: 'center', fontSize: size || 11, fontFace: F.med, color: C.photoTx
+      });
+    }
+  }
+}
+
+// Hexagon photo stand-in (slides 7, 8, 10) - flat top, points left/right.
+function photoHex(slide, x, y, w, h) {
+  slide.addShape('hexagon', { x: x, y: y, w: w, h: h, fill: { color: C.photo }, line: noLine });
+  text(slide, '[image]', {
+    x: x, y: y + h / 2 - 0.22, w: w, h: 0.44, align: 'center', valign: 'middle',
+    fontSize: 14, fontFace: F.med, color: C.photoTx
+  });
+}
+
+/* Scale a normalised icon outline (0..1 coordinates) into custGeom points. */
+function iconPts(w, h, data) {
+  return data.map(function (d) {
+    if (d.length === 1) return { close: true };
+    if (d.length === 3) return { x: d[1] * w, y: d[2] * h, moveTo: d[0] === 'M' };
+    return {
+      x: d[5] * w, y: d[6] * h,
+      curve: { type: 'cubic', x1: d[1] * w, y1: d[2] * h, x2: d[3] * w, y2: d[4] * h }
+    };
+  });
+}
+function icon(slide, x, y, w, h, data, color, line) {
+  slide.addShape('custGeom', {
+    x: x, y: y, w: w, h: h, points: iconPts(w, h, data),
+    fill: line ? { type: 'none' } : { color: color },
+    line: line ? { color: color, width: line } : noLine
+  });
+}
