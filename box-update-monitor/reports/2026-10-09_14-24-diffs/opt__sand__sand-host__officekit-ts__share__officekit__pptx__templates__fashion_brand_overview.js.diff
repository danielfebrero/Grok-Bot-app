+                 curve: { type: 'cubic', x1: p[0] * w, y1: p[1] * h,
+                                         x2: p[2] * w, y2: p[3] * h } });
+      return;
+    }
+    out.push({ x: p[0] * w, y: p[1] * h });
+  });
+  s.addShape('custGeom', Object.assign({ x, y, w, h, points: out,
+                                         fill: fill || undefined, line: NOLINE }, o || {}));
+}
