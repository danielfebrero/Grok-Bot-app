+function poly(s, x, y, w, h, pts, fill, o) {
+  const out = [];
+  pts.forEach(p => {
+    if (p === 'Z') { out.push({ close: true }); return; }
+    if (p[0] === 'M') { out.push({ x: p[1] * w, y: p[2] * h, moveTo: true }); return; }
+    if (p.length === 6) {
