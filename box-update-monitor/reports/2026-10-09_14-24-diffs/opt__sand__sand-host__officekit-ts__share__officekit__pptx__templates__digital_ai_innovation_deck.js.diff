+      .join('');
+  const sw = w / steps;
+  for (let i = 0; i < steps; i++) {
+    sh(slide, 'rect', x + i * sw, y, sw + 0.004, h, { fill: { color: mix(c1, c2, (i + 0.5) / steps) } });
+  }
