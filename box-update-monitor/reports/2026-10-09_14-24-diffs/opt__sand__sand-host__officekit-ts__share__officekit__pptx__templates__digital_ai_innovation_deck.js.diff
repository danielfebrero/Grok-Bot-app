+/* ---------------------------------------------------------------- shorthands */
+/* pptxgenjs mutates the shadow object it is handed, so hand it a fresh one each time. */
+const shadow = (opacity, blur, offset, angle, color) => ({ type: 'outer', color: color || '000000', opacity, blur, offset, angle });
+const softShadow = () => shadow(0.12, 19, 15, 135);
+const cardShadow = () => shadow(0.15, 12, 15, 135);
+const deepShadow = () => shadow(0.2, 52, 36, 135);
+const glow = (c) => shadow(0.35, 30, 12, 90, c);
+
+/* Add a shape. `opts` is passed straight through to pptxgenjs. */
+function sh(slide, shape, x, y, w, h, opts) {
+  slide.addShape(shape, Object.assign({ x, y, w, h }, opts));
+}
+
+/* Add a text box. Defaults mirror PowerPoint text boxes: top anchored, no fill. */
+function txt(slide, text, x, y, w, h, opts) {
+  const o = Object.assign(
+    { x, y, w, h, valign: 'top', align: 'left', fontFace: MINOR, fontSize: 18, color: WHITE },
+    opts
+  );
+  slide.addText(text, o);
+}
+
+/* Straight connector. */
+function ln(slide, x, y, w, h, color, width, opts) {
+  sh(slide, 'line', x, y, w, h, Object.assign({ line: Object.assign({ color, width: width || 0.75 }, opts || {}) }));
+}
+
+/* Rounded-rect radius: the source stores it as a % of the shorter side. */
+const radius = (pct, w, h) => (pct / 100) * Math.min(w, h);
+
+/* Placeholder standing in for a bitmap icon from the original deck. */
+function imageBox(slide, x, y, w, h, color) {
+  sh(slide, 'rect', x, y, w, h, { fill: { color: color || INK }, line: { color: color || INK, width: 0.5 } });
+}
