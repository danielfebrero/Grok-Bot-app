+const GREY = '595959'; // black lumMod 65% — secondary text on white
+const GREY2 = '808080'; // black lumMod 50%
+const SILVER = 'BFBFBF'; // white lumMod 75%
+const PALE = 'EDF1F3'; // light track / arc colour
