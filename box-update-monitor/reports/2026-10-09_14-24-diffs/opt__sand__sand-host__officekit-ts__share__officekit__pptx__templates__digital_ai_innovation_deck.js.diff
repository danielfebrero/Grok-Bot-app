+  '                   ##                                              #',
+  '                  ##',
+  '                   #',
+];
+
+function worldMap(slide, x, y, w, h) {
+  const cw = w / 72;
+  const ch = h / WORLD_MAP.length;
+  WORLD_MAP.forEach((row, r) => {
+    for (let c = 0; c < row.length; c++) {
+      if (row[c] !== '#') continue;
+      let run = 1;
+      while (row[c + run] === '#') run++; // merge runs so we emit far fewer shapes
+      sh(slide, 'rect', x + c * cw, y + r * ch, cw * run + 0.004, ch + 0.004, { fill: { color: MAP_GREY } });
+      c += run - 1;
+    }
+  });
+}
