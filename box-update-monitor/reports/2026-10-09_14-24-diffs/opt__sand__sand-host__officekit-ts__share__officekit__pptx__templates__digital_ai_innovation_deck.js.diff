+/* The map is a low-res stencil of the original vector land masses: each '#'
+ * becomes one small rectangle, so the continents read without any bitmap. */
+const WORLD_MAP = [
+  '                ##### #######',
+  '              #################                     #',
+  '                ## ###########      ##                #',
+  '          ## # ###   #########               ##    #####     #',
+  '        ##########    #######               #     #########',
+  ' ##### ###### ######   ######        ####      ###################  #',
+  '#################  ##  ####         ###################################',
+  '################# ###  ###   ##    ###################################',
+  '###############   ##    #          ## ##############################',
+  ' ##   ##########  ####          ## ## ########################   #',
+  '       ###############          ## ###########################   #',
+  '        ###############          ##############################',
+  '        #############            ############################',
+  '        ###########             ##  ########################',
+  '         #########              ####   ###################   #',
+  '          ########              ##### ####################',
+  '          #####  #             ###########################',
+  '            ##                ################ ##########',
+  '             ###              ###############   ### ###',
+  '               ##             #############     ##   ##',
+  '                  ####         #############     #   #    #',
+  '                  ######           ########          # ##',
