+	const hex = v => Math.round(v).toString(16).padStart(2, '0');
+	for (let i = 0; i < bands; i++) {
+		const t = i / (bands - 1);
+		const color = [0, 2, 4].map(n => hex(to(n) + (bo(n) - to(n)) * t)).join('');
