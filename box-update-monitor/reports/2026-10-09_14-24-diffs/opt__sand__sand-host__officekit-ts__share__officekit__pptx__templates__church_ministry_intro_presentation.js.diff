+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/**
+ * Draw a unit-square path table scaled into the box {x, y, w, h}.
+ * custGeom points are expressed relative to the shape's own bounding box.
+ */
+function freeform(slide, pathTable, o) {
+  const sx = v => v * o.w;
+  const sy = v => v * o.h;
+  slide.addShape('custGeom', {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    points: pathTable.map(([cmd, ...c]) => {
+      if (cmd === 'Z') return { close: true };
+      if (cmd === 'M') return { x: sx(c[0]), y: sy(c[1]), moveTo: true };
+      if (cmd === 'L') return { x: sx(c[0]), y: sy(c[1]) };
+      return {
+        x: sx(c[4]), y: sy(c[5]),
+        curve: { type: 'cubic', x1: sx(c[0]), y1: sy(c[1]), x2: sx(c[2]), y2: sy(c[3]) },
+      };
+    }),
+    fill: { color: o.color, ...(o.transparency ? { transparency: o.transparency } : {}) },
+    line: { type: 'none' },
+    rotate: o.rotate || 0, flipH: !!o.flipH, flipV: !!o.flipV,
+  });
+}
+
+/** The oversized background blob (16% opacity) that sits behind everything. */
+function waveBlob(slide, color) {
+  freeform(slide, WAVE_BLOB, { x: 4.132, y: 0, w: 9.201, h: 7.495, color, transparency: WAVE_ALPHA });
+}
