+// Custom paths are stored normalised to the unit square; scale to inches here.
+function scalePath(pts, w, h) {
+  const out = [];
+  let firstDone = false;
+  for (const it of pts) {
+    if (it === 'Z') { out.push({ close: true }); continue; }
+    if (it === 'M') { firstDone = false; continue; }
+    if (it.length === 2) {
+      const p = { x: it[0] * w, y: it[1] * h };
+      if (!firstDone) { p.moveTo = true; firstDone = true; }
