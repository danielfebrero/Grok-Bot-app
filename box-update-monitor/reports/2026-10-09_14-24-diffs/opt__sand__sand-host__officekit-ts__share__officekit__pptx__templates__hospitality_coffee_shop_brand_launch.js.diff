+    if (on(1)) p.push([1 - rx * K, 0, 1, ry * K, 1, ry]);
+    p.push([1, 1 - (on(2) ? ry : 0)]);
+    if (on(2)) p.push([1, 1 - ry * K, 1 - rx * K, 1, 1 - rx, 1]);
