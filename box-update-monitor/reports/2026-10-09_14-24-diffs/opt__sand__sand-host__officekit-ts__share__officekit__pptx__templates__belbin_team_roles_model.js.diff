+    const src = Array.isArray(ln) ? ln : [typeof ln === 'string' ? rgb(ln) : ln];
+    const runs = src.map((r) => ({ text: r.text, options: Object.assign({}, r.options) }));
+    if (bulletOpt) runs.forEach((r) => { r.options.bullet = bulletOpt; });
