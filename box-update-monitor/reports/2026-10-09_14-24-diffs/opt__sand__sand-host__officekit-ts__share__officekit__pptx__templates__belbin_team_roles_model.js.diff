+/** Convert a normalised [[x,y]] / [[x,y,cx1,cy1,cx2,cy2]] outline into points. */
+function poly(pts, x, y, w, h, closed) {
+  const P = pts.map((p, i) => {
+    const o = { x: x + p[0] * w, y: y + p[1] * h };
+    if (i === 0) { o.moveTo = true; return o; }
