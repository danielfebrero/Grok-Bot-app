+ * one rectangle per run of filled cells (slide 23).                            */
+
+const MAP_ROWS = [
+	'...................######...######..................................................',
+	'.................###################................#........#......................',
+	'...............#.##################.......###................###....................',
+	'...........#.#...####..############........#...................#....................',
+	'............###.#####.....#########.................##......######.....##...........',
+	'..........############....#########.................#.....###########...#...........',
+	'..###.....#.###..######....#######..........###.....#..#####################........',
+	'.###################.###...######..........######..###############################..',
+	'####################..###..####...##......##########################################',
+	'.#################.#..##...###.....#.....########################################...',
+	'##################...##.....##...........#######################################....',
+	'..##...###########...####.............#..###############################....#.......',
+	'........############.#####...........##..###############################...##.......',
+	'.........#################...........####################################...........',
+	'..........##############..#............##################################...........',
+	'..........###############..............################################.............',
+	'..........#############..............###..############################..#...........',
+	'..........############...............###....#######.#################..#............',
+	'...........###########................####.....####################..###............',
+	'............#########................###############################................',
+	'.............####...#...............###############################.................',
+	'..............###..................##################..############.................',
+	'...............####...#............##################...###..###....................',
+	'.................###...............################.....##....###..#................',
+	'...................#..###...........###############......#....###...................',
+	'.....................#####...........##############...........#.....#...............',
+	'.....................#######..............########............#..##.................',
+	'....................#########.............#######.............##.###..##............',
+	'....................###########...........#######..............##......###..........',
+	'.....................##########...........#######........................#..........',
+	'.....................##########...........#######.#..................##.#...........',
+	'.......................#######............######.##................#######..........',
+	'.......................#######.............#####.##...............########..........',
+	'.......................#####...............####..................##########.........',
+	'......................######...............####...................#########.........',
+	'......................#####.................##....................##..#####.........',
+	'......................####..............................................##......#...',
+	'......................###................................................#......#...',
+	'......................##......................................................##....',
+	'......................##............................................................',
+	'......................#.............................................................',
+	'......................##............................................................',
+];
+
+function worldMap(slide, x, y, w, h, color) {
+	const cw = w / MAP_ROWS[0].length;
+	const ch = h / MAP_ROWS.length;
+	MAP_ROWS.forEach((row, r) => {
+		let run = 0;
+		for (let c = 0; c <= row.length; c++) {
+			if (row[c] === '#') { run++; continue; }
+			if (run) {
+				shape(slide, 'rect', {
+					x: x + (c - run) * cw, y: y + r * ch, w: run * cw + cw * 0.06, h: ch * 1.06,
+					fill: { color }, line: { type: 'none' },
+				});
+				run = 0;
+			}
+		}
+	});
+}
