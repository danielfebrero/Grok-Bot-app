+function phoneMockup(slide, x, y, w, h) {
+	shape(slide, 'roundRect', Object.assign(
+		{ x, y, w, h, fill: { color: '1A1A1C' }, shadow: shadow() }, adj(9000, w, h)));
+	shape(slide, 'roundRect', Object.assign(
+		{ x: x + 0.07, y: y + 0.07, w: w - 0.14, h: h - 0.14, fill: { color: SCREEN } }, adj(8000, w, h)));
+	shape(slide, 'roundRect', Object.assign(
+		{ x: x + w / 2 - 0.42, y: y + 0.07, w: 0.84, h: 0.2, fill: { color: '1A1A1C' } }, adj(30000, 0.84, 0.2)));
+	text(slide, '[image]', { x, y: y + h / 2 - 0.2, w, h: 0.4, align: 'center', valign: 'middle', fontSize: 12, color: '6E6E70' });
+}
+
+function desktopMockup(slide, x, y, w, h) {
+	const bezel = h * 0.62;
+	shape(slide, 'roundRect', Object.assign(
+		{ x, y, w, h: bezel, fill: { color: '111113' }, shadow: shadow() }, adj(4000, w, bezel)));
+	shape(slide, 'rect', { x: x + 0.09, y: y + 0.09, w: w - 0.18, h: bezel - 0.42, fill: { color: SCREEN } });
+	shape(slide, 'rect', { x: x + 0.09, y: y + bezel - 0.3, w: w - 0.18, h: 0.28, fill: { color: 'BFC1C4' } });
+	shape(slide, 'trapezoid', Object.assign(
+		{ x: x + w / 2 - 0.45, y: y + bezel, w: 0.9, h: h * 0.26, fill: { color: 'B4B6B9' }, rotate: 180 },
+		adj2(30000, 0)));
+	shape(slide, 'ellipse', { x: x + w / 2 - 0.85, y: y + h - 0.28, w: 1.7, h: 0.24, fill: { color: 'C9CBCE' } });
+	text(slide, '[image]', { x, y: y + bezel / 2 - 0.2, w, h: 0.4, align: 'center', valign: 'middle', fontSize: 12, color: '6E6E70' });
+}
+
+function laptopMockup(slide, x, y, w, h) {
+	const lid = h * 0.86;
