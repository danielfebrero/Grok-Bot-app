+ i < flat.length;
+ i += 2) {
+ xs.push(flat[i]);
+ ys.push(flat[i + 1]);
+ }
+
+  const x0 = Math.min(...xs), y0 = Math.min(...ys);
+
+  const w = Math.max(...xs) - x0, h = Math.max(...ys) - y0;
+
+  if (w <= 0 || h <= 0) return;
+
+  const pts = xs.map((vx, i) => ({
+ x: vx - x0, y: ys[i] - y0 }
+));
+
+  pts.push({
+ close: true }
+);
