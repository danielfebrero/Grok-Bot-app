+    slide.addShape(S.star5, {
+      x: x + i * 0.1728, y: y + i * 0.0027, w: 0.146, h: 0.139,
+      fill: { color: i < 4 ? C.sand : C.track }, line: { type: 'none' }
+    });
+  }
+}
