+/**
+ * The cover and closing slides use a corner-focused radial gradient.
+ * pptxgenjs backgrounds are a flat colour only, so paint the ramp as a stack of
+ * nested ellipses centred on the bright corner (fx, fy) - largest (darkest)
+ * first, each one slightly smaller and brighter.
+ */
+const GLOW_REACH = 1.2; // outermost ring, as a fraction of the slide diagonal
+const GLOW_SQUASH = 0.8; // <1 stretches the rings vertically
+const GLOW_GAMMA = 0.8; // ramp shaping: <1 keeps the bright core tight
+
+function cornerGlow (slide, fx, fy, dark, bright, steps) {
+  for (let i = 0; i < steps; i++) {
+    const f = GLOW_REACH * (1 - i / (steps - 1));
+    const rx = SLIDE_W * f;
+    const ry = SLIDE_H * f / GLOW_SQUASH;
+    slide.addShape('ellipse', {
+      x: fx - rx, y: fy - ry, w: rx * 2, h: ry * 2,
+      fill: { color: mix(dark, bright, Math.pow(1 - f / GLOW_REACH, GLOW_GAMMA)) }
+    });
+  }
+}
