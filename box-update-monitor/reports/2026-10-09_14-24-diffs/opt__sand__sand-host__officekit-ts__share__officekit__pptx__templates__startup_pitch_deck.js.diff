+const lerp = (a, b, t) => Math.round(a + (b - a) * t);
+function mix (c1, c2, t) {
+  const p = (c, i) => parseInt(c.substr(i * 2, 2), 16);
+  const h = n => n.toString(16).toUpperCase().padStart(2, '0');
+  return h(lerp(p(c1, 0), p(c2, 0), t)) + h(lerp(p(c1, 1), p(c2, 1), t)) + h(lerp(p(c1, 2), p(c2, 2), t));
