+function roundedRectPoints(w, h, [tl, tr, br, bl]) {
+  const p = [{ x: tl, y: 0, moveTo: true }, { x: w - tr, y: 0 }];
+  if (tr) p.push({ x: w, y: tr, curve: { type: 'cubic', x1: w - tr * KAPPA, y1: 0, x2: w, y2: tr * KAPPA } });
+  p.push({ x: w, y: h - br });
+  if (br) p.push({ x: w - br, y: h, curve: { type: 'cubic', x1: w, y1: h - br * KAPPA, x2: w - br * KAPPA, y2: h } });
+  p.push({ x: bl, y: h });
+  if (bl) p.push({ x: 0, y: h - bl, curve: { type: 'cubic', x1: bl * KAPPA, y1: h, x2: 0, y2: h - bl * KAPPA } });
+  p.push({ x: 0, y: tl });
+  if (tl) p.push({ x: tl, y: 0, curve: { type: 'cubic', x1: 0, y1: tl * KAPPA, x2: tl * KAPPA, y2: 0 } });
+  p.push({ close: true });
+  return p;
