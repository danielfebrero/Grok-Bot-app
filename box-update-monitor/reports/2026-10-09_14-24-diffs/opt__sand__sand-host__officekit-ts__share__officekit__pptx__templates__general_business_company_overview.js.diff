+  slide.addText(runs, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: o.font, fontSize: o.size, color: o.color,
+    align: o.align || 'left', valign: 'top', margin: INSET,
+    bold: !!o.bold, italic: !!o.italic,
