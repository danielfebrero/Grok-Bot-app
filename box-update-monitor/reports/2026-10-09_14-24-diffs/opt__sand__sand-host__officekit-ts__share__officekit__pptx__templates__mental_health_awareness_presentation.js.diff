+// ---------------------------------------------------------------------------
+// Geometry helpers
+// ---------------------------------------------------------------------------
+
+/** OOXML roundRect `adj` (1/100000 of the short side) -> pptxgenjs rectRadius in inches. */
+function radius(adj, w, h) {
+  return (adj / 100000) * Math.min(w, h);
+}
+
+/** Expand a normalised path table into pptxgenjs custGeom points, scaled to w x h inches. */
+function iconPoints(pathData, w, h) {
+  const pts = [];
+  for (let i = 0; i < pathData.length; ) {
+    const cmd = pathData[i++];
+    if (cmd === 'Z') {
+      pts.push({ close: true });
+    } else if (cmd === 'M') {
+      pts.push({ x: pathData[i++] * w, y: pathData[i++] * h, moveTo: true });
+    } else if (cmd === 'L') {
+      pts.push({ x: pathData[i++] * w, y: pathData[i++] * h });
+    } else {
+      const x1 = pathData[i++] * w;
+      const y1 = pathData[i++] * h;
+      const x2 = pathData[i++] * w;
+      const y2 = pathData[i++] * h;
+      pts.push({ x: pathData[i++] * w, y: pathData[i++] * h, curve: { type: 'cubic', x1, y1, x2, y2 } });
+    }
+  }
+  return pts;
+}
+
+/**
+ * Rectangle with square top corners and radius `r` on the two bottom corners.
+ * pptxgenjs' `rectRadius` only writes a single `adj`, which is not enough for the
+ * two-value `round2SameRect` preset, so the outline is spelled out instead.
+ */
+function bottomRoundedRectPoints(w, h, r) {
+  const quarterTurn = (stAng) => ({ x: 0, y: 0, curve: { type: 'arc', hR: r, wR: r, stAng, swAng: 90 } });
+  return [
+    { x: 0, y: 0, moveTo: true },
+    { x: w, y: 0 },
+    { x: w, y: h - r },
+    quarterTurn(0), // sweeps right edge -> bottom edge
+    { x: r, y: h },
+    quarterTurn(90), // sweeps bottom edge -> left edge
+    { close: true },
+  ];
+}
+
+// ---------------------------------------------------------------------------
+// Shape / text helpers
+// ---------------------------------------------------------------------------
+
+/** Rounded rectangle. `adj` is the raw OOXML adjust value from the source deck. */
+function card(slide, pptx, { x, y, w, h, adj, fill, line }) {
+  slide.addShape(pptx.shapes.ROUNDED_RECTANGLE, {
+    x, y, w, h,
+    rectRadius: radius(adj, w, h),
+    fill: fill ? { color: fill } : { type: 'none' },
+    line: line ? { color: line, width: 1 } : { type: 'none' },
+  });
+}
+
+/** Solid-filled vector icon built from one of the path tables above. */
+function icon(slide, pptx, pathData, { x, y, w, h, color, flipH, flipV }) {
+  slide.addShape(pptx.shapes.CUSTOM_GEOMETRY, {
+    x, y, w, h,
+    points: iconPoints(pathData, w, h),
+    fill: { color },
+    line: { type: 'none' },
+    flipH: !!flipH,
+    flipV: !!flipV,
+  });
+}
