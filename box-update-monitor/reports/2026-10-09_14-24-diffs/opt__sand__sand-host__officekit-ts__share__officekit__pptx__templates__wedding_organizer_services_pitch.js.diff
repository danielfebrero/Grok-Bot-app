+			const dx = (x1 - x0) * w;
+			const dy = (y1 - y0) * h;
+			const len = Math.hypot(dx, dy);
+			slide.addShape('rect', {
+				x: x + ((x0 + x1) / 2) * w - len / 2,
+				y: y + ((y0 + y1) / 2) * h - (t * h) / 2,
+				w: len,
+				h: t * h,
+				rotate: (Math.atan2(dy, dx) * 180) / Math.PI,
+				fill: solid(color),
+				line: null,
+			});
+			return;
+		}
+		const box = { x: x + p.x * w, y: y + p.y * h, w: p.w * w, h: p.h * h };
+		if (p.t !== undefined) {
+			slide.addText(p.t, {
+				...box,
+				fontFace: SANS,
+				fontSize: Math.round(p.h * h * 62),
+				bold: true,
+				color,
+				align: 'center',
+				valign: 'middle',
+				margin: 0,
+			});
+			return;
+		}
+		slide.addShape(p.s, {
+			...box,
+			fill: p.o ? null : solid(color),
+			line: p.o ? stroke(color, p.lw || 1.25) : null,
+			...(p.r ? { rotate: p.r } : {}),
+			...(p.v ? { flipV: true } : {}),
+			...(p.rr ? { rectRadius: p.rr * Math.min(w, h) } : {}),
+			...(p.a ? { angleRange: p.a } : {}),
