+/** Linear gradient faked with a handful of solid slices (skill bars). */
+function gradientBar(slide, x, y, w, h, from, to, steps) {
+  const mix = (a, b, t) => [0, 2, 4].map(i => {
+    const v = Math.round(parseInt(a.substr(i, 2), 16) * (1 - t) + parseInt(b.substr(i, 2), 16) * t);
+    return v.toString(16).padStart(2, '0').toUpperCase();
+  }).join('');
+  for (let i = 0; i < steps; i++) {
+    rect(slide, x + (w / steps) * i, y, w / steps + 0.01, h, { color: mix(from, to, i / (steps - 1)) });
+  }
+}
