+/* ------------------------------------------------------------------ *
+ * Colour + geometry helpers
+ * ------------------------------------------------------------------ */
+
+function mix(from, to, t) {
+  const ch = i => {
+    const a = parseInt(from.substr(i, 2), 16);
+    const b = parseInt(to.substr(i, 2), 16);
+    return Math.round(a + (b - a) * t).toString(16).padStart(2, '0').toUpperCase();
+  };
+  return ch(0) + ch(2) + ch(4);
+}
+
+/** Clip a convex polygon against the half-plane  nx*x + ny*y <= d. */
+function clipHalfPlane(poly, nx, ny, d) {
+  const out = [];
+  for (let i = 0; i < poly.length; i++) {
+    const A = poly[i];
+    const B = poly[(i + 1) % poly.length];
+    const da = nx * A[0] + ny * A[1] - d;
+    const db = nx * B[0] + ny * B[1] - d;
+    if (da <= 0) out.push(A);
+    if ((da < 0 && db > 0) || (da > 0 && db < 0)) {
+      const t = da / (da - db);
+      out.push([A[0] + (B[0] - A[0]) * t, A[1] + (B[1] - A[1]) * t]);
+    }
+  }
+  return out;
+}
+
+/**
+ * Linear gradient fill, painted as a fan of slightly overlapping custGeom
+ * bands (pptxgenjs has no gradient fill API).  Fills the rectangle x/y/w/h,
+ * or - when `polys` is given - that list of convex polygons instead.
+ */
+function gradient(slide, o) {
+  const from = o.from || BLUE;
+  const to = o.to || CYAN;
+  const steps = o.steps || Math.max(12, Math.round(Math.max(o.w, o.h) * 9));
+  const rad = ((o.angle === undefined ? GRAD_ANGLE : o.angle) * Math.PI) / 180;
+  const nx = Math.cos(rad);
+  const ny = Math.sin(rad);
+  const shapes = o.polys || [[[o.x, o.y], [o.x + o.w, o.y], [o.x + o.w, o.y + o.h], [o.x, o.y + o.h]]];
+
+  let lo = Infinity;
+  let hi = -Infinity;
+  shapes.forEach(s => s.forEach(p => {
+    const d = nx * p[0] + ny * p[1];
+    if (d < lo) lo = d;
+    if (d > hi) hi = d;
+  }));
+
+  const band = (hi - lo) / steps;
+  const bleed = band * 0.4; // hides hairline seams between adjacent bands
+
+  for (let i = 0; i < steps; i++) {
+    const color = mix(from, to, (i + 0.5) / steps);
+    shapes.forEach(base => {
+      let poly = clipHalfPlane(base, nx, ny, lo + band * (i + 1) + bleed);
+      poly = clipHalfPlane(poly, -nx, -ny, -(lo + band * i - bleed));
+      if (poly.length < 3) return;
+      const xs = poly.map(p => p[0]);
+      const ys = poly.map(p => p[1]);
+      const bx = Math.min.apply(null, xs);
+      const by = Math.min.apply(null, ys);
+      const w = Math.max.apply(null, xs) - bx;
+      const h = Math.max.apply(null, ys) - by;
+      if (w < 0.002 || h < 0.002) return;
+      slide.addShape('custGeom', {
+        x: bx, y: by, w: w, h: h,
+        points: poly
+          .map(p => ({ x: +(p[0] - bx).toFixed(4), y: +(p[1] - by).toFixed(4) }))
+          .concat([{ close: true }]),
+        fill: { color: color },
+      });
+    });
+  }
+}
