+const C = {
+	white: 'FFFFFF',
+	ink: '000000',
+	tx1: '656D78', // body grey  (theme dk1)
+	tx2: '44546A', // heading slate (theme dk2)
+	a1: '26A69A',
+	a2: '009688',
+	a3: '00897B',
+	a4: '00796B',
+	a5: '00695C',
+	a6: '004D40',
+	ringOuter: 'D1D4D5', // donut gauge - outer track
+	ringInner: 'EDEDED', // donut gauge - inner track
+	pill: 'D8DADD',
+	coinRing: 'DFB87B',
+	coinFace: 'FFD697',
+	coinPale: 'E0CFAC',
+};
