+    fill: { color: o.color, transparency: o.transparency },
+    line: null,
+    points: o.pts.map(([px, py], i) => ({
+      x: +(px * o.w).toFixed(4), y: +(py * o.h).toFixed(4), moveTo: i === 0,
+    })).concat([{ close: true }]),
+  });
+}
