+/** draw a pictogram from GLYPH, scaled into a square of side `size` */
+function glyph(slide, name, x, y, size, color, rotate) {
+  const flat = GLYPH[name];
+  const pts = [];
+  let i = 0;
+  GLYPH_RINGS[name].forEach(n => {
+    flat.slice(i, i + n).forEach(([px, py], j) => pts.push({
+      x: +(px * size).toFixed(4), y: +(py * size).toFixed(4), moveTo: j === 0,
+    }));
+    pts.push({ close: true });
+    i += n;
+  });
+  box(slide, 'custGeom', { x, y, w: size, h: size, rotate: rotate || 0, fill: { color }, line: null, points: pts });
+}
