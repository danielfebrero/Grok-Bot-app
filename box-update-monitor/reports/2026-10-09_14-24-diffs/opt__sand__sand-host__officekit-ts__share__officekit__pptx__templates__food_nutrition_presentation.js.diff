+// ---------------------------------------------------------------- drawing helpers
+function rect (s, x, y, w, h, fill, opts) {
+  s.addShape('rect', Object.assign({ x, y, w, h, fill, line: NOLINE }, opts))
+}
+
+function shape (s, kind, x, y, w, h, fill, opts) {
+  s.addShape(kind, Object.assign({ x, y, w, h, fill, line: NOLINE }, opts))
+}
+
+function line (s, x, y, w, h, lineProps, opts) {
+  s.addShape('line', Object.assign({ x, y, w, h, line: lineProps }, opts))
+}
+
+// The deck's two recurring 1.5pt rule motifs: a plain hairline and an arrow.
+function rule (s, x, y, w, h, color, opts) {
+  line(s, x, y, w, h, { color, width: 1.5 }, opts)
+}
+
+function arrow (s, x, y, w, h, color, opts) {
+  line(s, x, y, w, h, { color, width: 1.5, endArrowType: 'triangle' }, opts)
+}
+
+// Draws a multi-contour outline (see the path tables above) scaled into x/y/w/h.
+function poly (s, x, y, w, h, contours, opts) {
+  const points = []
+  contours.forEach(contour => {
+    contour.forEach((pt, i) => points.push({ x: w * pt[0], y: h * pt[1], moveTo: i === 0 }))
+    points.push({ close: true })
+  })
+  s.addShape('custGeom', Object.assign({ x, y, w, h, points, line: NOLINE }, opts))
+}
+
+function text (s, body, x, y, w, h, opts) {
+  s.addText(body, Object.assign({ x, y, w, h, fontFace: SANS, color: SHADE, valign: 'top' }, opts))
+}
+
+// --- adjustable preset geometries -------------------------------------------
+// pptxgenjs cannot pass OOXML `adj` values, so these four are traced as outlines.
+
+// Diagonal band running corner to corner; `adj` is the band width / min(w, h).
+function diagStripe (s, x, y, w, h, fill, adj, opts) {
+  const t = Math.min(w, h) * adj
+  poly(s, x, y, w, h, [[[t / w, 0], [1, 0], [0, 1], [0, (t * h / w) / h]]],
+    Object.assign({ fill }, opts))
+}
+
+// Sheared rectangle leaning right; `adj` is the top offset / min(w, h).
+function parallelogram (s, x, y, w, h, fill, adj, opts) {
+  const d = Math.min(w, h) * adj / w
+  poly(s, x, y, w, h, [[[0, 1], [d, 0], [1, 0], [1 - d, 1]]], Object.assign({ fill }, opts))
+}
+
+// Rectangle with the top-right corner cut off; `adj` is the cut / min(w, h).
+function snipRect (s, x, y, w, h, fill, adj, opts) {
+  const d = Math.min(w, h) * adj
+  poly(s, x, y, w, h, [[[0, 0], [1 - d / w, 0], [1, d / h], [1, 1], [0, 1]]],
+    Object.assign({ fill }, opts))
+}
+
+// Triangle with a movable apex; `adj` is the apex position across the width.
+function triangle (s, x, y, w, h, fill, adj, opts) {
+  poly(s, x, y, w, h, [[[0, 1], [adj, 0], [1, 1]]], Object.assign({ fill }, opts))
+}
