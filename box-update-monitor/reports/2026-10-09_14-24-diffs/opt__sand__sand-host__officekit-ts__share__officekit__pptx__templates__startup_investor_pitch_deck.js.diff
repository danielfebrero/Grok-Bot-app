+const COVER_H = 1.2119;   // height of a 60pt headline box
+const LABEL_H = 0.3366;   // height of an 8pt label box
+const LINE_H = 0.3199;    // height of a single 7pt line
+
+/* ----------------------------------------------------------------- helpers */
+const NOLINE = { type: 'none' };
+
+function rrect(s, x, y, w, h, fill, radius) {
+  s.addShape('roundRect', {
+    x, y, w, h,
+    fill: { color: fill },
+    line: NOLINE,
+    rectRadius: (radius === undefined ? 0.5 : radius) * Math.min(w, h),
+  });
+}
+
+/** Fully rounded "pill". */
+const pill = (s, x, y, w, h, fill) => rrect(s, x, y, w, h, fill, 0.5);
+
+/** Big cream content card; `adj` is the OOXML roundRect adjust value (0-50000). */
+const card = (s, x, y, w, h, adj, fill) =>
+  rrect(s, x, y, w, h, fill || CREAM, (adj === undefined ? 5523 : adj) / 100000);
+
+const ellipse = (s, x, y, w, h, fill) =>
+  s.addShape('ellipse', { x, y, w, h, fill: { color: fill }, line: NOLINE });
+
+const hline = (s, x, y, w, color, width) =>
+  s.addShape('line', { x, y, w, h: 0, line: { color, width: width || 0.75 } });
+
+const glyph = (s, kind, x, y, w, h, opts) =>
+  s.addShape(kind, Object.assign({ x, y, w, h, fill: { color: INK }, line: NOLINE }, opts || {}));
+
+/** Text box. Defaults: 7pt justified body copy, vertically centred. */
+function text(s, str, x, y, w, h, o) {
+  o = o || {};
+  s.addText(str, {
+    x, y, w, h,
+    fontFace: FONT,
+    fontSize: o.size || BODY,
+    color: o.color || INK,
+    align: o.align || 'justify',
+    valign: o.top ? 'top' : 'middle',
+    lineSpacingMultiple: o.ls === undefined ? 1.15 : o.ls,
+    margin: 7.2,
+  });
+}
+
+const title = (s, str, x, y, w) => text(s, str, x, y, w, TITLE_H, { size: H2, align: 'left', ls: 1 });
+const label = (s, str, x, y, w, o) =>
