+/** Scale a unit-square path to inches. */
+function scalePath(points, w, h) {
+  return points.map((p) => {
+    if (p.close) return p;
+    const q = { x: p.x * w, y: p.y * h };
+    if (p.curve) {
+      q.curve = { type: 'cubic', x1: p.curve.x1 * w, y1: p.curve.y1 * h, x2: p.curve.x2 * w, y2: p.curve.y2 * h };
+    }
+    if (p.moveTo) q.moveTo = true;
+    return q;
+  });
+}
+
+/** Turn cubic segments into a polyline over the unit square. */
+function flattenPath(points, perCurve) {
+  const out = [];
+  let cur = { x: 0, y: 0 };
+  points.forEach((p) => {
+    if (p.close) return;
+    if (p.curve) {
+      const { x1, y1, x2, y2 } = p.curve;
+      for (let i = 1; i <= perCurve; i++) {
+        const t = i / perCurve;
+        const u = 1 - t;
+        out.push({
+          x: u * u * u * cur.x + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * p.x,
+          y: u * u * u * cur.y + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * p.y,
+        });
+      }
+    } else {
+      out.push({ x: p.x, y: p.y });
+    }
+    cur = { x: p.x, y: p.y };
+  });
+  return out;
+}
+
+/**
+ * Clip a closed polygon to one half-plane (Sutherland-Hodgman), keeping the
+ * side where `inside` holds and inserting the exact crossing points.
+ */
+function clipHalfPlane(poly, inside, cross) {
+  const out = [];
+  poly.forEach((cur, i) => {
+    const prev = poly[(i + poly.length - 1) % poly.length];
+    const curIn = inside(cur);
+    const prevIn = inside(prev);
+    if (curIn !== prevIn) out.push(cross(prev, cur));
+    if (curIn) out.push(cur);
+  });
+  return out;
+}
