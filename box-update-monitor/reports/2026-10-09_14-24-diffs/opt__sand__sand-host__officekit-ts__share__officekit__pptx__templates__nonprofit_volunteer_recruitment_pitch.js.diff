+/** Clip a unit polygon to the slice of `axis` between t0 and t1. */
+function pathSlice(poly, axis, t0, t1) {
+  const at = (a, b, t) => {
+    const f = (t - axis(a)) / (axis(b) - axis(a));
+    return { x: a.x + (b.x - a.x) * f, y: a.y + (b.y - a.y) * f };
+  };
