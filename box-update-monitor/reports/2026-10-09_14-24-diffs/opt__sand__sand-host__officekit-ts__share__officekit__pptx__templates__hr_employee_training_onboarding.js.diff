+/** Cream line-art pictogram inside a contact tile. */
+function contactIcon(s, kind, x, y, w, h) {
+  const stroke = { color: C.cream, width: 1.25 };
+  const outline = { fill: { type: 'none' }, line: stroke };
+
+  if (kind === 'pin') {
+    s.addShape('teardrop', { x, y, w, h: w, rotate: 135, ...outline });
+    s.addShape('ellipse', { x: x + w * 0.28, y: y + w * 0.22, w: w * 0.44, h: w * 0.44, ...outline });
+  } else if (kind === 'envelope') {
+    s.addShape('rect', { x, y, w, h, ...outline });
+    s.addShape('line', { x, y, w: w / 2, h: h * 0.62, line: stroke });
+    s.addShape('line', { x: x + w / 2, y, w: w / 2, h: h * 0.62, line: stroke, flipH: true });
+  } else if (kind === 'handset') {
+    s.addShape('blockArc', { x: x - w * 0.1, y: y - h * 0.1, w: w * 1.2, h: h * 1.2, rotate: 315, ...outline });
+  } else {
+    s.addShape('ellipse', { x, y, w, h, ...outline });
+    s.addShape('ellipse', { x: x + w * 0.32, y, w: w * 0.36, h, ...outline });
+    [0.28, 0.5, 0.72].forEach(f => s.addShape('line', {
+      x: x + (f === 0.5 ? 0 : w * 0.14), y: y + h * f,
+      w: f === 0.5 ? w : w * 0.72, h: 0, line: stroke,
+    }));
+  }
+}
