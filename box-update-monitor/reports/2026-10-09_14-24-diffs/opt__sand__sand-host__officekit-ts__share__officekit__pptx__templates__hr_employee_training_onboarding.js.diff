+/** Cream pictogram at the top of each pricing card, drawn from primitives. */
+function planIcon(s, { icon, iconX: x, iconY: y, iconW: w, iconH: h }) {
+  const fill = { color: C.cream };
+
+  if (icon === 'gear') {
+    s.addShape('gear6', { x, y, w, h, fill, line: NO_LINE });
+    s.addShape('ellipse', { x: x + w * 0.36, y: y + h * 0.36, w: w * 0.28, h: h * 0.28, fill: { color: C.coral }, line: NO_LINE });
+  } else if (icon === 'crown') {
+    // three peaks over a solid band, plus the separate base bar
+    s.addShape('rect', { x, y: y + h * 0.35, w, h: h * 0.33, fill, line: NO_LINE });
+    s.addShape('triangle', { x, y: y + h * 0.2, w: w * 0.28, h: h * 0.15, fill, line: NO_LINE });
+    s.addShape('triangle', { x: x + w * 0.28, y, w: w * 0.44, h: h * 0.35, fill, line: NO_LINE });
+    s.addShape('triangle', { x: x + w * 0.72, y: y + h * 0.2, w: w * 0.28, h: h * 0.15, fill, line: NO_LINE });
+    s.addShape('rect', { x, y: y + h * 0.78, w, h: h * 0.12, fill, line: NO_LINE });
+  } else {
+    const g = w / 2 - 0.03;
+    [[0, 0], [1, 0], [0, 1], [1, 1]].forEach(([cx, cy]) => s.addShape('roundRect', {
+      x: x + cx * (g + 0.06), y: y + cy * (g + 0.06), w: g, h: g,
+      rectRadius: g / 3, fill, line: NO_LINE,
+    }));
+  }
+}
