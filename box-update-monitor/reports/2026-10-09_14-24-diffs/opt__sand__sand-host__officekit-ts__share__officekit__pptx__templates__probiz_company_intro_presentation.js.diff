+// Draw the flame mark `w` inches wide; height follows the fixed aspect ratio.
+function flame(s, x, y, w) {
+  const h = w * 0.921;
+  for (const [fx, fy, fw, fh, paint, ...art] of FLAME) {
+    const px = x + fx * w, py = y + fy * h, pw = fw * w, ph = fh * h;
+    for (const outline of art) {
+      const poly = toPath(outline, pw, ph).slice(0, -1).map(p => [p.x, p.y]);
+      if (Array.isArray(paint) && typeof paint[1] === 'string') {
+        gradPoly(s, poly, px, py, pw, ph, paint[0], paint[1], 270);
+      } else {
+        const [hex, clear] = Array.isArray(paint) ? paint : [paint, 0];
+        s.addShape('custGeom', {
+          x: px, y: py, w: pw, h: ph, line: { type: 'none' },
+          points: poly.map((p, j) => ({ x: p[0], y: p[1], moveTo: j === 0 })).concat([{ close: true }]),
+          fill: { color: hex, transparency: clear },
+        });
+      }
+    }
+  }
+}
