+  const rad = angle * Math.PI / 180, nx = Math.cos(rad), ny = Math.sin(rad);
+  const proj = poly.map(p => nx * p[0] + ny * p[1]);
+  const lo = Math.min(...proj), hi = Math.max(...proj);
+  const step = (hi - lo) / BANDS, over = step * 0.4;
+  for (let i = 0; i < BANDS; i++) {
+    let band = clipHalf(poly, nx, ny, lo + step * (i + 1) + over);
+    band = clipHalf(band, -nx, -ny, -(lo + step * i - over));
+    if (band.length < 3) continue;
+    let tone = mix(from, to, (i + 0.5) / BANDS);
+    if (o.over) tone = mix(tone, o.over, (o.fade || 0) / 100);
+    s.addShape('custGeom', {
+      x, y, w, h,
+      points: band.map((p, j) => ({ x: p[0], y: p[1], moveTo: j === 0 })).concat([{ close: true }]),
