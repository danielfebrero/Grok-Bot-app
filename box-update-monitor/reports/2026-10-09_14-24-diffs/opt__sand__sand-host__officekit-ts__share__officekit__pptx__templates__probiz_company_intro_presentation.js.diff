+// Turn a flat [x0,y0,x1,y1,...] percentage outline into custGeom path points.
+// Coordinates are relative to the shape's own box, not the slide.
+const toPath = (outline, w, h) => outline
+  .reduce((acc, v, i) => (i % 2 ? acc[acc.length - 1].push(v) : acc.push([v]), acc), [])
+  .map(([px, py], i) => ({ x: (px / 100) * w, y: (py / 100) * h, moveTo: i === 0 }))
+  .concat([{ close: true }]);
+
+// Stamp a glyph from ICONS into the given rectangle, in one flat colour.
+function icon(s, name, x, y, w, h, color) {
+  const pts = [];
+  for (const outline of ICONS[name]) pts.push(...toPath(outline, w, h));
+  s.addShape('custGeom', { x, y, w, h, points: pts,
+                           fill: { color }, line: { type: 'none' } });
+}
