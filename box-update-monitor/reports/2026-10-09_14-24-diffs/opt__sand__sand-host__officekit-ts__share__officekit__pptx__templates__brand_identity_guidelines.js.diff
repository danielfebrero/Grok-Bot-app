+/* --------------------------------------------------------------- primitives */
+
+function text(slide, content, opts) {
+  slide.addText(content, Object.assign({ fontFace: F.body, fontSize: 18, color: C.black, valign: 'top' }, opts));
+}
+
+function box(slide, opts) {
+  const o = Object.assign({}, opts);
+  o.fill = o.fill ? (typeof o.fill === 'string' ? { color: o.fill } : o.fill) : { type: 'none' };
+  if (!o.line) o.line = { type: 'none' };
+  slide.addShape('rect', o);
+}
+
+function rule(slide, opts) {
+  slide.addShape('line', {
+    x: opts.x, y: opts.y, w: opts.w || 0, h: opts.h || 0,
+    line: { color: opts.color || C.accent, width: opts.width || 0.75, transparency: opts.transparency || 0 },
+  });
+}
+
+/* --------------------------------------------------------------- brand marks */
+
+// The brand mark is the lowercase "g" of the display face. Drawn as a glyph
+// (rather than a traced outline) so the geometry stays legible in source.
+// (x, y, w, h) is the box the *inked* glyph should fill; the text box around it
+// is deliberately oversized and the glyph is centred, so nothing ever clips.
+function logoG(slide, x, y, w, h, color) {
+  const pad = h;
+  slide.addText('g', {
+    x: x + w / 2 - pad, y: y + h / 2 - MARK.drop * h - pad, w: 2 * pad, h: 2 * pad,
+    fontFace: F.mark, fontSize: h / MARK.hPerPt, color,
+    align: 'center', valign: 'middle', margin: 0,
+  });
+}
+
+// "g GENESIS" lock-up. `h` is the height of the g; the word sits to its right.
+function wordmark(slide, x, y, h, color) {
+  logoG(slide, x, y, h * MARK.aspect, h, color);
+  text(slide, 'GENESIS', {
+    x: x + h * 0.713, y: y + h * 0.365, w: h * 2.587, h: h * 0.67,
+    fontFace: F.major, fontSize: h * 32.8, bold: true, charSpacing: h * 3.5, color,
+    wrap: false, margin: 0,
+  });
+}
+
+// Stacked variant: mark centred above the word (slides 7 and 19).
+function stackedMark(slide, x, y, w, gh, fontSize, markColor, wordColor) {
+  logoG(slide, x + w / 2 - gh * 0.355, y, gh * MARK.aspect, gh, markColor);
