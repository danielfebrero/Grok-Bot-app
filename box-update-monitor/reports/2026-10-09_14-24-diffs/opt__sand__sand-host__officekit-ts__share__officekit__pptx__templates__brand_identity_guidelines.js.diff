+// The EAN-style strip under the cover address block. Alternating gap/bar run
+// lengths, in thousandths of the strip width (they add up to 1000).
+const BARCODE_RUNS = [
+  0, 13, 8, 8, 12, 9, 27, 5, 16, 17, 10, 12, 14, 7, 13, 22, 16, 11, 12, 6, 37, 5, 24, 12, 15,
+  6, 9, 20, 13, 14, 15, 6, 14, 20, 8, 12, 7, 21, 15, 5, 14, 15, 13, 23, 7, 5, 14, 20, 11, 6,
+  40, 20, 7, 6, 16, 11, 16, 18, 15, 11, 3, 14, 14, 14, 27, 7, 28, 13, 20, 23, 6, 6, 8, 13,
+];
+
+function barcode(slide, x, y, w, h, color) {
+  let cx = x;
+  BARCODE_RUNS.forEach((run, i) => {
+    if (i % 2 === 1 && run > 0) box(slide, { x: cx, y, w: (run * w) / 1000, h, fill: color });
+    cx += (run * w) / 1000;
+  });
