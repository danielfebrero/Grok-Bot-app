+
+/** "Subtitle Here ✦ ————" divider. */
+function subtitleRow(sl, x, y, starX, ruleX, ruleW) {
+  head(sl, 'Subtitle Here', { x, y, w: 3.672, h: 0.37, fontSize: 16 });
+  star(sl, starX, y + 0.077, 0.188, C.A2);
+  hline(sl, ruleX, y + 0.173, ruleW, C.A5);
