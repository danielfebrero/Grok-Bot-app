+  star(sl, x, y + 0.058, 0.188, C.A2);
+  head(sl, label, { x: x + 0.188, y, w: 1.6, h: 0.34, fontSize: size || 14 });
+  if (arrow) {
+    sl.addShape('line', { x: arrow, y: y + 0.158, w: 0.357, h: 0,
+      line: { color: C.A5, width: 0.25, endArrowType: 'triangle' } });
+  }
