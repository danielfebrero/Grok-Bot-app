+/** Free-form polygon: `pts` are [x, y] pairs in inches, relative to x/y. */
+const poly = (s, x, y, w, h, pts, color, rotate) =>
+  s.addShape('custGeom', {
+    x, y, w, h, rotate,
+    fill: { color },
+    points: pts.map(([px, py]) => ({ x: px, y: py })).concat([{ close: true }]),
+  });
+
+/**
+ * Wide hexagon whose points are set by an "adj" ratio. pptxgenjs cannot emit
+ * preset adjust values, so the six corners are written out as an explicit path.
+ */
+const wideHexagon = (s, x, y, w, h, adj, color) => {
+  const x1 = Math.min(w, h) * adj;
+  poly(s, x, y, w, h, [[0, h / 2], [x1, 0], [w - x1, 0], [w, h / 2], [w - x1, h], [x1, h]], color);
+};
+
+/** Rectangle with both corners on one long side snipped off (snip2SameRect). */
+const snippedBanner = (s, x, y, w, h, color, rotate) => {
+  const c = Math.min(w, h) * 0.5;
