+  INK: '000000',
+  WHITE: 'FFFFFF',
+  PEACH: 'E9B384', // accent 2
+  SKY: 'A1CCD1',   // accent 3
+  SAGE: '7C9D96',  // accent 5
+  OLIVE: '726C4B',
+};
