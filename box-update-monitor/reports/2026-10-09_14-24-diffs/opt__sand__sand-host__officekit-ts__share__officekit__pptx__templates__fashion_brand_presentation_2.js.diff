+  LABORE_IPSUM: 'Lorem ipsum dolor sita amet, consectetur adipiscing elit doloranes eiusmod tempor incididunt ut labore. ipsum',
+  NOSTRUD: 'Lorem ipsum dolor sita amet, consectetur adipiscing elit doloranes eiusmod tempor incididunt ut labore dolore magna aliqua Cit enim minim venia nostrud.',
+  PARA: 'Lorem ipsum dolor sita amet, consectetur adipiscing elit doloranes eiusmod tempor incididunt ut labore. ipsum consectetur adipiscing elit doloranes eiusmod tempor incididunt ut labore. ipsum dolor sita amet,',
+  PRICE: 'Lorem ipsum dolor sit amet, adipiscing elit, sed do eiusmod tempor incididunt ut labore et',
+};
+
+// Google Slides text insets, in points: [left, right, bottom, top].
+const INSET = [5.4, 5.4, 2.7, 2.7];
+
+/* ------------------------------------------------------------------ *
+ * Generic drawing helpers                                             *
+ * ------------------------------------------------------------------ */
+
+/** Text box. `o.lead` is a line-spacing multiple, `o.size` a point size. */
+function txt(s, body, o) {
+  const opts = {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: o.font || F.BODY,
+    fontSize: o.size || 12,
+    color: o.color || C.INK,
+    bold: !!o.bold,
+    italic: !!o.italic,
+    align: o.align || 'left',
+    valign: o.valign || 'top',
+    margin: INSET,
+    isTextBox: true,
+    wrap: true,
+  };
+  if (o.lead) opts.lineSpacingMultiple = o.lead;
+  if (o.rotate) opts.rotate = o.rotate;
+  if (o.fill) opts.fill = { color: o.fill };
+  if (o.line) opts.line = { color: o.line, width: o.lineW || 1 };
+  s.addText(body, opts);
+}
+
+/** Solid rectangle. */
+function block(s, x, y, w, h, color) {
+  s.addShape('rect', { x, y, w, h, fill: { color } });
+}
+
+/**
+ * Diagonal two-stop gradient: `from` sits in the top-left corner and `to`
+ * in the bottom-right. Painted as opaque bands because pptxgenjs fills are solid.
+ */
+function gradBlock(s, x, y, w, h, from, to) {
+  const bands = 16;
+  for (let k = bands; k >= 1; k--) {
+    const u = k / bands;            // distance along the diagonal, 0..1
+    const d = 2 * u;
+    const p = d <= 1
+      ? [[0, 0], [d, 0], [0, d]]
+      : [[0, 0], [1, 0], [1, d - 1], [d - 1, 1], [0, 1]];
+    s.addShape('custGeom', {
+      x, y, w, h, fill: { color: mix(from, to, u) },
+      points: p.map(q => ({ x: q[0] * w, y: q[1] * h })).concat([{ close: true }]),
+    });
+  }
+}
+
+/** Linear blend of two hex colours, `t` = 0 gives `a`, 1 gives `b`. */
+function mix(a, b, t) {
+  const ch = (hex, i) => parseInt(hex.substr(i * 2, 2), 16);
+  const v = i => Math.round(ch(a, i) * (1 - t) + ch(b, i) * t).toString(16).padStart(2, '0');
+  return (v(0) + v(1) + v(2)).toUpperCase();
+}
+
+/** Outlined rectangle. */
+function frame(s, x, y, w, h, color, width) {
+  s.addShape('rect', { x, y, w, h, fill: { type: 'none' }, line: { color, width } });
+}
+
+/** Outlined ellipse. */
+function ring(s, x, y, w, h, color, width) {
+  s.addShape('ellipse', { x, y, w, h, fill: { type: 'none' }, line: { color, width } });
+}
+
+/** Straight rule / connector. */
+function rule(s, x, y, w, h, color, width) {
+  s.addShape('line', { x, y, w, h, line: { color, width } });
+}
+
+/* ------------------------------------------------------------------ *
+ * Photo placeholders                                                  *
+ * ------------------------------------------------------------------ */
+
+function photo(s, x, y, w, h, shade) {
+  s.addShape('rect', { x, y, w, h, fill: { color: shade } });
+}
+
+function photoCircle(s, x, y, w, h, shade, line) {
+  const o = { x, y, w, h, fill: { color: shade } };
+  if (line) o.line = { color: line, width: 3 };
+  s.addShape('ellipse', o);
+}
+
+function photoRound(s, x, y, w, h, shade) {
+  s.addShape('roundRect', { x, y, w, h, rectRadius: 0.16, fill: { color: shade } });
+}
+
+/** Right-triangle crop; `corner` names the square corner that survives. */
+function photoTri(s, x, y, w, h, shade, corner) {
+  const c = { tl: [[0, 0], [1, 0], [0, 1]], tr: [[0, 0], [1, 0], [1, 1]],
+              br: [[1, 0], [1, 1], [0, 1]], bl: [[0, 0], [1, 1], [0, 1]] }[corner];
+  s.addShape('custGeom', {
+    x, y, w, h, fill: { color: shade },
+    points: c.map(p => ({ x: p[0] * w, y: p[1] * h })).concat([{ close: true }]),
+  });
+}
+
+/** Square with a thin diagonal band of background cut through it. */
+function photoSplit(s, x, y, w, h, shade) {
+  photoTri(s, x, y, w, h, shade, 'tr');
+  photoTri(s, x, y + h * 0.066, w * 0.934, h * 0.934, shade, 'bl');
+}
+
+/* ------------------------------------------------------------------ *
+ * Decorative motifs                                                   *
+ * ------------------------------------------------------------------ */
+
+/** Concave-sided four-point star ("sparkle"). */
+function sparkle(s, x, y, size, color, rotate) {
+  curvedStar(s, x, y, size, 4, 0.5, color, null, rotate);
+}
+
+/** Same four-point star drawn as an outline only. */
+function quadArc(s, x, y, w, h, color) {
+  curvedStar(s, x, y, Math.max(w, h), 4, 0.5, null, color, 0);
+}
+
+/** Eight thin tapered spikes around a small solid disc. */
+function spark8(s, x, y, size, color, rotate) {
+  spikeStar(s, x, y, size, 8, 0.075, color, rotate);
+  const d = size * 0.3;
+  s.addShape('ellipse', { x: x + (size - d) / 2, y: y + (size - d) / 2, w: d, h: d, fill: { color } });
+}
+
+/** Sunburst: eight bars crossed at the centre, i.e. sixteen rays. */
+function burst(s, x, y, size, color) {
+  bars(s, x, y, size, 8, color);
+}
+
+/** Four bars crossed at the centre, i.e. eight straight spokes. */
+function aster(s, x, y, size, color, rotate) {
+  bars(s, x, y, size, 4, color, rotate);
+}
+
+function bars(s, x, y, size, count, color, rotate) {
+  const t = size * 0.0725;
+  for (let i = 0; i < count; i++) {
+    s.addShape('rect', {
+      x, y: y + (size - t) / 2, w: size, h: t,
+      rotate: (rotate || 0) + (180 * i) / count, fill: { color },
+    });
+  }
+}
+
+/** Star with straight edges: `tips` points, valleys at `inner` x radius. */
+function spikeStar(s, x, y, size, tips, inner, color, rotate) {
+  const r = size / 2, pts = [];
+  for (let i = 0; i < tips * 2; i++) {
+    const a = (Math.PI * i) / tips - Math.PI / 2;
+    const rr = i % 2 === 0 ? r : r * inner;
+    pts.push({ x: r + rr * Math.cos(a), y: r + rr * Math.sin(a) });
+  }
+  pts.push({ close: true });
+  s.addShape('custGeom', { x, y, w: size, h: size, rotate: rotate || 0, fill: { color }, points: pts });
+}
+
+/** Star whose sides bow inwards; `waist` pulls the bezier handles to the centre. */
+function curvedStar(s, x, y, size, tips, waist, fillColor, lineColor, rotate) {
+  const r = size / 2, k = r * waist, pts = [];
+  for (let i = 0; i < tips; i++) {
+    const a = (2 * Math.PI * i) / tips - Math.PI / 2;
+    const b = a + (2 * Math.PI) / tips;
+    if (i === 0) pts.push({ x: r + r * Math.cos(a), y: r + r * Math.sin(a), moveTo: true });
+    pts.push({
+      x: r + r * Math.cos(b), y: r + r * Math.sin(b),
+      curve: { type: 'cubic', x1: r + k * Math.cos(a), y1: r + k * Math.sin(a),
+               x2: r + k * Math.cos(b), y2: r + k * Math.sin(b) },
+    });
+  }
+  pts.push({ close: true });
+  s.addShape('custGeom', {
+    x, y, w: size, h: size, rotate: rotate || 0, points: pts,
+    fill: fillColor ? { color: fillColor } : { type: 'none' },
+    line: lineColor ? { color: lineColor, width: 1.5 } : undefined,
+  });
+}
+
+/** Five concentric thin circles. */
+function rings(s, x, y, size, color) {
+  for (let i = 0; i < 5; i++) {
+    const d = size * (1 - i * 0.2);
+    ring(s, x + (size - d) / 2, y + (size - d) / 2, d, d, color, 1.25);
+  }
+}
+
+/** Three overlapping hand-drawn loops climbing to the right. */
+function coil(s, x, y, w, h, color) {
+  const ew = w * 0.78, eh = h * 0.72;
+  [[0, 0.28], [0.11, 0.14], [0.22, 0]].forEach(p => {
+    ring(s, x + p[0] * w, y + p[1] * h, ew, eh, color, 1.5);
+  });
+}
+
+/* ------------------------------------------------------------------ *
+ * Pictogram helpers                                                   *
+ * ------------------------------------------------------------------ */
+
+/** Black rounded tile used behind the small contact pictograms. */
+function iconTile(s, x, y, w, h) {
+  s.addShape('roundRect', { x, y, w, h, rectRadius: 0.05, fill: { color: C.INK } });
+}
+
+/** Head-and-shoulders silhouette knocked out of a black tile. */
+function iconPerson(s, x, y, w, h) {
+  s.addShape('ellipse', { x: x + w * 0.16, y: y + h * 0.16, w: w * 0.26, h: h * 0.33,
+    fill: { color: C.WHITE } });
+  s.addShape('ellipse', { x: x + w * 0.06, y: y + h * 0.55, w: w * 0.46, h: h * 0.5,
+    fill: { color: C.WHITE } });
+}
+
+/** Contact-card icon: person on the left, text lines on the right. */
+function iconContact(s, x, y, w, h) {
