+/* -------------------------------------------------------------- primitives */
+
+function toPoints(cmds, w, h) {
+  return cmds.map((c) => {
+    if (c[0] === 'Z') return { close: true };
+    if (c[0] === 'M') return { x: c[1] * w, y: c[2] * h, moveTo: true };
+    if (c[0] === 'L') return { x: c[1] * w, y: c[2] * h };
+    return {
+      x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h },
+    };
+  });
+}
+
+function polyPoints(poly, w, h) {
+  const pts = poly.map(([px, py], i) => ({ x: px * w, y: py * h, moveTo: i === 0 }));
+  pts.push({ close: true });
+  return pts;
+}
+
+function freeform(slide, cmds, x, y, w, h, color) {
+  slide.addShape('custGeom', {
+    x, y, w, h, points: toPoints(cmds, w, h),
+    fill: { color }, line: { type: 'none' },
+  });
+}
+
+/** Purple panel whose top-right corner is cut off at 45 degrees. */
+function panel(slide, x, y, w, h, color) {
+  slide.addShape('custGeom', {
+    x, y, w, h,
+    points: [
+      { x: w, y: CUT }, { x: w, y: h }, { x: 0, y: h },
+      { x: 0, y: 0 }, { x: w - CUT, y: 0 }, { close: true },
+    ],
+    fill: { color: color || C.purple }, line: { type: 'none' },
+  });
+}
+
+/** White layout ornament, e.g. decor(slide, 'ringFull', 2.611, 0.97, 4.959, 4.959). */
+function decor(slide, key, x, y, w, h) {
+  freeform(slide, DECOR[key], x, y, w, h, C.white);
+}
+
+/** The blue arrow badge that appears once on nearly every slide. */
+function badge(slide, x, y, size) {
+  freeform(slide, BADGE, x, y, size || 0.319, size || 0.319, C.blue);
+}
+
+function rule(slide, x, y, w, h) {
+  slide.addShape('line', { x, y, w: w || 0, h: h || 0, line: RULE });
+}
+
+function rect(slide, x, y, w, h, color) {
+  slide.addShape('rect', { x, y, w, h, fill: { color }, line: { type: 'none' } });
+}
+
+/** Grey stand-in for one of the deck's photo placeholders. */
+function photo(slide, x, y, w, h, captionPt) {
+  rect(slide, x, y, w, h, C.photo);
+  slide.addText('PLACE YOUR IMAGE', {
+    x, y, w, h, align: 'center', valign: 'middle',
+    fontFace: FONT, fontSize: captionPt || 18, bold: true, color: C.white,
+  });
+}
+
+/* ------------------------------------------------------------------- text */
+
+// margin is [left, right, bottom, top] in points - PowerPoint's textbox defaults.
+// `fit: resize` emits <a:spAutoFit/>, which every text box in the source deck has.
+const TEXT_BASE = {
+  valign: 'top', margin: [7.2, 7.2, 3.6, 3.6], isTextBox: true, fit: 'resize',
+};
+
+/**
+ * paras: array of paragraphs, each an array of runs `[text, color?, extraOpts?]`.
+ * Runs without a colour inherit the box colour.
+ */
+function runsOf(paras) {
+  const out = [];
+  paras.forEach((para, pi) => {
+    para.forEach((run, ri) => {
+      out.push({
+        text: run[0],
+        options: Object.assign({
+          color: run[1],
+          breakLine: ri === para.length - 1 && pi < paras.length - 1,
+        }, run[2]),
+      });
+    });
+  });
+  return out;
+}
+
+/** 60 pt ExtraBold headline; `paras` lets a single word switch to orange. */
+function title(slide, x, y, w, h, paras, color) {
+  slide.addText(runsOf(paras), Object.assign({}, TEXT_BASE, {
+    x, y, w, h, wrap: false,
+    fontFace: FONT_XB, fontSize: TITLE_PT, bold: false, color: color || C.ink,
+  }));
+}
+
+/** 18 pt orange kicker above/below a headline. */
+function lead(slide, x, y, w, h, text, color) {
+  slide.addText(text, Object.assign({}, TEXT_BASE, {
+    x, y, w, h, wrap: false,
+    fontFace: FONT, fontSize: LEAD_PT, bold: false, color: color || C.orange,
+  }));
+}
+
+/** 14 pt paragraph copy; `opts` overrides colour, spacing, alignment, wrap. */
+function body(slide, x, y, w, h, text, opts) {
+  slide.addText(text, Object.assign({}, TEXT_BASE, {
+    x, y, w, h, fontFace: FONT, fontSize: BODY_PT, color: C.ink,
+    lineSpacingMultiple: 1.5,
+  }, opts));
+}
+
+/** Small 14 pt caption ("Travel Guide Presentation", "Timeline Infographic", ...). */
+function caption(slide, x, y, w, text, color) {
+  slide.addText(text, Object.assign({}, TEXT_BASE, {
+    x, y, w, h: 0.337, wrap: false, align: 'left',
+    fontFace: FONT, fontSize: BODY_PT, color: color || C.ink,
+  }));
+}
