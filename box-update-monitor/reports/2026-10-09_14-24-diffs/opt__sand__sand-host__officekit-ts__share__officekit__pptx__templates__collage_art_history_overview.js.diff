+  18: { rect: 0.503, text: 0.555, dy: 0.053 },
+  20: { rect: 0.503, text: 0.606, dy: 0.104 },
+};
+function pill(s, o) {
+  const m = PILL[o.size || 14];
+  s.addShape('roundRect', {
+    x: o.x, y: o.y + m.dy, w: o.w, h: m.rect, rectRadius: m.rect / 2,
