+// Plain heading / display text. The source deck anchors every text box to the top.
+function heading(s, text, o) {
+  s.addText(text, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontSize: o.size || SZ.title, fontFace: o.face || F.head,
+    color: o.color || C.black, align: o.align || 'left', valign: 'top',
+  });
+}
+
+// Running copy: 14 pt Montserrat at 1.5 line spacing.
+function body(s, text, o) {
+  s.addText(text, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontSize: o.size || SZ.body, fontFace: F.body,
+    color: o.color || C.ink, align: o.align || 'left', valign: 'top',
+    lineSpacingMultiple: 1.5,
+  });
+}
+
+// Stand-in for the photographs of the original deck; `frame` overrides the
+// outline colour where the placeholder sits on a coloured panel.
+function photo(s, x, y, w, h, frame) {
+  const c = frame || C.grey25;
+  s.addShape('rect', { x, y, w, h, line: { color: c, width: 0.75 } });
+  s.addText('[image]', {
+    x, y, w, h, align: 'center', valign: 'middle',
+    fontSize: SZ.small, fontFace: F.body, color: c,
+  });
