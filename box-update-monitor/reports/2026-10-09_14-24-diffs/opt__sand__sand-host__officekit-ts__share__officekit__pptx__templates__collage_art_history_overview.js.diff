+// Outlined circle holding a chevron; `dir` is 'down' or 'right'.
+function chevronBadge(s, x, y, d, color, dir) {
+  s.addShape('ellipse', { x, y, w: d, h: d, line: { color, width: 1.5 } });
+  const w = d * 0.54, h = d * 0.333;      // chevron bounding box inside the circle
+  const cx = x + (d - w) / 2, cy = y + d * 0.333;
+  const t = h * 0.19;                      // stroke thickness of the chevron
+  const pts = [
+    { x: w / 2, y: h, moveTo: true }, { x: 0, y: t }, { x: t, y: 0 },
+    { x: w / 2, y: h - t }, { x: w - t, y: 0 }, { x: w, y: t },
+    { x: w / 2, y: h }, { close: true },
+  ];
+  s.addShape('custGeom', {
+    x: dir === 'right' ? cx + (w - h) / 2 : cx,
+    y: dir === 'right' ? cy - (w - h) / 2 : cy,
+    w, h, fill: { color }, points: pts,
+    rotate: dir === 'right' ? 270 : 0,
+  });
+}
