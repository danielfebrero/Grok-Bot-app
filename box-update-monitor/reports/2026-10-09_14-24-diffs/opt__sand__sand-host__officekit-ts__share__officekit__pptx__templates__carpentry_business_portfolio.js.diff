+    if (o.close !== false) pts.push({ close: true });
+    s.addShape('custGeom', {
+        x: o.x, y: o.y, w: o.w, h: o.h, rotate: o.rotate, points: pts,
+        fill: o.fill ? { color: o.fill } : { type: 'none' },
+        line: o.line ? { color: o.line, width: o.lineW || 1 } : { type: 'none' },
