+/** Outline of an OOXML `parallelogram` (adj = 0..100000 of the short side). */
+function paraPoints(w, h, adj) {
+    const k = (adj / 100000) * Math.min(w, h);
+    return [{ x: k, y: 0 }, { x: w, y: 0 }, { x: w - k, y: h }, { x: 0, y: h }, { close: true }];
