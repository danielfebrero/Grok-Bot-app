+/* ------------------------------------------------------- shared strings --- */
+const LOREM = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit';
+const WELCOME = 'Welcome to Stagetalk, your ultimate template for presenting podcasts in style. ';
+const WHETHER = 'Whether you are promoting your own show or pitching a concept, this presentation is ' +
+  'designed to highlight the power of your voice and the impact of your message.';
+const WHETHER_DIVE = 'Whether you are promoting your own show or pitching a concept, this presentation ' +
+  'is designed to highlight the power of your voice and the impact of your message. Dive into the ' +
