+/* ---------------------------------------------------------- primitives --- */
+function mix(a, b, t) {
+  const ch = (h, i) => parseInt(h.substr(i * 2, 2), 16);
+  const v = i => Math.round(ch(a, i) + (ch(b, i) - ch(a, i)) * t).toString(16).padStart(2, '0');
+  return (v(0) + v(1) + v(2)).toUpperCase();
+}
+
+function rect(s, x, y, w, h, fill, opt) {
+  s.addShape('rect', Object.assign({ x, y, w, h, fill: { color: fill }, line: { type: 'none' } }, opt || {}));
+}
+
+/** red gradient B4141C -> EF2525 (dark at top / left) built from thin bands */
+function grad(s, x, y, w, h, opt) {
+  const o = opt || {};
+  const n = o.bands || 16;
+  for (let i = 0; i < n; i++) {
+    const col = mix(RED_DK, RED, i / (n - 1));
+    if (o.horiz) rect(s, x + w * i / n, y, w / n + 0.015, h, col);
+    else rect(s, x, y + h * i / n, w, h / n + 0.015, col);
+  }
+}
+
+/** right-angled triangle; `corner` names the square corner: tl / tr / bl / br */
+function rtri(s, x, y, w, h, color, corner) {
+  const c = { tl: [[0, 0], [1, 0], [0, 1]], tr: [[0, 0], [1, 0], [1, 1]],
+              bl: [[0, 0], [0, 1], [1, 1]], br: [[1, 0], [1, 1], [0, 1]] }[corner];
+  s.addShape('custGeom', { x, y, w, h, fill: { color }, line: { type: 'none' },
+    points: c.map(p => ({ x: p[0] * w, y: p[1] * h })).concat([{ close: true }]) });
+}
+
+/** gradient version of the `bl` wedge, sliced into horizontal trapezoids */
+function wedge(s, x, y, w, h) {
+  const n = 10;
+  for (let i = 0; i < n; i++) {
+    const y0 = h * i / n, y1 = h * (i + 1) / n + 0.004;
+    s.addShape('custGeom', { x, y, w, h, fill: { color: mix(RED_DK, RED, i / (n - 1)) },
+      line: { type: 'none' },
+      points: [{ x: 0, y: y0 }, { x: w * y0 / h, y: y0 }, { x: w * y1 / h, y: y1 }, { x: 0, y: y1 },
+               { close: true }] });
+  }
+}
+
+/** flat stand-in for a raster image, labelled so it reads as a placeholder */
+function ph(s, x, y, w, h, color, opt) {
+  const o = opt || {};
+  s.addShape(o.shape || 'rect', { x, y, w, h, fill: { color }, line: { type: 'none' },
+    rectRadius: o.rectRadius });
+  if (o.label) {
+    s.addText('[image]', { x, y: y + h / 2 - 0.16, w, h: 0.32, align: 'center', valign: 'middle',
+      fontFace: BODY, fontSize: 9, color: o.labelColor || '9AA0A6' });
+  }
+}
+
+/** text box (defaults match the deck's Montserrat 11pt body copy) */
+function tx(s, t, o) {
+  s.addText(t, Object.assign({ fontFace: BODY, fontSize: 11, color: BLACK, valign: 'top' }, o));
+}
+
+/** Anton display headline; the original paints these with a red gradient fill */
+function head(s, t, o) {
+  tx(s, t, Object.assign({ fontFace: HEAD, fontSize: 54, color: RED_SH }, o));
+}
+
+/** justified 11pt paragraph at 150% leading - the deck's standard body block */
+function para(s, t, x, y, w, h, o) {
+  tx(s, t, Object.assign({ x, y, w, h, align: 'justify', lineSpacingMultiple: 1.5 }, o || {}));
+}
+
+/** hairline red outline triangle doodle */
+function tri(s, x, y, w, h, rot) {
+  s.addShape('triangle', { x, y, w, h, rotate: rot, fill: { type: 'none' }, line: { color: RED, width: 1 } });
+}
