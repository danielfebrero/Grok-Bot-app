+/**
+ * STAGETALK — Podcast Presentation.
+ * 30 slides, 13.333in x 7.5in (16:9). Rebuilt with pptxgenjs only.
+ *
+ * The reference template's photo frames are empty picture placeholders, so
+ * they contribute no artwork; the three real raster mockups it does ship
+ * (tablet / laptop / smart-watch) are redrawn from native shapes by the
+ * `*Mock` helpers, and `ph()` is available for any flat image stand-in.
+ */
+'use strict';
