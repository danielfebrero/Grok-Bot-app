+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ------------------------------------------------------------- palette --- */
+const RED = 'EF2525';       // theme accent1
+const RED_DK = 'B4141C';    // theme accent2 - gradient start
+const RED_SH = 'C10E0E';    // accent1 @ lumMod 75% - headline colour
+const NAVY = '030022';      // theme dk2 - dark slide background
+const WHITE = 'FFFFFF';
+const BLACK = '000000';
+const GREY_LT = 'F2F2F2';
+const GREY = 'D9D9D9';
+const GREY_MD = 'D8D9DC';   // theme lt2
+const GREY_TX = '808080';
+const PINK = 'FCD3D3';      // pale play-button disc
+const PINK_MD = 'F57C7C';   // icon tiles on the red panel
+const GOLD = 'FFC000';
+
+const HEAD = 'Anton';       // theme major font
+const BODY = 'Montserrat';  // theme minor font
+
+// pptxgenjs rewrites shadow objects in place, so hand each shape its own copy
+const shadow = () => ({ type: 'outer', color: BLACK, opacity: 0.1, blur: 12, offset: 3, angle: 90 });
+const CHECK = { characterCode: '2713', indent: 13.5 };   // Wingdings tick in the original
