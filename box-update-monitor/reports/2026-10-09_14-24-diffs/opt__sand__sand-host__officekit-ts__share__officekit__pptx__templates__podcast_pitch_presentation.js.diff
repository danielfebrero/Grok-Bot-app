+/* --------------------------------------------------------------- icons --- */
+/** microphone glyph inside a d x d box */
+function micGlyph(s, x, y, d, color) {
+  const part = (fx, fy, fw, fh, shape, r) => s.addShape(shape || 'rect', {
+    x: x + fx * d, y: y + fy * d, w: fw * d, h: fh * d, fill: { color }, line: { type: 'none' },
+    rectRadius: r ? r * d : undefined });
+  part(0.295, 0.03, 0.41, 0.55, 'roundRect', 0.205);                    // capsule
+  s.addShape('blockArc', { x: x + 0.10 * d, y: y + 0.17 * d, w: 0.80 * d, h: 0.72 * d,
+    fill: { color }, line: { type: 'none' }, angleRange: [0, 180], arcThicknessRatio: 0.20 });
+  part(0.455, 0.72, 0.09, 0.16);                                        // stem
+  part(0.29, 0.865, 0.42, 0.085, 'roundRect', 0.04);                    // foot
+}
+
+/** briefcase glyph */
+function bagGlyph(s, x, y, d, color) {
+  s.addShape('roundRect', { x: x + 0.06 * d, y: y + 0.28 * d, w: 0.88 * d, h: 0.52 * d,
+    fill: { type: 'none' }, line: { color, width: 2.2 }, rectRadius: 0.1 * d });
+  s.addShape('roundRect', { x: x + 0.32 * d, y: y + 0.13 * d, w: 0.36 * d, h: 0.2 * d,
+    fill: { type: 'none' }, line: { color, width: 2.2 }, rectRadius: 0.05 * d });
+  s.addShape('rect', { x: x + 0.40 * d, y: y + 0.47 * d, w: 0.20 * d, h: 0.16 * d,
+    fill: { type: 'none' }, line: { color, width: 2 } });
+}
+
+/** audio waveform glyph - five rounded bars */
+function waveGlyph(s, x, y, d, color) {
+  [0.42, 0.72, 1.0, 0.66, 0.36].forEach((f, i) => s.addShape('roundRect', {
+    x: x + (0.10 + i * 0.20) * d, y: y + (0.5 - f / 2) * d, w: 0.07 * d, h: f * d,
+    fill: { color }, line: { type: 'none' }, rectRadius: 0.035 * d }));
+}
+
+/** megaphone glyph */
+function hornGlyph(s, x, y, d, color) {
+  s.addShape('ellipse', { x: x + 0.62 * d, y: y + 0.16 * d, w: 0.28 * d, h: 0.68 * d,
+    fill: { type: 'none' }, line: { color, width: 2.2 } });
+  s.addShape('ellipse', { x: x + 0.06 * d, y: y + 0.33 * d, w: 0.20 * d, h: 0.34 * d,
+    fill: { type: 'none' }, line: { color, width: 2.2 } });
+  rect(s, x + 0.16 * d, y + 0.325 * d, 0.62 * d, 0.03 * d, color);
+  rect(s, x + 0.16 * d, y + 0.645 * d, 0.62 * d, 0.03 * d, color);
+}
+
+/** circular red mic badge with two side dots - the deck's logo mark */
+function micBadge(s, x, y, d, dotColor) {
+  s.addShape('ellipse', { x, y, w: d, h: d, fill: { color: RED }, line: { type: 'none' } });
+  micGlyph(s, x + 0.178 * d, y + 0.185 * d, 0.645 * d, WHITE);
+  [0.104, 0.823].forEach(f => s.addShape('ellipse', { x: x + f * d, y: y + 0.471 * d,
+    w: 0.074 * d, h: 0.074 * d, fill: { color: dotColor || WHITE }, line: { type: 'none' } }));
+}
+
+/** rounded-square badge holding one glyph */
+function iconTile(s, x, y, d, fill, glyph) {
+  s.addShape('roundRect', { x, y, w: d, h: d, fill: { color: fill }, line: { type: 'none' },
+    rectRadius: d * 0.21 });
+  glyph(s, x + 0.19 * d, y + 0.19 * d, 0.62 * d, WHITE);
+}
+
+/** pale disc + red play triangle */
+function playBtn(s, x, y, d, opt) {
+  const o = opt || {};
+  s.addShape('ellipse', { x, y, w: d, h: d, fill: { color: o.disc || PINK }, line: { type: 'none' } });
+  s.addShape('triangle', { x: x + 0.315 * d, y: y + 0.325 * d, w: 0.444 * d, h: 0.382 * d,
+    rotate: 90, fill: { color: o.arrow || RED }, line: { type: 'none' } });
+}
+
+/** five review stars - `lit` of them gold, the rest `rest` */
+function stars(s, x, y, w, h, lit, rest) {
+  for (let i = 0; i < 5; i++) {
+    s.addShape('star5', { x: x + i * 0.369, y, w, h, fill: { color: i < lit ? GOLD : rest },
+      line: { type: 'none' } });
+  }
+}
+
+/** pill progress bar */
+function bar(s, x, y, w, h, frac, opt) {
+  const o = opt || {};
+  const fw = w * frac;
+  s.addShape('roundRect', { x, y, w, h, fill: { color: o.track || GREY_LT }, line: { type: 'none' },
+    rectRadius: h / 2 });
+  if (o.grad) {
+    const n = 12;
+    for (let i = 0; i < n; i++) {
+      rect(s, x + h / 2 + (fw - h) * i / n, y, (fw - h) / n + 0.02, h, mix(RED_DK, RED, i / (n - 1)));
+    }
+    s.addShape('roundRect', { x, y, w: h, h, fill: { color: RED_DK }, line: { type: 'none' }, rectRadius: h / 2 });
+    s.addShape('roundRect', { x: x + fw - h, y, w: h, h, fill: { color: RED }, line: { type: 'none' }, rectRadius: h / 2 });
+  } else {
+    s.addShape('roundRect', { x, y, w: fw, h, fill: { color: o.fill || RED }, line: { type: 'none' },
+      rectRadius: h / 2 });
+  }
+}
+
+/** small "growth" arrow drawn as three strokes */
+function arrowUpRight(s, x, y, d) {
+  s.addShape('custGeom', { x, y, w: d, h: d, fill: { type: 'none' }, line: { color: BLACK, width: 3 },
