+const GLYPH = {
+  pin: '\u2691', house: '\u2302', camera: '\u25C9', food: '\u2617', plane: '\u2708',
+  bus: '\u26D7', coins: '$', trophy: '\u265B', clock: '\u25F4', download: '\u2193',
+  phone: '\u260E', lock: '\u26BF', coin: '$', compass: '\u25CE', wifi: '\u2652',
+  chat: '\u2328', calendar: '\u26C1', movie: '\u2707', briefcase: '\u26C1',
+  rocket: '\u2708', mail: '\u2709', globe: '\u2295', twitter: '\u2712',
+  facebook: 'f', instagram: '\u25A3',
+};
+function icon(s, name, [x, y, w, h], color) {
+  const size = Math.round(Math.min(w, h) * 62);
+  s.addText(GLYPH[name] || '\u25CF', {
+    x: x - 0.1, y, w: w + 0.2, h, align: 'center', valign: 'middle',
