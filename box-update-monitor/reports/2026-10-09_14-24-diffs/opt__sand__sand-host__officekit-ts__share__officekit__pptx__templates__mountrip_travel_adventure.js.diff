+// ------------------------------------------------------- drawing helpers
+// Every helper takes a `[x, y, w, h]` box in inches.
+const at = ([x, y, w, h]) => ({ x, y, w, h });
+
+/** Filled rectangle. */
+function bar(s, box, color) {
+  s.addShape('rect', Object.assign(at(box), { fill: { color } }));
+}
+
+/** Any preset shape with optional fill and extra options. */
+function shape(s, kind, box, fill, opts) {
+  const o = Object.assign({}, opts || {});
+  const f = fill ? { color: fill } : { type: 'none' };
+  if (o.transparency !== undefined) { f.transparency = o.transparency; delete o.transparency; }
+  s.addShape(kind, Object.assign(at(box), { fill: f }, o));
+}
+
+/** Grey stand-in for a photograph. */
+function photo(s, box, opts) {
+  const o = Object.assign({ fill: { color: C.photo } }, opts || {});
+  s.addShape('rect', Object.assign(at(box), o));
+}
+
+/** Brown accent rule (the deck's signature 8pt divider). */
+function rule(s, box, opts) {
+  const o = Object.assign({ width: 8, color: C.brown }, opts || {});
+  s.addShape('line', Object.assign(at(box), { line: { color: o.color, width: o.width } },
+    o.rotate ? { rotate: o.rotate } : {}));
+}
+
+/** Text box: `body` is a string or an array of pptxgenjs text runs. */
+function txt(s, box, base, body, over) {
+  s.addText(body, Object.assign(at(box), base, over || {}, { isTextBox: true, margin: [7.2, 7.2, 3.6, 3.6] }));
+}
+
+/** Multi-line paragraph runs sharing one style. */
+const lines = (...arr) => arr.map((t, i) => ({ text: t, options: i < arr.length - 1 ? { breakLine: true } : {} }));
+
+/** Arrow-bulleted list; the bullet has to ride on every run, not the shape. */
+const BULLET = { characterCode: '25B8', indent: 13.5 };
+const bullets = (...arr) => arr.map((t) => ({ text: t, options: { bullet: BULLET, breakLine: true } }));
+
+/** Stack of three tiny dots — the timeline's leader marks. */
+function dots(s, [x, y, w, h]) {
+  const step = h / 3;
+  for (let i = 0; i < 3; i++) {
+    s.addShape('ellipse', { x, y: y + i * step, w, h: w, fill: { color: C.black } });
+  }
+}
+
+/** Grey lozenge behind a timeline node. */
+function bubble(s, [x, y, w, h]) {
+  s.addShape('roundRect', { x, y, w, h, fill: { color: C.pale }, rectRadius: w / 2 });
+}
+
+/**
+ * Pictogram: a glyph from the symbol font, sized to the box.
+ * Keeps raster artwork out of the file while preserving the visual beat.
