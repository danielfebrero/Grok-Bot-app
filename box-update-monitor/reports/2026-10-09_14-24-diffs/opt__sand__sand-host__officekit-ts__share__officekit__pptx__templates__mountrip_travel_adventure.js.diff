+/** Six-segment pinwheel with a ringed brown hub (the infographic slide). */
+function wheel(s, cx, cy, r) {
+  for (let i = 0; i < 6; i++) {
+    s.addShape('pie', {
+      x: cx - r, y: cy - r, w: 2 * r, h: 2 * r,
+      fill: { color: i % 2 === 0 ? C.brown : C.silver },
+      angleRange: [220 + i * 60, 220 + i * 60 + 54],
+    });
+  }
