+// pptxgenjs rewrites the shadow object it is handed, so each shape gets a fresh copy.
+function shadow(blur, offset, angle, opacity) {
+  return { type: 'outer', blur: blur, offset: offset, angle: angle, color: '000000', opacity: opacity || 0.2 };
