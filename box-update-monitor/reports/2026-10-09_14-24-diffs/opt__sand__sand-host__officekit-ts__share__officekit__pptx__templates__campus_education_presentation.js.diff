+  [[0, 0.24], [0.42, 0.0]].forEach(stack => {
+    const sx = x + w * stack[0];
+    const top = y + h * stack[1];
+    const bottom = y + h;
+    slide.addShape('rect', {
+      x: sx, y: top + eh / 2, w: cw, h: bottom - top - eh / 2, fill: { color: color }, line: NO_LINE,
+    });
+    for (let cy = top; cy < bottom - eh * 0.7; cy += eh * 0.62) {
+      slide.addShape('ellipse', { x: sx, y: cy, w: cw, h: eh, fill: { color: color }, line: { color: seam, width: 0.75 } });
