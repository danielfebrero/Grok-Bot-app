+/** Grey stand-in for a photograph, with optional rounded corners + caption. */
+function placeholder(slide, box, radii, opts) {
+  const o = opts || {};
+  slide.addShape('custGeom', {
+    x: box[0], y: box[1], w: box[2], h: box[3],
+    points: roundedRectPoints(box[2], box[3], radii || [0, 0, 0, 0]),
+    fill: { color: o.color || PHOTO }, line: NO_LINE,
+  });
+  if (o.label !== false) {
+    slide.addText('[image]', {
+      x: box[0], y: box[1] + box[3] / 2 - 0.2, w: box[2], h: 0.4, align: 'center', valign: 'middle',
+      fontFace: BODY_FONT, fontSize: 12, color: o.labelColor || PHOTO_LABEL,
+    });
+  }
