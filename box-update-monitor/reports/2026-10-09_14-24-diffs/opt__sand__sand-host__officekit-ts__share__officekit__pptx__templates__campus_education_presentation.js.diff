+/* ------------------------------------------------------------------ *
+ * Geometry helpers
+ * ------------------------------------------------------------------ */
+const KAPPA = 0.5523; // cubic-bezier constant for a quarter circle
+
+/** Cubic segment for a custGeom point list. */
+function curve(x1, y1, x2, y2, x, y) {
+  return { x: x, y: y, curve: { type: 'cubic', x1: x1, y1: y1, x2: x2, y2: y2 } };
+}
+
+/**
+ * Point list for a w x h rectangle with individually rounded corners
+ * (radii clockwise from the top-left corner).
+ */
+function roundedRectPoints(w, h, radii) {
+  const [tl, tr, br, bl] = radii;
+  const k = 1 - KAPPA;
+  return [
+    { x: tl, y: 0, moveTo: true },
+    { x: w - tr, y: 0 },
+    curve(w - tr * k, 0, w, tr * k, w, tr),
+    { x: w, y: h - br },
+    curve(w, h - br * k, w - br * k, h, w - br, h),
+    { x: bl, y: h },
+    curve(bl * k, h, 0, h - bl * k, 0, h - bl),
+    { x: 0, y: tl },
+    curve(0, tl * k, tl * k, 0, tl, 0),
+    { close: true },
+  ];
+}
+
+/**
+ * Box to feed addShape for a shape that should occupy [bx,by,bw,bh]
+ * *after* being rotated by a quarter turn.
+ */
+function quarterTurnBox(bx, by, bw, bh) {
+  return { x: bx + bw / 2 - bh / 2, y: by + bh / 2 - bw / 2, w: bh, h: bw };
+}
+
+/** Straight line between two points (pptxgenjs lines are box + flip based). */
+function connect(slide, x1, y1, x2, y2, line) {
+  slide.addShape('line', {
+    x: Math.min(x1, x2), y: Math.min(y1, y2),
+    w: Math.abs(x2 - x1), h: Math.abs(y2 - y1),
+    flipV: (x2 - x1) * (y2 - y1) < 0,
+    line: line,
+  });
+}
