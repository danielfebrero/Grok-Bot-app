+/** Big Raleway-Black slide heading; `lines` is an array of strings. */
+function heading(s, lines, x, y, w, h, o = {}) {
+  text(s, lines.map((t, i) => ({ text: t, options: { breakLine: i < lines.length - 1 } })),
+    x, y, w, h, { fontFace: HEAD, fontSize: 30, color: BLACK, ...o });
+}
+
+/** Centred Raleway-Black heading used by the "title on top" slides. */
+const centreHeading = (s, str, x, y, w, h, o = {}) =>
+  text(s, str, x, y, w, h, { align: 'center', fontFace: HEAD, fontSize: 30, color: BLACK, ...o });
+
+/** The circled-chevron glyph that precedes every eyebrow label. */
+function eyebrowMark(s, x, y, color, rotate = 0) {
+  // `rectRadius` drives the donut's "adj" adjust value, i.e. its ring thickness.
+  s.addShape('donut', {
+    x, y, w: 0.109, h: 0.113, rotate, rectRadius: 0.017,
+    fill: { color }, line: { type: 'none' },
+  });
