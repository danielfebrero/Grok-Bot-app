+
+// ---------------------------------------------------------------- palette ---
+const BLUE = '027DBA';    // theme accent1
+const SILVER = 'D8D8D8';  // theme accent2
+const GREY = '808080';    // body copy
+const GREY_L = 'A6A6A6';  // eyebrow labels
+const GREY_M = 'A2A2A2';  // muted card fill
+const GREY_XL = 'D9D9D9'; // breadcrumb chips
+const BFBFBF = 'BFBFBF';  // hamburger bars / centred eyebrows
+const WHITE = 'FFFFFF';
+const BLACK = '000000';
+const F2 = 'F2F2F2';      // progress-bar track
+
+const HEAD = 'Raleway Black'; // theme major font
+const BODY = 'Open Sans';     // theme minor font
+
+const PH = 'E4E4E4';     // image placeholder fill
+const PH_LBL = '9A9A9A'; // image placeholder caption
+
+// pptxgenjs mutates the shadow object it is handed, so each shape needs its own.
+const shadow = (opacity = 0.1, offset = 0, angle = 0) =>
+  ({ type: 'outer', color: BLACK, opacity, blur: 25, offset, angle });
+
+// PowerPoint "Normal" text insets used throughout the source: 0.1" / 0.05".
+const INSET = [7.2, 7.2, 3.6, 3.6]; // pptxgenjs order: [left, right, bottom, top] in points
+
+// ------------------------------------------------------------- primitives ---
+const rect = (s, x, y, w, h, o = {}) =>
+  s.addShape('rect', { x, y, w, h, line: { type: 'none' }, ...o });
+
+/** Solid rectangle with a transparency percentage (0-100). */
+const wash = (s, x, y, w, h, color, transparency) =>
+  s.addShape('rect', { x, y, w, h, line: { type: 'none' }, fill: { type: 'solid', color, transparency } });
+
+const lerpHex = (from, to, t) => [0, 2, 4]
+  .map(i => Math.round(parseInt(from.substr(i, 2), 16) * (1 - t) + parseInt(to.substr(i, 2), 16) * t))
+  .map(v => v.toString(16).padStart(2, '0').toUpperCase()).join('');
+
+/**
+ * Linear gradient faked with a stack of opaque, rotated colour bands
+ * (pptxgenjs has no gradient-fill API).  `angle` is the gradient direction in
+ * degrees measured clockwise from "left to right"; bands run perpendicular.
+ */
+function gradientBands(s, from, to, angle, steps = 90) {
+  const rad = (angle * Math.PI) / 180;
+  const ux = Math.cos(rad), uy = Math.sin(rad);
+  const corners = [[0, 0], [10, 0], [0, 5.625], [10, 5.625]].map(([x, y]) => x * ux + y * uy);
+  const lo = Math.min(...corners), hi = Math.max(...corners);
+  const thickness = (hi - lo) / steps;
+  const mid = 5 * ux + 2.8125 * uy;
+  for (let i = 0; i < steps; i++) {
+    const t = (i + 0.5) / steps;
+    const off = lo + t * (hi - lo) - mid;
+    const w = 12, h = thickness * 2.2;
+    s.addShape('rect', {
+      x: 5 + off * ux - w / 2, y: 2.8125 + off * uy - h / 2, w, h,
+      rotate: angle + 90, line: { type: 'none' }, fill: { color: lerpHex(from, to, t) },
+    });
+  }
+}
+
+const hline = (s, x, y, w, color, width = 1, o = {}) =>
+  s.addShape('line', { x, y, w, h: 0, line: { color, width }, ...o });
+
+/** Text box.  `runs` is a string or an array of pptxgenjs {text, options} runs. */
+function text(s, runs, x, y, w, h, o = {}) {
+  s.addText(runs, {
+    x, y, w, h,
+    fontFace: BODY, fontSize: 8.25, color: GREY, margin: INSET,
+    valign: 'top', paraSpaceBefore: 0, paraSpaceAfter: 0,
+    ...o,
+  });
+}
+
+/** Grey 8.25pt justified paragraph at 150% leading — the deck's workhorse. */
+const body = (s, str, x, y, w, h, o = {}) =>
+  text(s, str, x, y, w, h, { align: 'justify', lineSpacingMultiple: 1.5, ...o });
