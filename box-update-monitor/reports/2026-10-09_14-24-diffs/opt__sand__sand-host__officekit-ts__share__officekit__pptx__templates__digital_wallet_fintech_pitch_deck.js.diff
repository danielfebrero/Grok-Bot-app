+    x: x + 0.038, y: y + 0.031, w: 0.03, h: 0.05, rotate: rotate + 135,
+    fill: { color }, line: { type: 'none' },
+  });
+}
+
+/** Eyebrow: chevron mark + small bold 9pt label. */
+function eyebrow(s, label, markX, markY, textX, textY, o = {}) {
+  eyebrowMark(s, markX, markY, o.markColor || BLUE, o.rotate);
+  text(s, label, textX, textY, o.w || 2.743, 0.253,
+    { fontSize: 9, bold: true, color: o.color || GREY_L, align: o.align, rotate: o.rotate });
