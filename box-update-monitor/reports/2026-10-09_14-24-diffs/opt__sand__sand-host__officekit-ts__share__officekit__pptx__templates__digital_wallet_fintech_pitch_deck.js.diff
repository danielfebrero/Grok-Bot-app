+ *
+ * Slide size 10 x 5.625 in (16:9).  The source deck is a template whose photo
+ * frames are *empty* picture placeholders, so they contribute nothing visually;
+ * the single embedded raster (the phone mock-up on slide 27) is replaced here
+ * by a flat "[image]" placeholder rectangle.
+ */
+const path = require('path');
