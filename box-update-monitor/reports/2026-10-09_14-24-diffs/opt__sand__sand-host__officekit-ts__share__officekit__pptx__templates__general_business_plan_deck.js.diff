+/*
+ * UWESLAH — Business Plan deck (20 slides, 13.333 x 7.5 in)
+ * Standalone pptxgenjs re-creation of the reference presentation.
+ *
+ * The reference deck uses empty PowerPoint *picture placeholders* (no raster
+ * data is stored in the file).  They are re-created here with `imageSlot()`,
+ * which draws a rounded rectangle at the placeholder's exact position/size.
+ */
+'use strict';
+
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+const pptx = new PptxGenJS();
+const SH = pptx.ShapeType;
+const CH = pptx.ChartType;
+
+pptx.defineLayout({ name: 'UWESLAH', width: 12192000 / 914400, height: 6858000 / 914400 });
+pptx.layout = 'UWESLAH';
+pptx.author = 'UWESLAH';
+pptx.title = 'Business Plan';
+
+/* ------------------------------------------------------------------ palette */
+const BG = 'E0E0E0';   // slide background
+const DARK = '404040'; // primary dark card
+const DARK2 = '363636'; // slightly deeper card variant
+const GRAY = 'BFBFBF'; // light gray card
+const LIME = 'D0F750'; // accent
+const LIME2 = 'DCF78A'; // soft accent (SWOT headings)
+const WHITE = 'FFFFFF';
+const BLACK = '000000';
+const SILVER = 'D9D9D9'; // body copy on dark cards
+const INK = '0D0D0D';    // chart text
+
+const FONT = 'Poppins';
+const FONT_B = 'Poppins SemiBold';
+
+/* ---------------------------------------------------------------- primitives */
+
+// PowerPoint stores roundRect corners as an "adj" value (1/100000 of the
+// shorter side); pptxgenjs wants the radius in inches.
+const radius = (adj, w, h) => (adj / 100000) * Math.min(w, h);
+
+function box(s, x, y, w, h, fill, adj) {
+  const o = { x, y, w, h, fill: { color: fill }, line: { type: 'none' } };
+  if (adj) { o.rectRadius = radius(adj, w, h); return s.addShape(SH.roundRect, o); }
+  return s.addShape(SH.rect, o);
+}
+
+// pill = fully rounded rectangle (adj 50000)
+const pill = (s, x, y, w, h, fill) => box(s, x, y, w, h, fill, 50000);
+
+const oval = (s, x, y, w, h, fill) =>
+  s.addShape(SH.ellipse, { x, y, w, h, fill: { color: fill }, line: { type: 'none' } });
+
+/**
+ * Text box. Defaults mirror the deck: Poppins, 10pt, black, top aligned,
+ * PowerPoint's standard 0.1"/0.05" insets.
+ */
+function T(s, text, x, y, w, h, o) {
+  o = o || {};
+  s.addText(text, {
+    x, y, w, h,
+    valign: 'top',
+    fontFace: o.bold ? FONT_B : FONT,
+    bold: !!o.bold,
+    fontSize: o.size || 10,
+    color: o.color || BLACK,
+    align: o.align || 'left',
+    lineSpacingMultiple: o.ls,
+    charSpacing: o.spc,
+  });
+}
+
+const title = (s, text, x, y, w, h) => T(s, text, x, y, w, h, { bold: true, size: 40 });
+const lead = (s, text, x, y, w, h, color) =>
+  T(s, text, x, y, w, h, { size: 10, ls: 1.5, color: color || DARK });
+
+/** Empty picture placeholder from the reference deck. */
+const imageSlot = (s, x, y, w, h, adj, fill) => box(s, x, y, w, h, fill || BG, adj || 7989);
+
+/** Small square avatar placeholder: framed [image] tile. */
+function avatarSlot(s, x, y, d) {
+  box(s, x, y, d, d, WHITE);
+  box(s, x + d * 0.10, y + d * 0.10, d * 0.80, d * 0.80, 'F2F2F2');
+  oval(s, x + d * 0.20, y + d * 0.20, d * 0.20, d * 0.20, 'F2C46D');
+  s.addShape(SH.triangle, { x: x + d * 0.16, y: y + d * 0.46, w: d * 0.34, h: d * 0.34,
+    fill: { color: '7FADDE' }, line: { type: 'none' } });
+  s.addShape(SH.triangle, { x: x + d * 0.40, y: y + d * 0.34, w: d * 0.44, h: d * 0.46,
+    fill: { color: '5B9BD5' }, line: { type: 'none' } });
+}
+
+/* --------------------------------------------------------------------- icons */
+
+/** Eight-ray asterisk inside a dark disc (the deck's recurring "spark" mark). */
+function spark(s, x, y, d, disc, ray) {
+  oval(s, x, y, d, d, disc || DARK);
+  const len = d * 0.663, bar = d * 0.0679;
+  const bx = x + (d - bar) / 2, by = y + (d - len) / 2;
+  [0, 45, 90, 135].forEach(rotate => s.addShape(SH.roundRect, {
+    x: bx, y: by, w: bar, h: len, rotate,
+    fill: { color: ray || LIME }, line: { type: 'none' }, rectRadius: bar / 2,
+  }));
+}
+
+/**
+ * The deck's "open corner" arrow: a right-angle bracket hugging two sides of
+ * the box plus a diagonal running into the corner it points at.
+ * dir: 'ne' | 'nw' | 'se'
+ */
+function arrow(s, x, y, w, h, color, dir) {
+  const ln = { color, width: 1.5 };
+  const seg = (sx, sy, sw, sh, flipH, flipV) =>
+    s.addShape(SH.line, { x: sx, y: sy, w: sw, h: sh, flipH, flipV, line: ln });
+  if (dir === 'ne') {
+    seg(x, y, w, 0);            // top edge
+    seg(x + w, y, 0, h);        // right edge
+    seg(x, y, w, h, false, true); // diagonal SW -> NE
+  } else if (dir === 'nw') {
+    seg(x, y, w, 0);
+    seg(x, y, 0, h);
+    seg(x, y, w, h, true, true); // diagonal SE -> NW
+  } else { // 'se'
+    seg(x, y + h, w, 0);        // bottom edge
+    seg(x + w, y, 0, h);
+    seg(x, y, w, h);            // diagonal NW -> SE
+  }
+}
+
+/** Flame mark of the UWESLAH logo: a teardrop plus a small curling tongue. */
+function flame(s, x, y, w, h, color) {
+  const f = { fill: { color }, line: { type: 'none' } };
+  s.addShape(SH.teardrop, Object.assign(
+    { x: x + w * 0.24, y, w: w * 0.76, h: h * 0.80, rotate: 315 }, f));
+  s.addShape(SH.moon, Object.assign(
+    { x: x - w * 0.03, y: y + h * 0.36, w: w * 0.44, h: h * 0.62, rotate: 355 }, f));
+}
+
+/** "+" inside a disc. */
+function plusBadge(s, x, y, d, disc, glyph) {
+  oval(s, x, y, d, d, disc);
+  const p = d * 0.68;
+  s.addShape(SH.mathPlus, {
