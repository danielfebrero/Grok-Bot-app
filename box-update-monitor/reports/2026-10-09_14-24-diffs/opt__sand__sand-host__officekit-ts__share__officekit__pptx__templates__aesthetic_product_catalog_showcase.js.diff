+// Plain text box: top anchored, Jost, no bullet - the deck's default.
+function txt(slide, text, opts) {
+    slide.addText(text, Object.assign({ fontFace: FONT, valign: 'top' }, opts));
+}
+
+// Solid colour block (the navy / tan panels the layout is built from).
+function block(slide, x, y, w, h, color) {
+    slide.addShape('rect', { x, y, w, h, fill: { color }, line: { type: 'none' } });
+}
+
+// One wash of a photo placeholder, no caption. Used for the layout's copy,
+// which sits underneath everything the slide itself draws.
+function photoUnderlay(slide, rects) {
+    rects.forEach(([x, y, w, h]) => {
+        slide.addShape('rect', {
+            x, y, w, h,
+            fill: { color: PHOTO_COLOR, transparency: PHOTO_TRANSPARENCY },
+            line: { type: 'none' },
+        });
+    });
+}
+
+// The slide's own copy of a photo placeholder, labelled.
+function photos(slide, rects) {
