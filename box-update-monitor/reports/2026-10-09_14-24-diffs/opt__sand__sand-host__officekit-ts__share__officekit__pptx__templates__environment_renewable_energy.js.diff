+/**
+ * One stacked-column panel: six gridlines with their value labels, then the
+ * columns stacked from the 10.000 baseline upwards.  `y` is the panel top.
+ */
+function barChart(slide, x, y, years, stack) {
+
+  const AXIS = x + 0.831, PW = 4.072;
+ // plot area starts after the value labels
+  const TOP = y + 0.113, BASE = y + 2.022, SCALE = (BASE - TOP) / 240;
+
+  ['250.000', '200.000', '150.000', '100.000', '50.000', '10.000'].forEach((label, i) => {
+
+    const ly = TOP + [0, 0.372, 0.753, 1.134, 1.515, 1.909][i];
+
+    slide.addShape('line', {
+ x: AXIS, y: ly, w: PW, h: 0,
+      line: {
+ color: i === 0 ? CREAM : GRIDLN, width: 0.5 }
+ }
+);
+
+    text(slide, label, {
+ x: x - 0.01, y: ly - 0.11, w: 0.626, h: 0.219,
+      fontSize: 7, color: GREY59, align: 'right' }
+);
+
+  }
+);
+
+  const slot = PW / 6;
+
+  years.forEach((yr, i) => {
+
+    const cx = AXIS + slot * (i + 0.5);
+
+    text(slide, yr, {
+ x: cx - 0.27, y: BASE + 0.061, w: 0.54, h: 0.252,
+      fontSize: 9, color: GREY59, align: 'center' }
+);
+
+    let top = BASE;
+
+    stack.forEach((band) => {
+
+      const h = band.values[i] * SCALE;
+
+      top -= h;
+
+      slide.addShape('rect', {
+ x: cx - 0.176, y: top, w: 0.351, h, fill: {
+ color: band.color }
+ }
+);
+
+    }
+);
+
+  }
+);
+
+}
