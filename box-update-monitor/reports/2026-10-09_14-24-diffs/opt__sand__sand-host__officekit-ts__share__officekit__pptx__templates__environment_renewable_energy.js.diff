+/**
+ * Scale a normalised outline into `size` and return pptxgenjs `points`.
+ * custGeom coordinates are relative to the shape's own top-left corner.
+ */
+function poly(outline, size) {
+
+  const sx = (v) => v * size.w;
+
+  const sy = (v) => v * size.h;
+
+  return outline.map((c) =>
+    c.length === 0
+      ? {
+ close: true }
+
+      : c.length === 6
+      ? {
+ x: sx(c[0]), y: sy(c[1]), curve: {
+ type: 'cubic', x1: sx(c[2]), y1: sy(c[3]), x2: sx(c[4]), y2: sy(c[5]) }
+ }
+
+      : c.length === 3
+      ? {
+ x: sx(c[0]), y: sy(c[1]), moveTo: true }
+
+      : {
+ x: sx(c[0]), y: sy(c[1]) }
+
+  );
+
+}
