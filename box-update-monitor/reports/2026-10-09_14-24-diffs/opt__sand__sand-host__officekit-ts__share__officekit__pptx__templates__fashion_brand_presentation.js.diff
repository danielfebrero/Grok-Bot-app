+  slide.addShape('ellipse', { x: cx, y: cy, w: D, h: D,
+                              fill: { color: BLUE }, line: NOLINE });
+  // Meridians: the outline plus a narrowing ellipse and the polar axis.
+  [D, D * 0.50].forEach(function (w) {
+    slide.addShape('ellipse', { x: cx + (D - w) / 2, y: cy, w: w, h: D,
