+function star(slide, x, y, size, color, adj) {
+  const c = size / 2;
+  const d = c * (adj / 50000) * Math.SQRT1_2;  // diagonal offset of the inner points
+  const pts = [[0, c], [c - d, c - d], [c, 0], [c + d, c - d],
+               [size, c], [c + d, c + d], [c, size], [c - d, c + d]];
+  slide.addShape('custGeom', {
+    x: x, y: y, w: size, h: size, fill: { color: color }, line: NOLINE,
+    points: pts.map(function (p) { return { x: p[0], y: p[1] }; }).concat([{ close: true }]),
+  });
