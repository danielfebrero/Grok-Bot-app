+  });
+  slide.addShape('line', { x: cx + D / 2, y: cy, w: 0, h: D, line: { color: WHITE, width: 2 } });
+  // Parallels: equator plus a tropic either side.
+  [[0.50, 0.00], [0.25, 0.07], [0.75, 0.07]].forEach(function (p) {
+    slide.addShape('line', { x: cx + D * p[1], y: cy + D * p[0], w: D * (1 - 2 * p[1]), h: 0,
