+/** Globe bullet: blue disc on a white coin, ruled with meridians + parallels. */
+function globe(slide, x, y) {
+  const D = 0.298, cx = x + 0.101, cy = y + 0.103; // inner disc origin
+  slide.addShape('ellipse', { x: x, y: y, w: 0.500, h: 0.500,
