+
+const box = (b) => ({ x: b[0], y: b[1], w: b[2], h: b[3] });
+
+/** Display type set in the major font; `runs` may be a string or run array. */
+function heading(slide, b, runs, size) {
+  slide.addText(runs, Object.assign(box(b), {
+    fontFace: HEAD, fontSize: size, valign: 'top',
