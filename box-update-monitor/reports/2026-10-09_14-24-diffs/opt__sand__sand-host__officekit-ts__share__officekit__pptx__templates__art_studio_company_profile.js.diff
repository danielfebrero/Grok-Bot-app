+
+/** One text run. */
+function R(text, style, extra) {
+  return { text, options: Object.assign({}, style, extra) };
+}
+/** Paragraphs sharing one style: P(style, 'line one', 'line two', ...). */
+function P(style, ...lines) {
+  return lines.map((t, i) =>
+    R(t, style, i < lines.length - 1 ? { breakLine: true } : null));
+}
