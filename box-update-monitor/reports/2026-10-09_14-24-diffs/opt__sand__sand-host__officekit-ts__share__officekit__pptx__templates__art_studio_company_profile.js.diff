+}
+/** Stand-in for a white line-art icon glyph. */
+function ic(s, x, y, w, h, color) {
+  s.addShape('roundRect', {
+    x, y, w, h, rectRadius: Math.min(w, h) * 0.22,
+    fill: { color: W, transparency: 100 },
+    line: { color: color || W, width: 1 },
+  });
+}
