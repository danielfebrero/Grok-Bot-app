+/* -------------------------------------------------------------- gradient */
+/* Every slide sits on the same dark navy blend that runs diagonally from a
+   lighter top-left to near-black bottom-right.  pptxgenjs only supports flat
+   background colours, so it is painted as a stack of rotated bands. */
+const BANDS = 60;
+const GRAD_DEG = 45;
+function bg(s) {
+  s.background = { color: BG2 };
+  const a = [0x18, 0x28, 0x48];   // BG1
+  const b = [0x08, 0x0e, 0x1a];   // BG2
+  const rad = GRAD_DEG * Math.PI / 180;
+  const ux = Math.cos(rad), uy = Math.sin(rad);
+  const len = SLIDE_W * ux + SLIDE_H * uy;          // gradient axis length
+  const span = 2 * Math.sqrt(SLIDE_W * SLIDE_W + SLIDE_H * SLIDE_H);
+  const w = len / BANDS * 1.5;
+  for (let i = 0; i < BANDS; i++) {
+    const t = (i + 0.5) / BANDS;
+    const hex = a.map((v, k) => Math.round(v + (b[k] - v) * t).toString(16).padStart(2, '0'))
+      .join('').toUpperCase();
+    s.addShape('rect', {
+      x: t * len * ux - w / 2, y: t * len * uy - span / 2, w, h: span,
+      rotate: GRAD_DEG, fill: { color: hex }, line: { color: hex, width: 0.75 },
+    });
+  }
+}
