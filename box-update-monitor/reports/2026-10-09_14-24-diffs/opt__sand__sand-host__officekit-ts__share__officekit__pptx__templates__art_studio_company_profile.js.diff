+/* ----------------------------------------------------------- ring wedges */
+/** Annular sector: centre (cx,cy), outer/inner radius, start angle, sweep (deg). */
+function ring(s, cx, cy, rO, rI, a0, sweep, color) {
+  const x = cx - rO, y = cy - rO, rad = (a) => a * Math.PI / 180;
+  const a1 = a0 + sweep;
+  s.addShape('custGeom', {
+    x, y, w: 2 * rO, h: 2 * rO, fill: { color },
+    points: [
+      { x: rO + rO * Math.cos(rad(a0)), y: rO + rO * Math.sin(rad(a0)), moveTo: true },
+      { x: 0, y: 0, curve: { type: 'arc', hR: rO, wR: rO, stAng: a0, swAng: sweep } },
+      { x: rO + rI * Math.cos(rad(a1)), y: rO + rI * Math.sin(rad(a1)) },
+      { x: 0, y: 0, curve: { type: 'arc', hR: rI, wR: rI, stAng: a1, swAng: -sweep } },
+      { close: true },
+    ],
+  });
