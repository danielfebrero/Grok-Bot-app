+/* ------------------------------------------------------------- text style */
+/** Build a run-style object: size in pt, font face, colour, optional line spacing. */
+function S(fontSize, fontFace, color, lineSpacingMultiple) {
+  const o = { fontSize, fontFace, color };
+  if (lineSpacingMultiple) o.lineSpacingMultiple = lineSpacingMultiple;
+  return o;
+}
+
+/* the handful of styles the deck re-uses everywhere */
+const B8 = S(8, PO, GY, 1.5);          // body copy
+const B7 = S(7, PO, GY, 1.5);
+const B8L = S(8, PO, LGY, 1.5);
+const B8W = S(8, PO, W, 1.5);
+const B8A = S(8, PO, GY2, 1.5);
+const LB7 = S(7, PM, W);               // top bar labels
+const M8 = S(8, PM, W);
+const M9 = S(9, PM, W);
