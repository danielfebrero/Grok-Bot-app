+/* ---------------------------------------------------------- shape helpers */
+function tx(s, x, y, w, h, runs, opts) {
+  s.addText(runs, Object.assign({ x, y, w, h, valign: 'top', margin: [7.2, 7.2, 3.6, 3.6] }, opts));
+}
+function r(s, x, y, w, h, color, opts) {
+  s.addShape('rect', Object.assign({ x, y, w, h, fill: { color }, line: { width: 0 } }, opts));
+}
+function el(s, x, y, w, h, color, opts) {
+  s.addShape('ellipse', Object.assign({ x, y, w, h, fill: { color }, line: { width: 0 } }, opts));
+}
+function sh(s, type, x, y, w, h, opts) {
+  s.addShape(type, Object.assign({ x, y, w, h, line: { width: 0 } }, opts));
+}
+const UL = { style: 'sng' };
+function ln(s, x, y, w, h, o) {
+  o = o || {};
+  const line = { color: o.color || W, width: o.width || 0.75 };
+  if (o.arrow) line.endArrowType = 'triangle';
+  const p = { x, y, w, h, line };
+  if (o.rotate) p.rotate = o.rotate;
+  if (o.flipH) p.flipH = true;
+  s.addShape('line', p);
+}
