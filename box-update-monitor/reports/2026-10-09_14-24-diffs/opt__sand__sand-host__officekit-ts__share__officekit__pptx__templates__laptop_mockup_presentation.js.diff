+	const cy = Math.min(SLIDE_H - 0.5, Math.max(0.1, box.y + box.h / 2));
+	slide.addText('[image]', {
+		x: (left + right) / 2 - 0.6, y: cy - 0.16, w: 1.2, h: 0.32,
+		fontFace: F_MINOR, fontSize: 9, color: '9BA0A5',
+		align: 'center', valign: 'middle', margin: 0,
+	});
