+/** Cubic-bezier control points of the slide-2 sparkline (0..1 fractions). */
+function sparkline(w, h) {
+	const seq = [
+		0.0482, 0.1772, 0.0963, 0.0955, 0.1253, 0.0920,
+		0.1544, 0.0885, 0.1553, 0.2233, 0.1741, 0.2381,
