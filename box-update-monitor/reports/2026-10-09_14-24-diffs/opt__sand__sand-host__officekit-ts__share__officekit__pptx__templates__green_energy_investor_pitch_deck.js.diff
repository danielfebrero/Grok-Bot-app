+  rect(s, x + u(0.26), y, u(0.08), u(0.19), color);                        // right prong
+  rect(s, x + u(0.01), y + u(0.16), u(0.42), u(0.15), color);              // plug shoulder
+  s.addShape('trapezoid', Object.assign({                                  // tapered body
+    x: x + u(0.03), y: y + u(0.29), w: u(0.38), h: u(0.21),
