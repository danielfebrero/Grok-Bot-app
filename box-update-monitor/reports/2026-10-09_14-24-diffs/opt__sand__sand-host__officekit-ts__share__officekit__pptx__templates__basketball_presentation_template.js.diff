+  { cols: 11, rows: 6, x0: 1.144, dx: 1.104, y0: 0.986, dy: 1.072 },  // 32
+];
+function iconSheet(sheet, seed) {
+  const s = slideOf(null);
+  const d = 0.40;
+  for (let r = 0; r < sheet.rows; r++) {
+    for (let c = 0; c < sheet.cols; c++) {
+      const i = seed + r * sheet.cols + c * 5;
+      const solid = i % 4 === 0;   // the reference mixes solid and outlined marks
+      s.addShape(GLYPHS[i % GLYPHS.length], {
+        x: sheet.x0 + c * sheet.dx - d / 2, y: sheet.y0 + r * sheet.dy - d / 2, w: d, h: d,
+        fill: solid ? { color: DARK } : { type: 'none' },
+        line: { color: DARK, width: 1.75 },
+      });
+    }
+  }
+}
