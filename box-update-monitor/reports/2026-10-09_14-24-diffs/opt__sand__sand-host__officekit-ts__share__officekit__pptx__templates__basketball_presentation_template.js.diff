+  SH.FLOWCHART_MAGNETIC_DISK, SH.FLOWCHART_DISPLAY, SH.STAR_4_POINT, SH.OCTAGON, SH.HEPTAGON,
+  SH.MATH_PLUS, SH.MATH_MULTIPLY, SH.UP_ARROW, SH.WAVE, SH.EXPLOSION1, SH.CHART_STAR,
+];
+const ICON_SHEETS = [
+  { cols: 12, rows: 8, x0: 0.749, dx: 1.074, y0: 0.632, dy: 0.887 },  // 29
