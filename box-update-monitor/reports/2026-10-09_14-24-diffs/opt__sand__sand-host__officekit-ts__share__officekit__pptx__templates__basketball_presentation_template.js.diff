+const GLYPHS = [
+  SH.OVAL, SH.HEART, SH.STAR_5_POINT, SH.SUN, SH.MOON, SH.CLOUD, SH.LIGHTNING_BOLT, SH.DIAMOND,
+  SH.PIE, SH.DONUT, SH.FRAME, SH.HEXAGON, SH.TEAR, SH.PLAQUE, SH.SMILEY_FACE, SH.CROSS,
