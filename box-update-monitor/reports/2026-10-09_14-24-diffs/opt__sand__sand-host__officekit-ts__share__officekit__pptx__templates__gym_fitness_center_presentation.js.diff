+  const t = Math.max(0, Math.min(1, dist / (0.69 * (w + h))));
+  return hex2(0xfd + (0xeb - 0xfd) * t) + hex2(0x6b + (0x2b - 0x6b) * t) + hex2(0x07 + (0x02 - 0x07) * t);
