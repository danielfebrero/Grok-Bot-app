+      fill: { color: ramp(0.345 * (w + h), w, h) },
+    });
+    return;
+  }
+  const vertical = h >= w;                       // band along the longer axis
+  const span = vertical ? h : w;
+  const n = Math.max(2, Math.min(40, Math.round(span / BAND)));
+  const step = span / n;
+  const bleed = 0.01;                            // hide hairline seams between bands
+  for (let i = 0; i < n; i++) {
+    const grow = i < n - 1 ? bleed : 0;
+    const color = ramp((i + 0.5) * step + (vertical ? w : h) / 2, w, h);
+    if (vertical) band(slide, x, y + i * step, w, step + grow, color);
+    else band(slide, x + i * step, y, step + grow, h, color);
+  }
