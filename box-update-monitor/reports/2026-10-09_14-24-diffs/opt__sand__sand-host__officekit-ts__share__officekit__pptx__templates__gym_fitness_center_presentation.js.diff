+  const { x, y, w, h } = o;
+  const shape = o.shape || 'rect';
+  if (shape !== 'rect' || o.rotate) {
+    // Non-rectangular / rotated: one flat fill sampled at the ramp midpoint.
+    slide.addShape(shape, {
