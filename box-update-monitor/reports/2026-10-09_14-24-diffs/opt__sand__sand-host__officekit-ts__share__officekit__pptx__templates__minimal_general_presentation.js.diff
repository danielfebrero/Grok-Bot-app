+ * Set SHOW_IMAGE_FRAMES to true to outline where a photo would be dropped in.
+ */
+const SHOW_IMAGE_FRAMES = false;
+function imagePlaceholder(s, x, y, w, h) {
+  if (!SHOW_IMAGE_FRAMES) return;
