+
+/** 40 pt Poppins SemiBold section heading. */
+function heading(s, x, y, w, text, color) {
+  s.addText(text, {
+    x, y, w, h: 0.774, valign: 'top', wrap: false,
+    fontSize: 40, fontFace: SEMI, bold: true, color: color || GRAY,
