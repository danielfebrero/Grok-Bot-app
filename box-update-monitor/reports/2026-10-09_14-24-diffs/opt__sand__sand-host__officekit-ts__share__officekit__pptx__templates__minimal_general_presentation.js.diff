+    x: x + d * 0.294, y: y + (d - h) / 2, w, h, fill: { color: markColor }, flipH: true,
+    points: MONOGRAM.map(([px, py], i) => ({ x: px * w, y: py * h, moveTo: i === 0 })).concat([{ close: true }]),
