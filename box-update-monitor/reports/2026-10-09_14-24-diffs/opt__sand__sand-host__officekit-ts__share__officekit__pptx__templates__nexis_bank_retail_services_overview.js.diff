+/** Sutherland-Hodgman clip of a polygon against the half-plane x + y <= limit (or >=). */
+function clipDiagonal(poly, limit, keepBelow) {
+  const inside = p => (keepBelow ? p[0] + p[1] <= limit : p[0] + p[1] >= limit);
+  const cross = (a, b) => {
+    const da = a[0] + a[1] - limit;
+    const t = da / (da - (b[0] + b[1] - limit));
+    return [a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])];
+  };
+  const out = [];
+  poly.forEach((cur, i) => {
+    const prev = poly[(i + poly.length - 1) % poly.length];
+    if (inside(cur)) {
+      if (!inside(prev)) out.push(cross(prev, cur));
+      out.push(cur);
+    } else if (inside(prev)) {
+      out.push(cross(prev, cur));
+    }
