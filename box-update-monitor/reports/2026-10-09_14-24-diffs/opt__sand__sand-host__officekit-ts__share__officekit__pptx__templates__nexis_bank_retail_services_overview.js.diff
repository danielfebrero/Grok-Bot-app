+    { cx: w - r, cy: h - r, a0: 0 },              // bottom-right
+    { cx: r, cy: h - r, a0: Math.PI / 2 },        // bottom-left
+    { cx: r, cy: r, a0: Math.PI },                // top-left
+  ];
+  const pts = [];
+  corners.forEach(c => {
+    for (let i = 0; i <= seg; i++) {
+      const a = c.a0 + (Math.PI / 2) * (i / seg);
+      pts.push([c.cx + r * Math.cos(a), c.cy + r * Math.sin(a)]);
+    }
+  });
