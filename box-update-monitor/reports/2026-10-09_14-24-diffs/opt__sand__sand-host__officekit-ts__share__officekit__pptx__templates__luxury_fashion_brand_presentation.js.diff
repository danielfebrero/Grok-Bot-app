+/**
+ * VogueRise — fashion brand deck (16 slides, 13.333" x 7.5").
+ * Recreated with pptxgenjs. Raster artwork in the source deck (photo
+ * placeholders, icon PNGs, 3D phone renders) is redrawn here with native
+ * shapes or stands in as flat placeholder rectangles.
+ */
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ------------------------------------------------------------------ *
+ * Theme
+ * ------------------------------------------------------------------ */
+
+const C = {
+  orange: 'D5451B', // theme accent1
+  orangeDark: 'A03414', // accent1 lumMod 75%
+  blush: 'F9D9CF', // accent1 lumMod 20% / lumOff 80% — the pink slide background
+  black: '000000',
+  white: 'FFFFFF',
+  gray: '808080', // bg1 brightness -50% — body copy
+  grayDark: '7F7F7F',
+  panel: 'F2F2F2', // bg1 brightness -5%
+  panelDeep: 'D9D9D9', // bg1 brightness -15%
+  phoneBody: '24262B',
+  phoneScreen: 'F5F5F9',
+};
+
+const SERIF = 'Lora'; // theme major font
+const SANS = 'Urbanist Medium'; // theme minor font
+
+const LINE = { color: C.orange, width: 0.5 }; // theme line style 1
+
+/* ------------------------------------------------------------------ *
+ * Small helpers
+ * ------------------------------------------------------------------ */
+
+// Every text frame in the deck is top-anchored; pptxgenjs centres by default.
+function text(slide, content, opts) {
+  slide.addText(content, Object.assign({ fontFace: SANS, fontSize: 18, color: C.black, valign: 'top' }, opts));
+}
+
+function rect(slide, x, y, w, h, opts) {
+  slide.addShape('rect', Object.assign({ x, y, w, h }, opts));
+}
+
+/**
+ * The source deck reserves picture frames on most slides but ships them
+ * empty, so they render as bare background. They are kept here as invisible
+ * geometry so the layout intent stays readable in the code.
+ */
+function photoFrame(slide, x, y, w, h) {
+  slide.addShape('rect', { x, y, w, h, fill: { type: 'none' } });
+}
+
+// Round-capped bar, the building block of both asterisk glyphs.
+function spoke(slide, cx, cy, span, thick, angle, color) {
+  slide.addShape('roundRect', {
+    x: cx - span / 2, y: cy - thick / 2, w: span, h: thick,
+    fill: { color }, rectRadius: thick / 2, rotate: angle,
+  });
+}
+
+// Eight-spoke asterisk glyph: four bars crossing at 45 degree steps.
+function asterisk(slide, x, y, w, h, color) {
+  const span = 0.916 * w; // artwork fills ~92% of its frame
+  const thick = 0.084 * Math.min(w, h);
+  [0, 45, 90, 135].forEach(function (angle) {
+    spoke(slide, x + w / 2, y + h / 2, span, thick, angle, color);
+  });
+}
+
+// Six-spoke asterisk inside the pricing octagons: upright bar plus an X,
+// drawn with flat caps unlike the eight-spoke mark.
+function asteriskSix(slide, x, y, size, color) {
+  [30, 90, 150].forEach(function (angle) {
+    rect(slide, x + 0.15 * size, y + (size - 0.147 * size) / 2, 0.70 * size, 0.147 * size,
+      { fill: { color }, rotate: angle });
+  });
+}
+
+// Wireframe globe: outline, three latitude chords, one meridian line and
+// two meridian ellipses.
+function globe(slide, x, y, w, h, color) {
+  const d = 0.885; // circle diameter as a fraction of the frame
+  const gw = w * d;
+  const gh = h * d;
+  const cx = x + w / 2;
+  const cy = y + h / 2;
+  const stroke = { color, width: 1.4 * w };
+  slide.addShape('ellipse', { x: cx - gw / 2, y: cy - gh / 2, w: gw, h: gh, line: stroke });
+  [-0.42, 0, 0.42].forEach(function (f) {
+    const chord = gw * Math.sqrt(1 - f * f);
+    slide.addShape('line', { x: cx - chord / 2, y: cy + f * gh / 2, w: chord, h: 0, line: stroke });
+  });
+  slide.addShape('line', { x: cx, y: cy - gh / 2, w: 0, h: gh, line: stroke });
+  [0.5].forEach(function (f) {
+    slide.addShape('ellipse', { x: cx - gw * f / 2, y: cy - gh / 2, w: gw * f, h: gh, line: stroke });
+  });
+}
+
+// Handset render: dark rounded body, pale screen inset, pill camera cutout.
+// The cutout is offset along the tilt so it stays centred on the screen.
+function phone(slide, x, y, w, h, tilt) {
+  const rad = tilt * Math.PI / 180;
+  const inset = 0.024 * w;
+  slide.addShape('roundRect', {
+    x, y, w, h, fill: { color: C.phoneBody }, rectRadius: 0.50, rotate: tilt,
+  });
+  slide.addShape('roundRect', {
+    x: x + inset, y: y + inset, w: w - 2 * inset, h: h - 2 * inset,
+    fill: { color: C.phoneScreen }, rectRadius: 0.42, rotate: tilt,
+  });
+  const pillW = 0.30 * w;
+  const pillH = 0.055 * w;
+  const dy = -0.5 * h + 0.145 * w; // distance from the phone centre to the notch
+  slide.addShape('roundRect', {
+    x: x + w / 2 - pillW / 2 - dy * Math.sin(rad),
+    y: y + h / 2 - pillH / 2 + dy * Math.cos(rad),
+    w: pillW, h: pillH, fill: { color: C.phoneBody }, rectRadius: 0.1, rotate: tilt,
+  });
+}
+
+// Brand mark: a thick "C" ring cut open on the right, with a slanted bar
+// standing in the counter.
+function brandMark(slide, x, y, w, h, color) {
+  slide.addShape('blockArc', {
+    x, y, w, h, fill: { color }, angleRange: [35, 325], arcThicknessRatio: 0.43,
+  });
+  rect(slide, x + 0.30 * w, y + 0.39 * h, 0.40 * w, 0.22 * h, { fill: { color }, rotate: 113 });
+}
+
+// Shared top bar: brand mark + wordmark on the left, section label right.
+function header(slide, o) {
+  const opt = o || {};
+  const ink = opt.ink || C.black;
+  brandMark(slide, 0.371, 0.231, 0.431, 0.442, opt.mark || C.orange);
+  text(slide, 'VogueRise', { x: 0.802, y: 0.306, w: 1.147, h: 0.337, fontSize: 14, color: ink });
+  text(slide, 'Fashion', {
+    x: opt.fashionX || 11.184, y: 0.306, w: 1.778, h: 0.337,
+    fontSize: 14, align: 'right', color: opt.label || C.gray,
+  });
+}
+
+// Two-tone display heading: upright lead-in plus an italic accent word.
+function heading(slide, o) {
+  text(slide, o.parts.map(function (p) {
+    return { text: p[0], options: { italic: !!p[1], color: p[2] || o.color || C.black, breakLine: !!p[3] } };
+  }), {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: SERIF, fontSize: o.size, align: o.align, color: o.color || C.black,
+  });
+}
+
+// "01/" style caption stacked over a paragraph of body copy.
+function numberedNote(slide, o) {
+  text(slide, o.num, {
+    x: o.x, y: o.y, w: o.numW || 1.12, h: o.numH || 0.55,
+    fontFace: o.numFont || SERIF, fontSize: o.numSize || 20, bold: o.numBold !== false,
+    color: o.numColor || C.black, align: 'justify', lineSpacingMultiple: 1.5,
+  });
+  text(slide, o.body, {
+    x: o.x, y: o.bodyY, w: o.bodyW, h: o.bodyH,
+    fontSize: o.bodySize || 14, color: o.bodyColor || C.black, lineSpacingMultiple: 1.5,
+  });
+}
+
+// Serif sub-heading with a grey paragraph beneath it.
+function titledNote(slide, o) {
+  text(slide, o.title, {
+    x: o.x, y: o.y, w: o.titleW, h: o.titleH || 0.642,
+    fontFace: SERIF, fontSize: o.titleSize || 24, color: o.titleColor || C.black,
