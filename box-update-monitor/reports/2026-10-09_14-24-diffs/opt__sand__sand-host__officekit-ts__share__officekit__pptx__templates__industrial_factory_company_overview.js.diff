+/**
+ * Blend `color` at `alpha` (0..1) over `base` - used to flatten the source
+ * deck's translucent washes into the solid colours the slivers below paint.
+ */
+function mix(color, alpha, base) {
+  let out = '';
+  for (let i = 0; i < 6; i += 2) {
+    const f = parseInt(color.substr(i, 2), 16);
+    const b = parseInt(base.substr(i, 2), 16);
+    out += ('0' + Math.round(f * alpha + b * (1 - alpha)).toString(16)).slice(-2);
+  }
+  return out.toUpperCase();
+}
+
+/**
+ * Linear ramp of `color` fading into `base`, painted as a strip of opaque
+ * slivers. Reproduces the orange->transparent washes laid over the photos.
+ * `from`/`to` are alpha values (0..1) at the two ends of the run.
+ */
+function ramp(s, x, y, w, h, color, base, from, to, vertical) {
+  const n = 60;
+  const span = (vertical ? h : w) / n;
+  for (let i = 0; i < n; i++) {
+    const a = from + ((to - from) * (i + 0.5)) / n;
+    s.addShape('rect', {
+      x: vertical ? x : x + i * span,
+      y: vertical ? y + i * span : y,
+      w: vertical ? w : span + 0.008,
+      h: vertical ? span + 0.008 : h,
+      fill: { color: mix(color, a, base) },
+      line: LINE_NONE
+    });
+  }
+}
