+  const d = 0.105;
+  [0, 0.1447, 0.2893, 0.437].forEach(function (dx) {
+    s.addShape('ellipse', { x: x + dx, y: y, w: d, h: d, fill: { color: color }, line: LINE_NONE });
+  });
+}
