+  s.addText(GLYPH[name], {
+    x: x - w * 0.25, y: y - h * 0.35, w: w * 1.5, h: h * 1.7,
+    fontFace: F_ICON, fontSize: h * 72 * 1.32,
+    color: color, align: 'center', valign: 'middle', margin: 0
+  });
+}
+
+const iconCard = (s, x, y, w, h, color) => DRAW.card(s, x, y, w, h, color);
+
+/** Four little social-network dots that sit under every person's name. */
