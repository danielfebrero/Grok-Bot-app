+const RED = 'E72629'; // accent1
+const RED_DARK = 'B51416'; // shaded red used inside film bands
+const WHITE = 'FFFFFF';
+const LILAC = 'DFDFF2'; // hairline borders on white cards
+const GREY = '7F7F7F'; // body copy on light backgrounds
