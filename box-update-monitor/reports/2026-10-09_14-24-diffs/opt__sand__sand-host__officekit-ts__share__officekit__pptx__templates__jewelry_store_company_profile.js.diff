+
+/** Text-run shorthand: S('hello', { bold: true }) */
+function S(text, opts) {
+  return { text: text, options: opts || {} };
+}
+
+/** Normalises `'str'` | `S(..)` | `[['str', color], ...]` | `[S(..), ..]` into runs. */
+function runs(content, base) {
+  if (typeof content === 'string') return [S(content, base)];
+  if (!Array.isArray(content)) content = [content];
+  return content.map(function (r) {
+    if (Array.isArray(r)) return S(r[0], Object.assign({}, base, { color: r[1] }));
+    return S(r.text, Object.assign({}, base, r.options));
+  });
+}
+
+/** Generic text box. Boxes are top-anchored and auto-height, like the source. */
+function txt(s, x, y, w, h, content, opts) {
+  opts = opts || {};
+  const base = {
+    fontFace: opts.fontFace || SANS,
+    fontSize: opts.fontSize || 10,
+    color: opts.color || WHITE,
+    italic: opts.italic || false,
+    charSpacing: opts.charSpacing,
+  };
+  s.addText(runs(content, base), {
+    x: x, y: y, w: w, h: h,
+    align: opts.align || 'left',
+    valign: 'top',
+    wrap: opts.wrap !== false,
+    fit: 'resize',
+    lineSpacingMultiple: opts.lineSpacingMultiple,
+  });
+}
+
+/** 28pt italic serif section heading. */
+function title(s, x, y, w, h, content, opts) {
