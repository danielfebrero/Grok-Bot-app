+  tallFlip: { step: [0.1620, 0.1882], rows: ['o....', 'o....', '.o.o.', '.....', '..o..', '....o'] },
+};
+
+function dotGrid(s, x, y, motif) {
+  const [sx, sy] = motif.step;
+  motif.rows.forEach((row, r) => {
+    for (let c = 0; c < row.length; c++) {
