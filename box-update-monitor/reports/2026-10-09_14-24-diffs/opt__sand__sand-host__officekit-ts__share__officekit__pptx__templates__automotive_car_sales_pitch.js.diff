+    points.push({ x: l * w, y: h, moveTo: true },
+      { x: (l + skew) * w, y: 0 },
+      { x: (l + skew + bar) * w, y: 0 },
+      { x: (l + bar) * w, y: h },
+      { close: true });
+  }
+  s.addShape('custGeom', { x: x, y: y, w: w, h: h, fill: { color: C.yellow }, points: points });
