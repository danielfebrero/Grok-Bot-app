+/* ------------------------------------------------------------ helpers ---- */
+// Convert a normalised outline into pptxgenjs custGeom points.
+function pts(outline, w, h) {
+  const out = [];
+  outline.forEach((p, i) => { if (p[0] === 'c') { out.push({ x: p[5] * w, y: p[6] * h,
+                 curve: { type: 'cubic', x1: p[1] * w, y1: p[2] * h, x2: p[3] * w, y2: p[4] * h } });
+    } else { out.push(i === 0 ? { x: p[0] * w, y: p[1] * h, moveTo: true } : { x: p[0] * w, y: p[1] * h });
+    }
+  });
+  out.push({ close: true });
+  return out;
+}
