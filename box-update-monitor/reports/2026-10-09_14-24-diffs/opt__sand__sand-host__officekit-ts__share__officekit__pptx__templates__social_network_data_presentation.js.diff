+// Freeform shape from an outline (o = {fill, rotate, line})
+function poly(s, outline, x, y, w, h, fill, o = {}) {
+  s.addShape('custGeom', Object.assign({ x, y, w, h, points: pts(outline, w, h),
+                                         fill: fill ? { color: fill } : { type: 'none' }, line: { type: 'none' } }, o));
+}
+
+function rect(s, x, y, w, h, fill, o = {}) {
+  s.addShape('rect', Object.assign({ x, y, w, h, fill: { color: fill }, line: { type: 'none' } }, o));
