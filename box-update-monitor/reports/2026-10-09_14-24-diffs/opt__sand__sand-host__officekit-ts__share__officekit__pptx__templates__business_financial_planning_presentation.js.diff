+
+function points (ops, w, h) {
+  return ops.map(function (o) {
+    if (o[0] === 'Z') return { close: true };
+    if (o[0] === 'M') return { x: o[1] * w, y: o[2] * h, moveTo: true };
+    if (o[0] === 'L') return { x: o[1] * w, y: o[2] * h };
+    return {
+      x: o[5] * w, y: o[6] * h,
+      curve: { type: 'cubic', x1: o[1] * w, y1: o[2] * h, x2: o[3] * w, y2: o[4] * h }
+    };
+  });
+}
+
+// ------------------------------------------------------------- primitives --
+// `rot` of 180 flips a path end-for-end, e.g. moving a card's corner notch
+// from the lower-left to the upper-right.
+function poly (s, ops, x, y, w, h, fill, rot) {
+  s.addShape('custGeom', {
+    x: x, y: y, w: w, h: h, rotate: rot || 0,
+    fill: fill ? { color: fill } : { type: 'none' },
+    line: NO_LINE,
+    points: points(ops, w, h)
+  });
+}
+
+// Open, unfilled path (the sales sparkline on slide 1).
+function stroke (s, ops, x, y, w, h, color) {
+  s.addShape('custGeom', {
+    x: x, y: y, w: w, h: h,
+    fill: { type: 'none' }, line: { color: color, width: 1 },
+    points: points(ops, w, h)
+  });
+}
+
+function rect (s, x, y, w, h, fill) {
+  s.addShape('rect', { x: x, y: y, w: w, h: h, fill: { color: fill }, line: NO_LINE });
+}
+
+function rrect (s, x, y, w, h, fill, radius) {
+  s.addShape('roundRect', {
+    x: x, y: y, w: w, h: h, rectRadius: radius,
+    fill: fill ? { color: fill } : { type: 'none' }, line: NO_LINE
+  });
+}
+
+// Fully rounded ends (the deck's roundRect adj value 50000).
+function pill (s, x, y, w, h, fill, outline) {
+  s.addShape('roundRect', {
+    x: x, y: y, w: w, h: h, rectRadius: Math.min(w, h) / 2,
+    fill: fill ? { color: fill } : { type: 'none' },
+    line: outline ? { color: outline, width: 0.75 } : NO_LINE
+  });
+}
+
+function circle (s, x, y, d, fill) {
+  s.addShape('ellipse', { x: x, y: y, w: d, h: d, fill: { color: fill }, line: NO_LINE });
+}
+
+function hline (s, x, y, w, color) {
+  s.addShape('line', { x: x, y: y, w: w, h: 0, line: { color: color, width: 1 } });
+}
+
+/*
+ * Text. Opts: s = pt size, b = Raleway bold, p = plain "Raleway" face,
+ * c = colour, m = centre aligned, l = line-spacing multiple.
+ * Boxes in the source deck are top-anchored and unpadded.
