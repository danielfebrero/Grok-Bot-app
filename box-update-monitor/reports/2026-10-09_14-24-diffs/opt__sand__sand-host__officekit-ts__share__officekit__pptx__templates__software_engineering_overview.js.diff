+function mixHex(from, to, t) {
+  const c = (hex, i) => parseInt(hex.substr(i * 2, 2), 16);
+  const out = [0, 1, 2].map((i) => Math.round(c(from, i) + (c(to, i) - c(from, i)) * t));
+  return out.map((v) => v.toString(16).padStart(2, '0').toUpperCase()).join('');
+}
