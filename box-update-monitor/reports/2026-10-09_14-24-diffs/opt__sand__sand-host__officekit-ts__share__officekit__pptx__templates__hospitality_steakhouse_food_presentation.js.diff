+/* ---------------------------------------------------------------- shorthands */
+// Filled shape without text. `o` may carry line/rotate/flipH/flipV/rectRadius.
+function box(s, shape, x, y, w, h, color, o) {
+  s.addShape(shape, Object.assign({ x, y, w, h, fill: color ? { color } : { type: 'none' }, line: NOLINE }, o));
