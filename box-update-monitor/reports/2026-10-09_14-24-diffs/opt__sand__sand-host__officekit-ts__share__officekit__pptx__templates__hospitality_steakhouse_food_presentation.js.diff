+function trap(s, x, y, w, h, color, adj, o) { // trapezoid
+  const d = Math.min(Math.min(w, h) * adj, w / 2) / w;
+  poly(s, x, y, w, h, color, [[0, 1], [d, 0], [1 - d, 0], [1, 1]], o);
