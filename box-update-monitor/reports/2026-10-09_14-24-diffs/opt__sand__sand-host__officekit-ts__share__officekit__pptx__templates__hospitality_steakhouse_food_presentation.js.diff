+function skew(s, x, y, w, h, color, adj, o) { // parallelogram
+  const d = Math.min(w, h) * adj / w;
+  poly(s, x, y, w, h, color, [[d, 0], [1, 0], [1 - d, 1], [0, 1]], o);
