+/* A mid-tone disc plugs any hairline, then chord-shaped bands ramp the colour. */
+function gradEllipse(s, o) {
+    const steps = o.steps || 48;
+    const c1 = o.from || TEAL, c2 = o.to || LIME;
+    const rx = o.w / 2, ry = o.h / 2;
+    const lap = o.h / steps / 2;
