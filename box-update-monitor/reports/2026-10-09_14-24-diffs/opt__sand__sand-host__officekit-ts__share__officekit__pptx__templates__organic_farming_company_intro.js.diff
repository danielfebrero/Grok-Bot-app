+    s.addText(runs, {
+        x: o.x, y: o.y, w: o.w, h: o.h,
+        fontFace: F_TITLE, fontSize: o.size || 28, color: o.color || DARK,
+        align: o.align || 'left', valign: 'top', wrap: false, isTextBox: true, fit: 'resize',
