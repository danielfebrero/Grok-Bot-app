+/* 37-40 - Icon sheets --------------------------------------------------- */
+// Four sheets of vector pictograms, laid out as an 11 x 6 grid.  Each sheet
+// starts at a different offset into the glyph library so no two look alike.
+function iconSheet(x0, y0, offset) {
+  const s = slide();
+  const dx = 2.253, dy = 2.04, d = 0.95;
+  for (let r = 0; r < 6; r++) {
+    for (let c = 0; c < 11; c++) {
+      const draw = SOLID_GLYPHS[(offset + r * 11 + c) % SOLID_GLYPHS.length];
+      draw(s, x0 + c * dx, y0 + r * dy, d);
+    }
+  }
+}
