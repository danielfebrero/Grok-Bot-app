+    const px = parent.x + dx + w / 2 - pv.x, py = parent.y + dy + h / 2 - pv.y;
+    return {
+        x: pv.x + px * Math.cos(a) - py * Math.sin(a) - w / 2,
+        y: pv.y + px * Math.sin(a) + py * Math.cos(a) - h / 2,
+        w: w, h: h, rotate: parent.rot || 0,
+    };
