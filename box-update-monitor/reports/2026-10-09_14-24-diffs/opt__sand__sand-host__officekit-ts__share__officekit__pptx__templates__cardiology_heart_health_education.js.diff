+
+function oval(s, x, y, w, h, fill, shadow) {
+
+  s.addShape('ellipse', {
+ x, y, w, h, fill: {
+ color: fill }
+, shadow: fx(shadow) }
+);
+
+}
+
+
+function star(s, x, y, d, fill) {
+
+  s.addShape('star5', {
+ x, y, w: d, h: d, fill: {
