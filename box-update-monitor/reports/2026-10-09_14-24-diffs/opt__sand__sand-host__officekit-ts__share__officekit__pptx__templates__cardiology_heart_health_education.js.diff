+function drawPath(s, x, y, w, h, fill, steps, extra) {
+
+  // custGeom point coordinates are shape-local (inches from the shape origin).
+  const pts = steps.map(p => {
+
+    if (p.length === 0) return {
+ close: true }
+;
+
+    if (p.length === 6) {
+
+      return {
+ x: p[4] * w, y: p[5] * h,
+               curve: {
+ type: 'cubic', x1: p[0] * w, y1: p[1] * h,
+                                       x2: p[2] * w, y2: p[3] * h }
+ }
+;
+
+    }
+
+    return {
+ x: p[0] * w, y: p[1] * h }
+;
+
+  }
+);
+
+  s.addShape('custGeom', Object.assign({
+ x, y, w, h, fill: {
+ color: fill }
+, points: pts }
+, extra));
+
+}
