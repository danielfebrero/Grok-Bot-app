+ tl: [false, false], tr: [true, false], bl: [false, true], br: [true, true] }
+[corner];
+
+  drawPath(s, x, y, d, d, fill, ART.quarter, {
+ flipH: flip[0], flipV: flip[1], shadow: fx(shadow) }
+);
+
+}
