+    { x: 0.0000, y: 0.5000, c: [0.4422, 0.6065, 0.3935, 0.5578] },
+    { x: 0.5000, y: 0.0000, c: [0.3935, 0.4422, 0.4422, 0.3935] },
+    { x: 1.0000, y: 0.5000, c: [0.5578, 0.3935, 0.6065, 0.4422] },
