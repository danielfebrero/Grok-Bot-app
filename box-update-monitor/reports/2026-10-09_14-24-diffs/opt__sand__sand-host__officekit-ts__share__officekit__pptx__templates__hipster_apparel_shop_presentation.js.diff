+/**
+ * Free-form shape from a normalised outline.
+ *   start = [x, y]                    (0..1 inside the bounding box)
+ *   segs  = [[x, y] | [c1x, c1y, c2x, c2y, x, y], ...]
+ */
+function outline(s, box, color, start, segs) {
+  const [x, y, w, h] = box;
+  const pt = (u, v) => ({ x: u * w, y: v * h });
+  const pts = [Object.assign({ moveTo: true }, pt(start[0], start[1]))];
+  segs.forEach((g) => {
+    if (g.length === 2) pts.push(pt(g[0], g[1]));
+    else pts.push({ x: g[4] * w, y: g[5] * h, curve: { type: 'cubic', x1: g[0] * w, y1: g[1] * h, x2: g[2] * w, y2: g[3] * h } });
+  });
+  pts.push({ close: true });
+  s.addShape('custGeom', { x, y, w, h, points: pts, fill: { color }, line: NOLINE });
+}
