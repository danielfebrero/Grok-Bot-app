+  if (o.caption) {
+    slide.addText('[image]', {
+      x: o.caseX, y: o.caseY + o.caseH / 2 - 0.18, w: o.caseW, h: 0.36,
+      fontFace: MINOR, fontSize: 10, color: 'FFFFFF', align: 'center', valign: 'middle',
+    });
+  }
+}
+
+/**
+ * Browser-window pictogram: rounded frame, title bar with three dots and a
+ * filled motif — stands in for the deck's outlined browser / monitor glyphs.
+ */
+function iconTile(slide, [x, y, w, h], o = {}) {
+  const color = o.color || C.slate;
+  const bar = h * 0.22;
+  slide.addShape('roundRect', {
+    x, y, w, h, rectRadius: 0.12, fill: { color: o.fill || C.white }, line: { color, width: 2 },
+  });
+  slide.addShape('rect', { x, y, w, h: bar, fill: { color } });
+  for (let i = 0; i < 3; i++) {
+    slide.addShape('ellipse', {
+      x: x + w * (0.1 + i * 0.09), y: y + bar * 0.32, w: bar * 0.32, h: bar * 0.32,
+      fill: { color: o.fill || C.white },
+    });
+  }
+  slide.addShape('ellipse', {
+    x: x + w * 0.42, y: y + bar + h * 0.13, w: w * 0.16, h: h * 0.2, fill: { color },
+  });
+  slide.addShape('chord', {
+    x: x + w * 0.3, y: y + bar + h * 0.3, w: w * 0.4, h: h * 0.55, fill: { color },
+  });
+}
+
+/**
+ * Round line-art pictogram. `motif` picks the inner mark so the deck's
+ * globe / gear / stopwatch / pie glyphs stay distinguishable.
+ */
+function iconRing(slide, [x, y, w, h], o = {}) {
+  const color = o.color || C.slate;
+  const ring = { color, width: 2.25 };
+  slide.addShape('ellipse', { x, y, w, h, fill: { type: 'none' }, line: ring });
+  if (o.motif === 'gear') {
+    slide.addShape('gear6', {
+      x: x + w * 0.2, y: y + h * 0.2, w: w * 0.6, h: h * 0.6, fill: { color },
+    });
+  } else if (o.motif === 'clock') {
+    slide.addShape('pie', {
+      x: x + w * 0.18, y: y + h * 0.18, w: w * 0.64, h: h * 0.64,
+      angleRange: [90, 260], fill: { color },
+    });
+    slide.addShape('rect', { x: x + w * 0.42, y: y - h * 0.06, w: w * 0.16, h: h * 0.12, fill: { color } });
+  } else if (o.motif === 'pie') {
+    slide.addShape('pie', {
+      x: x + w * 0.14, y: y + h * 0.14, w: w * 0.72, h: h * 0.72,
+      angleRange: [0, 250], fill: { color },
+    });
+  } else {
+    slide.addShape('ellipse', {
+      x: x + w * 0.3, y: y + h * 0.12, w: w * 0.4, h: h * 0.76,
+      fill: { type: 'none' }, line: { color, width: 1.25 },
+    });
+    slide.addShape('line', { x, y: y + h / 2, w, h: 0, line: { color, width: 1.25 } });
+  }
+}
