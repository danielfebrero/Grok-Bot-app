+    x: o.caseX, y: o.caseY, w: o.caseW, h: o.caseH, rectRadius: 0.16, fill: { color: '4A4A4C' },
+  });
+  slide.addShape('roundRect', {
+    x: o.caseX + 0.25, y: o.caseY + 0.11, w: o.caseW - 0.5, h: o.caseH - 0.22,
+    rectRadius: 0.05, fill: { color: C.watch },
