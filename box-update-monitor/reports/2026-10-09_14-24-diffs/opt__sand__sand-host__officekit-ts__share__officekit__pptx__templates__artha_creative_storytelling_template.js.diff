+const C = {
+  accent1: 'DAB6DE', // light orchid — rules, corner square, series 1
+  accent2: '917AA8', // muted violet — series 2
+  accent3: 'CC8DB7', // dusty pink   — corner square, series 3
+  accent4: 'F7C3D2', // pale pink    — series 4
+  slate: '44546A', // tx2 — oversized numerals, line-art icons
+  text: '000000',
+  white: 'FFFFFF',
+  gray: '595959', // tx1 @ 65% — muted body copy (slide 27)
+  label: '7F7F7F', // tx1 @ 50% — chart data labels
+  grid: 'D9D9D9', // tx1 @ 15% — chart gridlines / axis lines
+  photo: 'D6D5D6', // average tone of the deck's photographs
+  star: 'FFC000',
+  starOff: 'ADACAC',
+  screen: 'E9E9EA', // blank device screen
+  bezel: '1A1A1A',
+  metal: 'C9CACC',
+  watch: 'E32D2D', // watch face artwork
+};
+
+const MAJOR = 'Roboto Slab'; // headings and numerals
+const MINOR = 'Raleway'; // body copy
+
+const TITLE_SZ = 32;
+const BODY_SZ = 12;
+const HEAD_SZ = 14;
+const RULE_PT = 3;
+
+/* ---------------------------------------------------------------- helpers */
+
+/** Thin accent rule — the deck's signature hairline. */
+function rule(slide, [x, y, w, h]) {
+  slide.addShape('line', { x, y, w, h, line: { color: C.accent1, width: RULE_PT } });
+}
+
+/** Corner squares bleeding off top-left and bottom-right + the slide's rules. */
+function frame(slide, rules) {
+  slide.addShape('rect', { x: 0, y: 0, w: 0.653, h: 0.653, fill: { color: C.accent1 } });
+  slide.addShape('rect', { x: 12.68, y: 6.847, w: 0.653, h: 0.653, fill: { color: C.accent3 } });
+  rules.forEach((r) => rule(slide, r));
+}
+
+/** Section title — 32pt Roboto Slab bold, 90% line spacing. */
+function title(slide, text, [x, y, w, h], o = {}) {
+  slide.addText(text, {
+    x, y, w, h,
+    fontFace: MAJOR, fontSize: o.size || TITLE_SZ, bold: true, color: C.text,
+    align: o.align || 'left', valign: o.valign || 'top',
+    lineSpacingMultiple: 0.9, rotate: o.rotate, charSpacing: o.charSpacing,
+  });
+}
+
+/** Bold sub-heading: "Description One", people's names, "Creative Story." */
+function heading(slide, text, [x, y, w, h], o = {}) {
+  slide.addText(text, {
+    x, y, w, h,
+    fontFace: MAJOR, fontSize: o.size || HEAD_SZ, bold: true, italic: o.italic,
+    color: o.color || C.text, align: o.align || 'left', valign: o.valign || 'top',
+    rotate: o.rotate, margin: o.margin,
+  });
+}
+
+/** Body copy — 12pt Raleway, justified, 1.5 line spacing. */
+function body(slide, text, [x, y, w, h], o = {}) {
+  slide.addText(text, {
+    x, y, w, h,
+    fontFace: MINOR, fontSize: BODY_SZ, color: o.color || C.text,
+    align: o.align || 'justify', valign: 'top', lineSpacingMultiple: 1.5,
+    rotate: o.rotate, margin: o.margin,
+  });
+}
+
+/** Oversized rotated statistic: "89%", "153k.", "2020." */
+function stat(slide, text, [x, y, w, h], o = {}) {
+  slide.addText(text, {
+    x, y, w, h,
+    fontFace: MAJOR, fontSize: o.size || 36, bold: true, color: o.color || C.slate,
+    align: o.align || 'right', valign: 'top', rotate: o.rotate === undefined ? 270 : o.rotate,
+  });
+}
+
+/** Stand-in for a photograph in the reference deck. */
+function photo(slide, [x, y, w, h], o = {}) {
+  slide.addShape(o.shape || 'rect', { x, y, w, h, fill: { color: C.photo } });
+  slide.addText('[image]', {
+    x, y: y + h / 2 - 0.18, w, h: 0.36,
+    fontFace: MINOR, fontSize: 10, color: '6F6F6F', align: 'center', valign: 'middle',
+  });
+}
+
+/** Stand-in for a device mockup: dark bezel wrapping a blank screen. */
+function device(slide, [x, y, w, h], o = {}) {
+  const b = o.bezel === undefined ? 0.14 : o.bezel;
+  const by = o.bezelY === undefined ? b : o.bezelY;
+  slide.addShape('roundRect', {
+    x, y, w, h, rectRadius: o.radius === undefined ? 0.06 : o.radius, fill: { color: C.bezel },
+  });
+  slide.addShape(o.screenRadius ? 'roundRect' : 'rect', {
+    x: x + b, y: y + by, w: w - 2 * b, h: h - 2 * by,
+    rectRadius: o.screenRadius, fill: { color: o.screen || C.screen },
+  });
+  if (o.caption !== false) {
+    slide.addText('[image]', {
+      x, y: y + h / 2 - 0.18, w, h: 0.36,
+      fontFace: MINOR, fontSize: 10, color: o.captionColor || '6F6F6F',
+      align: 'center', valign: 'middle',
+    });
+  }
+}
+
+/** Smartwatch stand-in: strap behind, dark case, coloured watch face. */
+function watch(slide, o) {
+  slide.addShape('roundRect', {
+    x: o.bandX, y: o.bandY, w: o.bandW, h: o.bandH, rectRadius: 0.12, fill: { color: '3B3B3D' },
+  });
