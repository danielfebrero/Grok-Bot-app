+const MAP_BOX = { x: 0.873, y: 1.295, w: 6.706, h: 4.910 };
+
+function mapPolygon(row, box) {
+    const pts = [];
+    for (let i = 1; i < row.length; i += 2) pts.push([row[i] * box.w, row[i + 1] * box.h]);
+    return pts;
+}
+
+/** Diagonal hatch clipped to an arbitrary polygon (used for the shaded states). */
+function hatchPolygon(slide, originX, originY, pts, step) {
+    const maxX = Math.max(...pts.map((p) => p[0]));
+    const minY = Math.min(...pts.map((p) => p[1]));
+    const maxY = Math.max(...pts.map((p) => p[1]));
+    const points = [];
+    // Lines run at 45 degrees: y = x - c. For each c, collect edge crossings.
+    for (let c = minY - maxX; c <= maxY; c += step) {
+        const hits = [];
+        for (let i = 0; i < pts.length; i++) {
+            const [ax, ay] = pts[i], [bx, by] = pts[(i + 1) % pts.length];
+            const fa = ay - ax - c, fb = by - bx - c;
+            if ((fa <= 0 && fb > 0) || (fb <= 0 && fa > 0)) {
+                const t = fa / (fa - fb);
+                hits.push(ax + t * (bx - ax));
+            }
+        }
+        hits.sort((a, b) => a - b);
+        for (let i = 0; i + 1 < hits.length; i += 2) {
+            if (hits[i + 1] - hits[i] < 0.01) continue;
+            points.push({ x: +hits[i].toFixed(3), y: +(hits[i] + c).toFixed(3), moveTo: true });
+            points.push({ x: +hits[i + 1].toFixed(3), y: +(hits[i + 1] + c).toFixed(3) });
+        }
+    }
+    if (!points.length) return;
+    slide.addShape('custGeom', {
+        x: originX, y: originY, w: MAP_BOX.w, h: MAP_BOX.h, points,
+        fill: { type: 'none' }, line: { color: BLACK, width: HATCH_WIDTH },
+    });
+}
+
+function mapPath(s, row) {
+    const pts = mapPolygon(row, MAP_BOX);
+    const points = pts.map(([x, y], i) => ({ x: +x.toFixed(3), y: +y.toFixed(3), moveTo: i === 0 }));
+    points.push({ close: true });
+    s.addShape('custGeom', {
+        x: MAP_BOX.x, y: MAP_BOX.y, w: MAP_BOX.w, h: MAP_BOX.h, points,
+        fill: { color: WHITE }, line: THIN_LINE,
+    });
+    if (row[0]) hatchPolygon(s, MAP_BOX.x, MAP_BOX.y, pts, HATCH_STEP);
+}
