+  slide.addShape('trapezoid', { x, y: deckY, w, h: deckH, rectRadius: slope, fill: { color: 'B4B4B7' }, line: { type: 'none' } });
+  slide.addShape('trapezoid', {
+    x: lidX - kbSlope + kbInset, y: deckY, w: lidW + 2 * kbSlope - 2 * kbInset, h: kbH,
