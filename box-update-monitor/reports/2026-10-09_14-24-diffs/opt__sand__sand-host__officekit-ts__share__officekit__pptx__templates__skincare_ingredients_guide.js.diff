+
+// Plain text box: PowerPoint text boxes are top-anchored, pptxgenjs defaults to middle.
+function txt(slide, text, o) {
+  slide.addText(text, Object.assign({
+    fontFace: SANS, fontSize: 18, color: C.ink, valign: 'top',
+  }, o));
+}
+
+// Filled rectangle (no outline) - the deck's basic building block.
+function rect(slide, x, y, w, h, color, opts) {
+  slide.addShape('rect', Object.assign({ x, y, w, h, fill: { color }, line: { type: 'none' } }, opts));
+}
+
+function oval(slide, x, y, d, color) {
+  slide.addShape('ellipse', { x, y, w: d, h: d, fill: { color }, line: { type: 'none' } });
+}
+
+// Horizontal / vertical rule
+function rule(slide, x, y, w, h, color, width) {
+  slide.addShape('line', { x, y, w, h, line: { color: color || C.ink, width: width || 1 } });
+}
+
+// Small caption above every section title, e.g. "Subheading Text"
+function eyebrow(slide, x, y, w, text, o) {
