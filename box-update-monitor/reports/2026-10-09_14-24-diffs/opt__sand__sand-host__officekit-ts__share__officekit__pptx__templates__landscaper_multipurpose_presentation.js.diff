+ type: 'none' }
+ }
+);
+
+  s.addShape('chevron', {
+ x: 0.54, y: 0.153, w: 0.194, h: 0.25,
+    fill: {
+ color: C.white }
+, line: {
+ type: 'none' }
+ }
+);
+
+  rect(s, 3.333, 7.343, 10.0, 0.157, C.tx2);
+
+}
+
+
+// Centred deck title + subtitle used by the infographic slides.
+function centreTitle(s, str, w) {
+
+  text(s, str, {
+ x: (13.333 - w) / 2, y: 0.52, w, h: 0.774, size: 40, bold: true,
+    face: FONT_H, color: '000000', align: 'center', wrap: false }
+);
+
+  subtitle(s, 5.834, 1.294, undefined, 'center');
+
+}
