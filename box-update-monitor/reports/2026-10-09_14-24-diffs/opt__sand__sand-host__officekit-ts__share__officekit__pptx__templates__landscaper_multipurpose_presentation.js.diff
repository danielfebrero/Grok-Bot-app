+/* ------------------------------------------------------------------ *
+ * Drawing helpers
+ * ------------------------------------------------------------------ */
+
+// Solid rectangle, no outline.
+function rect(s, x, y, w, h, color, transparency) {
+
+  s.addShape('rect', {
+ x, y, w, h, line: {
+ type: 'none' }
+,
+    fill: transparency ? {
+ color, transparency }
+ : {
+ color }
+ }
+);
+
+}
+
+
+// Free-form shape from a catalogue entry (or an inline sub-path list).
+function poly(s, key, x, y, w, h, color, opt = {
+}
+) {
+
+  const subs = typeof key === 'string' ? G[key] : key;
+
+  const pts = [];
+
+  for (const sub of subs) {
+
+    for (let i = 0;
+ i < sub.length;
+ i += 2) {
+
+      pts.push({
+ x: sub[i] * w, y: sub[i + 1] * h, ...(i === 0 ? {
+ moveTo: true }
+ : {
+}
+) }
+);
+
+    }
+
+    pts.push({
+ close: true }
+);
+
+  }
+
+  s.addShape('custGeom', {
+ x, y, w, h, points: pts, line: {
+ type: 'none' }
+,
+    fill: {
+ color }
+, ...opt }
+);
+
+}
+
+
+// One of the four line-art glyphs (target / monitor / browser / safe),
+// always drawn in white, centred on the given box.
+function icon(s, name, x, y, w, h) {
+
+  poly(s, name, x, y, w, h, C.white);
+
+}
+
+
+/* --- text ---------------------------------------------------------- *
+ * The template's text boxes use PowerPoint's default insets
+ * (0.1in left/right, 0.05in top/bottom) and are top-anchored.
+ */
+const INSET = [7.2, 7.2, 3.6, 3.6];
+   // pt: L, R, B, T
+
+function text(s, str, o) {
+
+  s.addText(str, {
+
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: o.face || FONT_B,
+    fontSize: o.size,
+    color: o.color || C.grey65,
+    bold: !!o.bold,
+    align: o.align || 'left',
+    valign: 'top',
+    wrap: o.wrap !== false,
+    margin: INSET,
+    charSpacing: o.spc,
+    lineSpacingMultiple: o.ls,
+  }
+);
+
+}
+
+
+// "ABOUT OUR / TITLE SLIDE" — the 40pt two-line section heading.
+function heading(s, x, y, lines, color, align) {
+
+  text(s, lines.map((t, i) => ({
+ text: t, options: {
+ breakLine: i < lines.length - 1 }
+ }
+)),
+    {
+ x, y, w: 3.557, h: 1.447, size: 40, bold: true, face: FONT_H,
+      color: color || '000000', wrap: false, align }
+);
+
+}
+
+
+// The small grey "Insert subtitle here" line that follows every heading.
+function subtitle(s, x, y, color, align) {
+
+  text(s, SUBTITLE, {
+ x, y, w: 1.666, h: 0.303, size: 12, wrap: false, align, color }
+);
+
+}
+
+
+// 10.5pt body paragraph at 150% leading.
+function body(s, str, x, y, w, h, color, align) {
+
+  text(s, str, {
+ x, y, w, h, size: 10.5, ls: 1.5, color: color || C.grey65, align }
+);
+
+}
+
+
+// 14pt bold caption used above every body blurb.
+function caption(s, x, y, color, align) {
+
+  text(s, TITLE_HERE, {
+ x, y, w: 1.559, h: 0.337, size: 14, bold: true,
+    face: FONT_H, color: color || '000000', wrap: false, align }
+);
+
+}
+
+
+// caption + body pair, the deck's basic "fact" block.
+function factBlock(s, x, y, o = {
+}
+) {
+
+  const align = o.align || 'left';
+
+  caption(s, o.capX !== undefined ? o.capX : x, y, o.capColor, align);
+
+  body(s, o.text || DONEC_LOR, x, y + 0.258, o.w || 2.302, o.h || 0.618, o.color, align);
+
+}
+
+
+// Big percentage figure (32pt by default).
+function percent(s, str, x, y, w, size) {
+
+  text(s, str, {
+ x, y, w, h: size >= 50 ? 1.01 : (size >= 36 ? 0.707 : 0.64),
+    size, face: FONT_H, color: C.white, align: 'center', wrap: false }
+);
+
+}
+
+
+/* --- photo stand-ins ----------------------------------------------- */
+
+// Flat plate standing in for a photograph. `shape` optionally names a
+// catalogue entry so clipped photos keep their silhouette.
+function photo(s, x, y, w, h, shape) {
+
+  if (shape === 'ellipse') {
+
+    s.addShape('ellipse', {
+ x, y, w, h, fill: {
+ color: C.photo }
+, line: {
+ type: 'none' }
+ }
+);
+
+  }
+ else if (shape) {
+
+    poly(s, shape, x, y, w, h, C.photo);
+
+  }
+ else {
+
+    rect(s, x, y, w, h, C.photo);
+
+  }
+
+  s.addText('[image]', {
+ x, y, w, h, fontFace: FONT_B, fontSize: 14,
+    color: C.photoInk, align: 'center', valign: 'middle' }
+);
+
+}
