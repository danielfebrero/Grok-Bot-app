+ * at 65% alpha over white (= F6DC90). pptxgenjs has no gradient fill, so the ramp
+ * is stepped with opaque strips of interpolated colour.
+ */
+const WASH_FROM = [0xf1, 0xca, 0x55];
+const WASH_TO = [0xf6, 0xdc, 0x90];
