+function gradientWash(s) {
+  const strips = 48, w = 13.333 / strips;
+  for (let i = 0; i < strips; i++) {
+    const t = i / (strips - 1);
+    const color = WASH_FROM
+      .map((from, c) => Math.round(from + (WASH_TO[c] - from) * t).toString(16).padStart(2, '0'))
+      .join('');
+    box(s, i * w, 0, w + 0.03, 7.5, color);
+  }
+}
