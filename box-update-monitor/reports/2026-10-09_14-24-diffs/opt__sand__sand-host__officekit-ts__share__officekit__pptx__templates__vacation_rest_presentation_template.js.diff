+    [0.876, 0.060, 0.026, 0.776],   // right edge
+    [0.100, 0.836, 0.802, 0.058],   // chin below the screen
+  ].forEach(bar => s.addShape('rect', { ...at(bar), ...lid }));
+  s.addShape('roundRect', { ...at([0.008, 0.894, 0.983, 0.082]), rectRadius: 0.5, fill: { color: 'C6C7C9' }, line: { type: 'none' } });
+  s.addShape('rect', { ...at([0.340, 0.894, 0.120, 0.018]), fill: { color: 'A9AAAC' }, line: { type: 'none' } });
+}
