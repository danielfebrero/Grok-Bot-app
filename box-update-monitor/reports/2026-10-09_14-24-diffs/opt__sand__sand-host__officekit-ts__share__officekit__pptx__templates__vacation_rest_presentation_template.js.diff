+// Flat colour rectangle.
+function box(s, x, y, w, h, color, o = {}) {
+  s.addShape('rect', {
+    x, y, w, h,
+    fill: { color, transparency: o.transparency },
+    line: { type: 'none' },
+    shadow: o.shadow ? SHADOWS[o.shadow]() : undefined,
+  });
+}
+
+// Flat colour circle / ellipse.
+function oval(s, x, y, w, h, color) {
+  s.addShape('ellipse', { x, y, w, h, fill: { color }, line: { type: 'none' } });
+}
+
+// Floating white panel; `kind` picks one of the four shadow recipes above.
+function card(s, x, y, w, h, kind = 'soft') {
+  s.addShape('rect', { x, y, w, h, fill: { color: C.white }, line: { type: 'none' }, shadow: SHADOWS[kind]() });
