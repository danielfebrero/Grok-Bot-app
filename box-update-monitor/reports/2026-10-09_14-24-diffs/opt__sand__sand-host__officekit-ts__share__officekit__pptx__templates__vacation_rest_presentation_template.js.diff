+// (The deck's other picture frames are empty layout placeholders and draw nothing.)
+function imageBox(s, x, y, w, h) {
+  const at = ([fx, fy, fw, fh]) => ({ x: x + fx * w, y: y + fy * h, w: fw * w, h: fh * h });
+  const lid = { fill: { color: '1F2124' }, line: { type: 'none' } };
