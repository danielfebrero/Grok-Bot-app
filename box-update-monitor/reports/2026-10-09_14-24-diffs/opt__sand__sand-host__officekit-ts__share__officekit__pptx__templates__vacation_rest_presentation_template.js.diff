+
+// Shared text-frame geometry: top anchored, auto-height, Open Sans 11pt grey.
+function textOpts(x, y, w, h, o) {
+  return {
+    x, y, w, h,
+    valign: 'top',
+    fit: 'resize',
+    wrap: o.wrap !== false,
+    align: o.align || 'left',
+    rotate: o.rotate,
+    fontFace: o.face || F.body,
+    fontSize: o.size || 11,
+    color: o.color || C.grey,
+    bold: !!o.bold,
+    lineSpacingMultiple: o.line,
+  };
+}
+
+function txt(s, x, y, w, h, text, o = {}) {
+  s.addText(text, textOpts(x, y, w, h, o));
+}
+
+// Text frame holding several differently formatted runs.
+function runs(s, x, y, w, h, parts, o = {}) {
+  s.addText(
