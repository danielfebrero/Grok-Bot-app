+/**
+ * @param ends (t) -> [low, high] positions of the outline's chord along the
+ *             bar direction at normal offset t, measured from the centre.
+ */
+function hatchBars(s, x, y, w, h, pitch, thick, ends, color, transparency, flipH) {
+  const u = Math.SQRT1_2; // 45-degree unit vector components
+  const span = w + h;
+  const cx = w / 2, cy = h / 2;
+  const quads = [];
+  for (let t = -span; t <= span; t += pitch) {
+    const a = ends(t), b = ends(t + thick);
+    if (a[1] - a[0] <= 0 && b[1] - b[0] <= 0) continue;
+    // corner = centre + offset*(u,u) + side*(u,-u)
+    const corner = (o, sd) => ['L', (cx + o * u + sd * u) / w, (cy + o * u - sd * u) / h];
+    const q = [corner(t, a[0]), corner(t, a[1]), corner(t + thick, b[1]), corner(t + thick, b[0])];
+    q[0][0] = 'M';
+    quads.push(...q, ['Z']);
+  }
+  custom(s, x, y, w, h, quads,
+    { fill: { color, transparency: transparency || 0 }, line: noLine, flipH: !!flipH });
