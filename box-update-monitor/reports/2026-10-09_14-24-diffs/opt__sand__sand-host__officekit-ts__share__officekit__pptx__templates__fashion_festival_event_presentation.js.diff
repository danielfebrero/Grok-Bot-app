+/** Striped rounded square — the small "card" motif. */
+function hatchSquare(s, x, y, w, h, color, transparency) {
+  const r = 0.11 * w;
+  const A = (w / 2) * Math.SQRT2, B = (h / 2) * Math.SQRT2;
+  const cut = (w / 2 + h / 2 - r * (2 - Math.SQRT2)) * Math.SQRT1_2; // 45-degree corner chamfer
