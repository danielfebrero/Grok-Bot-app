+  const a = r / w, b = r / h, ka = a * KAPPA, kb = b * KAPPA;
+  const [tl, tr, br, bl] = corners;
+  const p = [];
+  p.push(['M', tl ? a : 0, 0]);
+  p.push(['L', tr ? 1 - a : 1, 0]);
+  if (tr) p.push(['C', 1 - a + ka, 0, 1, kb, 1, b]);
+  p.push(['L', 1, br ? 1 - b : 1]);
+  if (br) p.push(['C', 1, 1 - b + kb, 1 - a + ka, 1, 1 - a, 1]);
+  p.push(['L', bl ? a : 0, 1]);
+  if (bl) p.push(['C', a - ka, 1, 0, 1 - b + kb, 0, 1 - b]);
+  p.push(['L', 0, tl ? b : 0]);
+  if (tl) p.push(['C', 0, b - kb, a - ka, 0, a, 0]);
+  p.push(['Z']);
+  custom(s, x, y, w, h, p, opts);
