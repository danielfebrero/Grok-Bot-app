+const RING_STEP = 0.295; // radial distance between rings
+const DOT_R0 = 0.0715;  // dot radius on the innermost ring
+const DOT_STEP = 0.0116; // dot shrink per ring
+const ARC_R0 = 0.268;   // arc distance between neighbouring dots
+const ARC_STEP = 0.006;
