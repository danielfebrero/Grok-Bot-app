+    if (c[0] === 'M') return { x: c[1] * w, y: c[2] * h, moveTo: true };
+    if (c[0] === 'L') return { x: c[1] * w, y: c[2] * h };
+    return {
+      x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h },
+    };
+  });
+  s.addShape('custGeom', Object.assign({ x, y, w, h, points: pts }, opts));
