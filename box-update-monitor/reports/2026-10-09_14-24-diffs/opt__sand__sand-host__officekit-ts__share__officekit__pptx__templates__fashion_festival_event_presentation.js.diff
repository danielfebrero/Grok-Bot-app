+function halftone(s, box, cx, cy, scale, color, transparency, rings) {
+  const [bx, by, bw, bh] = box;
+  const fill = { color: color || HALFTONE, transparency: transparency == null ? HALFTONE_T : transparency };
+  for (let k = 0; k < (rings || 6); k++) {
+    const R = (RING_R0 + RING_STEP * k) * scale;
+    const dot = (DOT_R0 - DOT_STEP * k) * scale;
+    const n = Math.max(1, Math.round((2 * Math.PI * R) / ((ARC_R0 - ARC_STEP * k) * scale)));
+    for (let i = 0; i < n; i++) {
+      const a = (2 * Math.PI * i) / n;
+      const x = cx + R * Math.cos(a) - dot;
+      const y = cy + R * Math.sin(a) - dot;
+      if (x < bx - 0.02 || y < by - 0.02 || x + 2 * dot > bx + bw + 0.02 || y + 2 * dot > by + bh + 0.02) continue;
