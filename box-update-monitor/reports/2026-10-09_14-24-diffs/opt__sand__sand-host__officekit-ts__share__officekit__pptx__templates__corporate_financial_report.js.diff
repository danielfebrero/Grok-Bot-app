+/* ------------------------------------------------------------------ *
+ * Small building blocks
+ * ------------------------------------------------------------------ */
+
+/** Flat rectangle. */
+function rect(slide, x, y, w, h, color, opts) {
+  slide.addShape('rect', Object.assign({ x, y, w, h, fill: { color } }, opts));
+}
+
+/** Grey stand-in for one of the deck's photographs. */
+function photo(slide, x, y, w, h, valign) {
+  slide.addText('[image]', {
+    shape: 'rect',
+    x, y, w, h,
+    fill: { color: PHOTO },
+    align: 'center',
+    valign: valign || 'middle',
+    fontFace: BODY,
+    fontSize: 12,
+    color: CAPTION,
+  });
+}
+
+/** Single-line auto-sized label (the deck's non-wrapping text boxes). */
+function label(slide, text, opts) {
+  slide.addText(
+    text,
+    Object.assign(
+      { fontFace: BODY, fontSize: SZ_COPY, color: INK, wrap: false, valign: 'top', h: 0.278 },
+      opts
+    )
+  );
+}
+
+/** Justified 10.5pt paragraph on 150% leading — the deck's body-copy style. */
+function para(slide, text, opts) {
+  slide.addText(
+    text,
+    Object.assign(
+      {
+        fontFace: BODY,
+        fontSize: SZ_COPY,
+        color: INK,
+        align: 'justify',
+        valign: 'top',
+        lineSpacingMultiple: 1.5,
+      },
+      opts
+    )
+  );
+}
+
+/** Archivo section title. */
+function title(slide, text, opts) {
+  slide.addText(
+    text,
+    Object.assign(
+      { fontFace: HEAD, fontSize: SZ_TITLE, bold: true, color: DARK, valign: 'top' },
+      opts
+    )
+  );
+}
+
+/** Filled rectangle carrying a centred bold caption (buttons, name plates). */
+function chip(slide, text, x, y, w, h, fill, color, fontSize) {
+  slide.addText(text, {
+    shape: 'rect',
+    x, y, w, h,
+    fill: { color: fill },
+    color,
+    align: 'center',
+    valign: 'middle',
+    bold: true,
+    fontFace: BODY,
+    fontSize: fontSize || SZ_LEAD,
+  });
+}
+
+/** Row of three small squares used as a decorative "…" marker. */
