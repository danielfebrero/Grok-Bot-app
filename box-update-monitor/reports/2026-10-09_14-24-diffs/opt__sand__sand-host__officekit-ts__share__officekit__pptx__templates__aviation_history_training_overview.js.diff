+
+/** Draw a normalised icon path inside the box (x, y, w, h). */
+function icon(slide, cmds, x, y, w, h, color, opts) {
+  // pptxgenjs path points are measured from the shape's own top-left corner.
+  const pts = [];
+  for (const c of cmds) {
+    const k = c[0];
+    if (k === 'M') pts.push({ x: c[1] * w, y: c[2] * h, moveTo: true });
+    else if (k === 'L') pts.push({ x: c[1] * w, y: c[2] * h });
+    else if (k === 'C') pts.push({
+      x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h },
+    });
+    else pts.push({ close: true });
+  }
+  slide.addShape('custGeom', Object.assign({ x, y, w, h, points: pts, fill: { color }, line: { type: 'none' } }, opts));
+}
+
+/** Solid shape with no outline. */
+function box(slide, type, o) {
+  slide.addShape(type, Object.assign({ line: { type: 'none' } }, o));
+}
+
+/** Pill / rounded button with a centred caption. */
+function pill(slide, x, y, w, h, bg, label, o) {
+  o = o || {};
+  box(slide, 'roundRect', { x, y, w, h, fill: { color: bg }, rectRadius: h / 2 });
+  slide.addText(label, {
+    x, y, w, h, align: 'center', valign: 'middle', fontFace: o.face || F.body,
+    fontSize: o.size || 10, bold: !!o.bold, color: o.color || C.white,
+  });
+}
+
+/** Plain text box; defaults mirror the deck's body style. */
+function txt(slide, text, o) {
+  slide.addText(text, Object.assign({
+    fontFace: F.body, fontSize: 10, color: C.black, valign: 'top', margin: [3.6, 7.2, 3.6, 7.2],
+  }, o));
+}
+
+/** Body paragraph: 10pt Open Sans on 1.5 line spacing. */
+function body(slide, text, x, y, w, h, o) {
+  txt(slide, text, Object.assign({ x, y, w, h, lineSpacingMultiple: 1.5 }, o));
+}
+
+/** Two-tone headline: black lead-in + blue tail, 36pt Montserrat bold. */
+function heading(slide, lead, tail, x, y, w, o) {
+  o = o || {};
+  const runs = [];
+  if (lead) runs.push({ text: lead, options: { color: o.color || C.black } });
+  if (tail) runs.push({ text: tail, options: { color: o.accent || C.blue } });
+  slide.addText(runs, Object.assign({
+    x, y, w, h: o.h || 0.707, fontFace: F.head, fontSize: o.size || 36, bold: true,
+    valign: 'top', align: o.align || 'left', margin: [3.6, 7.2, 3.6, 7.2],
+  }, o.opts));
+}
+
+/** Small grey eyebrow label above a heading. */
+function eyebrow(slide, text, x, y, w) {
+  txt(slide, text, { x, y, w, h: 0.37, fontSize: 16, fontFace: F.body });
+}
+
+/**
+ * Stands in for a bitmap in the source deck: a flat rectangle plus a caption.
+ * (The original also carries many *empty* picture placeholders; those show
+ * nothing when rendered and are therefore not reproduced here.)
+ */
+function photo(slide, x, y, w, h, o) {
+  o = o || {};
+  box(slide, o.shape || 'rect', {
+    x, y, w, h,
+    fill: { color: o.fill || 'EDEFF2' },
+    rectRadius: o.rectRadius,
+  });
+  slide.addText(o.label || '[image]', {
+    x, y, w, h, align: 'center', valign: 'middle',
+    fontFace: F.body, fontSize: o.size || 11, color: o.color || '9AA5AD',
+  });
+}
