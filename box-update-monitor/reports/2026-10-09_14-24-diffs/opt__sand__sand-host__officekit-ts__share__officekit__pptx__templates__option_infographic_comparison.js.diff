+/**
+ * Poly-line leader. `cap` is 'dot' (slide 6), 'diamond' (slides 12/15) or
+ * omitted for a plain line (slide 3).
+ */
+function leader(s, color, pts, cap) {
+
+    const ln = {
+ color: color, width: 1 }
+;
+
+    for (let i = 1;
+ i < pts.length;
+ i++) {
+
+        s.addShape('line', {
+ x: pts[i - 1][0], y: pts[i - 1][1], w: pts[i][0] - pts[i - 1][0], h: pts[i][1] - pts[i - 1][1], line: ln }
+);
+
+    }
+
+    if (!cap) return;
+
+    [pts[0], pts[pts.length - 1]].forEach(function (p) {
+
+        s.addShape(cap === 'diamond' ? 'diamond' : 'ellipse',
+            {
+ x: p[0] - 0.037, y: p[1] - 0.037, w: 0.074, h: 0.074, fill: {
+ color: color }
+ }
+);
+
+    }
+);
+
+}
