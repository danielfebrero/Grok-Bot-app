+/* ------------------------------------------------------------------ colour math */
+const hex = (c,i) => parseInt(c.substr(i*2,2),16);
+
+const rgb2hex = a => a.map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join('').toUpperCase();
+
+const mix = (a,b,t) => rgb2hex([0,1,2].map(i=>hex(a,i)+(hex(b,i)-hex(a,i))*t));
+
+/** flatten `color` at `alpha`% on top of opaque `over` */
+const over = (color, alpha, bg) => mix(bg, color, alpha/100);
+
+
+/* ------------------------------------------------------------------ geometry */
+const rectPoly = (x,y,w,h) => [[x,y],[x+w,y],[x+w,y+h],[x,y+h]];
+
+
+function rrPoly(x,y,w,h,r,seg){
+                       // rounded rectangle outline
+  seg = seg || 5;
+ r = Math.min(r, w/2, h/2);
+
+  const c = [[x+w-r,y+h-r,0],[x+r,y+h-r,90],[x+r,y+r,180],[x+w-r,y+r,270]], p = [];
+
+  c.forEach(([cx,cy,a0])=>{
+ for(let i=0;
+i<=seg;
+i++){
+ const a=(a0+90*i/seg)*Math.PI/180;
+
+    p.push([cx+r*Math.cos(a), cy+r*Math.sin(a)]);
+ }
+ }
+);
+
+  return p;
+
+}
+
+function ellPoly(cx,cy,rx,ry,seg){
+
+  seg = seg || 56;
+ const p=[];
+
+  for(let i=0;
+i<seg;
+i++){
+ const a=2*Math.PI*i/seg;
+ p.push([cx+rx*Math.cos(a), cy+ry*Math.sin(a)]);
+ }
+
+  return p;
+
+}
+
+/** Freeform outline: [x,y] = lineTo, [x1,y1,x2,y2,x,y] = cubic. First entry is the start point. */
+function flatten(pathArr, ox, oy, steps){
+
+  steps = steps || 8;
+ const out=[];
+ let cur=[pathArr[0][0], pathArr[0][1]];
+
+  out.push(cur);
+
+  for(let i=1;
+i<pathArr.length;
+i++){
+ const s=pathArr[i];
+
+    if(s.length===2){
+ cur=[s[0],s[1]];
+ out.push(cur);
+ }
+
+    else {
+ const [x1,y1,x2,y2,x,y]=s, p0=cur;
+
+      for(let k=1;
+k<=steps;
+k++){
+ const t=k/steps, u=1-t;
+
+        out.push([u*u*u*p0[0]+3*u*u*t*x1+3*u*t*t*x2+t*t*t*x,
+                  u*u*u*p0[1]+3*u*u*t*y1+3*u*t*t*y2+t*t*t*y]);
+ }
+
+      cur=[x,y];
+ }
+
+  }
+
+  return out.map(p=>[p[0]+(ox||0), p[1]+(oy||0)]);
+
+}
+
+/** keep the half-plane  nx*x + ny*y >= c  (Sutherland-Hodgman) */
+function clipHalf(poly,nx,ny,c){
+
+  const out=[], n=poly.length;
+
+  for(let i=0;
+i<n;
+i++){
+ const a=poly[i], b=poly[(i+1)%n];
+
+    const da=nx*a[0]+ny*a[1]-c, db=nx*b[0]+ny*b[1]-c;
+
+    if(da>=0) out.push(a);
+
+    if((da>=0)!==(db>=0)){
+ const t=da/(da-db);
+ out.push([a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t]);
+ }
+
+  }
+
+  return out;
+
+}
