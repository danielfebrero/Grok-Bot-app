+/** Linear gradient inside an arbitrary polygon, painted as nested colour steps.
+ *  pptxgenjs only emits solid fills, so a gradient is approximated by slicing the
+ *  polygon perpendicular to `ang` — one band roughly every 0.11 in. */
+function gradPoly(sl, poly, stops, ang, o){
+
+  o = o || {
+}
+;
+
+  const bg = o.over || BG;
+
+  const a = ang*Math.PI/180, dx=Math.cos(a), dy=Math.sin(a);
+
+  const pr = poly.map(p=>p[0]*dx+p[1]*dy);
+
+  const lo=Math.min(...pr), hi=Math.max(...pr);
+
+  const n = o.n || Math.max(8, Math.min(52, Math.ceil((hi-lo)/0.11)));
+
+  addPoly(sl, poly, Object.assign({
+ fill:{
+color: stopAt(stops,0,bg)}
+ }
+, o.base));
+
+  for(let k=1;
+k<n;
+k++){
+
+    const sub = clipHalf(poly, dx, dy, lo+(hi-lo)*k/n);
+
+    if(sub.length>2) addPoly(sl, sub, {
+ fill:{
+color: stopAt(stops, k/n, bg)}
+ }
+);
+
+  }
+
+}
