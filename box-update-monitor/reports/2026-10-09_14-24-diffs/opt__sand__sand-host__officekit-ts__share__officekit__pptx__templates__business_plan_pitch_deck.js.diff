+/* ------------------------------------------------------------------ drawing */
+function addPoly(sl, poly, opts){
+
+  const xs=poly.map(p=>p[0]), ys=poly.map(p=>p[1]);
+
+  const x=Math.min(...xs), y=Math.min(...ys);
+
+  const w=Math.max(1e-4, Math.max(...xs)-x), h=Math.max(1e-4, Math.max(...ys)-y);
+
+  sl.addShape('custGeom', Object.assign({
+ x, y, w, h, line:{
+type:'none'}
+,
+    points: poly.map(p=>({
+x:+(p[0]-x).toFixed(4), y:+(p[1]-y).toFixed(4)}
+)).concat([{
+close:true}
+])
+  }
+, opts));
+
+}
+
+/** straight stroked segment between two points */
+function seg(sl, p0, p1, col, wpt){
+
+  const x=Math.min(p0[0],p1[0]), y=Math.min(p0[1],p1[1]);
+
+  sl.addShape('custGeom',{
+x, y, w:Math.max(0.001,Math.abs(p1[0]-p0[0])), h:Math.max(0.001,Math.abs(p1[1]-p0[1])),
+    fill:{
+type:'none'}
+, line:{
+color:col, width:wpt}
+,
+    points:[{
+x:p0[0]-x,y:p0[1]-y}
+,{
+x:p1[0]-x,y:p1[1]-y}
+]}
+);
+
+}
+
+const ramp = (c1,c2) => [[0,c1,100],[100,c2,100]];
+
+/** sample a stop list [[pos%, color, alpha%], ...] at t in 0..1, flattened onto `bg` */
+function stopAt(stops, t, bg){
+
+  const p = t*100;
+ let i=0;
+
+  while(i<stops.length-2 && stops[i+1][0]<p) i++;
+
+  const a=stops[i], b=stops[i+1], u = b[0]===a[0] ? 0 : (p-a[0])/(b[0]-a[0]);
+
+  const col = mix(a[1], b[1], Math.max(0,Math.min(1,u)));
+
+  const al  = (a[2]===undefined?100:a[2]) + ((b[2]===undefined?100:b[2])-(a[2]===undefined?100:a[2]))*u;
+
+  return over(col, al, bg);
+
+}
