+/* Diagonal two-stop gradient card (accent2 -> bg1, corner to corner).
+   pptxgenjs has no gradient fill, so the ramp is painted as a stack of
+   custom-geometry regions {x/w + y/h <= u} anchored at the accent corner. Each
+   step is a little smaller than the last and adds the same amount of colour,
+   so the composite is a linear corner-to-corner ramp. */
+const GRAD_STEPS = 14;
+
+/* Outline of {x/w + y/h <= u} clipped to a rounded rectangle, walking
+   clockwise from the top of the accent corner's arc. */
+function diagonalRegion(w, h, r, u) {
+  const k = 0.5523 * r;                        // circle-to-bezier constant
+  const arc = (x, y, x1, y1, x2, y2) => ({ x: x, y: y, curve: { type: 'cubic', x1: x1, y1: y1, x2: x2, y2: y2 } });
+  const pts = [{ x: r, y: 0, moveTo: true }];
+  if (u <= 1) {
+    pts.push({ x: u * w, y: 0 }, { x: 0, y: u * h });
+  } else {
+    // the cut now clips the far corner instead: it meets the right edge at
+    // y = b and the bottom edge at x = a
+    const a = Math.max((u - 1) * w, r);
+    const b = Math.max((u - 1) * h, r);
+    pts.push({ x: w - r, y: 0 }, arc(w, r, w - r + k, 0, w, r - k));
+    pts.push({ x: w, y: b }, { x: a, y: h }, { x: r, y: h });
+    pts.push(arc(0, h - r, r - k, h, 0, h - r + k));
+  }
+  pts.push({ x: 0, y: r }, arc(r, 0, 0, r - k, r - k, 0), { close: true });
+  return pts;
+}
+
+/* `dark` names the corner holding the accent2 end: 'tl', 'tr', 'bl' or 'br'. */
+function gradCard(slide, o) {
+  const w = o.w, h = o.h, r = o.rectRadius;
+  const flipX = o.dark.indexOf('r') >= 0;
+  const flipY = o.dark.indexOf('b') >= 0;
+  const uMin = Math.max(r / w, r / h);         // keep the cut clear of the corner arc
+
+  shape(slide, 'roundRect', {
+    x: o.x, y: o.y, w: w, h: h, rotate: o.rotate || 0, rectRadius: r,
+    fill: { color: C.bg }, line: { type: 'none' }
+  });
+
+  for (let j = 1; j <= GRAD_STEPS; j++) {
+    const u = 2 - uMin - (2 - 2 * uMin) * (j - 1) / (GRAD_STEPS - 1);
+    slide.addShape('custGeom', {
+      x: o.x, y: o.y, w: w, h: h, rotate: o.rotate || 0,
+      fill: { color: C.sky, transparency: 100 * (1 - 1 / (GRAD_STEPS - j + 1)) },
+      line: { type: 'none' },
+      points: diagonalRegion(w, h, r, u).map(function (pt) {
+        if (pt.close) return pt;
+        const out = { x: flipX ? w - pt.x : pt.x, y: flipY ? h - pt.y : pt.y };
+        if (pt.moveTo) out.moveTo = true;
+        if (pt.curve) {
+          out.curve = {
+            type: 'cubic',
+            x1: flipX ? w - pt.curve.x1 : pt.curve.x1, y1: flipY ? h - pt.curve.y1 : pt.curve.y1,
+            x2: flipX ? w - pt.curve.x2 : pt.curve.x2, y2: flipY ? h - pt.curve.y2 : pt.curve.y2
+          };
+        }
+        return out;
+      })
