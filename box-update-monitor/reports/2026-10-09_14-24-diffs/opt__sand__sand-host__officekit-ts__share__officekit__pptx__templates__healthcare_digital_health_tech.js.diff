+/* Four rounded squares in a 3x3 grid - two outlined, two tinted. The group is
+   mirrored horizontally or vertically on some slides. */
+const DECO_CELLS = [
+  { col: 2, row: 0, solid: false },
+  { col: 1, row: 1, solid: true },
+  { col: 2, row: 2, solid: true },
