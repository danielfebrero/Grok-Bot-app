+// Grey stand-in for a photograph.
+function photo(slide, x, y, w, h, radius) {
+  slide.addShape(radius ? 'roundRect' : 'rect', {
+    x: x, y: y, w: w, h: h,
+    fill: { color: C.photo },
+    line: { type: 'none' },
+    rectRadius: radius || 0
