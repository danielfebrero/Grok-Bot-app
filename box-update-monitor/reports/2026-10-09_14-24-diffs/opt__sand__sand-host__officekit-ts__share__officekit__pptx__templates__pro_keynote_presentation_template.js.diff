+    align: {
+ l: 'left', c: 'center', r: 'right', j: 'justify' }
+[align],
+    valign: {
+ t: 'top', m: 'middle', b: 'bottom' }
+[valign],
+    margin: 3, isTextBox: true,
+  }
+;
+
+  if (typeof over === 'string') o.color = over;
+
+  else if (over) Object.assign(o, over);
