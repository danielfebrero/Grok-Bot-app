+// ------------------------------------------------------------------ helpers
+/** A text run. */
+function r(text, fontSize, fontFace, color, more) {
+
+  return {
+ text: text, options: Object.assign({
+ fontSize: fontSize, fontFace: fontFace, color: color }
+, more) }
