+    valign: o.va === "m" ? "middle" : "top",
+    x: x, y: y, w: w, h: h,
+    margin: 0, isTextBox: true, wrap: true,
+  };
+  if (o.lh) base.lineSpacingMultiple = o.lh;
+  if (typeof body === "string") { s.addText(body, base); return; }
+  const runs = body.map(function (r) {
+    return { text: r[0], options: { color: r[1] || base.color, fontSize: r[2] || base.fontSize } };
+  });
+  s.addText(runs, base);
+}
+
+/** Generic geometric shape. */
+function S(s, shape, x, y, w, h, o) {
+  o = o || {};
+  const opt = { x: x, y: y, w: w, h: h };
+  if (o.fill) opt.fill = o.alpha ? { color: o.fill, transparency: o.alpha } : { color: o.fill };
+  if (o.line) opt.line = { color: o.line, width: o.lw === undefined ? 1.5 : o.lw };
