+
+/* ------------------------------------------------- custom-geometry helper */
+
+const K = 0.5523; // circle -> cubic-bezier magic constant
+
+/** Convert fractional path commands (M/L/C/Z) into pptxgenjs `points`. */
+function pts(cmds, w, h) {
+  return cmds.map(c => {
+    if (c[0] === 'Z') return { close: true };
+    if (c[0] === 'M') return { x: c[1] * w, y: c[2] * h, moveTo: true };
+    if (c[0] === 'L') return { x: c[1] * w, y: c[2] * h };
+    return {
+      x: c[5] * w, y: c[6] * h,
+      curve: { type: 'cubic', x1: c[1] * w, y1: c[2] * h, x2: c[3] * w, y2: c[4] * h },
+    };
+  });
+}
+
+/** Free-form shape from fractional path commands. */
+function shape(s, cmds, o) {
+  s.addShape('custGeom', Object.assign({ points: pts(cmds, o.w, o.h) }, o));
+}
+
+/** Half ellipse as two cubics: side = -1 upper arc, +1 lower arc. */
+function arc(cx, cy, rx, ry, side) {
+  const sx = side > 0 ? 1 : -1; // travel direction along x
+  const dy = side * ry;
+  return [
+    ['C', cx + sx * rx, cy + K * dy, cx + sx * K * rx, cy + dy, cx, cy + dy],
+    ['C', cx - sx * K * rx, cy + dy, cx - sx * rx, cy + K * dy, cx - sx * rx, cy],
+  ];
+}
+
+/** Funnel band: wide elliptical rim on top, narrow rim at the bottom. */
+function bandPath(rxT, cyT, ryT, rxB, cyB, ryB) {
+  return [['M', 0.5 + rxT, cyT], ['L', 0.5 + rxB, cyB]]
+    .concat(arc(0.5, cyB, rxB, ryB, 1))
+    .concat([['L', 0.5 - rxT, cyT]])
+    .concat(arc(0.5, cyT, rxT, ryT, -1).map(c => c))
+    .concat([['Z']]);
+}
+
+/** Cone tip: apex at the top, elliptical bottom. */
+function conePath(cyB, ryB) {
+  return [['M', 0.5, 0], ['L', 1, cyB]]
+    .concat(arc(0.5, cyB, 0.5, ryB, 1))
+    .concat([['Z']]);
+}
