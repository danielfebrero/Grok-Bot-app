+  } else if (kind === 'note') {
+    s.addShape('roundRect', { x, y, w, h, rectRadius: w * 0.15, fill: f });
+    s.addShape('rect', { x: x + w * 0.2, y: y + h * 0.24, w: w * 0.6, h: h * 0.08, fill: { color: C.a4 } });
+    s.addShape('rect', { x: x + w * 0.2, y: y + h * 0.46, w: w * 0.6, h: h * 0.08, fill: { color: C.a4 } });
