+/**
+ * Rounded "chip" with a centred caption, e.g. `90% Develop`.
+ * `tw` is the width of the inner text box: in the source deck it is narrower
+ * than the chip, which is what makes a few captions wrap onto two lines.
+ */
+function chip(s, o) {
+  const tw = o.tw || o.w;
+  s.addShape('roundRect', {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    rectRadius: o.r === undefined ? Math.min(o.w, o.h) * 0.29 : o.r,
+    fill: { color: o.fill || C.a3 },
+  });
+  s.addText(o.text, {
+    x: o.x + (o.w - tw) / 2, y: o.y + (o.h - 0.34) / 2, w: tw, h: 0.34,
+    align: 'center', valign: 'top', wrap: !!o.tw,
+    fontFace: o.font || BODY, fontSize: o.size || 14, color: o.color || C.white,
