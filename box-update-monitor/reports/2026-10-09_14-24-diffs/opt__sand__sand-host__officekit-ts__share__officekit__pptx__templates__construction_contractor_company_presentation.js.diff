+// ---------------------------------------------------------------- design tokens
+const C = {
+  orange: 'DC5F00', // brand accent
+  dark:   '373A40', // panels + dark headings
+  light:  'EEEEEE', // page background + text on dark panels
+  yellow: 'FFC000', // the thin word-spacer runs inside titles
+  gray:   '404040', // theme tx1 @ 75% luminance
+};
