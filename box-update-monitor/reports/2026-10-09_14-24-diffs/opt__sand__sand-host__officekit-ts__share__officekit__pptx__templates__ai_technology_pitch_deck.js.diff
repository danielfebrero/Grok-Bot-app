+/**
+ * Recreation of "Ai Technology Template" (32 slides, 13.333 x 7.5 in) with pptxgenjs.
+ *
+ * Design notes
+ * ------------
+ * The source deck leans on OOXML gradient fills, which pptxgenjs does not expose.
+ * Gradients are therefore approximated with two readable helpers:
+ *   - `gradRect`  : bilinear wash built from horizontal + 50%-opacity vertical strips
+ *   - `gradShape` : concentric copies of a preset shape shrunk toward one corner
+ * Raster picture placeholders in the original are drawn as flat `[image]` panels.
+ */
+
+const path = require('path');
+const PptxGenJS = require('pptxgenjs');
+
+/* ---------------------------------------------------------------- palette */
+
+const BLUE = '5263AE';   // theme accent2
+const ORANGE = 'F47937'; // theme accent1
+const BLACK = '000000';
+const WHITE = 'FFFFFF';
+
+const FONT = 'Inter';     // body typeface
+const HEAD = 'Poppins';   // heading typeface
+
+const SLIDE_W = 13.333;
+const SLIDE_H = 7.5;
+
+/* ------------------------------------------------------------ color maths */
+
+const hex2rgb = (h) => [0, 2, 4].map((i) => parseInt(h.substr(i, 2), 16));
+const rgb2hex = (c) => c.map((v) => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, '0')).join('').toUpperCase();
+
+/** Linear blend of two hex colors; t=0 -> a, t=1 -> b. */
+function mix(a, b, t) {
+  const A = hex2rgb(a);
+  const B = hex2rgb(b);
+  return rgb2hex(A.map((v, i) => v + (B[i] - v) * Math.max(0, Math.min(1, t))));
+}
+
+/** Flatten a translucent color over an opaque one (alpha given in percent). */
+const over = (fg, alphaPct, bg) => mix(bg, fg, alphaPct / 100);
+
+/* ------------------------------------------------------------- primitives */
+
+/**
+ * The deck only ever uses two gradient ramps. `NIGHT` is the moody blue-to-black
+ * wash behind almost every slide and panel; `FLARE` is the warm blue-to-orange
+ * accent on cards, pills and bars. Mirrored variants come from `flip()`.
+ */
+const NIGHT = [BLUE, BLACK];
+const FLARE = [BLUE, ORANGE];
+
+/** Sample a ramp at 0..1. */
+function rampAt(ramp, t) {
+  const u = Math.max(0, Math.min(1, t)) * (ramp.length - 1);
+  const i = Math.min(ramp.length - 2, Math.floor(u));
+  return mix(ramp[i], ramp[i + 1], u - i);
+}
+
+/** Reverse a ramp (the deck uses several mirrored variants). */
+const flip = (ramp) => ramp.slice().reverse();
+
+/** Direction vectors keyed by OOXML gradient angle (degrees, y pointing down). */
+const DIR = { 0: [1, 0], 45: [1, 1], 90: [0, 1], 135: [-1, 1], 180: [-1, 0], 225: [-1, -1], 270: [0, -1], 315: [1, -1] };
+
+/**
+ * Rectangular gradient panel. A horizontal band pass plus a half-transparent
+ * vertical band pass compose into a bilinear ramp for the diagonal angles.
+ * `deg` is the direction the ramp travels, so 45 runs top-left -> bottom-right.
+ */
+function gradRect(s, o, ramp, deg, bands) {
+  const [dx, dy] = DIR[deg];
+  const n = bands || 26;
+  const diag = dx !== 0 && dy !== 0;
+  if (dx !== 0) {
+    // opaque pass: hairline overlap hides seams between bands
+    for (let i = 0; i < n; i++) {
+      const t = (i + 0.5) / n;
+      s.addShape('rect', {
+        x: o.x + (o.w * i) / n, y: o.y, w: o.w / n + 0.01, h: o.h,
+        fill: { color: rampAt(ramp, dx > 0 ? t : 1 - t) }, line: { type: 'none' },
+      });
+    }
+  }
+  if (dy !== 0) {
+    // translucent pass: butt-jointed, since overlapping would double-darken
+    for (let j = 0; j < n; j++) {
+      const t = (j + 0.5) / n;
+      s.addShape('rect', {
+        x: o.x, y: o.y + (o.h * j) / n, w: o.w, h: o.h / n,
+        fill: { color: rampAt(ramp, dy > 0 ? t : 1 - t), transparency: diag ? 50 : 0 }, line: { type: 'none' },
+      });
+    }
+  }
+}
+
+/** Full-bleed background wash: every slide but 14 and 32 uses this exact fill. */
+function wash(s, ramp, deg) {
+  gradRect(s, { x: 0, y: 0, w: SLIDE_W, h: SLIDE_H }, ramp || NIGHT, deg === undefined ? 45 : deg, 34);
+}
+
+/**
+ * Gradient fill for a non-rectangular preset shape. The silhouette is the
+ * full-size copy; `n` progressively smaller copies anchored to the corner the
+ * ramp runs away from paint the ramp back toward its start.
+ */
+function gradShape(s, shape, o, ramp, deg, bands) {
+  const [dx, dy] = DIR[deg];
+  const n = bands || 22;
+  for (let k = n; k >= 1; k--) {
+    const f = k / n;
+    const w = dx ? o.w * f : o.w;
+    const h = dy ? o.h * f : o.h;
+    s.addShape(shape, Object.assign({}, o, {
+      x: dx < 0 ? o.x + o.w - w : o.x,
+      y: dy < 0 ? o.y + o.h - h : o.y,
+      w, h,
+      fill: { color: rampAt(ramp, (k - 0.5) / n) },
+      line: { type: 'none' },
+    }));
+  }
+}
+
+/**
+ * Gradient fill for a stadium (fully rounded) bar. Plain `gradShape` would
+ * square off the leading cap once a copy gets narrower than the bar is tall,
+ * so copies here never shrink past that point and the ramp's first color is
+ * carried by a circle sitting exactly on the cap.
+ */
+function gradPill(s, o, ramp, bands) {
+  const n = bands || 30;
+  const r = o.h / 2;
+  for (let k = n; k >= 0; k--) {
+    const w = o.h + (o.w - o.h) * (k / n);
+    s.addShape('roundRect', {
+      x: o.x, y: o.y, w, h: o.h, rectRadius: r,
+      fill: { color: rampAt(ramp, (k + 0.5) / (n + 1)) }, line: { type: 'none' },
+    });
+  }
+}
