+/**
+ * Gradient fill for a big ellipse. Nesting (see `gradShape`) would show as
+ * crescent banding at this size, so the disc is instead built from horizontal
+ * chords whose width follows the ellipse, each chord carrying its own ramp.
+ */
+function gradOval(s, o, ramp, deg, rows, cols) {
+  const [dx, dy] = DIR[deg];
+  const nr = rows || 26;
+  const nc = cols || 14;
+  const a = o.w / 2;
+  const b = o.h / 2;
+  for (let j = 0; j < nr; j++) {
+    const y0 = (j / nr) * 2 - 1;          // chord edges in unit circle space
+    const y1 = ((j + 1) / nr) * 2 - 1;
+    const yn = Math.min(Math.abs(y0), Math.abs(y1));
+    const half = a * Math.sqrt(Math.max(0, 1 - yn * yn));
+    if (half <= 0) continue;
+    const tv = dy > 0 ? (j + 0.5) / nr : dy < 0 ? 1 - (j + 0.5) / nr : 0;
+    for (let i = 0; i < nc; i++) {
+      const th = dx > 0 ? (i + 0.5) / nc : dx < 0 ? 1 - (i + 0.5) / nc : 0;
+      const t = (tv + th) / (Math.abs(dx) + Math.abs(dy));
+      s.addShape('rect', {
+        x: o.x + a - half + (2 * half * i) / nc, y: o.y + b + y0 * b,
+        w: (2 * half) / nc + 0.008, h: (o.h / nr) + 0.008,
+        fill: { color: rampAt(ramp, t) }, line: { type: 'none' },
+      });
+    }
+  }
+}
+
+/** Solid preset shape, no outline. */
+function solid(s, shape, o, color) {
+  s.addShape(shape, Object.assign({ fill: { color }, line: { type: 'none' } }, o));
+}
+
+/** Outlined circle, no fill. */
+function ring(s, o, width, color) {
+  s.addShape('ellipse', Object.assign({ fill: { type: 'none' }, line: { color: color || WHITE, width: width || 1 } }, o));
