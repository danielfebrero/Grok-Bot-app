+}
+
+// Plain (untracked) Source Sans Pro heading, e.g. "About Us", "Project Goals".
+function sub(s, x, y, w, h, str, size, color, opts) {
+  text(s, x, y, w, h, str, Object.assign({ fontFace: F.sans, fontSize: size, color, fit: true }, opts));
