+  list.forEach(([x, y, h, tone, a]) => {
+    const seg = h / BAND_STEPS;
+    for (let i = 0; i < BAND_STEPS; i++) {
+      const t = tone === 'Y' ? i : BAND_STEPS - 1 - i;        // 0 = strongest end
+      const alpha = a * (1 - t / BAND_STEPS) * 0.55;
