+/**
+ * Small bar-chart icon built from rectangles; `variant` picks the silhouette
+ * so neighbouring icons in a list do not look identical.
+ */
+function barIcon(s, x, y, size, color, variant) {
+  const heights = { flat: [0.45, 0.65, 0.30], up: [0.28, 0.46, 0.68], down: [0.68, 0.46, 0.28] }[variant || 'flat'];
+  heights.forEach((hh, i) => rect(s, x + size * (0.11 + i * 0.26), y + size * (0.9 - hh), size * 0.16, size * hh, color));
+  rect(s, x + size * 0.05, y + size * 0.9, size * 0.9, size * 0.07, color);
+}
+
+/** Three stacked coins. */
+function coinIcon(s, x, y, size, color) {
