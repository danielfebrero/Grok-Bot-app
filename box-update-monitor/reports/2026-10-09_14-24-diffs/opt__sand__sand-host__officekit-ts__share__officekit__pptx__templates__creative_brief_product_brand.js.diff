+
+/* ---------------------------------------------------------------- helpers */
+function rect(s, x, y, w, h, color, more) {
+  s.addShape('rect', Object.assign({ x, y, w, h, fill: { color } }, more || {}));
+}
+
+function txt(s, text, o) {
+  // no `margin` override: PowerPoint's default text insets match the source deck
+  s.addText(text, Object.assign({ fontFace: MINOR, fontSize: 18, color: C.ink, valign: 'top' }, o));
+}
+
+/** 60pt Marcellus headline used on nearly every content slide. */
+function title(s, text, x, y, w, h, color, more) {
+  txt(s, text, Object.assign({ x, y, w, h, fontFace: MAJOR, fontSize: 60, bold: true, color: color || C.dark }, more || {}));
+}
+
+/** 12pt Lato paragraph with the deck's 1.3 line spacing. */
+function para(s, text, x, y, w, h, more) {
+  txt(s, text, Object.assign({ x, y, w, h, fontSize: 12, lineSpacingMultiple: 1.3 }, more || {}));
+}
+
+/** Grey panel standing in for a photograph. */
+function imagePanel(s, x, y, w, h, label) {
+  s.addText(label || 'Image placeholder', {
+    shape: 'rect', x, y, w, h, fill: { color: C.panel },
+    align: 'center', valign: 'middle', fontFace: MINOR, fontSize: 18, color: C.panelTxt,
+  });
+}
+
+function hLine(s, x, y, w, color, size) {
+  s.addShape('line', { x, y, w, h: 0, line: { color, width: size || 1 } });
+}
+
+/** Sage square holding a small white glyph. */
+function glyphTile(s, x, y, size, glyph, glyphSize, more) {
+  s.addShape('rect', Object.assign({ x, y, w: size, h: size, fill: { color: C.sage } }, more || {}));
+  txt(s, glyph, { x, y, w: size, h: size, align: 'center', valign: 'middle', fontSize: glyphSize, color: C.white, margin: 0 });
+}
