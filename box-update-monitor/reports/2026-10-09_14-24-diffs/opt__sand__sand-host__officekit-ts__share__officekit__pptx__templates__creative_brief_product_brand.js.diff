+/**
+ * Filled sparkline used twice on slide 20. Drawn in three layers because
+ * pptxgenjs cannot put a gradient inside a chart series:
+ *   1. grid + solid area   2. page-coloured fade strips   3. line + markers.
+ */
+function areaSpark(p, s, x, y, w, h, color, values) {
+  const labels = values.map((_, i) => String(i + 1));
+  const axes = {
+    showLegend: false, showValue: false, showTitle: false,
+    catAxisHidden: true, valAxisHidden: true, valAxisMinVal: 0, valAxisMaxVal: 100, valAxisMajorUnit: 33.34,
+  };
+  s.addChart('area', [{ name: 'fill', labels, values }], Object.assign({
+    x, y, w, h, chartColors: [color],
+    catGridLine: { color: C.panelTxt, size: 0.25, style: 'solid' },
+    valGridLine: { color: C.panelTxt, size: 0.25, style: 'solid' },
+    chartArea: { fill: { color: C.page } }, plotArea: { fill: { color: C.page } },
+  }, axes));
+  const STRIPS = 40;
+  for (let i = 0; i < STRIPS; i++) {
+    rect(s, x, y + (h * i) / STRIPS, w, h / STRIPS + 0.02, C.page,
+      { line: { type: 'none' }, fill: { color: C.page, transparency: Math.round(100 - (i * 74) / (STRIPS - 1)) } });
+  }
+  s.addChart('line', [{ name: 'line', labels, values }], Object.assign({
+    x, y, w, h, chartColors: [color], lineSize: 0.75,
+    lineDataSymbol: 'circle', lineDataSymbolSize: 4, lineDataSymbolLineColor: color,
+    catGridLine: { style: 'none' }, valGridLine: { style: 'none' },
+    chartArea: { fill: { color: C.page, transparency: 100 } }, plotArea: { fill: { color: C.page, transparency: 100 } },
+  }, axes));
+}
