+// Turn a normalised path table into pptxgenjs custGeom points (inches, shape-local).
+function scalePath(ops, w, h) {
+  return ops.map(op => {
+    const k = op[0];
+    if (k === 'Z') return { close: true };
+    if (k === 'M') return { x: op[1] * w, y: op[2] * h, moveTo: true };
+    if (k === 'L') return { x: op[1] * w, y: op[2] * h };
+    return {
+      x: op[5] * w, y: op[6] * h,
+      curve: { type: 'cubic', x1: op[1] * w, y1: op[2] * h, x2: op[3] * w, y2: op[4] * h },
+    };
+  });
+}
+
+function freeform(slide, ops, o) {
+  slide.addShape('custGeom', Object.assign({ points: scalePath(ops, o.w, o.h) }, o));
