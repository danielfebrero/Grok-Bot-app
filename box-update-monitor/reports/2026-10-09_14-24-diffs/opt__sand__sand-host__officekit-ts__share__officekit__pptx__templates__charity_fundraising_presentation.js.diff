+/** Solid rounded badge with the digit knocked out — "Our Target" quadrants. */
+function numberBadge(s, n, x, y, size, color, digitColor) {
+  box(s, S.roundRect, x, y, size, size, Object.assign(fill(color), { rectRadius: 0.12 }));
+  text(s, String(n), {
+    x, y, w: size, h: size, align: 'center', valign: 'middle', bold: true,
+    fontSize: Math.round(size * 42), color: digitColor,
+  });
+}
+
+/** Layered outline badge — the "counter" glyph on the world-map slide. */
+function counterBadge(s, n, x, y, size, color) {
+  box(s, S.rect, x, y + size * 0.14, size * 0.86, size * 0.86, stroke(color, 1.25));
+  box(s, S.rect, x + size * 0.14, y, size * 0.86, size * 0.86, stroke(color, 1.25));
+  text(s, String(n), {
+    x: x + size * 0.14, y, w: size * 0.86, h: size * 0.86,
+    align: 'center', valign: 'middle', bold: true, fontSize: Math.round(size * 30), color,
+  });
+}
