+/* ------------------------------------------------------------------ *
+ * Primitive helpers
+ * ------------------------------------------------------------------ */
+function box(s, kind, x, y, w, h, opts) {
+  s.addShape(kind, Object.assign({ x, y, w, h }, opts));
+}
+
+function rect(s, x, y, w, h, fill, opts) {
+  box(s, S.rect, x, y, w, h, Object.assign({ fill: { color: fill } }, opts));
+}
+
+function outline(s, x, y, w, h, lineColor, lineW) {
+  box(s, S.rect, x, y, w, h, {
+    fill: { type: 'none' },
+    line: { color: lineColor, width: lineW || 0.75 },
+  });
+}
+
+function hline(s, x, y, w, color, width) {
+  box(s, S.line, x, y, w, 0, { line: { color, width: width || 1 } });
+}
+
+function vline(s, x, y, h, color, width) {
+  box(s, S.line, x, y, 0, h, { line: { color, width: width || 1 } });
+}
+
+function text(s, str, o) {
+  s.addText(str, Object.assign({ margin: 0, valign: 'top', fontFace: F.sans, wrap: true }, o));
