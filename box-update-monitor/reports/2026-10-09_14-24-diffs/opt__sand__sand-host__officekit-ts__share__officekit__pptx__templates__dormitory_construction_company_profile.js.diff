+  s.addShape('line', { x: x + d * 13 * G, y: y + d * 23 * G, w: d * 35 * G, h: d * 27 * G, line });
+  s.addShape('line', { x: x + d * 48 * G, y: y + d * 50 * G, w: d * 35 * G, h: -d * 27 * G, line });
