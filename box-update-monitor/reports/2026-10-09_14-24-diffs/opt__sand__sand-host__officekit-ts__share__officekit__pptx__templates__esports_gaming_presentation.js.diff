+/**
+ * Master background: vertical gradient from 000000 (top) to 0A0A0A (bottom).
+ * pptxgenjs only does flat backgrounds, so it is painted as the same 11 steps
+ * a renderer quantizes that gradient into.
+ */
+function backdrop(slide, pageNo) {
+  for (let v = 0; v <= 10; v++) {
+    const y0 = Math.max(0, ((v - 0.5) / 10) * SLIDE_H);
+    const y1 = Math.min(SLIDE_H, ((v + 0.5) / 10) * SLIDE_H);
+    const hex = v.toString(16).toUpperCase().padStart(2, '0');
+    slide.addShape('rect', { x: 0, y: y0, w: SLIDE_W, h: y1 - y0, fill: { color: hex + hex + hex } });
+  }
+  if (pageNo) {
+    // Master's blue page-number tab, top right corner.
+    slide.addText(String(pageNo), {
+      x: 12.187, y: 0, w: 1.145, h: 0.54, shape: 'rect', fill: { color: BLUE },
+      align: 'center', valign: 'middle', fontFace: BODY, fontSize: 18, bold: true, color: WHITE,
+    });
+  }
+}
+
+/** Teko display headline; `parts` is a list of [text, color] pairs. */
+function headline(slide, o) {
+  slide.addText(o.parts.map(function (p) { return { text: p[0], options: { color: p[1] } }; }), {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: HEAD, fontSize: o.size || 44, bold: true,
+    align: o.align || 'left', valign: 'top', charSpacing: o.spc,
+  });
+}
+
+/** Small bold all-caps line (section eyebrow, stat caption, list heading). */
+function label(slide, o) {
+  slide.addText(o.text, {
+    x: o.x, y: o.y, w: o.w, h: o.h || 0.303,
+    fontFace: BODY, fontSize: o.size || 12, bold: o.bold !== false,
+    italic: !!o.italic, color: o.color || GOLD, align: o.align || 'left',
+    charSpacing: o.spc, valign: 'top',
+  });
+}
+
+/** 13pt justified body copy at 130% leading. */
+function para(slide, o) {
+  slide.addText(o.text, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fontFace: BODY, fontSize: o.size || 13, color: o.color || GREY,
+    align: o.align || 'justify', lineSpacingMultiple: o.line || 1.3, valign: 'top',
+  });
+}
+
+function rule(slide, o) {
+  slide.addShape('line', {
+    x: o.x, y: o.y, w: o.w, h: o.h || 0,
+    line: { color: o.color || BLUE, width: o.width || 4.5, dashType: o.dash },
+  });
+}
