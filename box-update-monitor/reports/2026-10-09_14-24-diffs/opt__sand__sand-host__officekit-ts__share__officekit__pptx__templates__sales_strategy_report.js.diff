+/** Thick stroke between two points, drawn as a rotated rectangle. */
+function bar(slide, x1, y1, x2, y2, thick, color) {
+  const dx = x2 - x1, dy = y2 - y1;
+  const len = Math.sqrt(dx * dx + dy * dy);
+  const deg = Math.atan2(dy, dx) * 180 / Math.PI;
+  rect(slide, (x1 + x2) / 2 - len / 2, (y1 + y2) / 2 - thick / 2, len, thick, color, { rotate: deg });
