+/**
+ * Paint a character grid; each run of identical characters becomes one bar.
+ * Rows are right-trimmed, so the nominal column count is passed in `cols`.
+ */
+function pixelMap(s, grid, cols, palette, x0, y0, w, h) {
+  const cw = w / cols;
+  const ch = h / grid.length;
+  grid.forEach((row, j) => {
+    let i = 0;
+    while (i < row.length) {
+      const c = row[i];
+      let k = i;
+      while (k < row.length && row[k] === c) k++;
+      if (palette[c]) box(s, x0 + i * cw, y0 + j * ch, (k - i) * cw + 0.003, ch + 0.003, palette[c]);
+      i = k;
+    }
+  });
+}
