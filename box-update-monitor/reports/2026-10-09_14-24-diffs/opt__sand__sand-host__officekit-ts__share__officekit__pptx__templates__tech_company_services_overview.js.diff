+/* ------------------------------------------------------------------ *
+ * Generic helpers
+ * ------------------------------------------------------------------ */
+function shape(slide, kind, o) {
+  slide.addShape(kind, Object.assign({ line: NOLINE }, o));
+}
+
+/** Solid rectangle. */
+function box(slide, x, y, w, h, color, transparency) {
+  shape(slide, pptx.ShapeType.rect,
+    { x, y, w, h, fill: Object.assign({ color }, transparency ? { transparency } : {}) });
+}
+
+/** Solid ellipse. */
+function oval(slide, x, y, w, h, color) {
+  shape(slide, pptx.ShapeType.ellipse, { x, y, w, h, fill: { color } });
+}
+
+/** Rounded rectangle. */
+function round(slide, x, y, w, h, color, radius) {
+  shape(slide, pptx.ShapeType.roundRect,
+    { x, y, w, h, fill: { color }, rectRadius: radius === undefined ? 0.09 : radius });
+}
+
+/** Straight rule; `o` may add dashType / beginArrowType / endArrowType. */
+function line(slide, x, y, w, h, color, width, o) {
+  slide.addShape(pptx.ShapeType.line,
+    { x, y, w, h, line: Object.assign({ color, width }, o || {}) });
+}
+
+/** Free polygon; `pts` are [u,v] fractions of the w x h bounding box. */
+function poly(slide, o) {
+  slide.addShape(pptx.ShapeType.custGeom, {
+    x: o.x, y: o.y, w: o.w, h: o.h,
+    fill: Object.assign({ color: o.color }, o.transparency ? { transparency: o.transparency } : {}),
+    line: NOLINE,
+    points: o.pts.map(p => ({ x: +(o.w * p[0]).toFixed(4), y: +(o.h * p[1]).toFixed(4) }))
+      .concat([{ close: true }])
+  });
+}
+
+/** Text box. Deck defaults: Source Sans Pro, no inset, top aligned. */
+function text(slide, body, o) {
+  slide.addText(body, Object.assign({
+    fontFace: SANS, margin: 0, valign: 'top', isTextBox: true, autoFit: false
+  }, o));
+}
+
+/* ------------------------------------------------------------------ *
+ * Deck-specific building blocks
+ * ------------------------------------------------------------------ */
+
+/** PT Serif headline; one array entry per line, 36pt / 40pt leading. */
+function title(slide, o) {
+  text(slide, (o.lines || [o.line]).map((t, i, a) => ({
+    text: t, options: { breakLine: i < a.length - 1 }
+  })), {
+    x: o.x, y: o.y, w: o.w, h: o.h || 0.561,
+    fontFace: SERIF, fontSize: o.size || 36, color: o.color || C.ink,
+    align: o.align || 'left', valign: o.valign || 'middle', lineSpacing: o.leading || 40
+  });
+}
+
+/** Grey body copy at 1.5 line spacing. */
