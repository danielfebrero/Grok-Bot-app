+  }, o));
+}
+
+/** Bold sub-heading. */
+function head(slide, body, o) {
+  text(slide, body, Object.assign({ fontSize: 14, bold: true, color: C.mid }, o));
+}
+
+/** 0.6 x 0.3 accent chip that bleeds off the left or right slide edge. */
+function chip(slide, x, y, color) {
+  box(slide, x, y, 0.6, 0.3, color);
+}
+
+/** Letter-spaced website line; pass rotate:270 for the vertical variant. */
+function www(slide, o) {
+  text(slide, WWW, Object.assign({
