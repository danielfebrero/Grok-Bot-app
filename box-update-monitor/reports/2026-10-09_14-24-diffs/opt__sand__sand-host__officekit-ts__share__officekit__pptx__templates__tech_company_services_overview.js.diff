+/**
+ * Flat stand-in for a device photograph, given the outer bezel rectangle and
+ * the inner screen rectangle measured off the original image.
+ */
+function device(slide, bezel, screen) {
+  round(slide, bezel.x, bezel.y, bezel.w, bezel.h, C.bezel, bezel.r === undefined ? 0.12 : bezel.r);
+  box(slide, screen.x, screen.y, screen.w, screen.h, C.white);
+  const cx = bezel.x + bezel.w / 2;
