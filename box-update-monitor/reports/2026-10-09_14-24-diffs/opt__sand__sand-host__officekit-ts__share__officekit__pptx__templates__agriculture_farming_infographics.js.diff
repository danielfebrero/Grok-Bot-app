+  slide.addShape(SH.ellipse, Object.assign(c(0.55), { fill: { color: C.pieMid } }));
+  slide.addShape(SH.pie, Object.assign(c(0.55), { fill: { color: chip.inner }, angleRange: chip.angles }));
+  slide.addShape(SH.ellipse, Object.assign(c(0.36), { fill: { color: C.white } }));
+  slide.addShape(SH.ellipse, Object.assign(c(0.12), { fill: { color: C.pieMid } }));
