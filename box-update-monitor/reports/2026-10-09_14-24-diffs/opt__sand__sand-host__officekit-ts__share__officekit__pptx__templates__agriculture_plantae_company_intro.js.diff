+  'flowChartSummingJunction', 'flowChartOr', 'flowChartCollate', 'flowChartSort', 'flowChartExtract', 'flowChartMerge',
+];
+function iconSheet(s, x0, y0, w, h, size) {
+  const cols = 12, rows = 6;
+  const dx = (w - size) / (cols - 1);
+  const dy = (h - size) / (rows - 1);
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      const x = x0 + c * dx;
+      const y = y0 + r * dy;
+      const g = GLYPHS[(r * cols + c) % GLYPHS.length];
+      s.addShape(g, { x, y, w: size, h: size, fill: { type: 'none' }, line: { color: C.orange, width: 3.5 } });
+    }
+  }
+}
