+/** Sheet of 72 outline pictograms (slides 39 and 40 of the original). */
+const GLYPHS = [
+  'leftArrow', 'upArrow', 'downArrow', 'rightArrow', 'leftRightArrow', 'upDownArrow', 'bentArrow', 'bentUpArrow',
+  'curvedRightArrow', 'curvedLeftArrow', 'curvedUpArrow', 'curvedDownArrow',
