+/* The "C" brand mark: a 270-degree ring whose notch faces right, with the
+   yellow pie wedge filling the inner hole. `d` is the outer diameter; the
+   visible width is 0.854*d because the notch clips the right side.       */
+function cMark(s, x, y, d, ringColor, ringAlpha, wedgeColor, wedgeAlpha) {
+  s.addShape('blockArc', {
+    x, y, w: d, h: d, angleRange: [45, 315], arcThicknessRatio: 0.4585,
+    fill: { color: ringColor, transparency: ringAlpha || 0 }, line: NONE,
+  });
+  if (wedgeColor) {
+    s.addShape('pie', {
+      x: x + 0.2294 * d, y: y + 0.2294 * d, w: 0.5413 * d, h: 0.5413 * d, angleRange: [315, 45],
+      fill: { color: wedgeColor, transparency: wedgeAlpha || 0 }, line: NONE,
+    });
+  }
+}
