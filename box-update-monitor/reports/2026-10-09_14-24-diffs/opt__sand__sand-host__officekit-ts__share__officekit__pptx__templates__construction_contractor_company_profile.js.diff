+   ellipse is scaled up to make the visible wedge match (x,y,w,h).      */
+function wedge(s, x, y, w, h, color, rotate) {
+  s.addShape('pie', {
+    x: x - w, y: y - h * 0.207, w: 2 * w, h: h * 1.414, angleRange: [315, 45],
