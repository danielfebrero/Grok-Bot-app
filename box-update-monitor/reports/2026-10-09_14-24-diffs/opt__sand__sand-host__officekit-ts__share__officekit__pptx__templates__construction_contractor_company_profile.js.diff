+/* ------------------------------------------------------------------ helpers */
+function txt(s, body, o) {
+  s.addText(body, Object.assign({
+    fontFace: F, fontSize: 12, color: DARK, align: 'left', valign: 'top',
+    margin: INSET, lineSpacingMultiple: 1,
+  }, o));
+}
+
+function box(s, x, y, w, h, color, o) {
