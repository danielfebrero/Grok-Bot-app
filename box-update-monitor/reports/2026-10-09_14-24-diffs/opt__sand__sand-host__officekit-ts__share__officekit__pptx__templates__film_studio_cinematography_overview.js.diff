+function mix(c1, c2, t) {
+    const ch = i => Math.round(parseInt(c1.substr(i, 2), 16) * (1 - t) + parseInt(c2.substr(i, 2), 16) * t);
+    return [ch(0), ch(2), ch(4)].map(v => v.toString(16).padStart(2, '0').toUpperCase()).join('');
