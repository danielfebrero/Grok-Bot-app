+    const steps = Math.max(4, Math.min(16, Math.round(w * 4)));
+    const sw = w / steps;
+    for (let i = 0; i < steps; i++) {
+        // slices overlap slightly so LibreOffice/PowerPoint show no hairlines
+        rect(slide, x + i * sw, y, sw + 0.006, h, mix(C.redDeep, C.red, (i + 0.5) / steps));
