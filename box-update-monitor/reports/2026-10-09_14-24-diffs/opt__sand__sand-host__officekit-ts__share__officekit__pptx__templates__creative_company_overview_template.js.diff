+/** Hub with `n` spokes and satellite dots — the "connected network" motif. */
+function hub(cx, cy, r, dots) {
+  const parts = [['ellipse', cx - 0.09 * r, cy - 0.09 * r, 0.18 * r, 0.18 * r]];
