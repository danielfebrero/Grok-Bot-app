+/**
+ * Draw icon `name` inside the square (x, y, s).
+ * `color` strokes/fills the glyph; `bg` fills its knocked-out parts.
+ */
+function icon(slide, name, x, y, s, color, weight, bg) {
+  const stroke = { color, width: Math.max(0.6, +(s * (weight || 1.5) / 24 * 72).toFixed(2)) };
+  const solid = { color };
+  const knockout = { color: bg || C.white };
+  const U = (v) => v * s;
+  const box = (d) => ({ x: x + U(d[1]), y: y + U(d[2]), w: U(d[3]), h: U(d[4]) });
+
+  ICONS[name].forEach((d) => {
+    const k = d[0];
+    if (k === 'l') {
+      const dx = U(d[3] - d[1]), dy = U(d[4] - d[2]);
+      slide.addShape('line', {
+        x: x + U(Math.min(d[1], d[3])), y: y + U(Math.min(d[2], d[4])),
+        w: Math.abs(dx), h: Math.abs(dy), flipH: dx < 0, flipV: dy < 0, line: stroke,
+      });
+    } else if (k === 'e' || k === 'E' || k === 'W') {
+      slide.addShape('ellipse', Object.assign(box(d),
+        k === 'e' ? { line: stroke } : { fill: k === 'E' ? solid : knockout, line: NO_LINE }));
+    } else if (k === 'r' || k === 'R') {
+      slide.addShape('roundRect', Object.assign(box(d),
+        { rectRadius: U(d[5]), rotate: d[6] || 0 },
+        k === 'r' ? { line: stroke } : { fill: solid, line: NO_LINE }));
+    } else if (k === 'A') {
+      slide.addShape('arc', Object.assign(box(d), { angleRange: [d[5], d[6]], line: stroke }));
+    } else if (k === 'P') {
+      slide.addShape('pie', Object.assign(box(d), { angleRange: [d[5], d[6]], fill: solid, line: NO_LINE }));
+    } else if (k === 'V') {
+      slide.addShape('triangle', Object.assign(box(d), { flipV: true, fill: knockout, line: NO_LINE }));
+    } else if (k === 'S' || k === 's') {
+      slide.addShape('star5', Object.assign(box(d),
+        { fill: k === 'S' ? solid : knockout, line: NO_LINE }));
+    }
+  });
