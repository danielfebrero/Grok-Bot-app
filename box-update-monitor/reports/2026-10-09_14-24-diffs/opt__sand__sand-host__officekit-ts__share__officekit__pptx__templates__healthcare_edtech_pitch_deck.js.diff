+    flipH: !!opt.flipH, flipV: !!opt.flipV,
+    points: [ // traced clockwise from the top edge; notch sits top-right
+      { x: r, y: 0, moveTo: true },
+      { x: w - nw - r, y: 0 }, arc(270, 90),
+      { x: w - nw, y: nh - r }, arc(180, -90),
+      { x: w - r, y: nh }, arc(270, 90),
+      { x: w, y: h - r }, arc(0, 90),
+      { x: r, y: h }, arc(90, 90),
+      { x: 0, y: r }, arc(180, 90),
