+# While no managed policy sets DefaultNotificationsSetting
+# (https://chromeenterprise.google/policies/#DefaultNotificationsSetting),
+# sites may ask to show notifications. Chrome's "Use quieter messaging"
+# setting shows such a request as a bell icon by the address bar instead of a
+# prompt over the page (https://support.google.com/chrome/answer/3220216), so
+# no screen click lands on Allow by accident. The profile's own value is kept
+# in the record and put back once a managed policy sets notifications again.
+SAND_QUIET_NOTIFICATIONS_RECORD="${CHROME_PROFILE}/.sand-quiet-notifications"
+sand_quiet_notification_prompts() {
+	local as_box=()
+	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
+	! profile_browser_pid >/dev/null || return 0
+	command -v python3 >/dev/null 2>&1 || return 0
+	"${as_box[@]}" python3 -I - "${SAND_CHROME_MANAGED_POLICY_DIR:-/etc/opt/chrome/policies/managed}" \
+		"${CHROME_PROFILE}/Default/Preferences" "${SAND_QUIET_NOTIFICATIONS_RECORD}" <<'SAND_QUIET_NOTIFICATIONS_EOF' || return 0
+import json, os, sys
+
+policy_dir, prefs, record = sys.argv[1:4]
+KEY = "notifications"
+
+
+def load(path):
+    with open(path, encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def managed_sets_notifications():
+    try:
+        names = os.listdir(policy_dir)
+    except OSError:
+        return False
+    for name in names:
+        try:
+            policy = load(os.path.join(policy_dir, name))
+        except (OSError, ValueError):
+            continue
+        if isinstance(policy, dict) and "DefaultNotificationsSetting" in policy:
+            return True
+    return False
+
+
+def write(path, value):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(f"{path}.tmp", "w", encoding="utf-8") as handle:
+        json.dump(value, handle, separators=(",", ":"))
+    os.replace(f"{path}.tmp", path)
+
+
+asking = not managed_sets_notifications()
+if not asking and not os.path.isfile(record):
+    sys.exit(0)
+try:
+    settings = load(prefs)
+except FileNotFoundError:
+    settings = {}
+except (OSError, ValueError):
+    sys.exit(1)
+if not isinstance(settings, dict):
+    sys.exit(1)
+profile = settings.get("profile", {})
+content = profile.get("content_settings", {}) if isinstance(profile, dict) else None
+quiet = content.get("enable_quiet_permission_ui", {}) if isinstance(content, dict) else None
+if not isinstance(quiet, dict):
+    sys.exit(1)
+
+
+def store():
+    content["enable_quiet_permission_ui"] = quiet
+    profile["content_settings"] = content
+    settings["profile"] = profile
+    write(prefs, settings)
+
+
+if asking:
+    if not os.path.isfile(record):
+        write(record, {KEY: quiet[KEY]} if KEY in quiet else {})
+    if quiet.get(KEY) is not True:
+        quiet[KEY] = True
+        store()
+    sys.exit(0)
+
+try:
+    saved = load(record)
+except (OSError, ValueError):
+    saved = {}
+if not isinstance(saved, dict):
+    saved = {}
+if KEY in saved:
+    if quiet.get(KEY) != saved[KEY] or KEY not in quiet:
+        quiet[KEY] = saved[KEY]
+        store()
+elif KEY in quiet:
+    del quiet[KEY]
+    store()
+os.remove(record)
+SAND_QUIET_NOTIFICATIONS_EOF
+}
