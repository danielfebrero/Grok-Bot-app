+export function buildWorkerFingerprintScript({
+  site,
+  generation,
+  documentCap = FINGERPRINT_DOCUMENT_UNIQUE_CAP,
+}) {
+  return `(${workerInstaller.toString()})(${JSON.stringify({ site, generation, documentCap })})`;
