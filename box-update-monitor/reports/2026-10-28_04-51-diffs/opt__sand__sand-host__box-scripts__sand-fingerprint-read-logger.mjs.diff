+    record: "read",
+    site: read.site,
+    vendor: VENDORS.has(read.vendor)
+      ? read.vendor
+      : classifyFingerprintVendor(read.scriptUrl, read.site),
+    surface: read.surface,
+    api: read.api,
+    argsSummary: read.argsSummary,
+    windowIndex,
+    reads: read.reads,
+    sampledBps,
+  };
