+	append_gtk_css_rule '#applicationsmenu-1 > button { padding-left: 6px; padding-right: 6px; }' || true
+}
+
+append_gtk_css_rule() {
+	local css="${HOME}/.config/gtk-3.0/gtk.css" rule="$1" line="" IFS=$' \t'
+	local -a words=()
+	mkdir -p "${css%/*}" || return 1
+	if [ -f "${css}" ]; then
+		while IFS= read -r line; do
+			read -r -a words <<<"${line//$'\r'/}"
+			[ "${words[*]}" != "${rule}" ] || return 0
+		done <"${css}"
+		read -r -a words <<<"${line//$'\r'/}"
+		[ "${words[*]}" != "${rule}" ] || return 0
+		[ -z "${line}" ] || printf '\n' >>"${css}" || return 1
+	fi
+	printf '%s\n' "${rule}" >>"${css}"
 }
 
