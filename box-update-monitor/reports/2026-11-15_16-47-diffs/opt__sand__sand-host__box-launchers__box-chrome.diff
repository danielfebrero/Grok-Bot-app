+				unsure=1
+			elif [ -z "${foreign}" ]; then
+				case "${name}" in
+				chrome) foreign=chrome ;;
+				node) foreign=node ;;
+				python*) foreign=python ;;
+				*) foreign=other ;;
+				esac
+			fi
+		done
+	done
+	if [ -n "${foreign}" ]; then
+		owner="${foreign}"
+	elif [ "${unsure}" -eq 1 ]; then
+		owner=unread
+	elif [ "${own}" -eq 1 ]; then
+		owner=browser
+	elif [ "${listening}" -eq 1 ]; then
+		owner=unknown
+	else
+		owner=none
+	fi
+	if [ "${wildcard}" -eq 1 ]; then
+		address=wildcard
+	elif [ "${odd}" -eq 1 ]; then
+		address=other
+	elif [ "${ipv4}" -eq 1 ] && [ "${ipv6}" -eq 1 ]; then
+		address=both_loopbacks
+	elif [ "${ipv4}" -eq 1 ]; then
+		address=ipv4_loopback
+	elif [ "${ipv6}" -eq 1 ]; then
+		address=ipv6_loopback
+	fi
+	printf '%s %s' "${owner}" "${address}"
