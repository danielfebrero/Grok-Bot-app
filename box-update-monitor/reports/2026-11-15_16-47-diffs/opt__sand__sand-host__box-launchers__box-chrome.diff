+# Who listens on the CDP port and where, from the socket table's process
+# column (https://man7.org/linux/man-pages/man8/ss.8.html). A listener that is
+# not this profile's browser is named by its executable name, from a closed set.
+# $1 is this profile's browser process, empty when there is none and unread
+# when it could not be looked up, in which case a holder named chrome is not
+# told apart. $2 is the time the read may take; a read that fails or is cut
+# off says so rather than that nothing listens.
+# Reads the socket table's rows for the port on its input and prints the
+# owner and the address they name.
+cdp_port_rows() {
+	local browser_pid="$1" local_address users rest name pid
+	local owner_re='\("([^"]*)",pid=([0-9]+)'
+	local listening=0 own=0 unsure=0 foreign="" ipv4=0 ipv6=0 wildcard=0 odd=0 owner address=""
+	while read -r _ _ _ local_address _ users; do
+		[ -n "${local_address}" ] || continue
+		listening=1
+		case "${local_address%:*}" in
+		127.0.0.1) ipv4=1 ;;
+		'[::1]') ipv6=1 ;;
+		0.0.0.0 | '*' | '[::]') wildcard=1 ;;
+		*) odd=1 ;;
