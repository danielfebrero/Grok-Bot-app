+# (https://curl.se/docs/manpage.html#--noproxy). $1 is the time it may take.
+cdp_timeout_probe() {
+	local out status=0 code="" connect="" class
+	out="$(timeout -s KILL "$1" curl --noproxy '*' --max-time 1 -sS -o /dev/null -w '%{http_code} %{time_connect}' \
