+# curl's exit status says how a request ended (https://everything.curl.dev/cmdline/exitcode.html).
+curl_result_class() {
+	case "$1" in
+	0) printf ok ;;
+	7) printf refused ;;
+	28) printf timeout ;;
+	52) printf empty_reply ;;
+	56) printf reset ;;
+	22) printf http_error ;;
+	5 | 97) printf proxy_error ;;
+	*) printf other ;;
+	esac
