+# The UA governor's configuredAcceptLanguage rule, so it can leave the default context's header to this flag.
+sand_accept_language() {
+	local LC_ALL=C list=""
+	local re='^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*(,[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*)*$'
+	if [ -f "$1" ] && [ ! -L "$1" ]; then
+		IFS= read -r -N 129 list 2>/dev/null <"$1" || true
+	fi
+	if [ "${#list}" -le 128 ] && [[ "${list}" =~ ${re} ]]; then
+		printf '%s' "${list}"
+	else
+		printf '%s' "en-US,en-GB,en"
+	fi
+}
+SAND_BROWSER_ACCEPT_LANGUAGE_FILE="${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US_FILE:-/tmp/sand-browser-accept-language-en-us}"
+SAND_ACCEPT_LANGUAGE_FLAGGED=0
+if [ -e "${SAND_BROWSER_ACCEPT_LANGUAGE_FILE}" ]; then
+	SAND_ACCEPT_LANGUAGE_FLAGGED=1
+	CHROME_FLAGS+=(--accept-lang="$(sand_accept_language "${SAND_BROWSER_ACCEPT_LANGUAGE_FILE}")")
+fi
 policy_status=0
