+
+function parseEnum(enumValues) {
+
+  const parserFn = (value) => {
+
+    if (enumValues.findIndex((v2) => v2 === value) === -1) {
+
+      throw new Error(
+        `Invalid value for enum: ${
+value}
+, expected one of: ${
+enumValues.join(", ")}
+`
+      );
+
+    }
+
+    return value;
+
+  }
+;
+
+  return Object.assign(parserFn, {
+ enumValues }
+);
+
+}
+
+function parseBoolean(value) {
+
+  if (typeof value !== "boolean") {
+
+    throw new Error(`Invalid value for boolean: ${
+value}
+`);
+
+  }
+
+  return value;
+
+}
+
+function parseString(value) {
+
+  if (typeof value !== "string") {
+
+    throw new Error(`Invalid value for string: ${
+value}
+`);
+
+  }
+
+  return value;
+
+}
+
+function parseNumber(value) {
+
+  if (typeof value !== "number") {
+
+    throw new Error(`Invalid value for number: ${
+value}
+`);
+
+  }
+
+  return value;
+
+}
+
+function parseStringArray(value) {
+
+  if (!Array.isArray(value)) {
+
+    throw new Error(`Invalid value for string array: ${
+value}
+`);
+
+  }
+
+  return value.map(parseString);
