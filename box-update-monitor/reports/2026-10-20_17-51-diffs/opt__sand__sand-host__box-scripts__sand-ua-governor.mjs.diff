+function readGovernorFingerprint(dir) {
+  try {
+    return governorCodeFingerprint(dir).fingerprint;
+  } catch (error) {
+    reportOnce(`governor code unreadable: ${errorClass(error)}`);
+    return null;
+  }
+}
