+export function createCodeUpdateWatch({
+  dir = GOVERNOR_DIR,
+  intervalMs = UPDATE_CHECK_INTERVAL_MS,
+  now = Date.now,
+  fingerprint = readGovernorFingerprint,
+} = {}) {
