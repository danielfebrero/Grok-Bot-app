+  let checkedAtMs = now();
+  let lastSeen = loaded;
+  let settled = null;
+  return {
+    loaded,
+    intervalMs,
+    poll() {
+      if (loaded == null || now() - checkedAtMs < intervalMs) return settled;
+      checkedAtMs = now();
+      const seen = fingerprint(dir);
+      settled = seen != null && seen === lastSeen && seen !== loaded ? seen : null;
+      lastSeen = seen;
