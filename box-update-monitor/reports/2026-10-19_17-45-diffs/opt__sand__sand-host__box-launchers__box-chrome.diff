+sand_url_host() {
+	local rest="${1#*://}"
+	rest="${rest%%[/?#]*}"
+	rest="${rest##*@}"
+	case "${rest}" in
+	\[*) rest="${rest%%]*}]" ;;
+	*) rest="${rest%%:*}" ;;
+	esac
+	while [ "${rest%.}" != "${rest}" ]; do rest="${rest%.}"; done
+	printf '%s' "${rest,,}"
+}
+
+sand_is_tailnet_host() {
+	local host="$1" suffix
+	for suffix in "${SAND_TAILNET_SUFFIXES[@]}"; do
+		[ "${host}" = "${suffix}" ] && return 0
+		case "${host}" in *".${suffix}") return 0 ;; esac
+	done
+	return 1
+}
