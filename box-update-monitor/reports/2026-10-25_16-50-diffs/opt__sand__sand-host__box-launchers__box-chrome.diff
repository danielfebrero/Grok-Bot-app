+# On Linux Chrome copies each CRX it installs into its temp dir and unpacks it
+# there, and an install it drops leaves both copies behind
+# (https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/sandboxed_unpacker.cc,
+# https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/updater/extension_downloader.cc).
+# Each profile keeps its own TMPDIR in its display's runtime dir, which
+# stop-window removes, and a cold launch empties it under the profile lock once
+# no browser holds the profile, so nothing in it belongs to a running Chrome.
+reset_chrome_tmpdir() {
+	local as_box=()
+	[ -n "${CHROME_TMPDIR:-}" ] || return 0
+	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
+	"${as_box[@]}" rm -rf -- "${CHROME_TMPDIR}" 2>/dev/null
+	"${as_box[@]}" mkdir -m 700 -- "${CHROME_TMPDIR}" 2>/dev/null || true
+}
