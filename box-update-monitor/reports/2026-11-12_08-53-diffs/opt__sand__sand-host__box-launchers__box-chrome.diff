+
+# curl sends a plain http request through the proxy that http_proxy, all_proxy
+# or ALL_PROXY names unless no_proxy covers the host
+# (https://curl.se/docs/manpage.html#ENVIRONMENT), so with one of them set the
+# readiness probe may never have reached this box's own CDP port.
+cdp_proxy_named() {
+	[ -n "${http_proxy:-}${all_proxy:-}${ALL_PROXY:-}" ]
+}
+
+cdp_answers_past_proxy() {
+	curl --noproxy '*' --max-time 1 -fsS "http://$1:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
+}
+
+cdp_timeout_state() {
+	local pid
+	if [ "${CHROME_PORT_HELD}" -ne 0 ]; then
+		printf held
+	elif pid="$(profile_browser_pid)" && process_running "${pid}"; then
+		if cdp_proxy_named && cdp_answers_past_proxy 127.0.0.1; then
+			if chrome_ready; then
+				printf listening
+			else
+				printf proxied
+			fi
+		elif cdp_answers_past_proxy '[::1]'; then
+			printf ipv6_only
+		elif cdp_port_listening; then
+			printf listening
+		else
+			printf silent
+		fi
+	elif display_up; then
+		printf exited
+	else
+		printf no_display
+	fi
+}
