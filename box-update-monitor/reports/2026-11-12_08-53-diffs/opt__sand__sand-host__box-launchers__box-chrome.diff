+box_chrome_launcher_commit() {
+	local commit="" version size
+	case "$1" in
+	/*/box-launchers/box-chrome) version="${1%/box-launchers/box-chrome}/version" ;;
+	*) return 0 ;;
+	esac
+	if [ ! -f "${version}" ] || [ -L "${version}" ]; then
+		return 0
+	fi
+	size="$(stat -c %s -- "${version}" 2>/dev/null)"
+	[ "${size}" -le 41 ] 2>/dev/null || return 0
+	IFS= read -r commit 2>/dev/null <"${version}" || true
+	case "${commit}" in
+	"" | *[!0-9a-f]*) return 0 ;;
+	esac
+	[ "${#commit}" -lt 7 ] || [ "${#commit}" -gt 40 ] || printf '%s' "${commit}"
+}
+BOX_CHROME_LAUNCHER_COMMIT="$(box_chrome_launcher_commit "$0")"
