+# Reads the leaf the firewall armed with the firewall's own reader, in a child
+# shell so sourcing it changes nothing here, and the browser's cgroup as the
+# kernel lists it (https://docs.kernel.org/admin-guide/cgroup-v2.html#processes).
+# The child is handed the state path, so a path the launcher's environment
+# names is not read. Each read is capped, so a state file that never answers
+# reads unknown. Prints nothing on an image that has no browser firewall.
+browser_firewall_state() {
+	local leaf pid membership status=0
+	[ -r "${BOX_BROWSER_FIREWALL_LIB:-}" ] || return 0
+	# shellcheck disable=SC2016
+	leaf="$(SAND_BROWSER_FIREWALL_STATE="${BOX_BROWSER_FIREWALL_STATE}" \
+		timeout "${BOX_BROWSER_FIREWALL_READ_S}" bash -c \
+		'. "$1" >/dev/null 2>&1 && sand_browser_firewall_armed_leaf 2>/dev/null' \
+		_ "${BOX_BROWSER_FIREWALL_LIB}")" || status=$?
+	if [ "${status}" -ge 124 ]; then
+		printf unknown
+	elif [ -z "${leaf}" ]; then
+		printf not_armed
+	elif pid="$(profile_browser_pid)" &&
+		membership="$(timeout "${BOX_BROWSER_FIREWALL_READ_S}" cat "${BOX_PROC_ROOT}/${pid}/cgroup" 2>/dev/null)"; then
+		if printf '%s\n' "${membership}" | grep -Eq "^0::/${leaf}(/|$)"; then
+			printf armed
+		else
+			printf not_joined
+		fi
+	else
+		printf unknown
+	fi
+}
