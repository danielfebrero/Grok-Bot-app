+export function createBoxHostAttestationReader({
+  socketPath,
+  requestImpl = http.request,
+  timeoutMs = BOX_HOST_ATTESTATION_TIMEOUT_MS,
+}) {
+  const payload = JSON.stringify({
+    surface: GROK_BOT_BOX_HOST_ATTESTATION_INFERENCE_CREDENTIAL_SURFACE,
+  });
+  return async () =>
+    await new Promise((resolve) => {
+      let settled = false;
+      const finish = (assertion) => {
+        if (settled) return;
+        settled = true;
+        resolve(assertion);
+      };
+      const req = requestImpl(
+        {
+          socketPath,
+          path: GROK_BOT_BOX_HOST_ATTESTATION_SOCKET_PATH,
+          method: "POST",
+          timeout: timeoutMs,
+          headers: {
+            "content-type": "application/json",
+            "content-length": Buffer.byteLength(payload),
+          },
+        },
+        (res) => {
+          if (res.statusCode !== 200) {
+            res.resume();
+            finish(undefined);
+            return;
+          }
+          const chunks = [];
+          let total = 0;
+          res.on("data", (chunk) => {
+            if (settled) return;
+            total += chunk.byteLength;
+            if (total > BOX_HOST_ATTESTATION_MAX_RESPONSE_BYTES) {
+              res.destroy();
+              finish(undefined);
+              return;
+            }
+            chunks.push(chunk);
+          });
+          res.on("end", () => {
+            if (settled) return;
+            try {
+              const parsed = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+              finish(
+                typeof parsed?.assertion === "string" && parsed.assertion.length > 0
+                  ? parsed.assertion
+                  : undefined,
+              );
+            } catch {
+              finish(undefined);
+            }
+          });
+          res.on("error", () => finish(undefined));
+        },
+      );
+      req.on("timeout", () => {
+        req.destroy();
+        finish(undefined);
+      });
+      req.on("error", () => finish(undefined));
+      req.end(payload);
+    });
+}
