+    try {
+      text = readBoxFile(BOX_FILE_FS, path, WALL_EVIDENCE_BOX_BOOT_ID_MAX_BYTES + 1)?.text?.split(
+        "\n",
+      )[0];
+    } catch {
+      return null;
+    }
+  }
+  return text !== undefined && BOOT_ID.test(text) && text !== WALL_EVIDENCE_BOX_BOOT_ID_UNKNOWN
