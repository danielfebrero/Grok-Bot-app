+const BOOT_ID = new RegExp(WALL_EVIDENCE_BOX_BOOT_ID_SOURCE);
+const BOX_FILE_FS = { openSync, fstatSync, readSync, closeSync };
+
+function readBoxFile(fs, path, maxBytes) {
+  let fd;
+  try {
+    fd = fs.openSync(path, constants.O_RDONLY | constants.O_NONBLOCK | constants.O_NOFOLLOW);
+  } catch (error) {
+    if (error?.code === "ENOENT") return undefined;
+    throw error;
+  }
+  try {
+    const stat = fs.fstatSync(fd);
+    if (!stat.isFile() || stat.size > maxBytes) return { stat };
+    const buffer = Buffer.alloc(maxBytes + 1);
+    const length = fs.readSync(fd, buffer, 0, buffer.length, 0);
+    return length > maxBytes ? { stat } : { stat, text: buffer.toString("utf8", 0, length) };
+  } finally {
+    fs.closeSync(fd);
+  }
+}
