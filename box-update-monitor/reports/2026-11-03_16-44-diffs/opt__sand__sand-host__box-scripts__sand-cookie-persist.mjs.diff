+function writeJsonFile(fs, path, value) {
+  const tmp = `${path}.${process.pid}.tmp`;
+  try {
+    fs.writeFileSync(tmp, JSON.stringify(value));
+    fs.renameSync(tmp, path);
+  } finally {
+    fs.rmSync?.(tmp, { force: true });
+  }
+}
