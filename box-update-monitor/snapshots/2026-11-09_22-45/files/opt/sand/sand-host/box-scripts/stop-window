#!/usr/bin/env bash
set -uo pipefail

STOP_MODE=stop
if [ "${1:-}" = "--park" ]; then
	STOP_MODE=park
	shift
fi
DISPLAY_NUM="${1:?display number required}"
DESKTOP_UNIT=":${DISPLAY_NUM}"
CHROME_PROFILE="/home/box/chrome-profile/Fork-${DISPLAY_NUM}"
CHROME_STOP_WAIT_TENTHS="${SAND_CHROME_STOP_WAIT_TENTHS:-100}"

if [ "${DISPLAY_NUM}" -le 1 ] 2>/dev/null; then
	echo "stop-window: refusing to stop primary desktop :${DISPLAY_NUM}" >&2
	exit 0
fi

# >>> box port table (from sand/src/shared/box/box-contract.ts; regenerate: pnpm --filter sand run gen:box-ports) >>>
WINDOW_TOKEN_DIR="/tmp/sand-window-tokens.d"
NOVNC_TOKEN_DIR="/tmp/sand-novnc-tokens.d"
EXEC_DAEMON_PORT=$((14000 + DISPLAY_NUM))
VNC_PORT=$((5900 + DISPLAY_NUM))
# <<< box port table <<<

if [ "${STOP_MODE}" = stop ]; then
	rm -f "${WINDOW_TOKEN_DIR}/${DISPLAY_NUM}"
fi

if [ -r /usr/local/bin/sand-desktop-supervise.sh ]; then
	# shellcheck source=/dev/null
	. /usr/local/bin/sand-desktop-supervise.sh
fi
if ! command -v sand_desktop_unregister_group >/dev/null 2>&1; then
	sand_desktop_unregister_group() { :; }
fi
sand_desktop_unregister_group "d${DISPLAY_NUM}"

SAND_DESKTOP_UNIT_LIB="${SAND_DESKTOP_UNIT_LIB:-/usr/local/bin/sand-desktop-unit.sh}"
if [ -r "${SAND_DESKTOP_UNIT_LIB}" ]; then
	# shellcheck source=/dev/null
	. "${SAND_DESKTOP_UNIT_LIB}"
fi
if ! command -v sand_desktop_unit_kill >/dev/null 2>&1; then
	sand_desktop_unit_kill() { :; }
fi

pids_on_port() {
	local port="$1"
	[ -n "${port}" ] || return 0
	if command -v ss >/dev/null 2>&1; then
		ss -lptnH "sport = :${port}" 2>/dev/null |
			grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
	elif command -v fuser >/dev/null 2>&1; then
		fuser "${port}/tcp" 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+$'
	fi
}

kill_pid() { [ -n "${1:-}" ] && kill "${1}" 2>/dev/null || true; }

profile_browser_pids() {
	local pid args
	for pid in $(pgrep -x chrome 2>/dev/null); do
		args="$( (tr '\0' '\n' <"/proc/${pid}/cmdline") 2>/dev/null || true)"
		printf '%s\n' "${args}" | grep -q '^--type=' && continue
		printf '%s\n' "${args}" | grep -qxF -- "--user-data-dir=${CHROME_PROFILE}" && printf '%s\n' "${pid}"
	done
}

stop_profile_browser() {
	local pids pid
	pids="$(profile_browser_pids)"
	[ -n "${pids}" ] || return 0
	for pid in ${pids}; do kill -TERM "${pid}" 2>/dev/null || true; done
	for _ in $(seq 1 "${CHROME_STOP_WAIT_TENTHS}"); do
		pids="$(profile_browser_pids)"
		[ -n "${pids}" ] || return 0
		sleep 0.1
	done
	echo "stop-window ${DISPLAY_NUM}: Chrome did not exit within the grace period; the unit sweep kills it" >&2
}

x11vnc_pids_on_port() {
	local port="$1" pid cmd
	[ -n "${port}" ] || return 0
	{
		pids_on_port "${port}"
		pgrep -f "[x]11vnc.*-rfbport ${port}" 2>/dev/null || true
	} | sort -un | while read -r pid; do
		[ -n "${pid}" ] || continue
		[ "${pid}" = "$$" ] && continue
		cmd="$( (tr '\0' ' ' <"/proc/${pid}/cmdline") 2>/dev/null || true)"
		case "${cmd}" in
		*x11vnc*) printf '%s\n' "${pid}" ;;
		esac
	done
}

reap_x11vnc_on_port() {
	local port="$1" pid remaining
	[ -n "${port}" ] || return 0
	for pid in $(x11vnc_pids_on_port "${port}"); do kill_pid "${pid}"; done
	for _ in $(seq 1 50); do
		remaining="$(x11vnc_pids_on_port "${port}")"
		[ -z "${remaining}" ] && return 0
		for pid in ${remaining}; do kill -9 "${pid}" 2>/dev/null || true; done
		sleep 0.1
	done
	if [ -n "$(x11vnc_pids_on_port "${port}")" ]; then
		echo "stop-window ${DISPLAY_NUM}: rfbport ${port} still held after reap; box-x11vnc will reap on the next launch" >&2
		return 1
	fi
	return 0
}

rm -f "${NOVNC_TOKEN_DIR}/${DISPLAY_NUM}"

stop_profile_browser

for pid in $(pids_on_port "${EXEC_DAEMON_PORT}"); do kill_pid "${pid}"; done

reap_x11vnc_on_port "${VNC_PORT}"

LOCK="/tmp/.X${DISPLAY_NUM}-lock"
if [ -f "${LOCK}" ]; then kill_pid "$(tr -dc '0-9' <"${LOCK}")"; fi

sand_desktop_unit_kill "${DESKTOP_UNIT}" "${CHROME_PROFILE}"

rm -f "${LOCK}" "/tmp/.X11-unix/X${DISPLAY_NUM}"
RUNTIME_PATHS=(
	"/tmp/xdg-runtime-box-${DISPLAY_NUM}"
	"/tmp/xdg-runtime-${DISPLAY_NUM}"
	"/tmp/sand-window-${DISPLAY_NUM}"
)
if [ "${STOP_MODE}" = stop ]; then
	RUNTIME_PATHS+=("${CHROME_PROFILE}")
fi
rm -rf "${RUNTIME_PATHS[@]}"

if [ "${STOP_MODE}" = park ]; then
	echo "sand window ${DISPLAY_NUM} parked"
	exit 0
fi
echo "sand window ${DISPLAY_NUM} stopped"
