fi
CHROME_FLAGS+=(
	--remote-debugging-port="${CHROME_DEBUG_PORT}"
	--remote-debugging-address=127.0.0.1
	--disable-blink-features=AutomationControlled
)
SAND_EGRESS_PROXY_ADDR=""
SAND_EGRESS_PROXY_FILE=/tmp/sand-egress-proxy
SAND_EGRESS_PROXY_ADDR=""
if [ -r "${SAND_EGRESS_PROXY_FILE}" ]; then
	SAND_EGRESS_PROXY_ADDR="$(sed -n 1p "${SAND_EGRESS_PROXY_FILE}" 2>/dev/null || true)"
fi

sand_tailnet_pac() {
	local fallback=DIRECT suffix
	[ -z "${SAND_EGRESS_PROXY_ADDR}" ] || fallback="PROXY ${SAND_EGRESS_PROXY_ADDR}"
	printf 'function FindProxyForURL(url, host) {\n'
	printf '  host = host.toLowerCase().replace(/\\.+$/, "");\n'
	printf '  if (host === "localhost" || host === "127.0.0.1" || host === "[::1]" || host === "::1") return "DIRECT";\n' # pragma: allowlist secret
	for suffix in "${SAND_TAILNET_SUFFIXES[@]}"; do
		printf '  if (host === "%s" || dnsDomainIs(host, ".%s")) return "PROXY 127.0.0.1:9";\n' "${suffix}" "${suffix}"
	done
	printf '  return "%s";\n}\n' "${fallback}"
}

if [ "${#SAND_TAILNET_SUFFIXES[@]}" -gt 0 ]; then
	CHROME_FLAGS+=(
		--proxy-pac-url="data:application/x-ns-proxy-autoconfig;base64,$(sand_tailnet_pac | base64 -w0)"
	)
elif [ -r "${SAND_EGRESS_PROXY_FILE}" ]; then
	if [ -n "${SAND_EGRESS_PROXY_ADDR}" ]; then
		CHROME_FLAGS+=(--proxy-server="http://${SAND_EGRESS_PROXY_ADDR}")
		SAND_EGRESS_PROXY_BYPASS_FLAG=${#CHROME_FLAGS[@]}
		CHROME_FLAGS+=(--proxy-bypass-list="localhost;127.0.0.1;[::1]") # pragma: allowlist secret
	fi
fi
SAND_BOX_BROWSER_RUNNING=/tmp/sand-box-browser-running
BOX_BROWSER_RUNNING_FILE="${SAND_BOX_BROWSER_RUNNING}-${CHROME_DEBUG_PORT}"
SAND_BOX_BROWSER_GPU_MODE=/tmp/sand-box-browser-gpu-mode
BOX_BROWSER_GPU_MODE_FILE="${SAND_BOX_BROWSER_GPU_MODE}-${CHROME_DEBUG_PORT}"
SAND_BOX_BROWSER_LAUNCH_MARKERS=/tmp/sand-box-browser-launch-markers
BOX_BROWSER_LAUNCH_MARKERS_FILE="${SAND_BOX_BROWSER_LAUNCH_MARKERS}-${CHROME_DEBUG_PORT}"
UNGOOGLED_CHROMIUM=/opt/ungoogled-chromium/chrome
box_browser_ungoogled_wanted() {
	[ "${SAND_BOX_BROWSER_UNGOOGLED:-0}" = "1" ] || [ -e "${SAND_BOX_BROWSER_UNGOOGLED_FILE:-/tmp/sand-box-browser-ungoogled}" ]
}
resolve_box_browser() {
	local ticks
	if [ ! -e "${BOX_BROWSER_RUNNING_FILE}" ]; then
		ticks=$((${SAND_BOX_BROWSER_GATE_WAIT_S:-5} * 10))
		while [ "${ticks}" -gt 0 ] && [ ! -e "${SAND_BOX_EXPERIMENTS_READY_FILE:-/tmp/sand-box-experiments-ready}" ]; do
			sleep 0.1
			ticks=$((ticks - 1))
		done
	fi
	if box_browser_ungoogled_wanted && [ -x "${UNGOOGLED_CHROMIUM}" ]; then
		printf ungoogled-chromium
	else
		printf chrome
	fi
}
UNGOOGLED_CHROMIUM_FLAGS=(
	"--enable-features=ReducedSystemInfo,SpoofWebGLInfo,SetIpv6ProbeFalse"
	"--disable-features=OptimizationGuideModelDownloading,OptimizationHintsFetching,OptimizationTargetPrediction,OptimizationHints,EnforcePrivacySandboxAttestations,Translate,MediaRouter,DialMediaRouteProvider,CalculateNativeWinOcclusion,InterestFeedContentSuggestions,CertificateTransparencyComponentUpdater,AutofillServerCommunication,PrivacySandboxSettings4,AutomationControlled,HttpsUpgrades"
	--webrtc-ip-handling-policy=disable_non_proxied_udp
)
BOX_BROWSER="$(resolve_box_browser)"
case "${BOX_BROWSER}" in
ungoogled-chromium) CHROME_BIN="${UNGOOGLED_CHROMIUM}" ;;
*) CHROME_BIN=google-chrome-stable ;;
esac
SAND_BOX_BROWSER_NO_LOCAL_DNS="${SAND_BOX_BROWSER_NO_LOCAL_DNS:-0}"
if [ -e "${SAND_BOX_BROWSER_NO_LOCAL_DNS_FILE:-/tmp/sand-box-browser-no-local-dns}" ]; then
	SAND_BOX_BROWSER_NO_LOCAL_DNS=1
fi
if [ "${SAND_BOX_BROWSER_NO_LOCAL_DNS}" = "1" ] && [ -n "${SAND_EGRESS_PROXY_BYPASS_FLAG:-}" ]; then
	CHROME_FLAGS[SAND_EGRESS_PROXY_BYPASS_FLAG]="--proxy-bypass-list=<-loopback>;localhost;127.0.0.1;[::1]" # pragma: allowlist secret
	CHROME_FLAGS+=("--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE localhost , EXCLUDE 127.0.0.1 , EXCLUDE ::1") # pragma: allowlist secret
fi
SAND_CHROME_DISABLE_QUIC="${SAND_CHROME_DISABLE_QUIC:-0}"
if [ -e "${SAND_CHROME_DISABLE_QUIC_FILE:-/tmp/sand-chrome-disable-quic}" ]; then
	SAND_CHROME_DISABLE_QUIC=1
fi
if [ "${SAND_CHROME_DISABLE_QUIC}" = "1" ]; then
	CHROME_FLAGS+=(--disable-quic)
fi
sand_box_chrome_extra_flag_allowed() {
	case "$1" in
	--disable-quic) return 0 ;;
	--disable-features=TLSTrustAnchorIDs) return 0 ;;
	*) return 1 ;;
	esac
}
sand_chrome_flag_present() {
	local want="$1" flag
	for flag in "${CHROME_FLAGS[@]}"; do
		[ "${flag}" = "${want}" ] && return 0
	done
	return 1
}
BOX_CHROME_EXTRA_FLAGS_FILE="${SAND_BOX_CHROME_EXTRA_FLAGS_FILE:-/tmp/sand-box-chrome-extra-flags}"
if [ -f "${BOX_CHROME_EXTRA_FLAGS_FILE}" ] && [ ! -L "${BOX_CHROME_EXTRA_FLAGS_FILE}" ]; then
	while IFS= read -r sand_extra_flag || [ -n "${sand_extra_flag}" ]; do
		sand_extra_flag="${sand_extra_flag%$'\r'}"
		sand_extra_flag="${sand_extra_flag#"${sand_extra_flag%%[![:space:]]*}"}"
		sand_extra_flag="${sand_extra_flag%"${sand_extra_flag##*[![:space:]]}"}"
		[ -n "${sand_extra_flag}" ] || continue
		sand_box_chrome_extra_flag_allowed "${sand_extra_flag}" || continue
		sand_chrome_flag_present "${sand_extra_flag}" && continue
		CHROME_FLAGS+=("${sand_extra_flag}")
	done <"${BOX_CHROME_EXTRA_FLAGS_FILE}"
fi
# The UA governor's configuredAcceptLanguage rule, so it can leave the default context's header to this flag.
sand_accept_language() {
	local LC_ALL=C list=""
	local re='^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*(,[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*)*$'
	if [ -f "$1" ] && [ ! -L "$1" ]; then
		IFS= read -r -N 129 list 2>/dev/null <"$1" || true
	fi
	if [ "${#list}" -le 128 ] && [[ "${list}" =~ ${re} ]]; then
		printf '%s' "${list}"
	else
		printf '%s' "en-US,en-GB,en"
	fi
}
SAND_BROWSER_ACCEPT_LANGUAGE_FILE="${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US_FILE:-/tmp/sand-browser-accept-language-en-us}"
