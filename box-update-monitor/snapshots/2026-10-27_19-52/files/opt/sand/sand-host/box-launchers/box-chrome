#!/usr/bin/env bash
# >>> box-chrome port table (from sand/src/shared/box/box-contract.ts; regenerate: pnpm --filter sand run gen:box-ports) >>>
SAND_BOX_CDP_PORT_BASE=9222
# <<< box-chrome port table <<<
/usr/local/bin/ensure-machine-id || true

if [ -n "${CURSOR_MCP_BROWSER_OPEN_LOG:-}" ]; then
	for sand_opened_url in "$@"; do
		case "${sand_opened_url}" in
		http://* | https://*)
			printf '%s\topen\t%s\n' "$(date +%s%3N)" "${sand_opened_url}" \
				>>"${CURSOR_MCP_BROWSER_OPEN_LOG}" 2>/dev/null || true
			;;
		esac
	done
fi

SAND_TAILNET_SUFFIX_FILE="${SAND_TAILNET_SUFFIX_FILE:-/var/lib/sand/tailnet/host-suffixes}"
SAND_TAILNET_SUFFIXES=()
sand_tailnet_add_suffix() {
	local suffix="${1,,}"
	suffix="${suffix#.}"
	suffix="${suffix%.}"
	case "${suffix}" in
	"" | *[!a-z0-9.-]* | .* | *. | *..*) return ;;
	*.*) ;;
	*) return ;;
	esac
	case " ${SAND_TAILNET_SUFFIXES[*]-} " in *" ${suffix} "*) return ;; esac
	SAND_TAILNET_SUFFIXES+=("${suffix}")
}
# The box env's list counts too, so a host list that failed to land on disk
# still keeps tailnet hosts out of the everyday profile.
if [ "${SAND_BOX_TAILNET_PROFILE:-0}" != "1" ]; then
	if [ -r "${SAND_TAILNET_SUFFIX_FILE}" ]; then
		while IFS= read -r sand_tailnet_suffix || [ -n "${sand_tailnet_suffix}" ]; do
			sand_tailnet_add_suffix "${sand_tailnet_suffix}"
		done <"${SAND_TAILNET_SUFFIX_FILE}"
	fi
	IFS=$', \t\n' read -r -d '' -a SAND_TAILNET_ENV_SUFFIXES <<<"${SAND_TAILNET_HOST_SUFFIXES:-}" || true
	for sand_tailnet_suffix in "${SAND_TAILNET_ENV_SUFFIXES[@]}"; do
		sand_tailnet_add_suffix "${sand_tailnet_suffix}"
	done
fi

sand_url_host() {
	local rest="${1#*://}"
	rest="${rest%%[/?#]*}"
	rest="${rest##*@}"
	case "${rest}" in
	\[*) rest="${rest%%]*}]" ;;
	*) rest="${rest%%:*}" ;;
	esac
	while [ "${rest%.}" != "${rest}" ]; do rest="${rest%.}"; done
	printf '%s' "${rest,,}"
}

sand_is_tailnet_host() {
	local host="$1" suffix
	for suffix in "${SAND_TAILNET_SUFFIXES[@]}"; do
		[ "${host}" = "${suffix}" ] && return 0
		case "${host}" in *".${suffix}") return 0 ;; esac
	done
	return 1
}

# An untrusted-turn clone is forked from the owner's box, so it inherits the
# tailnet host list but has no tailnet route. Tailnet hosts stay blocked in the
# everyday browser there, and the tailnet browser never starts.
SAND_UNTRUSTED_CLONE_MARKER="${SAND_UNTRUSTED_CLONE_MARKER:-/var/lib/sand/untrusted-clone/marker}"
if [ "${#SAND_TAILNET_SUFFIXES[@]}" -gt 0 ] && [ ! -e "${SAND_UNTRUSTED_CLONE_MARKER}" ]; then
	for sand_opened_url in "$@"; do
		case "${sand_opened_url}" in
		http://* | https://*)
			if sand_is_tailnet_host "$(sand_url_host "${sand_opened_url}")"; then
				exec "${SAND_TAILNET_CHROME:-/usr/local/bin/box-tailnet-chrome}" "$@"
			fi
			;;
		esac
	done
fi

if [ -r /usr/local/bin/box-cgroups.sh ]; then
