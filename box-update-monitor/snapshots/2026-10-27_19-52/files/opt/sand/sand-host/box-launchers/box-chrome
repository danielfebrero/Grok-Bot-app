		XDG_STATE_HOME="${SAND_CHROME_HOME}/.local/state"
		TMPDIR="${SAND_CHROME_HOME}/tmp"
	)
fi
if [ "$(id -u)" -eq 0 ]; then
	CHROME_ENV=(runuser -u box -- "${CHROME_ENV[@]}")
fi

chrome_ready() {
	curl --max-time 1 -fsS "http://127.0.0.1:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
}

# Headful Chrome serves CDP on 127.0.0.1:<port> and, when that is still held,
# on [::1]:<port> for the rest of its life
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/chrome/browser/devtools/remote_debugging_server.cc).
# Handing a launch to a browser that is shutting down makes Chrome start a
# second browser at once, and one that has not answered for 20 s is SIGKILLed
# without waiting for it to exit
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/chrome/browser/process_singleton_posix.cc);
# the new browser then aborts on the old SingletonLock or lands on [::1]. So
# box-chrome only hands a launch to a browser that answers CDP, keeps the
# browser running past its last window, and starts a new one only once the old
# process is gone and the port is free.
chrome_on_ipv6_only() {
	curl --max-time 1 -fsS "http://[::1]:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
}

process_running() {
	local state
	state="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null)" || return 1
	[ -n "${state}" ] && [ "${state%% *}" != Z ]
}

profile_browser_pid() {
	local pids pid
	pids="$(pgrep -d, -x chrome 2>/dev/null)" || return 1
	pid="$(ps -ww -o pid=,args= -p "${pids}" 2>/dev/null | awk -v want="--user-data-dir=${CHROME_PROFILE}" '
		{ for (i = 2; i <= NF; i++) if ($i ~ /^--type=/) next }
		{ for (i = 2; i <= NF; i++) if ($i == want) { print $1; exit } }')"
	[ -n "${pid}" ] && printf '%s' "${pid}"
}

cdp_port_listening() {
	[ -n "$(ss -ltnH "sport = :${CHROME_DEBUG_PORT}" 2>/dev/null)" ]
}

stop_browser() {
	local pid="$1" target="$1" end
	[ "$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d ' ')" = "${pid}" ] && target="-${pid}"
	kill -TERM -- "${target}" 2>/dev/null || true
	end=$((SECONDS + 3))
	while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do sleep 0.1; done
	process_running "${pid}" && kill -KILL -- "${target}" 2>/dev/null
	end=$((SECONDS + 10))
	while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do sleep 0.1; done
}

release_profile_browser() {
	local pid end
	if pid="$(profile_browser_pid)"; then
		if ! chrome_on_ipv6_only; then
			end=$((SECONDS + CHROME_RELEASE_GRACE_S))
			while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do
				chrome_ready && return 0
				sleep 0.1
			done
		fi
		process_running "${pid}" && stop_browser "${pid}"
		process_running "${pid}" && return 1
	fi
	end=$((SECONDS + CHROME_PORT_WAIT_S))
	while cdp_port_listening; do
		[ "${SECONDS}" -lt "${end}" ] || return 1
		sleep 0.1
	done
}

# Chrome on Linux keeps only the last value of a repeated switch
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/base/command_line.cc),
# so every --disable-features value is folded into the last such switch.
merge_disable_features() {
	local -n merge_flags="$1"
	local i last=-1 count=0 merged="" feature features=()
	for i in "${!merge_flags[@]}"; do
		case "${merge_flags[i]}" in --disable-features=*)
			last="${i}"
			count=$((count + 1))
			;;
		esac
	done
	[ "${count}" -gt 1 ] || return 0
	for i in "${last}" "${!merge_flags[@]}"; do
		case "${merge_flags[i]-}" in --disable-features=*) ;; *) continue ;; esac
		IFS=, read -r -a features <<<"${merge_flags[i]#--disable-features=}"
		for feature in "${features[@]}"; do
			[ -n "${feature}" ] || continue
			case ",${merged}," in *",${feature},"*) ;; *) merged+="${merged:+,}${feature}" ;; esac
		done
		[ "${i}" = "${last}" ] || unset 'merge_flags[i]'
	done
	merge_flags[last]="--disable-features=${merged}"
	merge_flags=("${merge_flags[@]}")
}

launch_chrome() {
	local flags=("${CHROME_FLAGS[@]}") env=("${CHROME_ENV[@]}")
	[ "${CHROME_BIN}" != "${UNGOOGLED_CHROMIUM}" ] || flags+=("${UNGOOGLED_CHROMIUM_FLAGS[@]}")
	merge_disable_features flags
	[ -z "${CHROME_TMPDIR:-}" ] || [ ! -d "${CHROME_TMPDIR}" ] || env+=(TMPDIR="${CHROME_TMPDIR}")
	setsid -f /usr/local/bin/box-bounded-log --run "${CHROME_LOG}" -- \
		"${env[@]}" \
		nice -n 10 "${CHROME_BIN}" "${flags[@]}" "$@" \
		</dev/null >/dev/null 2>&1 9>&-
}

# On Linux Chrome copies each CRX it installs into its temp dir and unpacks it
# there, and an install it drops leaves both copies behind
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/sandboxed_unpacker.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/updater/extension_downloader.cc).
# Each profile keeps its own TMPDIR in its display's runtime dir, which
# stop-window removes, and a cold launch empties it under the profile lock once
# no browser holds the profile, so nothing in it belongs to a running Chrome.
reset_chrome_tmpdir() {
	local as_box=()
	[ -n "${CHROME_TMPDIR:-}" ] || return 0
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	"${as_box[@]}" rm -rf -- "${CHROME_TMPDIR}" 2>/dev/null
	"${as_box[@]}" mkdir -m 700 -- "${CHROME_TMPDIR}" 2>/dev/null || true
}

lowercase_trimmed() {
	printf '%s' "$1" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'
}

# The UA governor's rule: a non-empty env value is on only for 1, on, or true;
# without one, the marker file is on, unless honor_contents and it says 0,
# off, or false.
marker_gate_on() {
	local env_value="$1" path="$2" honor_contents="$3" contents=""
	if [ -n "$(lowercase_trimmed "${env_value}")" ]; then
		case "$(lowercase_trimmed "${env_value}")" in
		1 | on | true) return 0 ;;
		*) return 1 ;;
		esac
	fi
	[ -e "${path}" ] || return 1
	[ "${honor_contents}" = 1 ] || return 0
	read -r contents 2>/dev/null <"${path}" || true
	case "$(lowercase_trimmed "${contents}")" in
	0 | off | false) return 1 ;;
	esac
	return 0
}

# The stealth markers in force for this cold launch, in the vocabulary order of
# SAND_BROWSER_LAUNCH_MARKERS. The ones this script applies read what it did;
# the governor's and the tunnel's read their markers as those readers do, at
# launch. The governor rereads its markers once a browser has no page open.
box_browser_launch_markers() {
	local markers=()
	marker_gate_on "${SAND_BROWSER_HARDWARE_PROFILE:-}" \
		"${SAND_BROWSER_HARDWARE_PROFILE_FILE:-/tmp/sand-browser-hardware-profile}" 1 &&
		markers+=(hardware_profile)
	marker_gate_on "${SAND_BOX_BROWSER_COHERENT_FINGERPRINT:-}" \
		"${SAND_BOX_BROWSER_COHERENT_FINGERPRINT_FILE:-/tmp/sand-box-browser-coherent-fingerprint}" 1 &&
		markers+=(coherent_fingerprint)
	[ -e "${SAND_BOX_BROWSER_WEBRTC_PROXY_ONLY_FILE:-/tmp/sand-box-browser-webrtc-proxy-only}" ] &&
		markers+=(webrtc_proxy_only)
	[ "${SAND_BOX_BROWSER_NO_LOCAL_DNS}" = "1" ] && [ -n "${SAND_EGRESS_PROXY_BYPASS_FLAG:-}" ] &&
		markers+=(no_local_dns)
	[ "${SAND_CHROME_DISABLE_QUIC}" = "1" ] && markers+=(disable_quic)
	[ -e "${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US_FILE:-/tmp/sand-browser-accept-language-en-us}" ] &&
		markers+=(accept_language)
	marker_gate_on "${SAND_BROWSER_EGRESS_TIMEZONE:-}" \
		"${SAND_BROWSER_EGRESS_TIMEZONE_FILE:-/tmp/sand-browser-egress-timezone}" 0 &&
		markers+=(egress_timezone)
	[ -e "${SAND_EGRESS_TUNNEL_FAIL_CLOSED_FILE:-/tmp/sand-egress-tunnel-fail-closed}" ] &&
		markers+=(fail_closed)
	printf '%s\n' "${markers[*]}"
}

record_box_browser() {
	printf '%s\n' "${BOX_BROWSER}" >"${BOX_BROWSER_RUNNING_FILE}.$$" &&
		mv -f "${BOX_BROWSER_RUNNING_FILE}.$$" "${BOX_BROWSER_RUNNING_FILE}" 2>/dev/null || true
	printf '%s\n' "${BOX_CHROME_GPU_MODE}" >"${BOX_BROWSER_GPU_MODE_FILE}.$$" &&
		mv -f "${BOX_BROWSER_GPU_MODE_FILE}.$$" "${BOX_BROWSER_GPU_MODE_FILE}" 2>/dev/null || true
	box_browser_launch_markers >"${BOX_BROWSER_LAUNCH_MARKERS_FILE}.$$" &&
		mv -f "${BOX_BROWSER_LAUNCH_MARKERS_FILE}.$$" "${BOX_BROWSER_LAUNCH_MARKERS_FILE}" 2>/dev/null || true
}

# Chromium 139 dies right after it starts serving CDP on a profile whose
# Default/Sync Data store Google Chrome 155 wrote. ungoogled-chromium blocks
# its own requests to Google's hosts and so never syncs
# (https://github.com/ungoogled-software/ungoogled-chromium/blob/master/README.md),
# so its cold launch drops the store and Chrome rebuilds it on its next launch.
drop_sync_store_for_ungoogled() {
	[ "${CHROME_BIN}" = "${UNGOOGLED_CHROMIUM}" ] || return 0
	[ ! -L "${CHROME_PROFILE}/Default" ] || return 0
	rm -rf -- "${CHROME_PROFILE}/Default/Sync Data" 2>/dev/null || true
}

use_running_browser() {
	local recorded=""
	read -r recorded 2>/dev/null <"${BOX_BROWSER_RUNNING_FILE}" || true
	if [ "${recorded}" = ungoogled-chromium ] && [ -x "${UNGOOGLED_CHROMIUM}" ]; then
		CHROME_BIN="${UNGOOGLED_CHROMIUM}"
	else
		CHROME_BIN=google-chrome-stable
	fi
}

# Chrome keeps session cookies only in memory
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/151.0.7922.169/net/cookies/cookie_monster.h),
# so a cold launch comes up without them until the saved cookie seed is pushed
# back in. That has to finish before Chrome is handed a URL: a page that loads
# first gets a fresh session cookie under the same name, and the seed then saves
# that value over the login.
restore_cookie_seed() {
	local out
	[ -s "${SAND_COOKIE_SEED:-}" ] && [ -x "${SAND_COOKIE_NODE:-}" ] && [ -r "${SAND_COOKIE_PERSIST:-}" ] || return 0
	out="$(timeout "${CHROME_COOKIE_RESTORE_WAIT_S:-5}" "${SAND_COOKIE_NODE}" "${SAND_COOKIE_PERSIST}" \
		--restore-port "${CHROME_DEBUG_PORT}" </dev/null 2>&1 9>&-)" || true
	[ -z "${out}" ] || printf '%s\n' "${out}" 2>/dev/null >>"${SAND_COOKIE_RESTORE_LOG:-/dev/null}" || true
}

# box-chrome-policy keeps session cookies past the last window by making each
# profile restore its last session, and Chrome restores it in the next window
# from the files it writes under Default/Sessions, or under
# Default/Sessions_Encrypted once its EncryptSessionStorage field trial is on
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/chrome/browser/sessions/session_service.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/components/sessions/core/command_storage_backend.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/components/sessions/core/command_storage_manager.cc).
# An empty folder Chrome cannot write leaves no session to restore, so a closed
# tab never comes back, and a running Chrome loses the file it has open.
lock_session_restore() {
	local default="${CHROME_PROFILE}/Default" folder sessions as_box=()
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	for folder in Sessions Sessions_Encrypted; do
		sessions="${default}/${folder}"
		if [ "$(stat -c %a "${sessions}" 2>/dev/null)" = 555 ] && [ -z "$(ls -A "${sessions}" 2>/dev/null)" ]; then
			continue
		fi
		[ -L "${sessions}" ] || "${as_box[@]}" chmod u+w -- "${sessions}" 2>/dev/null
		"${as_box[@]}" rm -rf -- "${sessions}" 2>/dev/null || continue
		{ [ -d "${default}" ] || "${as_box[@]}" mkdir -m 700 -- "${default}"; } 2>/dev/null &&
			"${as_box[@]}" mkdir -m 555 -- "${sessions}" 2>/dev/null || true
	done
}

# Both profiles share the box-chrome window class on one display, so the wait
# matches a visible window owned by this profile's own browser process.
chrome_window_up() {
	local pid
	pid="$(profile_browser_pid)" || return 1
	DISPLAY="${DISPLAY:-:1}" xdotool search --onlyvisible --pid "${pid}" >/dev/null 2>&1
}

wait_for_chrome() {
	local visible="$1" end=$((SECONDS + CHROME_LAUNCH_WAIT_S))
	CHROME_CDP_READY_MS=""
	while :; do
		if chrome_ready; then
			[ -n "${CHROME_CDP_READY_MS}" ] || CHROME_CDP_READY_MS="$(date +%s%3N)"
			if [ "${visible}" -eq 0 ] || chrome_window_up; then
				return
			fi
		fi
		[ "${SECONDS}" -lt "${end}" ] || return 1
		sleep 0.1
	done
}

next_launch_attempt() {
	local counter="${CHROME_PROFILE}/.sand-launch-count"
	local boot="${SAND_BOX_BOOT_ID:-${SAND_BOX_BOOT_STARTED_AT_MS:-unknown}}"
	local recorded_boot="" count=0
	read -r recorded_boot count 2>/dev/null <"${counter}" || true
	[ "${recorded_boot}" = "${boot}" ] && [ "${count}" -ge 0 ] 2>/dev/null || count=0
	count=$((count + 1))
	printf '%s %s\n' "${boot}" "${count}" 2>/dev/null >"${counter}" || true
	printf '%s' "${count}"
}

start_chrome() {
	local mode="$1" visible=1 started_ms attempt outcome duration_ms cdp_ready_ms launcher_fields
	shift
	[ "${mode}" = window ] || visible=0
	attempt="$(next_launch_attempt)"
	started_ms="$(date +%s%3N)"
	if [ "${CHROME_PORT_HELD}" -eq 0 ]; then
		if [ "${policy_status:-0}" = 3 ]; then
			echo "box-chrome: sand_box_browser_webrtc_proxy_only is on but its managed policy could not be written; not launching" >&2
			exit 1
		fi
		record_box_browser
		drop_sync_store_for_ungoogled
		reset_chrome_tmpdir
		launch_chrome --no-startup-window
	else
		use_running_browser
	fi
	if ! wait_for_chrome 0; then
		outcome=cdp_timeout
	else
		cdp_ready_ms="${CHROME_CDP_READY_MS}"
		restore_cookie_seed
		if [ "${visible}" -eq 0 ]; then
			outcome=ready
		else
			launch_chrome "$@"
			if wait_for_chrome 1; then outcome=ready; else outcome=window_timeout; fi
		fi
		CHROME_CDP_READY_MS="${cdp_ready_ms}"
	fi
	duration_ms=$((${CHROME_CDP_READY_MS:-$(date +%s%3N)} - started_ms))
	[ "${duration_ms}" -ge 0 ] || duration_ms=0
	launcher_fields=",\"launcher\":${BOX_CHROME_LAUNCHER_VERSION}"
	case "${SAND_BOX_CHROME_LAUNCHER_SOURCE:-}" in
	bundle | image) launcher_fields+=",\"launcherSource\":\"${SAND_BOX_CHROME_LAUNCHER_SOURCE}\"" ;;
	esac
	printf '{"kind":"chrome_launch","display":%s,"mode":"%s","attempt":%s,"outcome":"%s","durationMs":%s%s}\n' \
		"${BOX_DISPLAY_NUM:-1}" "${mode}" "${attempt}" "${outcome}" "${duration_ms}" "${launcher_fields}" \
		2>/dev/null >>"${SAND_BOX_TELEMETRY_LOG:-/tmp/sand-box-telemetry.log}" || true
	[ "${outcome}" = ready ]
}

exec 9>"${CHROME_PROFILE}/.sand-launch.lock"
flock -w 90 9 || exit 1
lock_session_restore

CHROME_PORT_HELD=0
chrome_ready || release_profile_browser || CHROME_PORT_HELD=1

# A force-installed extension gets NO incognito access by default, and Chrome
# reports that by simply not proxying: an incognito window falls through to
# Chrome's own WebAuthn stack, which in a box with no USB shows a "touch your
# key" dialog that can never be satisfied. Grant it the same way the
# chrome://extensions toggle does, by seeding the profile pref. Only while this
# profile's Chrome is down — a running Chrome rewrites Preferences from memory
# on exit and would drop the edit — and re-applied on every cold launch so a
# profile that lost the grant heals itself.
if [ -f "${SAND_WEBAUTHN_MARKER}" ] && [ -r "${SAND_WEBAUTHN_ID_FILE}" ] &&
	! chrome_ready && command -v python3 >/dev/null 2>&1; then
	SAND_INCOGNITO_SEED=(python3 -I -)
	if [ "$(id -u)" -eq 0 ]; then
		SAND_INCOGNITO_SEED=(runuser -u box -- python3 -I -)
	fi
	"${SAND_INCOGNITO_SEED[@]}" "${CHROME_PROFILE}/Default/Preferences" "$(cat "${SAND_WEBAUTHN_ID_FILE}")" <<'SAND_INCOGNITO_EOF' || true
import json, os, sys

prefs, extension_id = sys.argv[1], sys.argv[2]
try:
    with open(prefs, encoding="utf-8") as handle:
        settings = json.load(handle)
except (OSError, ValueError):
    settings = {}
entry = (
    settings.setdefault("extensions", {})
    .setdefault("settings", {})
    .setdefault(extension_id, {})
)
if entry.get("incognito") is not True:
    entry["incognito"] = True
    os.makedirs(os.path.dirname(prefs), exist_ok=True)
    with open(prefs, "w", encoding="utf-8") as handle:
        json.dump(settings, handle, separators=(",", ":"))
SAND_INCOGNITO_EOF
fi

SAND_ACCEPT_LANGUAGE_RECORD="${CHROME_PROFILE}/.sand-accept-lang"
sand_saved_accept_language() {
	local as_box=() mode=restore
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	if [ "${SAND_ACCEPT_LANGUAGE_FLAGGED}" = 1 ]; then
		[ ! -e "${SAND_ACCEPT_LANGUAGE_RECORD}" ] || return 0
		mode=save
	elif [ ! -f "${SAND_ACCEPT_LANGUAGE_RECORD}" ] || profile_browser_pid >/dev/null; then
		return 0
	fi
	command -v python3 >/dev/null 2>&1 || return 0
	"${as_box[@]}" python3 -I - "${mode}" "${CHROME_PROFILE}/Default/Preferences" "${SAND_ACCEPT_LANGUAGE_RECORD}" <<'SAND_ACCEPT_LANGUAGE_EOF' || return 0
import json, os, sys

mode, prefs, record = sys.argv[1:4]
KEYS = ("accept_languages", "selected_languages")


def load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


if mode == "save":
    try:
        intl = load(prefs).get("intl")
    except (OSError, ValueError, AttributeError):
        intl = None
    saved = {key: intl[key] for key in KEYS if isinstance(intl, dict) and key in intl}
    with open(f"{record}.tmp", "w", encoding="utf-8") as handle:
        json.dump(saved, handle)
    os.replace(f"{record}.tmp", record)
    sys.exit(0)

try:
    saved = load(record)
except (OSError, ValueError):
    saved = {}
if not isinstance(saved, dict):
    saved = {}
try:
    settings = load(prefs)
except FileNotFoundError:
    settings = None
except (OSError, ValueError):
    sys.exit(1)
if isinstance(settings, dict):
    intl = settings.get("intl")
    if intl is None and any(key in saved for key in KEYS):
        intl = settings["intl"] = {}
    if isinstance(intl, dict):
        changed = False
        for key in KEYS:
            if key in saved and (key not in intl or intl[key] != saved[key]):
                intl[key] = saved[key]
                changed = True
            elif key not in saved and key in intl:
                del intl[key]
                changed = True
        if changed:
            with open(f"{prefs}.tmp", "w", encoding="utf-8") as handle:
                json.dump(settings, handle, separators=(",", ":"))
            os.replace(f"{prefs}.tmp", prefs)
os.remove(record)
SAND_ACCEPT_LANGUAGE_EOF
}
if ! chrome_ready; then
	sand_saved_accept_language
fi

if [ "${SAND_CHROME_PREPARE}" -eq 1 ]; then
	if chrome_ready; then
		wait_for_chrome 0
	else
		start_chrome prepare
	fi
	exit
fi

if chrome_ready; then
	use_running_browser
	launch_chrome "$@"
	wait_for_chrome 1
else
	start_chrome window "$@"
fi
