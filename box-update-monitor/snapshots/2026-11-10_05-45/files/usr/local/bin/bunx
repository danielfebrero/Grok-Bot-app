#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/usr/local/lib/pnpm/5/.pnpm/bun@1.4.2/node_modules/bun/node_modules:/usr/local/lib/pnpm/5/.pnpm/bun@1.4.2/node_modules:/usr/local/lib/pnpm/5/.pnpm/node_modules"
else
  export NODE_PATH="/usr/local/lib/pnpm/5/.pnpm/bun@1.4.2/node_modules/bun/node_modules:/usr/local/lib/pnpm/5/.pnpm/bun@1.4.2/node_modules:/usr/local/lib/pnpm/5/.pnpm/node_modules:$NODE_PATH"
fi
"$basedir/../lib/pnpm/5/.pnpm/bun@1.4.2/node_modules/bun/bin/bunx.exe"   "$@"
exit $?
