#!/usr/bin/env bash
set -uo pipefail

export DISPLAY="${DISPLAY:-:1}"
export SAND_BOX_BOOT_STARTED_AT_MS="${SAND_BOX_BOOT_STARTED_AT_MS:-$(date +%s%3N)}"
if [ -z "${SAND_BOX_BOOT_ID:-}" ]; then
	if [ -r /proc/sys/kernel/random/uuid ]; then
		SAND_BOX_BOOT_ID="$(cat /proc/sys/kernel/random/uuid)"
	else
		SAND_BOX_BOOT_ID="${SAND_BOX_BOOT_STARTED_AT_MS}-$$"
	fi
	export SAND_BOX_BOOT_ID
fi
export SAND_BOX_TELEMETRY_LOG="${SAND_BOX_TELEMETRY_LOG:-/tmp/sand-box-telemetry.log}"

# >>> box port table (from sand/src/shared/box/box-contract.ts; regenerate: pnpm --filter sand run gen:box-ports) >>>
SAND_BOX_PORT_PRIMARY_EXEC_DAEMON=1337
SAND_BOX_PORT_WINDOW_ROUTER=1339
SAND_BOX_PORT_FORK_NOVNC=6081
SAND_BOX_PORT_EGRESS_TUNNEL_WS=8790
SAND_BOX_PORT_EGRESS_CONNECT_PROXY=8791
SAND_BOX_FORK_EXEC_BASE=14000
WINDOW_TOKEN_DIR="/tmp/sand-window-tokens.d"
NOVNC_TOKEN_DIR="/tmp/sand-novnc-tokens.d"
SAND_BOX_WEBAUTHN_PROXY_CREDENTIAL_DIR="/run/sand-webauthn-proxy"
# <<< box port table <<<

emit_boot_stage() {
	local stage="$1"
	local now_ms duration_ms
	now_ms="$(date +%s%3N)"
	duration_ms=$((now_ms - SAND_BOX_BOOT_STARTED_AT_MS))
	if [ "${duration_ms}" -lt 0 ]; then
		duration_ms=0
	fi
	printf '{"kind":"boot_stage","stage":"%s","durationMs":%s}\n' \
		"${stage}" "${duration_ms}" >>"${SAND_BOX_TELEMETRY_LOG}"
}

emit_boot_failure() {
	local stage="$1"
	local reason="$2"
	local now_ms duration_ms
	now_ms="$(date +%s%3N)"
	duration_ms=$((now_ms - SAND_BOX_BOOT_STARTED_AT_MS))
	if [ "${duration_ms}" -lt 0 ]; then
		duration_ms=0
	fi
	printf '{"kind":"boot_failure","stage":"%s","reason":"%s","durationMs":%s}\n' \
		"${stage}" "${reason}" "${duration_ms}" >>"${SAND_BOX_TELEMETRY_LOG}"
}

emit_boot_stage "entrypoint_started"

SAND_BOX_CGROUPS_LIB="${SAND_BOX_CGROUPS_LIB:-/usr/local/bin/box-cgroups.sh}"
if [ -r "${SAND_BOX_CGROUPS_LIB}" ]; then
	# shellcheck source=/dev/null
	. "${SAND_BOX_CGROUPS_LIB}"
fi
if ! command -v sand_cgroup_setup >/dev/null 2>&1; then
	sand_cgroup_setup() { :; }
	sand_cgroup_place() { :; }
	sand_cgroup_join() { :; }
fi
if ! command -v sand_cgroup_background_ready >/dev/null 2>&1; then
	sand_cgroup_background_ready() { return 1; }
fi
sand_cgroup_setup

sand_user_non_root() {
	case "$(printf '%s' "${SAND_USER_NON_ROOT:-}" | tr '[:upper:]' '[:lower:]')" in
	1 | true | yes) return 0 ;;
	*) return 1 ;;
	esac
}

if sand_user_non_root; then
	export SAND_BOX_SCRIPT_SYNC_DISABLED="${SAND_BOX_SCRIPT_SYNC_DISABLED:-1}"
fi

# Team-admin opt-out (enterprise): the backend stamps SAND_BOX_SUDO_DISABLED=1
# on a NEW pod when the owner's team turned off the agent's root access on its
# own machine. Absent (the default) keeps the box user's blanket passwordless
# sudo; set, the box user gets the narrow timezone grant only. The team's
# setup scripts still run as root in such a box, but through the host, whose
# own uid holds that grant (see the uid split below), never through `box`.
sand_box_sudo_disabled() {
	case "$(printf '%s' "${SAND_BOX_SUDO_DISABLED:-}" | tr '[:upper:]' '[:lower:]')" in
	1 | true | yes) return 0 ;;
	*) return 1 ;;
	esac
}

# Host/agent uid split (SAND_HOST_UID_SPLIT=1, non-root boxes only): the in-box
# host and its supervisor run as the image's `sand-host` account while the
# agent's shell, exec-daemon, and the desktop stay `box`. The agent then cannot
# read or rewrite the host's code (/opt/sand), its mailbox, or the state it
# keeps, and the managed-setup sudo grant belongs to sand-host alone, so
# nothing the agent runs can reach it. The host still has to work inside the
# agent's box-owned trees (sand-data, chrome-profile, /workspace), so it keeps
# the file capabilities below as ambient capabilities: they let it read, write,
# chown and signal there without being root or box. The split is requested by
# the backend and only takes effect when the probe shows this image and this
# runtime can actually hand those capabilities to sand-host; otherwise the boot
# reports the fallback and runs the host as box exactly as before.
SAND_HOST_USER=sand-host
SAND_HOST_AMBIENT_CAPS=+chown,+dac_override,+fowner,+kill
SAND_HOST_UID_SPLIT_ACTIVE=0
sand_host_uid_split_requested() {
	case "$(printf '%s' "${SAND_HOST_UID_SPLIT:-}" | tr '[:upper:]' '[:lower:]')" in
	1 | true | yes) return 0 ;;
	*) return 1 ;;
	esac
}
sand_host_uid_split_probe() {
	[ "$(id -u)" -eq 0 ] || return 1
	sand_user_non_root || return 1
	# Only the supervisor launches the host as sand-host; a box that does not
	# run it would start the host as box and hand the sudo grant to a uid the
	# host never has.
	[ "${SAND_SUPERVISOR_ENABLED:-}" = "1" ] || return 1
	id -u "${SAND_HOST_USER}" >/dev/null 2>&1 || return 1
	[ -x /usr/bin/setpriv ] || return 1
	local probe
	probe="$(mktemp /tmp/.sand-host-probe.XXXXXX 2>/dev/null)" || return 1
	chmod 600 "${probe}" 2>/dev/null || {
		rm -f "${probe}"
		return 1
	}
	# A root-only file only reads as sand-host when CAP_DAC_OVERRIDE actually
	# survived the uid change, which is the whole point of the probe.
	if /usr/bin/setpriv --reuid="${SAND_HOST_USER}" --regid="${SAND_HOST_USER}" --init-groups \
		--inh-caps="${SAND_HOST_AMBIENT_CAPS}" --ambient-caps="${SAND_HOST_AMBIENT_CAPS}" \
		/usr/bin/cat "${probe}" >/dev/null 2>&1; then
		rm -f "${probe}"
		return 0
	fi
	rm -f "${probe}"
	return 1
}
if sand_host_uid_split_requested; then
	if sand_host_uid_split_probe; then
		SAND_HOST_UID_SPLIT_ACTIVE=1
		echo "[start-sand-box] host/agent uid split active: host runs as ${SAND_HOST_USER}, agent as box"
	else
		emit_boot_failure "host_uid_split" "probe_failed"
		echo "[start-sand-box] SAND_HOST_UID_SPLIT requested but this box cannot run the host as ${SAND_HOST_USER}; running it as the box user" >&2
	fi
fi
sand_host_uid_split() {
	[ "${SAND_HOST_UID_SPLIT_ACTIVE}" = "1" ]
}

SAND_DATA_HOST_OWNED_FILES=(gateway.json webhook-keys.json teach-queue-key.json box-secrets.json)
remove_host_owned_write_leftovers() {
	box_no_follow remove-leftovers sand-data /home/box/sand-data "${SAND_DATA_HOST_OWNED_FILES[@]}" || true
}
chown_tree_to_box() {
	local host=()
	if sand_host_uid_split; then
		host=(--host "$(id -u "${SAND_HOST_USER}"):$(id -g "${SAND_HOST_USER}")")
	fi
	/usr/bin/python3 -I - "$(id -u box):$(id -g box)" "${host[@]}" "$@" 2>/dev/null <<-'PY' || true
	import argparse
	import errno
	import os
	import resource
	import stat


	def ids(value):
	    uid, gid = value.split(":")
	    return int(uid), int(gid)


	parser = argparse.ArgumentParser()
	parser.add_argument("box", type=ids)
	parser.add_argument("--host", type=ids)
	parser.add_argument("--host-file", action="append", default=[])
	parser.add_argument("--mode", type=lambda value: int(value, 8))
	parser.add_argument("--shallow", action="store_true")
	parser.add_argument("roots", nargs="+")
	args = parser.parse_args()
	host_files = set(args.host_file)


	def is_host_file(name):
	    stem, dot, suffix = name.rpartition(".")
	    return name in host_files or (
	        dot == "." and stem in host_files and suffix.isascii() and suffix.isdigit() and len(suffix) <= 10
	    )


	def is_host_owned(info):
	    return args.host is not None and info.st_uid == args.host[0]


	def owner_for(info, name, top):
	    if is_host_owned(info):
	        return None
	    if top and is_host_file(name):
	        return args.host if name in host_files and stat.S_ISREG(info.st_mode) else None
	    return args.box


	def open_entry(name, dir_fd):
	    flags = os.O_NOFOLLOW | os.O_CLOEXEC
	    try:
	        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | flags, dir_fd=dir_fd)
	        opened_dir = True
	    except OSError as error:
	        if error.errno not in (errno.ENOTDIR, errno.ELOOP):
	            raise
	        fd = os.open(name, os.O_PATH | flags, dir_fd=dir_fd)
	        opened_dir = False
	    try:
	        return fd, opened_dir, os.fstat(fd)
	    except OSError:
	        os.close(fd)
	        raise


	def open_root(path):
	    parts = [part for part in path.split("/") if part]
	    if not parts:
	        raise FileNotFoundError(path)
	    parent = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
	    try:
	        for part in parts[:-1]:
	            child = os.open(
	                part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent
	            )
	            os.close(parent)
	            parent = child
	            if is_host_owned(os.fstat(parent)):
	                raise PermissionError(path)
	        return open_entry(parts[-1], parent)
	    finally:
	        os.close(parent)


	def settle(fd, opened_dir, info, name, top):
	    owner = owner_for(info, name, top)
	    if owner is None:
	        return False
	    try:
	        if (info.st_uid, info.st_gid) != owner:
	            if opened_dir:
	                os.fchown(fd, *owner)
	            else:
	                os.chown("/proc/self/fd/%d" % fd, *owner)
	    except OSError:
	        return False
	    return opened_dir and owner == args.box


	def already_settled(name, dir_fd, top):
	    try:
	        info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
	    except OSError:
	        return True
	    if is_host_owned(info):
	        return True
	    if top and is_host_file(name):
	        return False
	    return not stat.S_ISDIR(info.st_mode) and (info.st_uid, info.st_gid) == args.box


	def walk(path):
	    try:
	        fd, opened_dir, info = open_root(path)
	    except OSError:
	        return
	    try:
	        descend = settle(fd, opened_dir, info, os.path.basename(path), False)
	        if descend and args.mode is not None:
	            os.fchmod(fd, args.mode)
	        names = os.listdir(fd) if descend and not args.shallow else None
	    except OSError:
	        names = None
	    if names is None:
	        os.close(fd)
	        return
	    stack = [(fd, iter(names), True)]
	    while stack:
	        dir_fd, entries, top = stack[-1]
	        name = next(entries, None)
	        if name is None:
	            os.close(dir_fd)
	            stack.pop()
	            continue
	        if already_settled(name, dir_fd, top):
	            continue
	        try:
	            child, opened_dir, info = open_entry(name, dir_fd)
	        except OSError:
	            continue
	        try:
	            if settle(child, opened_dir, info, name, top):
	                stack.append((child, iter(os.listdir(child)), False))
	                continue
	        except OSError:
	            pass
	        os.close(child)


	soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
	if hard != resource.RLIM_INFINITY and soft < hard:
	    try:
	        resource.setrlimit(resource.RLIMIT_NOFILE, (hard, hard))
	    except (OSError, ValueError):
	        pass
	for root in args.roots:
	    walk(root)
	PY
}
box_no_follow() {
	/usr/bin/python3 -I - "$@" <<-'PY'
	import errno
	import os
	import re
	import stat
	import sys
	import time

	DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
	SINGLETONS = ("SingletonLock", "SingletonSocket", "SingletonCookie")


	class Refused(Exception):
	    pass


	def report(operation, role, error_class):
	    print("[start-sand-box] refused %s at %s (%s)" % (operation, role, error_class), file=sys.stderr)


	def is_link(name, dir_fd):
	    try:
	        return stat.S_ISLNK(os.stat(name, dir_fd=dir_fd, follow_symlinks=False).st_mode)
	    except OSError:
	        return False


	def open_below(name, dir_fd, error_class="parent-link"):
	    try:
	        return os.open(name, DIRECTORY, dir_fd=dir_fd)
	    except OSError as error:
	        if error.errno == errno.ELOOP or (error.errno == errno.ENOTDIR and is_link(name, dir_fd)):
	            raise Refused(error_class)
	        raise


	def open_path(path, create=False):
	    fd = os.open("/", DIRECTORY)
	    try:
	        for name in [part for part in path.split("/") if part]:
	            try:
	                child = open_below(name, fd)
	            except FileNotFoundError:
	                if not create:
	                    raise
	                try:
	                    os.mkdir(name, 0o777, dir_fd=fd)
	                except FileExistsError:
	                    pass
	                child = open_below(name, fd)
	            os.close(fd)
	            fd = child
	    except BaseException:
	        os.close(fd)
	        raise
	    return fd


	def unlink_singletons(fd):
	    for name in SINGLETONS:
	        try:
	            os.unlink(name, dir_fd=fd)
	        except OSError:
	            pass


	def open_parent(path, create=False):
	    parent_path, name = os.path.split(path.rstrip("/"))
	    return open_path(parent_path, create), name


	def clear_singletons(role, path):
	    try:
	        profile = open_path(path)
	    except FileNotFoundError:
	        return 0
	    except Refused as refused:
	        report("remove", role, refused.args[0])
	        return 0
	    try:
	        unlink_singletons(profile)
	        refused_fork = None
	        for name in os.listdir(profile):
	            if not name.startswith("Fork-"):
	                continue
	            try:
	                fork = open_below(name, profile)
	            except Refused as refused:
	                refused_fork = refused.args[0]
	                continue
	            except OSError:
	                continue
	            try:
	                unlink_singletons(fork)
	            finally:
	                os.close(fork)
	        if refused_fork is not None:
	            report("remove", role + "-fork", refused_fork)
	    finally:
	        os.close(profile)
	    return 0


	def real_dir(role, path):
	    parent_path, name = os.path.split(path.rstrip("/"))
	    try:
	        parent = open_path(parent_path, create=True)
	    except Refused as refused:
	        report("create", role, refused.args[0])
	        return 1
	    try:
	        if is_link(name, parent):
	            os.unlink(name, dir_fd=parent)
	        try:
	            os.mkdir(name, 0o777, dir_fd=parent)
	        except FileExistsError:
	            pass
	        os.close(open_below(name, parent, "target-link"))
	        return 0
	    except Refused as refused:
	        report("create", role, refused.args[0])
	        return 1
	    finally:
	        os.close(parent)


	def remove(role, path):
	    try:
	        parent, name = open_parent(path)
	    except FileNotFoundError:
	        return 0
	    except Refused as refused:
	        report("remove", role, refused.args[0])
	        return 1
	    try:
	        os.unlink(name, dir_fd=parent)
	    except FileNotFoundError:
	        pass
	    finally:
	        os.close(parent)
	    return 0


	def remove_leftovers(role, path, *names):
	    try:
	        folder = open_path(path)
	    except FileNotFoundError:
	        return 0
	    except Refused as refused:
	        report("remove", role, refused.args[0])
	        return 1
	    try:
	        for entry in os.listdir(folder):
	            stem, _, suffix = entry.rpartition(".")
	            if stem not in names or not re.fullmatch("[0-9]{1,10}", suffix):
	                continue
	            try:
	                os.unlink(entry, dir_fd=folder)
	            except FileNotFoundError:
	                pass
	            except OSError as error:
	                report("remove", role, errno.errorcode.get(error.errno, "OSError"))
	    finally:
	        os.close(folder)
	    return 0


	def replace_link(name, target, dir_fd):
	    try:
	        os.symlink(target, name, dir_fd=dir_fd)
	    except FileExistsError:
	        os.unlink(name, dir_fd=dir_fd)
	        os.symlink(target, name, dir_fd=dir_fd)


	def link(role, path, target):
	    try:
	        parent, name = open_parent(path)
	    except Refused as refused:
	        report("create", role, refused.args[0])
	        return 1
	    try:
	        try:
	            folder = open_below(name, parent)
	        except (FileNotFoundError, NotADirectoryError, Refused):
	            replace_link(name, target, parent)
	            return 0
	        try:
	            replace_link(os.path.basename(target), target, folder)
	        finally:
	            os.close(folder)
	        return 0
	    finally:
	        os.close(parent)


	def root_lock_mtime(name, dir_fd):
	    try:
	        info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
	    except FileNotFoundError:
	        return None
	    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
	        return None
	    return int(info.st_mtime)


	def clear_stale_lock(role, path):
	    try:
	        parent, name = open_parent(path)
	    except FileNotFoundError:
	        return 0
	    except Refused as refused:
	        report("remove", role, refused.args[0])
	        return 1
	    try:
	        first = root_lock_mtime(name, parent)
	        if first is None:
	            return 0
	        for attempt in range(1, 9):
	            if root_lock_mtime(name, parent) != first:
	                return 0
	            age = int(time.time()) - first
	            if age > 5 and attempt > 2:
	                print(
	                    "[start-sand-box] removing a root-owned box-store lock that stopped beating %ds ago (a copy-in that did not exit)" % age,
	                    flush=True,
	                )
	                try:
	                    os.unlink(name, dir_fd=parent)
	                except FileNotFoundError:
	                    pass
	                return 0
	            time.sleep(1)
	        return 0
	    finally:
	        os.close(parent)


	OPERATIONS = {
	    "clear-singletons": (clear_singletons, "remove"),
	    "real-dir": (real_dir, "create"),
	    "remove": (remove, "remove"),
	    "remove-leftovers": (remove_leftovers, "remove"),
	    "link": (link, "create"),
	    "clear-stale-lock": (clear_stale_lock, "remove"),
	}
	operation, role = sys.argv[1:3]
	action, verb = OPERATIONS[operation]
	try:
	    sys.exit(action(role, *sys.argv[3:]))
	except Refused as refused:
	    report(verb, role, refused.args[0])
	    sys.exit(1)
	except OSError as error:
	    report(verb, role, errno.errorcode.get(error.errno, "OSError"))
	    sys.exit(1)
	PY
}
chown_sand_data_to_box() {
	remove_host_owned_write_leftovers
	local name host_files=()
	if sand_host_uid_split; then
		for name in "${SAND_DATA_HOST_OWNED_FILES[@]}"; do
			host_files+=(--host-file "${name}")
		done
	fi
	chown_tree_to_box "${host_files[@]}" /home/box/sand-data
}

reassert_cli_config_owner() {
	[ "$(id -u)" -eq 0 ] || return 0
	if sand_user_non_root; then
		chown_tree_to_box /home/box/cli-config
	else
		chown -hR root:root /home/box/cli-config 2>/dev/null || true
		chmod 700 /home/box/cli-config 2>/dev/null || true
	fi
}

# Writes one validated sudoers drop-in; returns non-zero and leaves nothing
# behind when the rule does not pass visudo.
install_sudoers_rule() {
	local name="$1" rule="$2"
	printf '%s\n' "${rule}" >"/etc/sudoers.d/${name}.tmp" 2>/dev/null || return 1
	chmod 440 "/etc/sudoers.d/${name}.tmp" 2>/dev/null || true
	if visudo -cf "/etc/sudoers.d/${name}.tmp" >/dev/null 2>&1 &&
		mv -f "/etc/sudoers.d/${name}.tmp" "/etc/sudoers.d/${name}" 2>/dev/null; then
		return 0
	fi
	rm -f "/etc/sudoers.d/${name}.tmp" 2>/dev/null || true
	return 1
}

if [ "$(id -u)" -eq 0 ]; then
	if sand_user_non_root; then
		if sand_box_sudo_disabled; then
			SAND_BOX_SUDOERS_RULE='box ALL=(root:root) NOPASSWD: /usr/local/bin/sand-box-timezone apply *'
		else
			SAND_BOX_SUDOERS_RULE='box ALL=(ALL:ALL) NOPASSWD:ALL'
		fi
		install_sudoers_rule box "${SAND_BOX_SUDOERS_RULE}" || true
		if sand_host_uid_split; then
			# The host cannot change uid itself, so every managed-setup converge
			# of a split box goes through the fixed wrapper: as root when the
			# team disabled the agent's sudo (its setup scripts still get root;
			# nothing the agent runs does), dropped back to box (`--as-box`)
			# when it did not, exactly as the converge always ran. The timezone
			# helper is there for the case where it decides to sudo itself.
			SAND_HOST_SUDOERS_RULE="${SAND_HOST_USER}"' ALL=(root:root) NOPASSWD: /usr/local/bin/sand-box-timezone apply *, /usr/local/bin/sand-team-converge-privileged "", /usr/local/bin/sand-team-converge-privileged --force, /usr/local/bin/sand-team-converge-privileged --as-box, /usr/local/bin/sand-team-converge-privileged --as-box --force'
			if install_sudoers_rule sand-host "${SAND_HOST_SUDOERS_RULE}" &&
				[ -x /usr/local/bin/sand-team-converge-privileged ]; then
				if sand_box_sudo_disabled; then
					export SAND_MANAGED_SETUP_RUN_AS=root
				else
					export SAND_MANAGED_SETUP_RUN_AS=box
				fi
			else
				# Without its grant the host could only converge as sand-host
				# itself, which must never run team scripts; give the split up
				# before anything launches.
				SAND_HOST_UID_SPLIT_ACTIVE=0
				rm -f /etc/sudoers.d/sand-host 2>/dev/null || true
				emit_boot_failure "host_uid_split" "sudoers_failed"
				echo "[start-sand-box] could not install the ${SAND_HOST_USER} sudoers rule; running the host as the box user" >&2
			fi
		else
			rm -f /etc/sudoers.d/sand-host 2>/dev/null || true
		fi
	else
		rm -f /etc/sudoers.d/box /etc/sudoers.d/sand-host 2>/dev/null || true
	fi
fi

SAND_DAEMON_LAUNCHERS_DIR="/usr/local/libexec/sand"
SAND_DAEMON_RELEASE_STORE_DIR="/var/lib/sand-daemon-supervisor"
SAND_DAEMON_LOGS_DIR="/tmp"
declare -A SAND_DISABLED_DAEMONS=()
SAND_BUNDLED_DAEMON_SERVICES=()
SAND_DAEMON_LAUNCHER_ARGS=()

daemon_has_bundled_release() {
	local service="$1"
	local bundled="$SAND_DAEMON_RELEASE_STORE_DIR/$service/bundled"

	[[ -x "$bundled/$service" && -f "$bundled/manifest.json" ]]
}

discover_bundled_daemons() {
	local service_store service

	for service_store in "$SAND_DAEMON_RELEASE_STORE_DIR"/*; do
		[[ -d "$service_store" ]] || continue
		service="$(basename "$service_store")"
		daemon_has_bundled_release "$service" || continue
		SAND_BUNDLED_DAEMON_SERVICES+=("$service")
	done
}

reconcile_daemon_group_access() {
	local service box_has_access

	[ "$(id -u)" -eq 0 ] || return 0
	sand_user_non_root || return 0
	for service in "${SAND_BUNDLED_DAEMON_SERVICES[@]}"; do
		if ! getent group "$service" >/dev/null 2>&1 ||
			! id -u "$service" >/dev/null 2>&1; then
			SAND_DISABLED_DAEMONS["$service"]=1
			echo "[start-sand-box] daemon identity is missing for $service; keeping it down" >&2
			continue
		fi

		box_has_access=0
		case " $(id -nG box) " in
		*" $service "*)
			box_has_access=1
			;;
		esac

		if sand_host_uid_split; then
			if ((box_has_access)) &&
				! gpasswd --delete box "$service" >/dev/null; then
				SAND_DISABLED_DAEMONS["$service"]=1
				echo "[start-sand-box] could not remove box from the $service group" >&2
			fi
		elif ((!box_has_access)) &&
			! usermod --append --groups "$service" box; then
			SAND_DISABLED_DAEMONS["$service"]=1
			echo "[start-sand-box] could not grant box access to $service" >&2
		fi
	done
}

prepare_daemon_logs() {
	local service="$1"
	local bounded_log="$SAND_DAEMON_LOGS_DIR/sand-${service}.log"
	local bounded_log_lock="${bounded_log}.lock"
	local supervisor_log="$SAND_DAEMON_LOGS_DIR/sand-${service}-supervisor.log"

	rm -f -- "$bounded_log" "$bounded_log_lock" "$supervisor_log" 2>/dev/null || return 1
	install -T -m 0600 -o root -g root /dev/null "$bounded_log" || return 1
	install -T -m 0600 -o root -g root /dev/null "$bounded_log_lock" || return 1
	install -T -m 0644 -o root -g root /dev/null "$supervisor_log" || return 1
}

prepare_bundled_daemon_logs() {
	local service

	[ "$(id -u)" -eq 0 ] || return 0
	for service in "${SAND_BUNDLED_DAEMON_SERVICES[@]}"; do
		if ! prepare_daemon_logs "$service"; then
			SAND_DISABLED_DAEMONS["$service"]=1
			echo "[start-sand-box] could not prepare trusted logs for $service; keeping it down" >&2
		fi
	done
}

collect_daemon_launcher_args() {
	local service service_dir

	[ "$(id -u)" -eq 0 ] || return 0
	((${#SAND_BUNDLED_DAEMON_SERVICES[@]} > 0)) || return 0
	if ((copy_in_failed)); then
		echo "[start-sand-box] box-store copy-in failed; keeping managed daemons down" >&2
		return 0
	fi
	if ! sand_cgroup_background_ready; then
		echo "[start-sand-box] background cgroup unavailable; keeping managed daemons down" >&2
		return 0
	fi

	for service in "${SAND_BUNDLED_DAEMON_SERVICES[@]}"; do
		service_dir="$SAND_DAEMON_LAUNCHERS_DIR/$service"
		[[ -z "${SAND_DISABLED_DAEMONS[$service]:-}" ]] || continue
		if [[ ! -x "$service_dir/start" ]]; then
			echo "[start-sand-box] daemon launcher is missing for $service; keeping it down" >&2
			continue
		fi
		SAND_DAEMON_LAUNCHER_ARGS+=(
			--daemon-launcher
			"$service=$service_dir/start"
		)
	done
}

