export_npm_prefix_without_seeded_npmrc() {
	AS_BOX+=(NPM_CONFIG_PREFIX=/home/box/.local)
}

AS_BOX=()
if sand_user_non_root && [ "$(id -u)" -eq 0 ]; then
	AS_BOX=(/usr/bin/setpriv --reuid=box --regid=box --init-groups /usr/bin/env HOME=/home/box USER=box LOGNAME=box)
	export_npm_prefix_without_seeded_npmrc
	AS_BOX+=("PATH=/home/box/.local/bin:${PATH}")
fi

box_env_token_unsets() {
	local entry env_name token_value
	BOX_ENV_TOKEN_UNSETS=(-u SAND_GATEWAY_TOKEN -u SAND_EGRESS_TUNNEL_BEARER)
	TOKEN_ALIAS_UNSETS=()
	while IFS= read -r -d '' entry; do
		env_name="${entry%%=*}"
		[ "${env_name}" != "${entry}" ] || continue
		case "${env_name}" in
		'' | SAND_GATEWAY_TOKEN | SAND_EGRESS_TUNNEL_BEARER) continue ;;
		esac
		for token_value in "${SAND_GATEWAY_TOKEN:-}" "${SAND_EGRESS_TUNNEL_BEARER:-}"; do
			if [ -n "${token_value}" ] && [[ "${entry#*=}" == *"${token_value}"* ]]; then
				TOKEN_ALIAS_UNSETS+=(-u "${env_name}")
				break
			fi
		done
	done < <(/usr/bin/env -0)
	BOX_ENV_TOKEN_UNSETS+=("${TOKEN_ALIAS_UNSETS[@]}")
}
box_env_token_unsets

# Launches the host side (its supervisor, and through it the host) as
# sand-host with the file capabilities the probe confirmed. HOME stays the
# agent's home because that is where the host keeps and finds the agent's
# data; PATH deliberately omits /home/box/.local/bin, which the agent writes.
AS_HOST=(/usr/bin/env "${TOKEN_ALIAS_UNSETS[@]}" "${AS_BOX[@]}")
if sand_host_uid_split; then
	AS_HOST=(
		/usr/bin/env "${TOKEN_ALIAS_UNSETS[@]}"
		/usr/bin/setpriv --reuid="${SAND_HOST_USER}" --regid="${SAND_HOST_USER}" --init-groups
		--inh-caps="${SAND_HOST_AMBIENT_CAPS}" --ambient-caps="${SAND_HOST_AMBIENT_CAPS}"
		/usr/bin/env HOME=/home/box "USER=${SAND_HOST_USER}" "LOGNAME=${SAND_HOST_USER}" "PATH=${PATH}"
	)
fi
AS_EGRESS_TUNNEL=(/usr/bin/env -u SAND_GATEWAY_TOKEN "${AS_HOST[@]}")
if sand_host_uid_split; then
	AS_EGRESS_TUNNEL=(
		/usr/bin/env -u SAND_GATEWAY_TOKEN "${TOKEN_ALIAS_UNSETS[@]}"
		/usr/bin/setpriv --reuid="${SAND_HOST_USER}" --regid="${SAND_HOST_USER}" --init-groups
		/usr/bin/env HOME=/home/box "USER=${SAND_HOST_USER}" "LOGNAME=${SAND_HOST_USER}" "PATH=${PATH}"
	)
fi
AS_BOX=(/usr/bin/env "${BOX_ENV_TOKEN_UNSETS[@]}" "${AS_BOX[@]}")

