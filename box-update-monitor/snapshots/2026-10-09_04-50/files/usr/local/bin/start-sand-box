if [ "${SAND_EGRESS_TUNNEL_ENABLED:-}" = "1" ]; then
	EGRESS_TUNNEL_WRAPPER=(
		/usr/local/bin/supervise-egress-tunnel
		"${SAND_EGRESS_TUNNEL_WS_PORT:-${SAND_BOX_PORT_EGRESS_TUNNEL_WS}}"
		/usr/local/bin/start-egress-tunnel
	)
	if sand_host_uid_split; then
		(
			attempt=0
			delay_s=1
			while :; do
				started_s=${SECONDS}
				"${AS_EGRESS_TUNNEL[@]}" "${EGRESS_TUNNEL_WRAPPER[@]}"
				exit_status=$?
				runtime_s=$((SECONDS - started_s))
				attempt=$((attempt + 1))
				[ "${runtime_s}" -lt 60 ] || delay_s=1
				printf '{"kind":"egress_tunnel","outcome":"restart","attempt":%s,"exitStatus":%s,"runtimeS":%s}\n' \
					"${attempt}" "${exit_status}" "${runtime_s}" >>"${SAND_BOX_TELEMETRY_LOG}" 2>/dev/null || true
				echo "[start-sand-box] egress-tunnel wrapper exited (status ${exit_status}); restarting in ${delay_s}s" >&2
				sleep "${delay_s}"
				[ "${delay_s}" -ge 30 ] || delay_s=$((delay_s * 2))
			done
		) >/tmp/egress-tunnel.log 2>&1 &
	else
		(
			exec "${AS_EGRESS_TUNNEL[@]}" "${EGRESS_TUNNEL_WRAPPER[@]}"
		) >/tmp/egress-tunnel.log 2>&1 &
		HOME=/home/box sand_desktop_register shared egress-proxy 4 /tmp/egress-tunnel.log "$!" -- \
			/usr/bin/env -u SAND_GATEWAY_TOKEN "${EGRESS_TUNNEL_WRAPPER[@]}"
	fi
	printf '%s\n' "${SAND_EGRESS_TUNNEL_PROXY_ADDR:-127.0.0.1:${SAND_BOX_PORT_EGRESS_CONNECT_PROXY}}" \
		>/tmp/sand-egress-proxy 2>/dev/null || true
	chmod 644 /tmp/sand-egress-proxy 2>/dev/null || true
fi

