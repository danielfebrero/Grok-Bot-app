# The host bundle root (/opt/sand: sand-host/ + deps/, plus the swap's .stage
# and .prev siblings) belongs to whichever account runs the host. Every
# recursive chown over a tree the agent can write is -h: a symlink it planted
# there must never hand its target to box.
if [ "$(id -u)" -eq 0 ]; then
	if sand_host_uid_split; then
		chown -hR "${SAND_HOST_USER}:${SAND_HOST_USER}" /opt/sand 2>/dev/null || true
	elif sand_user_non_root; then
		chown_tree_to_box /opt/sand
	else
		chown -hR root:root /opt/sand 2>/dev/null || true
	fi
fi

# The host owns the orbitd proxy socket; box processes may connect but cannot
# replace it. setgid makes host-created sockets inherit group box.
if [ "$(id -u)" -eq 0 ]; then
	if sand_host_uid_split; then
		install -d -m 2750 -o "${SAND_HOST_USER}" -g box /run/orbitd-proxy 2>/dev/null || true
	elif sand_user_non_root; then
		install -d -m 2750 -o box -g box /run/orbitd-proxy 2>/dev/null || true
	else
		install -d -m 2700 -o root -g root /run/orbitd-proxy 2>/dev/null || true
	fi
fi

if [ "$(id -u)" -eq 0 ]; then
	rm -f /tmp/sand-managed-converge.log
	if sand_host_uid_split; then
		# The host publishes the assignment and manifests here, and a root
		# converge reads them, so the tree must be one the agent cannot write:
		# sand-host owns it (the wrapper hands only the receipts of an --as-box
		# converge to box). The converge log is host-owned and agent-readable,
		# so the agent can debug setup without being able to alter the output.
		install -d -m 755 -o box -g box /run/sand 2>/dev/null || true
		install -d -m 755 -o "${SAND_HOST_USER}" -g "${SAND_HOST_USER}" /opt/sand-managed 2>/dev/null || true
		chown_tree_to_box /run/sand
		chown -hR "${SAND_HOST_USER}:${SAND_HOST_USER}" /opt/sand-managed 2>/dev/null || true
		install -m 640 -o "${SAND_HOST_USER}" -g box /dev/null /tmp/sand-managed-converge.log 2>/dev/null || true
	elif sand_user_non_root; then
		install -d -m 755 -o box -g box /run/sand 2>/dev/null || true
		install -d -m 700 -o box -g box /opt/sand-managed 2>/dev/null || true
		chown_tree_to_box /run/sand /opt/sand-managed
	else
		install -d -m 755 -o root -g root /run/sand 2>/dev/null || true
		install -d -m 700 -o root -g root /opt/sand-managed 2>/dev/null || true
		chown -R root:root /run/sand /opt/sand-managed 2>/dev/null || true
	fi
fi

