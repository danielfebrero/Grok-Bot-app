BOX_TMP_DIR="${SAND_PROFILE_PRIOR_BOOT%/*}"
BOX_LAST_LAUNCH_FILE="${BOX_TMP_DIR}/sand-box-chrome-last-launch-${CHROME_DEBUG_PORT}"
UNGOOGLED_CHROMIUM=/opt/ungoogled-chromium/chrome
box_browser_ungoogled_wanted() {
	[ "${SAND_BOX_BROWSER_UNGOOGLED:-0}" = "1" ] || [ -e "${SAND_BOX_BROWSER_UNGOOGLED_FILE:-/tmp/sand-box-browser-ungoogled}" ]
}
resolve_box_browser() {
	local ticks
	if [ ! -e "${BOX_BROWSER_RUNNING_FILE}" ]; then
		ticks=$((${SAND_BOX_BROWSER_GATE_WAIT_S:-5} * 10))
		while [ "${ticks}" -gt 0 ] && [ ! -e "${SAND_BOX_EXPERIMENTS_READY_FILE:-/tmp/sand-box-experiments-ready}" ]; do
			sleep 0.1
			ticks=$((ticks - 1))
		done
	fi
	if box_browser_ungoogled_wanted && [ -x "${UNGOOGLED_CHROMIUM}" ]; then
		printf ungoogled-chromium
	else
		printf chrome
	fi
}
UNGOOGLED_ONLY_FEATURE_FLAGS=("--enable-features=ReducedSystemInfo,SpoofWebGLInfo,SetIpv6ProbeFalse")
UNGOOGLED_CHROMIUM_FLAGS=(
	"--disable-features=OptimizationGuideModelDownloading,OptimizationHintsFetching,OptimizationTargetPrediction,OptimizationHints,EnforcePrivacySandboxAttestations,Translate,MediaRouter,DialMediaRouteProvider,CalculateNativeWinOcclusion,InterestFeedContentSuggestions,CertificateTransparencyComponentUpdater,AutofillServerCommunication,PrivacySandboxSettings4,AutomationControlled,HttpsUpgrades"
	--webrtc-ip-handling-policy=disable_non_proxied_udp
)
BOX_BROWSER="$(resolve_box_browser)"
case "${BOX_BROWSER}" in
ungoogled-chromium) CHROME_BIN="${UNGOOGLED_CHROMIUM}" ;;
*) CHROME_BIN=google-chrome-stable ;;
esac
SAND_UNGOOGLED_FLAGS_ON=0
if [ -e "${SAND_BOX_BROWSER_UNGOOGLED_FLAGS_FILE:-/tmp/sand-box-browser-ungoogled-flags}" ] && [ "${SAND_BOX_BROWSER_UNGOOGLED_FLAGS:-}" != 0 ]; then
	SAND_UNGOOGLED_FLAGS_ON=1
fi
SAND_BOX_BROWSER_NO_LOCAL_DNS="${SAND_BOX_BROWSER_NO_LOCAL_DNS:-}"
if [ -z "${SAND_BOX_BROWSER_NO_LOCAL_DNS}" ] && [ -e "${SAND_BOX_BROWSER_NO_LOCAL_DNS_FILE:-/tmp/sand-box-browser-no-local-dns}" ]; then
	SAND_BOX_BROWSER_NO_LOCAL_DNS=1
fi
if [ "${SAND_BOX_BROWSER_NO_LOCAL_DNS}" = "1" ] && [ -n "${SAND_EGRESS_PROXY_BYPASS_FLAG:-}" ]; then
	CHROME_FLAGS[SAND_EGRESS_PROXY_BYPASS_FLAG]="--proxy-bypass-list=<-loopback>;localhost;127.0.0.1;[::1]" # pragma: allowlist secret
	CHROME_FLAGS+=("--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE localhost , EXCLUDE 127.0.0.1 , EXCLUDE ::1") # pragma: allowlist secret
fi
SAND_CHROME_DISABLE_QUIC="${SAND_CHROME_DISABLE_QUIC:-0}"
if [ -e "${SAND_CHROME_DISABLE_QUIC_FILE:-/tmp/sand-chrome-disable-quic}" ] ||
	[ ! -e "${SAND_BOX_EXPERIMENTS_READY_FILE:-/tmp/sand-box-experiments-ready}" ]; then
	SAND_CHROME_DISABLE_QUIC=1
fi
if [ "${SAND_CHROME_DISABLE_QUIC}" = "1" ]; then
	CHROME_FLAGS+=(--disable-quic)
fi
SAND_BOX_BROWSER_NO_SWIFTSHADER="${SAND_BOX_BROWSER_NO_SWIFTSHADER:-}"
SAND_NO_SWIFTSHADER_FILE="${SAND_BOX_BROWSER_NO_SWIFTSHADER_FILE:-/tmp/sand-box-browser-no-swiftshader}"
SAND_NO_SWIFTSHADER_MODE=""
if [ -e "${SAND_NO_SWIFTSHADER_FILE}" ]; then
	[ "${SAND_BOX_BROWSER_NO_SWIFTSHADER}" = 0 ] || SAND_BOX_BROWSER_NO_SWIFTSHADER=1
	[ ! -f "${SAND_NO_SWIFTSHADER_FILE}" ] || read -r SAND_NO_SWIFTSHADER_MODE 2>/dev/null <"${SAND_NO_SWIFTSHADER_FILE}" || true
fi
if [ "${SAND_BOX_BROWSER_NO_SWIFTSHADER}" = "1" ] && [ -n "${SAND_SWIFTSHADER_FLAG:-}" ]; then
	if [ "${SAND_NO_SWIFTSHADER_MODE}" = llvmpipe ]; then
		# --enable-unsafe-swiftshader stays: when ANGLE's GL display can't start (no
		# GLX on the X server, no Mesa driver) Chrome falls back to SwiftShader WebGL
		# instead of blocklisting WebGL, while a working llvmpipe still wins.
		CHROME_FLAGS+=(
			--use-gl=angle
			--use-angle=gl
			--ignore-gpu-blocklist
			--disable-gpu-compositing
			--disable-accelerated-2d-canvas
		)
		BOX_CHROME_GPU_MODE=llvmpipe
	else
		unset 'CHROME_FLAGS[SAND_SWIFTSHADER_FLAG]'
		BOX_CHROME_GPU_MODE=stock
	fi
fi
sand_box_chrome_extra_flag_allowed() {
	case "$1" in
	--disable-quic) return 0 ;;
	--disable-features=TLSTrustAnchorIDs) return 0 ;;
	*) return 1 ;;
	esac
}
sand_chrome_flag_present() {
	local want="$1" flag
	for flag in "${CHROME_FLAGS[@]}"; do
		[ "${flag}" = "${want}" ] && return 0
	done
	return 1
}
BOX_CHROME_EXTRA_FLAGS_FILE="${SAND_BOX_CHROME_EXTRA_FLAGS_FILE:-/tmp/sand-box-chrome-extra-flags}"
if [ -f "${BOX_CHROME_EXTRA_FLAGS_FILE}" ] && [ ! -L "${BOX_CHROME_EXTRA_FLAGS_FILE}" ]; then
	while IFS= read -r sand_extra_flag || [ -n "${sand_extra_flag}" ]; do
		sand_extra_flag="${sand_extra_flag%$'\r'}"
		sand_extra_flag="${sand_extra_flag#"${sand_extra_flag%%[![:space:]]*}"}"
		sand_extra_flag="${sand_extra_flag%"${sand_extra_flag##*[![:space:]]}"}"
		[ -n "${sand_extra_flag}" ] || continue
		sand_box_chrome_extra_flag_allowed "${sand_extra_flag}" || continue
		sand_chrome_flag_present "${sand_extra_flag}" && continue
		CHROME_FLAGS+=("${sand_extra_flag}")
	done <"${BOX_CHROME_EXTRA_FLAGS_FILE}"
fi
# The UA governor's configuredAcceptLanguage rule, so it can leave the default context's header to this flag.
sand_accept_language_valid() {
	local LC_ALL=C
	local re='^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*(,[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*)*$'
	[ "${#1}" -le 128 ] && [[ "$1" =~ ${re} ]]
}
sand_accept_language() {
	local list=""
	if [ -f "$1" ] && [ ! -L "$1" ]; then
		IFS= read -r -N 129 list 2>/dev/null <"$1" || true
	fi
	if sand_accept_language_valid "${list}"; then
		printf '%s' "${list}"
	else
		printf '%s' "en-US,en-GB,en"
	fi
}
SAND_BROWSER_ACCEPT_LANGUAGE_FILE="${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US_FILE:-/tmp/sand-browser-accept-language-en-us}"
SAND_ACCEPT_LANGUAGE_FLAGGED=0
SAND_ACCEPT_LANGUAGE_LIST=""
if [ -e "${SAND_BROWSER_ACCEPT_LANGUAGE_FILE}" ] && [ "${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US:-}" != 0 ]; then
	SAND_ACCEPT_LANGUAGE_FLAGGED=1
	SAND_ACCEPT_LANGUAGE_LIST="$(sand_accept_language "${SAND_BROWSER_ACCEPT_LANGUAGE_FILE}")"
	CHROME_FLAGS+=(--accept-lang="${SAND_ACCEPT_LANGUAGE_LIST}")
fi
policy_status=0
box_chrome_policy=/usr/local/bin/box-chrome-policy
case "$0" in
/*/box-launchers/box-chrome)
	if [ -x "${0%/box-launchers/box-chrome}/box-scripts/box-chrome-policy" ]; then
		box_chrome_policy="${0%/box-launchers/box-chrome}/box-scripts/box-chrome-policy"
	fi
	;;
esac
apply_box_chrome_policy() {
	local forced=0
	if [ "${BOX_CHROME_GATES_READY}" = false ] && [ "${BOX_CHROME_WEBRTC_PROXY_ONLY}" = false ]; then
		SAND_BOX_BROWSER_WEBRTC_PROXY_ONLY=1 "${box_chrome_policy}" || forced=$?
		BOX_CHROME_WEBRTC_FALLBACK="$(box_chrome_policy_outcome "${forced}")"
		if [ "${forced}" = 0 ]; then
			BOX_CHROME_WEBRTC_PROXY_ONLY=true
			return 0
		fi
	fi
	"${box_chrome_policy}"
}
box_chrome_policy_outcome() {
	case "$1" in
	0) printf ok ;;
	3) printf unwritable ;;
	*) printf failed ;;
	esac
}
BOX_CHROME_WEBRTC_FALLBACK=""
BOX_CHROME_GATES_READY=false
[ ! -e "${SAND_BOX_EXPERIMENTS_READY_FILE:-/tmp/sand-box-experiments-ready}" ] || BOX_CHROME_GATES_READY=true
BOX_CHROME_WEBRTC_PROXY_ONLY=false
if [ "${SAND_BOX_BROWSER_WEBRTC_PROXY_ONLY:-0}" = "1" ] ||
	[ -e "${SAND_BOX_BROWSER_WEBRTC_PROXY_ONLY_FILE:-/tmp/sand-box-browser-webrtc-proxy-only}" ] ||
	[ -L "${SAND_BOX_BROWSER_WEBRTC_PROXY_ONLY_FILE:-/tmp/sand-box-browser-webrtc-proxy-only}" ]; then
	BOX_CHROME_WEBRTC_PROXY_ONLY=true
fi
apply_box_chrome_policy || policy_status=$?
