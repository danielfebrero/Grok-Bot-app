# Chrome watches /etc/localtime for zone changes only while TZ is unset in its environment
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/151.0.7922.169/services/device/time_zone_monitor/time_zone_monitor_linux.cc),
# so the browser is launched without TZ and follows the box clock sand-box-timezone sets.
CHROME_ENV=(
	env
	-u TZ
	-u SAND_GATEWAY_TOKEN
	-u SAND_EGRESS_TUNNEL_BEARER
	DISPLAY="${DISPLAY:-:1}"
	HOME="${SAND_CHROME_HOME:-/home/box}"
	XDG_RUNTIME_DIR="${CHROME_XDG}"
	DBUS_SESSION_BUS_ADDRESS="${CHROME_DBUS_ADDRESS}"
)
# A display that start-desktop gave audio devices serves PulseAudio from its
# runtime dir. The cookie path keeps libpulse from writing its cookie under the
# home dir (https://manpages.debian.org/trixie/pulseaudio-utils/pulse-client.conf.5.en.html).
if [ -S "${CHROME_XDG}/pulse/native" ]; then
	CHROME_ENV+=(
		PULSE_SERVER="unix:${CHROME_XDG}/pulse/native"
		PULSE_COOKIE="${CHROME_XDG}/pulse/cookie"
	)
fi
# fontconfig reads the config FONTCONFIG_FILE names in place of the system one
# (https://www.freedesktop.org/software/fontconfig/fontconfig-user.html), so with
# the stock-fonts marker Chrome lists only the fonts of a stock Ubuntu desktop.
SAND_BOX_BROWSER_STOCK_FONTS_CONF="${SAND_BOX_BROWSER_STOCK_FONTS_CONF:-/etc/fonts/sand-box-stock/fonts.conf}"
if [ -e "${SAND_BOX_BROWSER_STOCK_FONTS_FILE:-/tmp/sand-box-browser-stock-fonts}" ] &&
	[ -r "${SAND_BOX_BROWSER_STOCK_FONTS_CONF}" ]; then
	CHROME_ENV+=(FONTCONFIG_FILE="${SAND_BOX_BROWSER_STOCK_FONTS_CONF}")
fi
if [ -n "${SAND_CHROME_HOME:-}" ]; then
	CHROME_ENV+=(
		XDG_CONFIG_HOME="${SAND_CHROME_HOME}/.config"
		XDG_CACHE_HOME="${SAND_CHROME_HOME}/.cache"
		XDG_DATA_HOME="${SAND_CHROME_HOME}/.local/share"
		XDG_STATE_HOME="${SAND_CHROME_HOME}/.local/state"
		TMPDIR="${SAND_CHROME_HOME}/tmp"
	)
fi
if [ "$(id -u)" -eq 0 ]; then
	CHROME_ENV=(runuser -u box -- "${CHROME_ENV[@]}")
fi

# The shell that runs the launcher may name a proxy, and curl would send a
# request for this box's own port to it (https://curl.se/docs/manpage.html#--noproxy).
chrome_ready() {
	curl --noproxy '*' --max-time 1 -fsS "http://127.0.0.1:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
	CHROME_READY_STATUS=$?
	return "${CHROME_READY_STATUS}"
}

# Headful Chrome serves CDP on 127.0.0.1:<port> and, when that is still held,
# on [::1]:<port> for the rest of its life
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/chrome/browser/devtools/remote_debugging_server.cc).
# Handing a launch to a browser that is shutting down makes Chrome start a
# second browser at once, and one that has not answered for 20 s is SIGKILLed
# without waiting for it to exit
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/chrome/browser/process_singleton_posix.cc);
# the new browser then aborts on the old SingletonLock or lands on [::1]. So
# box-chrome only hands a launch to a browser that answers CDP, keeps the
# browser running past its last window, and starts a new one only once the old
# process is gone and the port is free.
chrome_on_ipv6_only() {
	curl --noproxy '*' --max-time 1 -fsS "http://[::1]:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
}

process_running() {
	local state
	state="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null)" || return 1
	[ -n "${state}" ] && [ "${state%% *}" != Z ]
}

# Whether one of the processes in the comma-separated list $1 still exists.
# ps exits non-zero when it could not list the processes, and also when none
# of the ones it was asked for exists any more
# (https://gitlab.com/procps-ng/procps/-/blob/v4.0.4/src/ps/display.c). Only a
# ps that failed while one of them is still there has failed to look.
listed_process_left() {
	local rest="$1," pid
	while [ -n "${rest}" ]; do
		pid="${rest%%,*}"
		rest="${rest#*,}"
		[ -z "${pid}" ] || [ ! -e "${BOX_PROC_ROOT}/${pid}" ] || return 0
	done
	return 1
}

# The browser of this profile among the processes $1 names: its pid, then the
# exit statuses of ps and of awk, each after a colon. Any further arguments go
# in front of both commands. awk reads ps through a pipe, so a listing of any
# size needs no file.
profile_browser_listing() {
	local pids="$1"
	shift
	# shellcheck disable=SC2016
	"$@" ps -ww -o pid=,args= -p "${pids}" 2>/dev/null | "$@" awk -v want="--user-data-dir=${CHROME_PROFILE}" '
		{ for (i = 2; i <= NF; i++) if ($i ~ /^--type=/) next }
		{ for (i = 2; i <= NF; i++) if ($i == want) { print $1; exit } }'
	printf ':%s:%s' "${PIPESTATUS[0]}" "${PIPESTATUS[1]}"
}

# Reads what profile_browser_listing printed for the processes $1. Prints the
# browser's pid and exits 0 when it listed one. Otherwise exits 1 when the
# listing held none, and 2 when it cannot say: awk failed, or ps failed while a
# process it was asked for was still there.
profile_browser_found() {
	local pids="$1" listing="$2" pid statuses
	pid="${listing%%:*}"
	pid="${pid//[!0-9]/}"
	if [ -n "${pid}" ]; then
		printf '%s' "${pid}"
		return 0
	fi
	statuses="${listing#*:}"
	[ "${statuses#*:}" = 0 ] || return 2
	[ "${statuses%%:*}" = 0 ] || ! listed_process_left "${pids}" || return 2
	return 1
}

# Exits 1 when no browser of this profile runs and higher when it could not
# look: pgrep exits above 1 then
# (https://man7.org/linux/man-pages/man1/pgrep.1.html#EXIT_STATUS).
profile_browser_pid() {
	local pids
	pids="$(pgrep -d, -x chrome 2>/dev/null)" || return
	profile_browser_found "${pids}" "$(profile_browser_listing "${pids}")"
}

cdp_port_listening() {
	local out
	out="$(ss -ltnH "sport = :${CHROME_DEBUG_PORT}" 2>/dev/null)"
	CDP_PORT_READ_STATUS=$?
	[ -n "${out}" ]
}

stop_browser() {
	local pid="$1" target="$1" end
	[ "$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d ' ')" = "${pid}" ] && target="-${pid}"
	kill -TERM -- "${target}" 2>/dev/null || true
	end=$((SECONDS + 3))
	while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do sleep 0.1; done
	process_running "${pid}" && {
		CHROME_PRIOR_BROWSER=killed
		kill -KILL -- "${target}" 2>/dev/null
	}
	end=$((SECONDS + 10))
	while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do sleep 0.1; done
}

release_profile_browser() {
	local pid end status found=0
	CHROME_PRIOR_BROWSER=none CHROME_PRIOR_PORT=""
	pid="$(profile_browser_pid)" || found=$?
	[ "${found}" -le 1 ] || CHROME_PRIOR_BROWSER=unread
	if [ "${found}" -eq 0 ]; then
		CHROME_PRIOR_BROWSER=exited
		if ! chrome_on_ipv6_only; then
			end=$((SECONDS + CHROME_RELEASE_GRACE_S))
			while process_running "${pid}" && [ "${SECONDS}" -lt "${end}" ]; do
				chrome_ready && {
					CHROME_PRIOR_BROWSER=answered
					return 0
				}
				sleep 0.1
			done
		fi
		process_running "${pid}" && {
			CHROME_PRIOR_BROWSER=stopped
			stop_browser "${pid}"
		}
		process_running "${pid}" && {
			CHROME_PRIOR_BROWSER=stuck
			return 1
		}
	fi
	end=$((SECONDS + CHROME_PORT_WAIT_S))
	CHROME_PRIOR_PORT=free
	while cdp_port_listening; do
		CHROME_PRIOR_PORT=held
		[ "${SECONDS}" -lt "${end}" ] || return 1
		sleep 0.1
	done
	status=$?
	if [ "${CDP_PORT_READ_STATUS:-0}" -ne 0 ]; then
		CHROME_PRIOR_PORT=unread
	elif [ "${CHROME_PRIOR_PORT}" != free ]; then
		CHROME_PRIOR_PORT=cleared
	fi
	return "${status}"
}

# Chrome on Linux keeps only the last value of a repeated switch
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/base/command_line.cc),
# so every --disable-features value is folded into the last such switch.
merge_disable_features() {
	local -n merge_flags="$1"
	local i last=-1 count=0 merged="" feature features=()
	for i in "${!merge_flags[@]}"; do
		case "${merge_flags[i]}" in --disable-features=*)
			last="${i}"
			count=$((count + 1))
			;;
		esac
	done
	[ "${count}" -gt 1 ] || return 0
	for i in "${last}" "${!merge_flags[@]}"; do
		case "${merge_flags[i]-}" in --disable-features=*) ;; *) continue ;; esac
		IFS=, read -r -a features <<<"${merge_flags[i]#--disable-features=}"
		for feature in "${features[@]}"; do
			[ -n "${feature}" ] || continue
			case ",${merged}," in *",${feature},"*) ;; *) merged+="${merged:+,}${feature}" ;; esac
		done
		[ "${i}" = "${last}" ] || unset 'merge_flags[i]'
	done
	merge_flags[last]="--disable-features=${merged}"
	merge_flags=("${merge_flags[@]}")
}

SAND_BROWSER_EXIT_LOCALE_FILE="${SAND_BROWSER_EXIT_LOCALE_FILE:-/tmp/sand-browser-exit-locale}"
SAND_EXIT_LOCALE_WAIT_S="${SAND_EXIT_LOCALE_WAIT_S:-8}"
SAND_EXIT_LOCALE_OUTCOME=""
SAND_EXIT_LOCALE_LOOKUP_MS=""
SAND_EXIT_LOCALE_LANGUAGE=""
exit_locale_script() {
	local bundled="${0%/box-launchers/box-chrome}/box-scripts/sand-egress-timezone.mjs"
	case "$0" in
	/*/box-launchers/box-chrome)
		[ ! -r "${bundled}" ] || {
			printf '%s' "${bundled}"
			return 0
		}
		;;
	esac
	printf '%s' /usr/local/bin/sand-egress-timezone.mjs
}
# With TZ set, Chrome takes its zone from TZ instead of watching /etc/localtime
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/151.0.7922.169/services/device/time_zone_monitor/time_zone_monitor_linux.cc),
# so every page and worker of this browser keeps the exit's zone, and the
# governor reads the zone back from --sand-exit-geo. A lookup that fails or
# runs out of time leaves the launch as it was.
apply_exit_locale() {
	local script line zone list provider source i started status=0 as_box=()
	SAND_EXIT_LOCALE_OUTCOME="" SAND_EXIT_LOCALE_LOOKUP_MS="" SAND_EXIT_LOCALE_LANGUAGE=""
	[ -e "${SAND_BROWSER_EXIT_LOCALE_FILE}" ] || return 0
	SAND_EXIT_LOCALE_OUTCOME=skipped
	[ -n "${SAND_EGRESS_PROXY_ADDR}" ] || return 0
	[ "${#SAND_TAILNET_SUFFIXES[@]}" -eq 0 ] || return 0
	script="$(exit_locale_script)"
	[ -x "${SAND_COOKIE_NODE}" ] && [ -r "${script}" ] || return 0
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	started="$(date +%s%3N)"
	line="$(timeout "${SAND_EXIT_LOCALE_WAIT_S}" "${as_box[@]}" "${SAND_COOKIE_NODE}" "${script}" \
		--exit-locale "http://${SAND_EGRESS_PROXY_ADDR}" "${SAND_ACCEPT_LANGUAGE_LIST}" </dev/null 2>/dev/null 9>&-)" || status=$?
	SAND_EXIT_LOCALE_LOOKUP_MS=$(($(date +%s%3N) - started))
	[ "${SAND_EXIT_LOCALE_LOOKUP_MS}" -ge 0 ] || SAND_EXIT_LOCALE_LOOKUP_MS=0
	case "${status}" in
	0) SAND_EXIT_LOCALE_OUTCOME=failed ;;
	124) SAND_EXIT_LOCALE_OUTCOME=timeout; return 0 ;;
	*) SAND_EXIT_LOCALE_OUTCOME=failed; return 0 ;;
	esac
	IFS=$'\t' read -r zone list provider source <<<"${line}" || true
	case "${zone}" in
	-) SAND_EXIT_LOCALE_OUTCOME=no_zone; return 0 ;;
	'' | */ | /* | *..* | *[!A-Za-z0-9_+/-]*) return 0 ;;
	esac
	[ -f "/usr/share/zoneinfo/${zone}" ] || return 0
	case "${provider},${source}" in
	*[!a-z_,]*) return 0 ;;
	esac
	CHROME_ENV+=(TZ="${zone}")
	CHROME_FLAGS+=(--sand-exit-geo="${zone},${provider},${source}")
	SAND_EXIT_LOCALE_OUTCOME=applied
	SAND_EXIT_LOCALE_LANGUAGE=false
	if [ "${SAND_ACCEPT_LANGUAGE_FLAGGED}" = 1 ] && sand_accept_language_valid "${list}"; then
		for i in "${!CHROME_FLAGS[@]}"; do
			case "${CHROME_FLAGS[i]}" in --accept-lang=*) CHROME_FLAGS[i]="--accept-lang=${list}" ;; esac
		done
		[ "${list}" = "${SAND_ACCEPT_LANGUAGE_LIST}" ] || SAND_EXIT_LOCALE_LANGUAGE=true
	fi
}

mark_exit_locale_held() {
	SAND_EXIT_LOCALE_OUTCOME="" SAND_EXIT_LOCALE_LOOKUP_MS="" SAND_EXIT_LOCALE_LANGUAGE=""
	[ ! -e "${SAND_BROWSER_EXIT_LOCALE_FILE}" ] || SAND_EXIT_LOCALE_OUTCOME=held
}

exit_locale_row_fields() {
	case "${SAND_EXIT_LOCALE_OUTCOME}" in
	applied | no_zone | timeout | failed | skipped | held) printf ',"exitLocale":"%s"' "${SAND_EXIT_LOCALE_OUTCOME}" ;;
	*) return 0 ;;
	esac
	case "${SAND_EXIT_LOCALE_LOOKUP_MS}" in
	'' | *[!0-9]*) ;;
	*) printf ',"exitLocaleLookupMs":%s' "${SAND_EXIT_LOCALE_LOOKUP_MS}" ;;
	esac
	case "${SAND_EXIT_LOCALE_LANGUAGE}" in
	true | false) printf ',"exitLocaleLanguage":%s' "${SAND_EXIT_LOCALE_LANGUAGE}" ;;
	esac
}

BOX_BROWSER_CGROUP_ENTER=/usr/local/bin/box-browser-cgroup-enter.sh
launch_chrome() {
	local flags=("${CHROME_FLAGS[@]}") env=("${CHROME_ENV[@]}") leaf=()
	if [ "${CHROME_BIN}" = "${UNGOOGLED_CHROMIUM}" ]; then
		flags+=("${UNGOOGLED_ONLY_FEATURE_FLAGS[@]}" "${UNGOOGLED_CHROMIUM_FLAGS[@]}")
	elif [ "${SAND_UNGOOGLED_FLAGS_ON}" = 1 ]; then
		flags+=("${UNGOOGLED_CHROMIUM_FLAGS[@]}")
	fi
	merge_disable_features flags
	[ -z "${CHROME_TMPDIR:-}" ] || [ ! -d "${CHROME_TMPDIR}" ] || env+=(TMPDIR="${CHROME_TMPDIR}")
	[ ! -x "${BOX_BROWSER_CGROUP_ENTER}" ] || leaf=("${BOX_BROWSER_CGROUP_ENTER}" --exec --)
	setsid -f /usr/local/bin/box-bounded-log --run "${CHROME_LOG}" -- \
		"${leaf[@]}" \
		"${env[@]}" \
		nice -n 10 "${CHROME_BIN}" "${flags[@]}" "$@" \
		</dev/null >/dev/null 2>&1 9>&-
}

# On Linux Chrome copies each CRX it installs into its temp dir and unpacks it
# there, and an install it drops leaves both copies behind
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/sandboxed_unpacker.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/extensions/browser/updater/extension_downloader.cc).
# Each profile keeps its own TMPDIR in its display's runtime dir, which
# stop-window removes, and a cold launch empties it under the profile lock once
# no browser holds the profile, so nothing in it belongs to a running Chrome.
reset_chrome_tmpdir() {
	local as_box=()
	[ -n "${CHROME_TMPDIR:-}" ] || return 0
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	"${as_box[@]}" rm -rf -- "${CHROME_TMPDIR}" 2>/dev/null
	"${as_box[@]}" mkdir -m 700 -- "${CHROME_TMPDIR}" 2>/dev/null || true
}

lowercase_trimmed() {
	local value="$1"
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "${value,,}"
}

# The UA governor's rule: an env value of 1, on, true, or yes is on, and 0,
# off, false, or no is off; with any other value the marker file is on,
# unless honor_contents and it says 0, off, false, or no.
marker_gate_on() {
	local path="$2" honor_contents="$3" contents=""
	case "$(lowercase_trimmed "$1")" in
	1 | on | true | yes) return 0 ;;
	0 | off | false | no) return 1 ;;
	esac
	[ -e "${path}" ] || return 1
	[ "${honor_contents}" = 1 ] || return 0
	read -r contents 2>/dev/null <"${path}" || true
	case "$(lowercase_trimmed "${contents}")" in
	0 | off | false | no) return 1 ;;
	esac
	return 0
}

# The stealth markers in force for this cold launch, in the vocabulary order of
# SAND_BROWSER_LAUNCH_MARKERS. The ones this script applies read what it did;
# the governor's and the tunnel's read their markers as those readers do, at
# launch. The governor rereads its markers once a browser has no page open.
box_browser_launch_markers() {
	local markers=()
	marker_gate_on "${SAND_BOX_BROWSER_COHERENT_FINGERPRINT:-}" \
		"${SAND_BOX_BROWSER_COHERENT_FINGERPRINT_FILE:-/tmp/sand-box-browser-coherent-fingerprint}" 1 &&
		markers+=(coherent_fingerprint)
	[ "${BOX_CHROME_WEBRTC_PROXY_ONLY}" = true ] && markers+=(webrtc_proxy_only)
	[ "${SAND_BOX_BROWSER_NO_LOCAL_DNS}" = "1" ] && [ -n "${SAND_EGRESS_PROXY_BYPASS_FLAG:-}" ] &&
		markers+=(no_local_dns)
	[ "${SAND_CHROME_DISABLE_QUIC}" = "1" ] && markers+=(disable_quic)
	[ -e "${SAND_BROWSER_ACCEPT_LANGUAGE_EN_US_FILE:-/tmp/sand-browser-accept-language-en-us}" ] &&
		markers+=(accept_language)
	marker_gate_on "${SAND_BROWSER_EGRESS_TIMEZONE:-}" \
		"${SAND_BROWSER_EGRESS_TIMEZONE_FILE:-/tmp/sand-browser-egress-timezone}" 0 &&
		markers+=(egress_timezone)
	[ -e "${SAND_EGRESS_TUNNEL_FAIL_CLOSED_FILE:-/tmp/sand-egress-tunnel-fail-closed}" ] &&
		markers+=(fail_closed)
	printf '%s\n' "${markers[*]}"
}

mark_box_browser_launch() {
	printf '%s\n' "${BOX_BROWSER}" >"${BOX_BROWSER_RUNNING_FILE}.$$" &&
		mv -f "${BOX_BROWSER_RUNNING_FILE}.$$" "${BOX_BROWSER_RUNNING_FILE}" 2>/dev/null || true
}

record_box_browser() {
	mark_box_browser_launch
	printf '%s\n' "${BOX_CHROME_GPU_MODE}" >"${BOX_BROWSER_GPU_MODE_FILE}.$$" &&
		mv -f "${BOX_BROWSER_GPU_MODE_FILE}.$$" "${BOX_BROWSER_GPU_MODE_FILE}" 2>/dev/null || true
	box_browser_launch_markers >"${BOX_BROWSER_LAUNCH_MARKERS_FILE}.$$" &&
		mv -f "${BOX_BROWSER_LAUNCH_MARKERS_FILE}.$$" "${BOX_BROWSER_LAUNCH_MARKERS_FILE}" 2>/dev/null || true
}

# Chromium 139 dies right after it starts serving CDP on a profile whose
# Default/Sync Data store Google Chrome 155 wrote. ungoogled-chromium blocks
# its own requests to Google's hosts and so never syncs
# (https://github.com/ungoogled-software/ungoogled-chromium/blob/master/README.md),
# so its cold launch drops the store and Chrome rebuilds it on its next launch.
drop_sync_store_for_ungoogled() {
	[ "${CHROME_BIN}" = "${UNGOOGLED_CHROMIUM}" ] || return 0
	[ ! -L "${CHROME_PROFILE}/Default" ] || return 0
	rm -rf -- "${CHROME_PROFILE}/Default/Sync Data" 2>/dev/null || true
}

use_running_browser() {
	local recorded=""
	read -r recorded 2>/dev/null <"${BOX_BROWSER_RUNNING_FILE}" || true
	if [ "${recorded}" = ungoogled-chromium ] && [ -x "${UNGOOGLED_CHROMIUM}" ]; then
		CHROME_BIN="${UNGOOGLED_CHROMIUM}"
	else
		CHROME_BIN=google-chrome-stable
	fi
}

# Chrome keeps session cookies only in memory
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/151.0.7922.169/net/cookies/cookie_monster.h),
# so a cold launch comes up without them until the saved cookie seed is pushed
# back in. That has to finish before Chrome is handed a URL: a page that loads
# first gets a fresh session cookie under the same name, and the seed then saves
# that value over the login.
restore_cookie_seed() {
	local out
	[ -s "${SAND_COOKIE_SEED:-}" ] && [ -x "${SAND_COOKIE_NODE:-}" ] && [ -r "${SAND_COOKIE_PERSIST:-}" ] || return 0
	out="$(timeout "${CHROME_COOKIE_RESTORE_WAIT_S:-5}" "${SAND_COOKIE_NODE}" "${SAND_COOKIE_PERSIST}" \
		--restore-port "${CHROME_DEBUG_PORT}" </dev/null 2>&1 9>&-)" || true
	[ -z "${out}" ] || printf '%s\n' "${out}" 2>/dev/null >>"${SAND_COOKIE_RESTORE_LOG:-/dev/null}" || true
}

# box-chrome-policy keeps session cookies past the last window by making each
# profile restore its last session, and Chrome restores it in the next window
# from the files it writes under Default/Sessions, or under
# Default/Sessions_Encrypted once its EncryptSessionStorage field trial is on
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/chrome/browser/sessions/session_service.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/components/sessions/core/command_storage_backend.cc,
# https://chromium.googlesource.com/chromium/src/+/refs/tags/155.0.8059.84/components/sessions/core/command_storage_manager.cc).
# An empty folder Chrome cannot write leaves no session to restore, so a closed
# tab never comes back, and a running Chrome loses the file it has open.
lock_session_restore() {
	local default="${CHROME_PROFILE}/Default" folder sessions as_box=()
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	for folder in Sessions Sessions_Encrypted; do
		sessions="${default}/${folder}"
		if [ "$(stat -c %a "${sessions}" 2>/dev/null)" = 555 ] && [ -z "$(ls -A "${sessions}" 2>/dev/null)" ]; then
			continue
		fi
		[ -L "${sessions}" ] || "${as_box[@]}" chmod u+w -- "${sessions}" 2>/dev/null
		"${as_box[@]}" rm -rf -- "${sessions}" 2>/dev/null || continue
		{ [ -d "${default}" ] || "${as_box[@]}" mkdir -m 700 -- "${default}"; } 2>/dev/null &&
			"${as_box[@]}" mkdir -m 555 -- "${sessions}" 2>/dev/null || true
	done
}

# Both profiles share the box-chrome window class on one display, so the wait
# matches a visible window owned by this profile's own browser process.
chrome_window_up() {
	local pid
	pid="$(profile_browser_pid)" || return 1
	DISPLAY="${DISPLAY:-:1}" xdotool search --onlyvisible --pid "${pid}" >/dev/null 2>&1
}

chrome_visible_windows() {
	local pid
	[ "${BOX_CHROME_WM_MAXIMIZE}" = 1 ] || return 0
	pid="$(profile_browser_pid)" || return 0
	DISPLAY="${DISPLAY:-:1}" xdotool search --onlyvisible --pid "${pid}" 2>/dev/null
}

# Chrome opens a window from a maximized one maximized, so only a window the
# launch brought up is maximized (https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/chrome/browser/ui/window_sizer/window_sizer.cc).
wm_maximize_new_windows() {
	local shown="$1" id
	[ "${BOX_CHROME_WM_MAXIMIZE}" = 1 ] || return 0
	for id in $(chrome_visible_windows); do
		case " ${shown//$'\n'/ } " in *" ${id} "*) continue ;; esac
		DISPLAY="${DISPLAY:-:1}" wmctrl -i -r "${id}" -b add,maximized_vert,maximized_horz 2>/dev/null || true
	done
}

wait_for_chrome() {
	local visible="$1" end=$((SECONDS + CHROME_LAUNCH_WAIT_S))
	CHROME_CDP_READY_MS=""
	while :; do
		if chrome_ready; then
			[ -n "${CHROME_CDP_READY_MS}" ] || CHROME_CDP_READY_MS="$(date +%s%3N)"
			if [ "${visible}" -eq 0 ] || chrome_window_up; then
				return
			fi
		fi
		[ "${SECONDS}" -lt "${end}" ] || return 1
		sleep 0.1
	done
}

display_up() {
	DISPLAY="${DISPLAY:-:1}" timeout 2 xdotool getdisplaygeometry >/dev/null 2>&1
}

# curl sends a plain http request through the proxy that http_proxy, all_proxy
# or ALL_PROXY names unless no_proxy covers the host
# (https://curl.se/docs/manpage.html#ENVIRONMENT). The readiness check goes past
# that proxy as the read after the wait does, so with one of them set a launch
# reads proxied only when the browser answers that read and not the readiness
# check that follows it. A launcher whose readiness check went to the proxy
# wrote proxied for a browser the check never reached.
cdp_proxy_named() {
	[ -n "${http_proxy:-}${all_proxy:-}${ALL_PROXY:-}" ]
}

cdp_answers_past_proxy() {
	curl --noproxy '*' --max-time 1 -fsS "http://$1:${CHROME_DEBUG_PORT}/json/version" >/dev/null 2>&1
}

cdp_timeout_state() {
	local pid
	if [ "${CHROME_PORT_HELD}" -ne 0 ]; then
		printf held
	elif pid="$(profile_browser_pid)" && process_running "${pid}"; then
		if cdp_proxy_named && cdp_answers_past_proxy 127.0.0.1; then
			if chrome_ready; then
				printf listening
			else
				printf proxied
			fi
		elif cdp_answers_past_proxy '[::1]'; then
			printf ipv6_only
		elif cdp_port_listening; then
			printf listening
		else
			printf silent
		fi
	elif display_up; then
		printf exited
	else
		printf no_display
	fi
}

# Reads the leaf the firewall armed with the firewall's own reader, in a child
# shell so sourcing it changes nothing here, and the browser's cgroup as the
# kernel lists it (https://docs.kernel.org/admin-guide/cgroup-v2.html#processes).
# The child is handed the state path, so a path the launcher's environment
# names is not read. Each read is capped, so a state file that never answers
# reads unknown. Prints nothing on an image that has no browser firewall.
browser_firewall_state() {
	local leaf pid membership status=0
	[ -r "${BOX_BROWSER_FIREWALL_LIB:-}" ] || return 0
	# shellcheck disable=SC2016
	leaf="$(SAND_BROWSER_FIREWALL_STATE="${BOX_BROWSER_FIREWALL_STATE}" \
		timeout "${BOX_BROWSER_FIREWALL_READ_S}" bash -c \
		'. "$1" >/dev/null 2>&1 && sand_browser_firewall_armed_leaf 2>/dev/null' \
		_ "${BOX_BROWSER_FIREWALL_LIB}")" || status=$?
	if [ "${status}" -ge 124 ]; then
		printf unknown
	elif [ -z "${leaf}" ]; then
		printf not_armed
	elif pid="$(profile_browser_pid)" &&
		membership="$(timeout "${BOX_BROWSER_FIREWALL_READ_S}" cat "${BOX_PROC_ROOT}/${pid}/cgroup" 2>/dev/null)"; then
		if printf '%s\n' "${membership}" | grep -Eq "^0::/${leaf}(/|$)"; then
			printf armed
		else
			printf not_joined
		fi
	else
		printf unknown
	fi
}

# curl's exit status says how a request ended (https://everything.curl.dev/cmdline/exitcode.html).
curl_result_class() {
	case "$1" in
	0) printf ok ;;
	7) printf refused ;;
	28) printf timeout ;;
	52) printf empty_reply ;;
	56) printf reset ;;
	22) printf http_error ;;
	5 | 97) printf proxy_error ;;
	*) printf other ;;
	esac
}

# True for a regular file that is not a link. The reads below open nothing
# else: opening a FIFO waits for its other end
# (https://man7.org/linux/man-pages/man7/fifo.7.html) and a link leads to a
# file someone else chose.
plain_file() {
	[ -f "$1" ] && [ ! -L "$1" ]
}

# A command ended by its cap, or one that could not be run, exits with one of
# these (https://www.gnu.org/software/coreutils/manual/html_node/timeout-invocation.html).
read_cut_off() {
	case "$1" in
	124 | 125 | 126 | 127 | 137) return 0 ;;
	esac
	return 1
}

# One more readiness request after the wait, keeping the HTTP status and
# whether the connection opened (https://curl.se/docs/manpage.html#-w). It goes
# to the port itself and not to a proxy the launcher's shell names
# (https://curl.se/docs/manpage.html#--noproxy). $1 is the time it may take.
cdp_timeout_probe() {
	local out status=0 code="" connect="" class
	out="$(timeout -s KILL "$1" curl --noproxy '*' --max-time 1 -sS -o /dev/null -w '%{http_code} %{time_connect}' \
		"http://127.0.0.1:${CHROME_DEBUG_PORT}/json/version" 2>/dev/null)" || status=$?
	if read_cut_off "${status}"; then
		printf unread
		return
	fi
	code="${out%% *}"
	connect=""
	[ "${out}" = "${code}" ] || connect="${out#* }"
	connect="${connect%% *}"
	case "${code}" in
	[1-5][0-9][0-9]) ;;
	*) code="" ;;
	esac
	case "${status}" in
	0)
		class=ok
		[ -z "${code}" ] || [ "${code}" -lt 400 ] || class=http_error
		;;
	28)
		class=connect_timeout
		case "${connect}" in *[1-9]*) class=reply_timeout ;; esac
		;;
	*) class="$(curl_result_class "${status}")" ;;
	esac
	printf '%s %s' "${class}" "${code}"
}

# Who listens on the CDP port and where, from the socket table's process
# column (https://man7.org/linux/man-pages/man8/ss.8.html). A listener that is
# not this profile's browser is named by its executable name, from a closed set.
# $1 is this profile's browser process, empty when there is none and unread
# when it could not be looked up, in which case a holder named chrome is not
# told apart. $2 is the time the read may take; a read that fails or is cut
# off says so rather than that nothing listens.
# Reads the socket table's rows for the port on its input and prints the
# owner and the address they name.
cdp_port_rows() {
	local browser_pid="$1" local_address users rest name pid
	local owner_re='\("([^"]*)",pid=([0-9]+)'
	local listening=0 own=0 unsure=0 foreign="" ipv4=0 ipv6=0 wildcard=0 odd=0 owner address=""
	while read -r _ _ _ local_address _ users; do
		[ -n "${local_address}" ] || continue
		listening=1
		case "${local_address%:*}" in
		127.0.0.1) ipv4=1 ;;
		'[::1]') ipv6=1 ;;
		0.0.0.0 | '*' | '[::]') wildcard=1 ;;
		*) odd=1 ;;
		esac
		rest="${users}"
		while [[ "${rest}" =~ ${owner_re} ]]; do
			name="${BASH_REMATCH[1]}" pid="${BASH_REMATCH[2]}"
			rest="${rest#*"${BASH_REMATCH[0]}"}"
			if [ -n "${browser_pid}" ] && [ "${pid}" = "${browser_pid}" ]; then
				own=1
			elif [ "${browser_pid}" = unread ] && [ "${name}" = chrome ]; then
				unsure=1
			elif [ -z "${foreign}" ]; then
				case "${name}" in
				chrome) foreign=chrome ;;
				node) foreign=node ;;
				python*) foreign=python ;;
				*) foreign=other ;;
				esac
			fi
		done
	done
	if [ -n "${foreign}" ]; then
		owner="${foreign}"
	elif [ "${unsure}" -eq 1 ]; then
		owner=unread
	elif [ "${own}" -eq 1 ]; then
		owner=browser
	elif [ "${listening}" -eq 1 ]; then
		owner=unknown
	else
		owner=none
	fi
	if [ "${wildcard}" -eq 1 ]; then
		address=wildcard
	elif [ "${odd}" -eq 1 ]; then
		address=other
	elif [ "${ipv4}" -eq 1 ] && [ "${ipv6}" -eq 1 ]; then
		address=both_loopbacks
	elif [ "${ipv4}" -eq 1 ]; then
		address=ipv4_loopback
	elif [ "${ipv6}" -eq 1 ]; then
		address=ipv6_loopback
	fi
	printf '%s %s' "${owner}" "${address}"
}

cdp_port_listener() {
	local out
	out="$(
		timeout -s KILL "$2" ss -ltnpH "sport = :${CHROME_DEBUG_PORT}" 2>/dev/null | cdp_port_rows "$1"
		printf ':%s' "${PIPESTATUS[0]}"
	)"
	if [ "${out##*:}" != 0 ]; then
		printf unread
		return
	fi
	printf '%s' "${out%:*}"
}

# Chrome names the machine and process holding a profile in its SingletonLock
# link, and a starting browser waits on a lock whose process is a live Chrome
# before it serves the profile
# (https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.57/chrome/browser/process_singleton_posix.cc).
# $1 is this profile's browser process, as for cdp_port_listener: when it
# could not be looked up, a lock held by a live Chrome is not told apart.
# $2 is the time reading the link may take.
profile_lock_state() {
	local browser_pid="$1" lock="${CHROME_PROFILE}/SingletonLock" target pid stat="" state comm
	if [ ! -L "${lock}" ]; then
		printf absent
		return
	fi
	if ! target="$(timeout -s KILL "$2" readlink -- "${lock}" 2>/dev/null)"; then
		printf unread
		return
	fi
	pid="${target##*-}"
	case "${target}" in
	*-*) ;;
	*) pid="" ;;
	esac
	case "${pid}" in
	'' | *[!0-9]*)
		printf unreadable
		return
		;;
	esac
	if [ -n "${browser_pid}" ] && [ "${pid}" = "${browser_pid}" ]; then
		printf own
		return
	fi
	if [ "${target%-*}" != "${HOSTNAME:-}" ]; then
		printf other_machine
		return
	fi
	if [ ! -e "${BOX_PROC_ROOT}/${pid}" ]; then
		printf dead
		return
	fi
	! plain_file "${BOX_PROC_ROOT}/${pid}/stat" ||
		IFS= read -r stat 2>/dev/null <"${BOX_PROC_ROOT}/${pid}/stat" || true
	state="${stat##*) }"
	state="${state%% *}"
	comm="${stat#*(}"
	comm="${comm%)*}"
	if [ -z "${stat}" ]; then
		printf unread
	elif [ "${state}" = Z ]; then
		printf dead
	elif [ "${comm}" = chrome ] && [ "${browser_pid}" = unread ]; then
		printf unread
	elif [ "${comm}" = chrome ]; then
		printf live_chrome
	else
		printf live_other
	fi
}

# Walks up from the launcher's parent. A parent it cannot read is not the same
# as no exec daemon among them, so it reads unread.
launched_from() {
	local pid="${PPID}" depth=0 args arg stat file
	while [ "${depth}" -lt 8 ]; do
		case "${pid}" in
		0 | 1) break ;;
		'' | *[!0-9]*)
			printf unread
			return
			;;
		esac
		file="${BOX_PROC_ROOT}/${pid}/cmdline"
		args=()
		if ! plain_file "${file}" || ! mapfile -d '' -t -n 4 args 2>/dev/null <"${file}"; then
			printf unread
			return
		fi
		for arg in "${args[@]}"; do
			case "${arg}" in
			*/exec-daemon/index.js | */exec-daemon/exec-daemon)
				printf exec_daemon
				return
				;;
			esac
		done
		file="${BOX_PROC_ROOT}/${pid}/stat"
		stat=""
		! plain_file "${file}" || IFS= read -r stat 2>/dev/null <"${file}" || true
		if [ -z "${stat}" ]; then
			printf unread
			return
		fi
		stat="${stat##*) }"
		stat="${stat#* }"
		pid="${stat%% *}"
		depth=$((depth + 1))
	done
	printf other
}

exec_daemon_build_fields() {
	local line lines=0 commit="" built=""
	local commit_re='"gitCommit":[[:space:]]*"([0-9a-f]{7,40})"'
	local built_re='"buildTimestamp":[[:space:]]*"([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,3})?Z)"'
	plain_file "${BOX_EXEC_DAEMON_PACKAGE}" || return 0
	while [ "${lines}" -lt 16 ] && { IFS= read -r -n 256 line || [ -n "${line}" ]; }; do
		lines=$((lines + 1))
		[[ "${line}" =~ ${commit_re} ]] && commit="${BASH_REMATCH[1]}"
		[[ "${line}" =~ ${built_re} ]] && built="${BASH_REMATCH[1]}"
	done 2>/dev/null <"${BOX_EXEC_DAEMON_PACKAGE}"
	[ -z "${commit}" ] || printf ',"execDaemonCommit":"%s"' "${commit}"
	[ -z "${built}" ] || printf ',"execDaemonBuiltAt":"%s"' "${built}"
}

box_boot_age_fields() {
	local started="${SAND_BOX_BOOT_STARTED_AT_MS:-}" now="${EPOCHSECONDS:-}" age
	case "${started}:${now}" in
	: | :* | *: | *[!0-9:]*) return 0 ;;
	esac
	[ "${#started}" -le 15 ] || return 0
	age=$((10#${now} - 10#${started} / 1000))
	[ "${age}" -lt 0 ] || [ "${age}" -gt 315360000 ] || printf ',"bootAgeS":%s' "${age}"
}

# Read once after a wait for CDP ran out, outside the row's duration. What
# needs a command runs in the background against one deadline, just short of
# CHROME_TIMEOUT_READ_S after this function starts so that writing the row
# fits inside it: every command may take only the time left, and this function
# stops listening at the deadline, so the launcher is held that long at most
# whatever a read does. That covers the process entries read for the
# launcher's ancestry too, since reading one can wait on the process it
# describes. A read that did not finish, or that a shell without a sub-second
# clock never started, reads unread, and the row says whether the reads
# finished, were cut off at the deadline or were not run. A read outside its
# closed set writes no field.
cdp_timeout_detail_fields() {
	local wait_status="$1" cap="${CHROME_TIMEOUT_READ_S:-2}" now="${EPOCHREALTIME:-}" class end reads fd line
	local ended=0 finished="" name
	now="${now/[.,]/}"
	case "${wait_status}" in
	'' | *[!0-9]*) ;;
	*)
		class="$(curl_result_class "${wait_status}")"
		case "${class}" in
		refused | timeout | empty_reply | reset | http_error | proxy_error | other)
			printf ',"cdpWaitResult":"%s"' "${class}"
			;;
		esac
		;;
	esac
	box_boot_age_fields
	case "${cap}:${now}" in
	: | :* | *: | *[!0-9:]*) ;;
	*)
		end=$((now + cap * 1000000 - 100000))
		# A read that outlives the deadline must hold nothing of the launcher's:
		# not the launch lock, which the next launch waits on, nor its input and
		# error streams, which its caller may wait on.
		exec {fd}< <(
			exec </dev/null 2>/dev/null 9>&-
			cdp_timeout_command_reads "${end}"
		)
		reads=$!
		while read_time_left "${end}"; do
			IFS= read -r -t "${READ_TIME_LEFT}" -u "${fd}" line || {
				ended=$?
				break
			}
			finished+=" ${line%% *}"
			printf '%s' "${line#* }"
		done
		exec {fd}<&-
		# read exits 1 once the reads have closed their end and above 128 when
		# its time ran out (https://www.gnu.org/software/bash/manual/html_node/Bash-Builtins.html);
		# only reads still running are ended.
		[ "${ended}" -eq 1 ] || kill "${reads}" 2>/dev/null || true
		;;
	esac
	case "${finished}:${reads:-}" in
	" from probe lock owner":*) printf ',"cdpReads":"finished"' ;;
	*:) printf ',"cdpReads":"not_run"' ;;
	*) printf ',"cdpReads":"cut_off"' ;;
	esac
	for name in from probe lock owner; do
		case "${finished} " in
		*" ${name} "*) continue ;;
		esac
		case "${name}" in
		from) printf ',"launchedFrom":"unread"' ;;
		probe) printf ',"cdpProbe":"unread"' ;;
		lock) printf ',"profileLock":"unread"' ;;
		owner) printf ',"cdpPortOwner":"unread"' ;;
		esac
	done
}

# The time left until $1, a microsecond count on the clock of EPOCHREALTIME
# (https://www.gnu.org/software/bash/manual/html_node/Bash-Variables.html), as
# seconds in READ_TIME_LEFT. Fails once none is left.
read_time_left() {
	local now="${EPOCHREALTIME:-}" left
	now="${now/[.,]/}"
	READ_TIME_LEFT=""
	case "${now}" in
	'' | *[!0-9]*) return 1 ;;
	esac
	left=$(($1 - now))
	[ "${left}" -gt 0 ] || return 1
	printf -v READ_TIME_LEFT '%d.%06d' "$((left / 1000000))" "$((left % 1000000))"
}

# This profile's browser process, found as profile_browser_pid finds it, with
# each command it runs held to the time left until $1. Prints the process id.
# Exits 1 when there is none and 2 when a command failed or was cut off, which
# says nothing about a browser.
profile_browser_pid_until() {
	local end="$1" pids listing status=0
	read_time_left "${end}" || return 2
	pids="$(timeout -s KILL "${READ_TIME_LEFT}" pgrep -d, -x chrome 2>/dev/null)" || status=$?
	case "${status}" in
	0) ;;
	1) return 1 ;;
	*) return 2 ;;
	esac
	read_time_left "${end}" || return 2
	listing="$(profile_browser_listing "${pids}" timeout -s KILL "${READ_TIME_LEFT}")"
	profile_browser_found "${pids}" "${listing}" || status=$?
	listing="${listing#*:}"
	[ "${status}" -ne 1 ] || ! read_cut_off "${listing%%:*}" || status=2
	return "${status}"
}

# Writes one line per read, its name and then its row fields, so a deadline
# keeps what finished and the caller knows what did not.
cdp_timeout_command_reads() {
	local end="$1" pid="" found=0 class code owner address lock line from out
	from="$(launched_from)"
	line=""
	case "${from}" in
	exec_daemon | other | unread) line=",\"launchedFrom\":\"${from}\"" ;;
	esac
	printf 'from %s\n' "${line}"
	read_time_left "${end}" || return 0
	out="$(cdp_timeout_probe "${READ_TIME_LEFT}")"
	class="${out%% *}"
	code="${out#"${class}"}"
	code="${code# }"
	line=""
	case "${class}" in
	ok | refused | connect_timeout | reply_timeout | empty_reply | reset | http_error | proxy_error | other | unread)
		line=",\"cdpProbe\":\"${class}\""
		;;
	esac
	case "${code}" in
	[1-5][0-9][0-9]) line+=",\"cdpProbeHttpStatus\":${code}" ;;
	esac
	printf 'probe %s\n' "${line}"
	pid="$(profile_browser_pid_until "${end}")" || found=$?
	[ "${found}" -eq 0 ] || pid=""
	[ "${found}" -le 1 ] || pid=unread
	read_time_left "${end}" || return 0
	lock="$(profile_lock_state "${pid}" "${READ_TIME_LEFT}")"
	line=""
	case "${lock}" in
	own | live_chrome | live_other | dead | other_machine | unreadable | absent | unread)
		line=",\"profileLock\":\"${lock}\""
		;;
	esac
	printf 'lock %s\n' "${line}"
	read_time_left "${end}" || return 0
	out="$(cdp_port_listener "${pid}" "${READ_TIME_LEFT}")"
	owner="${out%% *}"
	address="${out#"${owner}"}"
	address="${address# }"
	line=""
	case "${owner}" in
	browser | chrome | node | python | other | unknown | none | unread) line=",\"cdpPortOwner\":\"${owner}\"" ;;
	esac
	case "${address}" in
	ipv4_loopback | ipv6_loopback | both_loopbacks | wildcard | other)
		line+=",\"cdpPortAddress\":\"${address}\""
		;;
	esac
	printf 'owner %s\n' "${line}"
}

# The X server writes its process id to the display's lock file
# (https://gitlab.freedesktop.org/xorg/xserver/-/blob/master/os/utils.c) and a
# server that is killed leaves the file behind, so the id counts only while it
# is a live X server started for this display. A different one since the
# display's last cold launch means the display was taken down in between. The
# id stays in the display's record, which sits outside the profile so that
# nothing that saves or copies a profile holds it.
read_display_server() {
	local pid="" lock="${BOX_X_LOCK_DIR:-/tmp}/.X${BOX_DISPLAY_NUM:-1}-lock" entry stat="" state comm
	local cap="${CHROME_TIMEOUT_READ_S:-2}" now="${EPOCHREALTIME:-}" fd reader named="" ended=0
	CHROME_DISPLAY_SERVER="" CHROME_DISPLAY_SERVER_UNREAD=""
	! plain_file "${lock}" || read -r pid _ 2>/dev/null <"${lock}" || true
	case "${pid}" in
	'' | *[!0-9]*) return 0 ;;
	esac
	entry="${BOX_PROC_ROOT:-/proc}/${pid}"
	! plain_file "${entry}/stat" || IFS= read -r stat 2>/dev/null <"${entry}/stat" || true
	state="${stat##*) }"
	state="${state%% *}"
	comm="${stat#*(}"
	comm="${comm%)*}"
	case "${state}:${comm}" in
	[!Z]:X*) ;;
	*) return 0 ;;
	esac
	# A read of a process's command line goes through that process's memory and
	# can wait on it (get_mm_cmdline, https://github.com/torvalds/linux/blob/v6.12/fs/proc/base.c),
	# so a child does it against the deadline the reads after a timed-out wait
	# have, holding neither the launch lock nor the launcher's streams, and is
	# ended when it has not answered by then.
	CHROME_DISPLAY_SERVER_UNREAD=1
	now="${now/[.,]/}"
	case "${cap}:${now}" in
	: | :* | *: | *[!0-9:]*) return 0 ;;
	esac
	read_time_left "$((now + cap * 1000000 - 100000))" || return 0
	exec {fd}< <(
		exec </dev/null 2>/dev/null 9>&-
		display_server_named "${entry}/cmdline"
	)
	reader=$!
	IFS= read -r -t "${READ_TIME_LEFT}" -u "${fd}" named || ended=$?
	exec {fd}<&-
	[ "${ended}" -eq 1 ] || kill -KILL "${reader}" 2>/dev/null || true
	case "${named}" in
	yes) CHROME_DISPLAY_SERVER="${pid}" CHROME_DISPLAY_SERVER_UNREAD="" ;;
	no) CHROME_DISPLAY_SERVER_UNREAD="" ;;
	esac
}

display_server_named() {
	local arg
	local -a args=()
	if ! plain_file "$1" || ! mapfile -d '' -t -n 64 args 2>/dev/null <"$1"; then
		printf no
		return 0
	fi
	for arg in "${args[@]}"; do
		if [ "${arg}" = ":${BOX_DISPLAY_NUM:-1}" ]; then
			printf yes
			return 0
		fi
	done
	printf no
}

# down is a display with no live X server as this launch begins, whatever the
# record says. Otherwise the server is compared with the one the previous cold
# launch on the display recorded, which is - when that launch found none.
read_last_launch() {
	local boot="$1" record="${BOX_LAST_LAUNCH_FILE:-}" recorded_boot="" mode="" outcome="" server=""
	CHROME_PREV_MODE="" CHROME_PREV_OUTCOME="" CHROME_DISPLAY_SERVER_STATE=""
	if [ -n "${CHROME_DISPLAY_SERVER_UNREAD:-}" ]; then
		CHROME_DISPLAY_SERVER_STATE=unread
	elif [ -z "${CHROME_DISPLAY_SERVER}" ]; then
		CHROME_DISPLAY_SERVER_STATE=down
	fi
	[ -n "${record}" ] && plain_file "${record}" || return 0
	read -r recorded_boot mode outcome server _ 2>/dev/null <"${record}" || true
	[ "${recorded_boot}" = "${boot}" ] || return 0
	CHROME_PREV_MODE="${mode}" CHROME_PREV_OUTCOME="${outcome}"
	[ -n "${CHROME_DISPLAY_SERVER}" ] || return 0
	case "${server}" in
	"${CHROME_DISPLAY_SERVER}") CHROME_DISPLAY_SERVER_STATE=same ;;
	-) CHROME_DISPLAY_SERVER_STATE=restarted ;;
	'' | *[!0-9]*) ;;
	*) CHROME_DISPLAY_SERVER_STATE=restarted ;;
	esac
}

write_last_launch() {
	local record="${BOX_LAST_LAUNCH_FILE:-}" server="${CHROME_DISPLAY_SERVER:--}"
	[ -n "${record}" ] || return 0
	[ -z "${CHROME_DISPLAY_SERVER_UNREAD:-}" ] || server="?"
	# Anything at the path that is not a plain file stays as it is and the
	# display goes without a record.
	plain_file "${record}" || { [ ! -e "${record}" ] && [ ! -L "${record}" ]; } || return 0
	printf '%s %s %s %s\n' "$1" "$2" "$3" "${server}" 2>/dev/null >"${record}" || true
}

# The backend stamps a pod whose drive was seeded from a snapshot, and the
# entrypoint exports the boot time to everything it starts; a launcher that
# has neither was not started from that environment and cannot tell.
box_drive_seeded() {
	if [ "${SAND_BOX_USER_DATA_DRIVE_SEEDED_FROM_SNAPSHOT:-}" = 1 ]; then
		printf seeded
	elif [ -n "${SAND_BOX_BOOT_STARTED_AT_MS:-}" ]; then
		printf not_seeded
	else
		printf unknown
	fi
}

launch_begin_facts() {
	local entry
	CHROME_PRIOR_LOCK=false CHROME_PRIOR_TMP=""
	[ ! -L "${CHROME_PROFILE}/SingletonLock" ] || CHROME_PRIOR_LOCK=true
	[ -n "${CHROME_TMPDIR:-}" ] || return 0
	CHROME_PRIOR_TMP=false
	for entry in "${CHROME_TMPDIR}"/* "${CHROME_TMPDIR}"/.[!.]*; do
		if [ -e "${entry}" ] || [ -L "${entry}" ]; then
			CHROME_PRIOR_TMP=true
			break
		fi
	done
}

launch_begin_row_fields() {
	case "${CHROME_PRIOR_BROWSER:-}" in
	none | answered | exited | stopped | killed | stuck | unread)
		printf ',"priorBrowser":"%s"' "${CHROME_PRIOR_BROWSER}"
		;;
	esac
	case "${CHROME_PRIOR_PORT:-}" in
	free | cleared | held | unread) printf ',"priorPort":"%s"' "${CHROME_PRIOR_PORT}" ;;
	esac
	case "${CHROME_PRIOR_LOCK:-}" in
	true | false) printf ',"priorLock":%s' "${CHROME_PRIOR_LOCK}" ;;
	esac
	case "${CHROME_PRIOR_TMP:-}" in
	true | false) printf ',"priorTmp":%s' "${CHROME_PRIOR_TMP}" ;;
	esac
	case "${BOX_CHROME_RUNTIME_DIR:-}" in
	present | made) printf ',"runtimeDir":"%s"' "${BOX_CHROME_RUNTIME_DIR}" ;;
	esac
	case "${BOX_CHROME_DBUS_SOURCE:-}" in
	display | env | none) printf ',"dbusSource":"%s"' "${BOX_CHROME_DBUS_SOURCE}" ;;
	esac
	case "${CHROME_PREV_MODE:-}" in
	prepare | window) printf ',"prevMode":"%s"' "${CHROME_PREV_MODE}" ;;
	esac
	case "${CHROME_PREV_OUTCOME:-}" in
	started | ready | cdp_timeout | window_timeout) printf ',"prevOutcome":"%s"' "${CHROME_PREV_OUTCOME}" ;;
	esac
	case "${CHROME_DISPLAY_SERVER_STATE:-}" in
	same | restarted | down | unread) printf ',"displayServer":"%s"' "${CHROME_DISPLAY_SERVER_STATE}" ;;
	esac
	printf ',"driveSeeded":"%s"' "$(box_drive_seeded)"
	exec_daemon_build_fields
}

next_launch_attempt() {
	local counter="${CHROME_PROFILE}/.sand-launch-count" boot="$1"
	local recorded_boot="" count=0
	read -r recorded_boot count 2>/dev/null <"${counter}" || true
	[ "${recorded_boot}" = "${boot}" ] && [ "${count}" -ge 0 ] 2>/dev/null || count=0
	count=$((count + 1))
	printf '%s %s\n' "${boot}" "${count}" 2>/dev/null >"${counter}" || true
	printf '%s' "${count}"
}

profile_boot_id() {
	case "$1" in
	'' | unknown | *[!A-Za-z0-9-]*) return 1 ;;
	esac
	[ "${#1}" -le 64 ] || return 1
	printf '%s' "$1"
}

box_boot_id() {
	local boot="${SAND_BOX_BOOT_ID:-}"
	if [ -z "${boot}" ]; then
		read -r boot 2>/dev/null <"${SAND_BOX_BOOT_ID_FILE:-/tmp/sand-box-boot-id}" || true
		boot="$(profile_boot_id "${boot}")" || boot=""
	fi
	printf '%s' "${boot:-${SAND_BOX_BOOT_STARTED_AT_MS:-unknown}}"
}

write_profile_file() {
	printf '%s\n' "$2" 2>/dev/null >"$1.$$" && mv -f "$1.$$" "$1" 2>/dev/null || rm -f "$1.$$" 2>/dev/null || true
}

# Runs before next_launch_attempt so the launch count still names the boot
# that last launched this profile.
record_profile_origin() {
	local boot launched_boot="" prior_boot="" prior_recorded="" prior_profile="" recorded="-" late_gate="" gate=0
	local marker="${CHROME_PROFILE}/.sand-profile-origin.json" origin=unknown created="" boot_field launcher="" writer_boot=""
	[ -e "${SAND_BOX_WALL_EVIDENCE_RECORDERS_FILE:-/tmp/sand-box-wall-evidence-recorders}" ] && gate=1
	[ "${gate}" -eq 0 ] || write_profile_file "${BOX_PROFILE_DIR_FILE}" "${CHROME_PROFILE}"
	boot="$(profile_boot_id "$1")" || return 0
	read -r launched_boot _ 2>/dev/null <"${CHROME_PROFILE}/.sand-launch-count" || true
	if [ "${launched_boot}" = "${boot}" ]; then
		late_gate=',"lateGate":true'
		read -r prior_boot prior_recorded prior_profile 2>/dev/null <"${BOX_PROFILE_PRIOR_BOOT_FILE}" || true
		if [ "${prior_boot}" = "${boot}" ] && [ "${prior_profile}" = "${CHROME_PROFILE}" ]; then
			recorded="$(profile_boot_id "${prior_recorded}")" || recorded="-"
		fi
	else
		recorded="$(profile_boot_id "${launched_boot}")" || recorded="-"
		write_profile_file "${BOX_PROFILE_PRIOR_BOOT_FILE}" "${boot} ${recorded} ${CHROME_PROFILE}"
	fi
	[ "${gate}" -eq 1 ] || return 0
	[ ! -e "${marker}" ] && [ ! -L "${marker}" ] || return 0
	# Chrome writes Local State on its first run, so a profile without it or a
	# launch count has never been opened; any other profile predates the marker.
	if [ ! -e "${CHROME_PROFILE}/Local State" ] && [ ! -e "${CHROME_PROFILE}/.sand-launch-count" ]; then
		origin=fresh
		[ "${BOX_DISPLAY_NUM:-1}" -ge 2 ] 2>/dev/null && origin=fork
		created="\"createdMs\":$(date +%s%3N),"
		boot_field="\"${boot}\""
	elif [ "${recorded}" = "-" ]; then
		boot_field=null
		writer_boot=",\"writerBootId\":\"${boot}\""
	else
		boot_field="\"${recorded}\""
	fi
	case "${SAND_BOX_CHROME_LAUNCHER_SOURCE:-}" in
	bundle | image) launcher=",\"launcherSource\":\"${SAND_BOX_CHROME_LAUNCHER_SOURCE}\"" ;;
	esac
	write_profile_file "${marker}" \
		"{${created}\"origin\":\"${origin}\",\"bootId\":${boot_field},\"writerVersion\":${BOX_WALL_EVIDENCE_WRITER_VERSION}${launcher}${late_gate}${writer_boot}}"
}

start_chrome() {
	local mode="$1" visible=1 started_ms attempt outcome duration_ms cdp_ready_ms launcher_fields shown boot
	local cdp_state="" firewall="" cdp_wait_status=""
	shift
	[ "${mode}" = window ] || visible=0
	boot="$(box_boot_id)"
	record_profile_origin "${boot}"
	attempt="$(next_launch_attempt "${boot}")"
	read_display_server
	read_last_launch "${boot}"
	launch_begin_facts
	write_last_launch "${boot}" "${mode}" started
	started_ms="$(date +%s%3N)"
	if [ "${CHROME_PORT_HELD}" -eq 0 ]; then
		if [ "${policy_status:-0}" = 3 ]; then
			echo "box-chrome: sand_box_browser_webrtc_proxy_only is on but its managed policy could not be written; not launching" >&2
			exit 1
		fi
		if [ "${SAND_UNGOOGLED_FLAGS_ON}" = 1 ] && [ "${CHROME_BIN}" != "${UNGOOGLED_CHROMIUM}" ]; then
			echo "box-chrome: sand_box_browser_ungoogled_flags is on but ${CHROME_BIN} has no ReducedSystemInfo, SpoofWebGLInfo or SetIpv6ProbeFalse; launching without them" >&2
		fi
		apply_exit_locale
		record_box_browser
		drop_sync_store_for_ungoogled
		reset_chrome_tmpdir
		launch_chrome --no-startup-window
	else
		mark_exit_locale_held
		use_running_browser
	fi
	if ! wait_for_chrome 0; then
		outcome=cdp_timeout
		cdp_wait_status="${CHROME_READY_STATUS:-}"
	else
		cdp_ready_ms="${CHROME_CDP_READY_MS}"
		restore_cookie_seed
		if [ "${visible}" -eq 0 ]; then
			outcome=ready
		else
			shown="$(chrome_visible_windows)"
			launch_chrome "$@"
			if wait_for_chrome 1; then
				outcome=ready
				wm_maximize_new_windows "${shown}"
			else
				outcome=window_timeout
			fi
		fi
		CHROME_CDP_READY_MS="${cdp_ready_ms}"
	fi
	duration_ms=$((${CHROME_CDP_READY_MS:-$(date +%s%3N)} - started_ms))
	[ "${duration_ms}" -ge 0 ] || duration_ms=0
	launcher_fields=",\"launcher\":${BOX_CHROME_LAUNCHER_VERSION}"
	case "${SAND_BOX_CHROME_LAUNCHER_SOURCE:-}" in
	bundle | image) launcher_fields+=",\"launcherSource\":\"${SAND_BOX_CHROME_LAUNCHER_SOURCE}\"" ;;
	esac
	case "${BOX_CHROME_WEBRTC_PROXY_ONLY:-}:${BOX_CHROME_GATES_READY:-}" in
	true:true | true:false | false:true | false:false)
		launcher_fields+=",\"webrtcProxyOnly\":${BOX_CHROME_WEBRTC_PROXY_ONLY},\"gatesReady\":${BOX_CHROME_GATES_READY}"
		;;
	esac
	case "${BOX_CHROME_POLICY_RUN:-}" in
	ok | unwritable | failed) launcher_fields+=",\"policyRun\":\"${BOX_CHROME_POLICY_RUN}\"" ;;
	esac
	case "${BOX_CHROME_WEBRTC_FALLBACK:-}" in
	ok | unwritable | failed) launcher_fields+=",\"webrtcFallback\":\"${BOX_CHROME_WEBRTC_FALLBACK}\"" ;;
	esac
	[ -z "${BOX_CHROME_LAUNCHER_COMMIT:-}" ] ||
		launcher_fields+=",\"launcherCommit\":\"${BOX_CHROME_LAUNCHER_COMMIT}\""
	case "${BOX_CHROME_GPU_MODE:-}" in
	swiftshader | legacy | stock | llvmpipe) launcher_fields+=",\"gpuMode\":\"${BOX_CHROME_GPU_MODE}\"" ;;
	esac
	launcher_fields+="$(exit_locale_row_fields)"
	firewall="$(browser_firewall_state)"
	case "${firewall}" in
	armed | not_joined | not_armed | unknown) launcher_fields+=",\"browserFirewall\":\"${firewall}\"" ;;
	esac
	[ "${outcome:-}" != cdp_timeout ] || cdp_state="$(cdp_timeout_state)"
	case "${cdp_state:-}" in
	held | no_display | exited | ipv6_only | silent | proxied | listening)
		launcher_fields+=",\"cdpTimeoutState\":\"${cdp_state}\""
		;;
	esac
	launcher_fields+="$(launch_begin_row_fields)"
	[ "${outcome:-}" != cdp_timeout ] || launcher_fields+="$(cdp_timeout_detail_fields "${cdp_wait_status}")"
	write_last_launch "${boot}" "${mode}" "${outcome}"
	printf '{"kind":"chrome_launch","display":%s,"mode":"%s","attempt":%s,"outcome":"%s","durationMs":%s%s}\n' \
		"${BOX_DISPLAY_NUM:-1}" "${mode}" "${attempt}" "${outcome}" "${duration_ms}" "${launcher_fields}" \
		2>/dev/null >>"${SAND_BOX_TELEMETRY_LOG:-/tmp/sand-box-telemetry.log}" || true
	[ "${outcome}" = ready ]
}

exec 9>"${CHROME_PROFILE}/.sand-launch.lock"
flock -w 90 9 || exit 1
lock_session_restore

CHROME_PORT_HELD=0
chrome_ready || release_profile_browser || CHROME_PORT_HELD=1

# A force-installed extension gets NO incognito access by default, and Chrome
# reports that by simply not proxying: an incognito window falls through to
# Chrome's own WebAuthn stack, which in a box with no USB shows a "touch your
# key" dialog that can never be satisfied. Grant it the same way the
# chrome://extensions toggle does, by seeding the profile pref. Only while this
# profile's Chrome is down — a running Chrome rewrites Preferences from memory
# on exit and would drop the edit — and re-applied on every cold launch so a
# profile that lost the grant heals itself.
if [ -f "${SAND_WEBAUTHN_MARKER}" ] && [ -r "${SAND_WEBAUTHN_ID_FILE}" ] &&
	! chrome_ready && command -v python3 >/dev/null 2>&1; then
	SAND_INCOGNITO_SEED=(python3 -I -)
	if [ "$(id -u)" -eq 0 ]; then
		SAND_INCOGNITO_SEED=(runuser -u box -- python3 -I -)
	fi
	"${SAND_INCOGNITO_SEED[@]}" "${CHROME_PROFILE}/Default/Preferences" "$(cat "${SAND_WEBAUTHN_ID_FILE}")" <<'SAND_INCOGNITO_EOF' || true
import json, os, sys

prefs, extension_id = sys.argv[1], sys.argv[2]
try:
    with open(prefs, encoding="utf-8") as handle:
        settings = json.load(handle)
except (OSError, ValueError):
    settings = {}
entry = (
    settings.setdefault("extensions", {})
    .setdefault("settings", {})
    .setdefault(extension_id, {})
)
if entry.get("incognito") is not True:
    entry["incognito"] = True
    os.makedirs(os.path.dirname(prefs), exist_ok=True)
    with open(prefs, "w", encoding="utf-8") as handle:
        json.dump(settings, handle, separators=(",", ":"))
SAND_INCOGNITO_EOF
fi

# A window opens at the profile's saved placement, or at Chrome's first-run default bounds
# when it has none (https://chromium.googlesource.com/chromium/src/+/refs/tags/156.0.8078.47/chrome/browser/ui/window_sizer/window_sizer.cc).
if [ "${BOX_CHROME_WM_MAXIMIZE}" = 1 ] && ! chrome_ready && command -v python3 >/dev/null 2>&1; then
	SAND_PLACEMENT_SEED=(python3 -I -)
	[ "$(id -u)" -ne 0 ] || SAND_PLACEMENT_SEED=(runuser -u box -- python3 -I -)
	"${SAND_PLACEMENT_SEED[@]}" "${CHROME_PROFILE}/Default/Preferences" \
		"$(DISPLAY="${DISPLAY:-:1}" xprop -root -notype _NET_WORKAREA 2>/dev/null)" <<'SAND_PLACEMENT_EOF' || true
import json, os, re, sys

prefs, workarea = sys.argv[1], sys.argv[2]
numbers = [int(n) for n in re.findall(r"\d+", workarea.partition("=")[2])[:4]]
if len(numbers) < 4 or numbers[2] == 0 or numbers[3] == 0:
    sys.exit(0)
try:
    with open(prefs, encoding="utf-8") as handle:
        settings = json.load(handle)
except FileNotFoundError:
    settings = {}
except (OSError, ValueError):
    sys.exit(0)
browser = settings.setdefault("browser", {}) if isinstance(settings, dict) else None
if not isinstance(browser, dict) or "window_placement" in browser:
    sys.exit(0)
x, y, w, h = numbers
browser["window_placement"] = {"left": x, "top": y, "right": x + w, "bottom": y + h, "maximized": True}
os.makedirs(os.path.dirname(prefs), exist_ok=True)
with open(f"{prefs}.tmp", "w", encoding="utf-8") as handle:
    json.dump(settings, handle, separators=(",", ":"))
os.replace(f"{prefs}.tmp", prefs)
SAND_PLACEMENT_EOF
fi

SAND_ACCEPT_LANGUAGE_RECORD="${CHROME_PROFILE}/.sand-accept-lang"
sand_saved_accept_language() {
	local as_box=() mode=restore
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	if [ "${SAND_ACCEPT_LANGUAGE_FLAGGED}" = 1 ]; then
		[ ! -e "${SAND_ACCEPT_LANGUAGE_RECORD}" ] || return 0
		mode=save
	elif [ ! -f "${SAND_ACCEPT_LANGUAGE_RECORD}" ] || profile_browser_pid >/dev/null; then
		return 0
	fi
	command -v python3 >/dev/null 2>&1 || return 0
	"${as_box[@]}" python3 -I - "${mode}" "${CHROME_PROFILE}/Default/Preferences" "${SAND_ACCEPT_LANGUAGE_RECORD}" <<'SAND_ACCEPT_LANGUAGE_EOF' || return 0
import json, os, sys

mode, prefs, record = sys.argv[1:4]
KEYS = ("accept_languages", "selected_languages")


def load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


if mode == "save":
    try:
        intl = load(prefs).get("intl")
    except (OSError, ValueError, AttributeError):
        intl = None
    saved = {key: intl[key] for key in KEYS if isinstance(intl, dict) and key in intl}
    with open(f"{record}.tmp", "w", encoding="utf-8") as handle:
        json.dump(saved, handle)
    os.replace(f"{record}.tmp", record)
    sys.exit(0)

try:
    saved = load(record)
except (OSError, ValueError):
    saved = {}
if not isinstance(saved, dict):
    saved = {}
try:
    settings = load(prefs)
except FileNotFoundError:
    settings = None
except (OSError, ValueError):
    sys.exit(1)
if isinstance(settings, dict):
    intl = settings.get("intl")
    if intl is None and any(key in saved for key in KEYS):
        intl = settings["intl"] = {}
    if isinstance(intl, dict):
        changed = False
        for key in KEYS:
            if key in saved and (key not in intl or intl[key] != saved[key]):
                intl[key] = saved[key]
                changed = True
            elif key not in saved and key in intl:
                del intl[key]
                changed = True
        if changed:
            with open(f"{prefs}.tmp", "w", encoding="utf-8") as handle:
                json.dump(settings, handle, separators=(",", ":"))
            os.replace(f"{prefs}.tmp", prefs)
os.remove(record)
SAND_ACCEPT_LANGUAGE_EOF
}
if ! chrome_ready; then
	sand_saved_accept_language
fi

# While no managed policy sets DefaultNotificationsSetting
# (https://chromeenterprise.google/policies/#DefaultNotificationsSetting),
# sites may ask to show notifications. Chrome's "Use quieter messaging"
# setting shows such a request as a bell icon by the address bar instead of a
# prompt over the page (https://support.google.com/chrome/answer/3220216), so
# no screen click lands on Allow by accident. The profile's own value is kept
# in the record and put back once a managed policy sets notifications again.
SAND_QUIET_NOTIFICATIONS_RECORD="${CHROME_PROFILE}/.sand-quiet-notifications"
sand_quiet_notification_prompts() {
	local as_box=()
	[ "$(id -u)" -ne 0 ] || as_box=(runuser -u box --)
	! profile_browser_pid >/dev/null || return 0
	command -v python3 >/dev/null 2>&1 || return 0
	"${as_box[@]}" python3 -I - "${SAND_CHROME_MANAGED_POLICY_DIR:-/etc/opt/chrome/policies/managed}" \
		"${CHROME_PROFILE}/Default/Preferences" "${SAND_QUIET_NOTIFICATIONS_RECORD}" <<'SAND_QUIET_NOTIFICATIONS_EOF' || return 0
import json, os, sys

policy_dir, prefs, record = sys.argv[1:4]
KEY = "notifications"


def load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def managed_sets_notifications():
    try:
        names = os.listdir(policy_dir)
    except OSError:
        return False
    for name in names:
        try:
            policy = load(os.path.join(policy_dir, name))
        except (OSError, ValueError):
            continue
        if isinstance(policy, dict) and "DefaultNotificationsSetting" in policy:
            return True
    return False


def write(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(f"{path}.tmp", "w", encoding="utf-8") as handle:
        json.dump(value, handle, separators=(",", ":"))
    os.replace(f"{path}.tmp", path)


asking = not managed_sets_notifications()
if not asking and not os.path.isfile(record):
    sys.exit(0)
try:
    settings = load(prefs)
except FileNotFoundError:
    settings = {}
except (OSError, ValueError):
    sys.exit(1)
if not isinstance(settings, dict):
    sys.exit(1)
profile = settings.get("profile", {})
content = profile.get("content_settings", {}) if isinstance(profile, dict) else None
quiet = content.get("enable_quiet_permission_ui", {}) if isinstance(content, dict) else None
if not isinstance(quiet, dict):
    sys.exit(1)


def store():
    content["enable_quiet_permission_ui"] = quiet
    profile["content_settings"] = content
    settings["profile"] = profile
    write(prefs, settings)


if asking:
    if not os.path.isfile(record):
        write(record, {KEY: quiet[KEY]} if KEY in quiet else {})
    if quiet.get(KEY) is not True:
        quiet[KEY] = True
        store()
    sys.exit(0)

try:
    saved = load(record)
except (OSError, ValueError):
    saved = {}
if not isinstance(saved, dict):
    saved = {}
if KEY in saved:
    if quiet.get(KEY) != saved[KEY] or KEY not in quiet:
        quiet[KEY] = saved[KEY]
        store()
elif KEY in quiet:
    del quiet[KEY]
    store()
os.remove(record)
SAND_QUIET_NOTIFICATIONS_EOF
}
if ! chrome_ready; then
	# A launch is marked before the read so a stock notifications sync that
	# starts later waits for the next boot instead of dropping the policy under it.
	if [ "${CHROME_PORT_HELD}" -eq 0 ] && [ "${policy_status:-0}" != 3 ]; then
		mark_box_browser_launch
	fi
	sand_quiet_notification_prompts
fi

if [ "${SAND_CHROME_PREPARE}" -eq 1 ]; then
	if chrome_ready; then
		wait_for_chrome 0
	else
		start_chrome prepare
	fi
	exit
fi

if chrome_ready; then
	use_running_browser
	shown="$(chrome_visible_windows)"
	launch_chrome "$@"
	wait_for_chrome 1 && wm_maximize_new_windows "${shown}"
else
	start_chrome window "$@"
fi
