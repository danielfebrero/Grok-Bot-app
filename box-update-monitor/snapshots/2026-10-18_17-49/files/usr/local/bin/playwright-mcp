#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/usr/local/lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules/@playwright/mcp/node_modules:/usr/local/lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules:/usr/local/lib/pnpm/5/.pnpm/node_modules"
else
  export NODE_PATH="/usr/local/lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules/@playwright/mcp/node_modules:/usr/local/lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules:/usr/local/lib/pnpm/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules/@playwright/mcp/cli.js" "$@"
else
  exec node  "$basedir/../lib/pnpm/5/.pnpm/@playwright+mcp@0.0.80/node_modules/@playwright/mcp/cli.js" "$@"
fi
