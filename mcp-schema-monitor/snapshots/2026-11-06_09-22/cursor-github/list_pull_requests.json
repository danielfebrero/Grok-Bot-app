{
  "description": "GET /repos/{owner}/{repo}/pulls: one page of pull requests.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "base": {
        "description": "Filter by base branch name.",
        "type": "string"
      },
      "direction": {
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "head": {
        "description": "Filter by head as `user:ref-name` or `org:ref-name`.",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "sort": {
        "enum": [
          "created",
          "updated",
          "popularity",
          "long-running"
        ],
        "type": "string"
      },
      "state": {
        "description": "Default open.",
        "enum": [
          "open",
          "closed",
          "all"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_pull_requests"
}
