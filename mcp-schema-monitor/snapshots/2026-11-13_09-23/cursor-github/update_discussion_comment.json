    "additionalProperties": false,
    "properties": {
      "body": {
        "minLength": 1,
        "type": "string"
      },
      "comment_id": {
        "description": "The comment's node id (`id`, e.g. DC_kwDO...), from get_discussion_comments.",
        "minLength": 1,
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "comment_id",
      "body"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "update_discussion_comment"
}
