{
  "description": "Retrieves Posts from the full archive matching a search query. At most one of `start_time`, `since_id` may be provided. At most one of `end_time`, `until_id` may be provided. At most one of `pagination_token`, `next_token` may be provided. Each returned post includes a `url` deeplinking to it on x.com. The search string is query, not q. Date operators are since:YYYY-MM-DD or since:YYYY-MM-DD_HH:MM:SS_UTC (UTC only).",
  "inputSchema": {
    "properties": {
      "end_time": {
        "type": "string"
      },
      "expansions": {
        "description": "A comma separated list of fields to expand.",
        "items": {
          "enum": [
            "article.cover_media",
            "article.media_entities",
            "attachments.media_keys",
            "attachments.media_source_tweet",
            "attachments.poll_ids",
            "author_id",
            "edit_history_post_ids",
            "entities.mentions.username",
            "geo.place_id",
            "in_reply_to_user_id",
            "referenced_posts",
            "username"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "max_results": {
        "default": 10,
        "maximum": 500,
        "minimum": 10,
        "type": "integer"
      },
      "media.fields": {
        "description": "A comma separated list of Media fields to display.",
        "items": {
          "enum": [
            "alt_text",
            "duration_ms",
            "height",
            "media_key",
            "non_public_metrics",
            "organic_metrics",
            "preview_image_url",
            "promoted_metrics",
            "public_metrics",
            "revenue",
            "type",
            "url",
            "variants",
            "width"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "next_token": {
        "description": "A base32hex-encoded pagination token.",
        "type": "string"
      },
      "pagination_token": {
        "description": "A base32hex-encoded pagination token.",
        "type": "string"
      },
      "place.fields": {
        "description": "A comma separated list of Place fields to display.",
        "items": {
          "enum": [
            "contained_within",
            "country",
            "country_code",
            "full_name",
            "geo",
            "id",
            "name",
            "place_type"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "poll.fields": {
        "description": "A comma separated list of Poll fields to display.",
        "items": {
          "enum": [
            "duration_minutes",
            "end_datetime",
            "id",
            "options",
            "voting_status"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "post.fields": {
        "description": "A comma separated list of Post fields to display.",
        "items": {
          "enum": [
            "article",
            "article_title",
            "attachments",
            "card_uri",
            "community_id",
            "context_annotations",
            "conversation_id",
            "created_at",
            "display_text_range",
            "edit_controls",
            "entities",
            "geo",
            "id",
            "lang",
            "matched_media_notes",
            "media_metadata",
            "non_public_metrics",
            "note_post",
            "note_request_suggestions",
            "organic_metrics",
            "paid_partnership",
            "possibly_sensitive",
            "promoted_metrics",
            "public_metrics",
            "reply_settings",
            "rest_id",
            "scopes",
            "source",
            "suggested_source_links",
            "suggested_source_links_with_counts",
            "text",
            "withheld"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "query": {
        "type": "string"
      },
      "since_id": {
        "type": "string"
      },
      "sort_order": {
        "enum": [
          "recency",
          "relevancy"
        ],
        "type": "string"
      },
      "start_time": {
        "type": "string"
      },
      "until_id": {
        "type": "string"
      },
      "user.fields": {
        "description": "A comma separated list of User fields to display.",
        "items": {
          "enum": [
            "active_follower_count",
            "confirmed_email",
            "connection_status",
            "created_at",
            "description",
            "entities",
            "id",
            "is_identity_verified",
            "location",
            "name",
            "org_only",
            "parody",
            "profile_banner_url",
            "profile_image_url",
            "protected",
            "public_metrics",
            "receives_your_chat",
            "receives_your_dm",
            "subscriber_count",
            "subscribes_to_you",
            "subscription",
            "subscription_type",
            "url",
            "username",
            "verified",
            "verified_followers_count",
            "verified_type",
            "withheld"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "search_posts_all"
}
