{
  "description": "Retrieves news story by its ID. Each returned story includes a `url` deeplinking to its x.com page.",
  "inputSchema": {
    "properties": {
      "id": {
        "type": "string"
      },
      "news.fields": {
        "description": "A comma separated list of News fields to display.",
        "items": {
          "enum": [
            "category",
            "cluster_posts_results",
            "contexts",
            "disclaimer",
            "hook",
            "id",
            "keywords",
            "name",
            "summary",
            "updated_at"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "get_news"
}
