{
  "description": "GET /repos/{owner}/{repo}/actions/workflows/{workflow_id}: one workflow object (id, name, path, state, badge URL).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "workflow_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "description": "Numeric workflow id or the workflow file name, e.g. ci.yml."
      }
    },
    "required": [
      "owner",
      "repo",
      "workflow_id"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "get_workflow"
}
