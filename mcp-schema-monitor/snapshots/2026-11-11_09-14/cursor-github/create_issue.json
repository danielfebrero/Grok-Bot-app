{
  "description": "POST /repos/{owner}/{repo}/issues: open an issue.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "assignees": {
        "items": {
          "type": "string"
        },
        "maxItems": 10,
        "type": "array"
      },
      "body": {
        "type": "string"
      },
      "labels": {
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "type": "array"
      },
      "milestone": {
        "minimum": 1,
        "type": "integer"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "title": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "title"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "create_issue"
}
