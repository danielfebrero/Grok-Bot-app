{
  "description": "PATCH /repos/{owner}/{repo}/issues/{issue_number}/sub_issues/priority: move a sub-issue within its parent's list, placing it after `after_id` or before `before_id` (pass exactly one).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "after_id": {
        "minimum": 1,
        "type": "integer"
      },
      "before_id": {
        "minimum": 1,
        "type": "integer"
      },
      "issue_number": {
        "description": "Issue number.",
        "minimum": 1,
        "type": "integer"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "sub_issue_id": {
        "description": "The sub-issue's `id` (the numeric id on the issue object, not its number).",
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "owner",
      "repo",
      "issue_number",
      "sub_issue_id"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "reprioritize_sub_issue"
}
