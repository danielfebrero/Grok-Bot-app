{
  "description": "GET /repos/{owner}/{repo}/pulls/{pull_number}/commits: one page of the pull request's commits, oldest first (GitHub returns at most 250).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "pull_number": {
        "description": "Pull request number.",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_pull_request_commits"
}
