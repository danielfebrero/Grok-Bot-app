{
  "description": "GET /repos/{owner}/{repo}/actions/runs, or /actions/workflows/{workflow_id}/runs when `workflow_id` is given: one page of workflow runs, newest first, with GitHub's run filters.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "actor": {
        "description": "Login of the user who triggered the run.",
        "type": "string"
      },
      "branch": {
        "type": "string"
      },
      "created": {
        "description": "Date range in GitHub search syntax, e.g. >=2026-01-01.",
        "type": "string"
      },
      "event": {
        "description": "Trigger event, e.g. push, pull_request.",
        "type": "string"
      },
      "exclude_pull_requests": {
        "type": "boolean"
      },
      "head_sha": {
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "status": {
        "enum": [
          "completed",
          "action_required",
          "cancelled",
          "failure",
          "neutral",
          "skipped",
          "stale",
          "success",
          "timed_out",
          "in_progress",
          "queued",
          "requested",
          "waiting",
          "pending"
        ],
        "type": "string"
      },
      "workflow_id": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "description": "Workflow id or file name (ci.yml); all workflows when omitted."
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_workflow_runs"
}
