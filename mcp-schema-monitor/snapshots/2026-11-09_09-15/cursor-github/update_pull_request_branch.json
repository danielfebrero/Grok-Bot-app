{
  "description": "PUT /repos/{owner}/{repo}/pulls/{pull_number}/update-branch: bring the head branch up to date with its base (GitHub's \"Update branch\"). Asynchronous on GitHub's side (202).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "expected_head_sha": {
        "description": "Refuse if the head has moved past this SHA.",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "pull_number": {
        "description": "Pull request number.",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "update_pull_request_branch"
}
