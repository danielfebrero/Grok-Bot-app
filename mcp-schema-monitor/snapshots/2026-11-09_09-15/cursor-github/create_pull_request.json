{
  "description": "POST /repos/{owner}/{repo}/pulls: open a pull request from an existing branch. `head` is the branch with the changes (`user:branch` for a fork), `base` the target branch.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "base": {
        "minLength": 1,
        "type": "string"
      },
      "body": {
        "description": "Markdown description.",
        "type": "string"
      },
      "draft": {
        "type": "boolean"
      },
      "head": {
        "minLength": 1,
        "type": "string"
      },
      "maintainer_can_modify": {
        "type": "boolean"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "title": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "title",
      "head",
      "base"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "create_pull_request"
}
