{
  "description": "PATCH /repos/{owner}/{repo}/pulls/{pull_number}: change title, body, base branch, or state (open/closed).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "base": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "maintainer_can_modify": {
        "type": "boolean"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "pull_number": {
        "description": "Pull request number.",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "state": {
        "enum": [
          "open",
          "closed"
        ],
        "type": "string"
      },
      "title": {
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "update_pull_request"
}
