{
  "description": "GET /repos/{owner}/{repo}/pulls/{pull_number}/comments: one page of inline review comments (each with path, line, and diff hunk).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "direction": {
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "pull_number": {
        "description": "Pull request number.",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "since": {
        "description": "ISO 8601 timestamp.",
        "type": "string"
      },
      "sort": {
        "enum": [
          "created",
          "updated"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_pull_request_review_comments"
}
