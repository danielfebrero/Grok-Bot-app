{
  "description": "GET /repos/{owner}/{repo}/issues/{issue_number}/comments: one page of an issue's comments.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "issue_number": {
        "description": "Issue number.",
        "minimum": 1,
        "type": "integer"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "since": {
        "description": "ISO 8601 timestamp.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "issue_number"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_issue_comments"
}
