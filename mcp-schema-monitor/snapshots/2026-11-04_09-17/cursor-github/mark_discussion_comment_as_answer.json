{
  "description": "Mark (`answer: true`) or unmark a comment as the accepted answer of a Q&A discussion (GraphQL `markDiscussionCommentAsAnswer` / `unmarkDiscussionCommentAsAnswer`).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "answer": {
        "description": "true marks, false unmarks.",
        "type": "boolean"
      },
      "comment_id": {
        "description": "The comment's node id (`id`, e.g. DC_kwDO...), from get_discussion_comments.",
        "minLength": 1,
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "comment_id",
      "answer"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "mark_discussion_comment_as_answer"
}
