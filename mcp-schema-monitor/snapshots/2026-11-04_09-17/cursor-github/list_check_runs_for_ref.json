{
  "description": "GET /repos/{owner}/{repo}/commits/{ref}/check-runs: one page of check runs (GitHub Actions and other Checks API apps) for a ref.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "check_name": {
        "type": "string"
      },
      "filter": {
        "enum": [
          "latest",
          "all"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "page": {
        "description": "1-based page number.",
        "minimum": 1,
        "type": "integer"
      },
      "per_page": {
        "description": "Results per page (GitHub's default is 30, max 100).",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "ref": {
        "description": "Commit SHA, branch name, or tag name.",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      },
      "status": {
        "enum": [
          "queued",
          "in_progress",
          "completed"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "ref"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "list_check_runs_for_ref"
}
