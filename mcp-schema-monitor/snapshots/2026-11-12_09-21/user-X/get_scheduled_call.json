{
  "description": "Returns a scheduled call the authenticated user organizes or is invited to, at its occurrence running now or its next one within a year: its time, call, recurrence and who is invited and how they answered. Changes can take a few seconds to show here. Use scheduled_call.fields to select which fields are returned.",
  "inputSchema": {
    "properties": {
      "call.fields": {
        "description": "A comma separated list of Call fields to display.",
        "items": {
          "enum": [
            "conversation_id",
            "created_at",
            "id",
            "join_policy",
            "join_url",
            "participant_count",
            "title",
            "viewer_may_join"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "expansions": {
        "description": "A comma separated list of fields to expand.",
        "items": {
          "enum": [
            "call_id",
            "invitees",
            "organizer_id"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "id": {
        "type": "string"
      },
      "scheduled_call.fields": {
        "description": "A comma separated list of ScheduledCall fields to display.",
        "items": {
          "enum": [
            "calendar",
            "call_id",
            "description",
            "end_time",
            "id",
            "join_url",
            "occurrence_start_time",
            "recurrence",
            "start_time",
            "status",
            "time_zone",
            "title"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "user.fields": {
        "description": "A comma separated list of User fields to display.",
        "items": {
          "enum": [
            "active_follower_count",
            "confirmed_email",
            "connection_status",
            "created_at",
            "description",
            "entities",
            "id",
            "is_identity_verified",
            "location",
            "name",
            "parody",
            "profile_banner_url",
            "profile_image_url",
            "protected",
            "public_metrics",
            "receives_your_chat",
            "receives_your_dm",
            "subscriber_count",
            "subscribes_to_you",
            "subscription",
            "subscription_type",
            "url",
            "username",
            "verified",
            "verified_followers_count",
            "verified_type",
            "withheld"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "get_scheduled_call"
}
