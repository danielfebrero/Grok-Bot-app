    "properties": {
      "body": {
        "minLength": 1,
        "type": "string"
      },
      "issue_number": {
        "description": "Issue number.",
        "minimum": 1,
        "type": "integer"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "issue_number",
      "body"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "add_issue_comment"
}
