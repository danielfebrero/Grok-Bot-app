    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "Label name (case-insensitive).",
        "minLength": 1,
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (user or org login).",
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "name"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "delete_label"
}
