{
  "description": "Retrieves a list of News stories matching the specified search query. Each returned story includes a `url` deeplinking to its x.com page. The search string is query, not q. max_age_hours is 1 to 720.",
  "inputSchema": {
    "properties": {
      "max_age_hours": {
        "default": 168,
        "maximum": 720,
        "minimum": 1,
        "type": "integer"
      },
      "max_results": {
        "default": 10,
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "news.fields": {
        "description": "A comma separated list of News fields to display.",
        "items": {
          "enum": [
            "category",
            "cluster_posts_results",
            "contexts",
            "disclaimer",
            "hook",
            "id",
            "keywords",
            "name",
            "summary",
            "updated_at"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "search_news"
}
