{
  "description": "Retrieves a list of Spaces matching the specified search query.",
  "inputSchema": {
    "properties": {
      "expansions": {
        "description": "A comma separated list of fields to expand.",
        "items": {
          "enum": [
            "creator_id",
            "host_ids",
            "invited_user_ids",
            "speaker_ids",
            "topic_ids"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "max_results": {
        "default": 100,
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "type": "string"
      },
      "space.fields": {
        "description": "A comma separated list of Space fields to display.",
        "items": {
          "enum": [
            "created_at",
            "ended_at",
            "id",
            "is_ticketed",
            "lang",
            "participant_count",
            "scheduled_start",
            "started_at",
            "state",
            "subscriber_count",
            "title",
            "updated_at"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "state": {
        "default": "all",
        "enum": [
          "live",
          "scheduled",
          "all"
        ],
        "type": "string"
      },
      "topic.fields": {
        "description": "A comma separated list of Topic fields to display.",
        "items": {
          "enum": [
            "description",
            "id",
            "name"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "user.fields": {
        "description": "A comma separated list of User fields to display.",
        "items": {
          "enum": [
            "active_follower_count",
            "confirmed_email",
            "connection_status",
            "created_at",
            "description",
            "entities",
            "id",
            "is_identity_verified",
            "location",
            "name",
            "org_only",
            "parody",
            "profile_banner_url",
            "profile_image_url",
            "protected",
            "public_metrics",
            "receives_your_chat",
            "receives_your_dm",
            "subscriber_count",
            "subscribes_to_you",
            "subscription",
            "subscription_type",
            "url",
            "username",
            "verified",
            "verified_followers_count",
            "verified_type",
            "withheld"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  },
  "outputSchema": null,
  "tool": "search_spaces"
}
